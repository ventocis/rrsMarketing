---
import TexasLayout from '../../layouts/TexasLayout.astro';
import CoursePlanCards from '../../components/texas/CoursePlanCards.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { courtStats as S } from '../../lib/court-stats';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const price = TEXAS_PRICE_LABEL;
const coursePrice = TEXAS_COURSE.price;

// Rebuilt 2026-10-06 from Jackson's design canvas (Dallas Page Redesign2.html, artboard 04 "Cost" + its
// search preview), implemented as the spec: his copy, section order, the fee calculator, CTAs. Adaptations,
// all flagged in the PR: the calculator's fee range uses our verified court dataset (court-stats.ts) instead
// of the design's placeholder "$100–$184"; the refund checkmark matches our policy (full refund within the
// three-day cancellation window); the design has no video so the previous YouTube card is not carried over.

const feeOptions = Array.from(new Set([S.fee.min, 144, 169, S.fee.max])).sort((a, b) => a - b);
const recordFee = 12;
const defaultFee = 144;
const defaultTotal = defaultFee + recordFee + coursePrice;

const faqs = [
  { q: 'How much does a defensive driving course cost in Texas?', a: `At least ${floor}, by law. What you pay depends on what a provider adds at checkout. Ours is ${price} with the instant certificate included.` },
  { q: 'What is the cheapest defensive driving course in Texas?', a: `One at or near the ${floor} floor with the certificate included and nothing added at checkout. Compare final totals, not ads.` },
  { q: 'Why do some courses advertise $25 and charge more?', a: 'Certificate, “processing” and premium lines get added after the advertised price. Some checkouts also still show the old $25 + $3 split.' },
  { q: 'Does Road Ready Safety charge anything after the course?', a: `No. ${price} covers the course, the instant certificate with both copies, and unlimited retakes.` },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'A Texas defensive driving course costs $25. Here’s what you’ll actually pay.',
  description: 'Texas law sets a $25 minimum for every approved course. Every fee that gets added at checkout, and the full cost to dismiss a ticket at your court’s fee.',
  datePublished: '2026-06-15',
  dateModified: '2026-10-06',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/cost`,
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const addons = [
  { t: 'Certificate delivery', pill: 'Watch this one', hot: true, b: 'Free by mail in a week or more, extra for an instant copy. The most common add-on.' },
  { t: 'Rush or “instant” certificate', pill: 'Often avoidable', hot: false, b: 'Only matters if instant download isn’t already included.' },
  { t: '“Processing” or “state” fee', pill: 'Check it', hot: false, b: `A line added to reach or pass ${floor}. A “$3 state fee” is a leftover from the old $25 + $3 rule.` },
  { t: 'Driving record add-on', pill: 'Skip it', hot: false, b: `DPS sells the same Type 3A record for $${recordFee} online. A markup is pure margin. <a href="/texas/type-3a-driving-record" class="text-primary hover:text-primary-deep font-medium">How to order it</a>` },
  { t: 'Audio, video or “premium”', pill: 'Optional', hot: false, b: 'A higher tier of the same course. Same certificate, same dismissal.' },
  { t: 'Retake or extension fees', pill: 'Read first', hot: false, b: 'Charges to retry a quiz or reopen an expired course. Check the policy before you pay.' },
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5 lg:p-[22px]';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
---

{isEnabled ? (
  <TexasLayout
    title={`Texas Defensive Driving Cost: $${TEXAS_COURSE.legalMinimumPrice} Course, About $${defaultTotal} All In`}
    description="Texas law sets a $25 minimum for every approved course. See every fee that gets added at checkout and the full cost to dismiss a ticket."
    keywords="texas defensive driving course cost, how much is defensive driving in texas, defensive driving price texas, cheapest defensive driving course texas, texas driving safety course fee"
    url="/texas/cost"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><span>Cost</span></p>
        <div class="max-w-[780px] pt-8 pb-10">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>A Texas defensive driving course costs {floor}. Here's what you'll actually pay.</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">{floor} is the legal minimum for every TDLR-approved course. But the course is the <strong>cheapest</strong> part of getting a ticket dismissed. At the most common court fee, the whole thing comes to about <strong>${defaultTotal}</strong>.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">So where does the rest go, and which of it can you avoid? Pick your court's fee below and see the full math.</p>
          <p class="text-[15px] text-text-muted m-0">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber}. We sell one of these courses, so every rule here points at its source. · Updated October 6, 2026</p>
        </div>
      </div>

      <!-- ===== Calculator ===== -->
      <section id="total" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`} data-calc data-course={coursePrice} data-record={recordFee}>
          <h2 class={h2c} style={inter}>How much does it cost to dismiss a Texas ticket, all in?</h2>
          <p class="text-base leading-7 m-0 mb-7 max-w-[780px]">Three costs: the court's fee, sometimes a ${recordFee} driving record, and the course. The court fee is the big one, and it's the same whichever course you pick.</p>
          <div class="flex flex-wrap gap-8">
            <div class="flex-[1_1_340px] min-w-0 flex flex-col gap-6">
              <div>
                <p class="font-bold text-base m-0 mb-2.5">Your court's fee</p>
                <div class="flex flex-wrap gap-2.5">
                  {feeOptions.map((v) => <button type="button" data-fee={v} aria-pressed={v === defaultFee ? 'true' : 'false'} class={`font-bold text-[17px] min-h-[48px] px-[18px] rounded-full border-2 transition-colors ${v === defaultFee ? pillOn : pillOff}`}>${v}</button>)}
                </div>
                <p class="text-[15px] text-text-muted m-0 mt-2">$144 is the most common. $169 is common in school zones. Range across courts we've verified: ${S.fee.min}–${S.fee.max}. <a href="/texas/dsc-fees-by-court" class="text-primary hover:text-primary-deep font-medium">Fees by court</a></p>
              </div>
              <div>
                <p class="font-bold text-base m-0 mb-2.5">Does your court want a Type 3A driving record?</p>
                <div class="flex flex-wrap gap-2.5">
                  <button type="button" data-rec="1" aria-pressed="true" class={`font-bold text-[17px] min-h-[48px] px-[18px] rounded-full border-2 transition-colors ${pillOn}`}>Yes, +${recordFee}</button>
                  <button type="button" data-rec="0" aria-pressed="false" class={`font-bold text-[17px] min-h-[48px] px-[18px] rounded-full border-2 transition-colors ${pillOff}`}>No</button>
                </div>
              </div>
            </div>
            <div class="flex-[1_1_400px] min-w-0 rounded-2xl border border-border bg-surface-muted p-6 flex flex-col gap-3.5">
              <span class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep">Your total with Road Ready Safety</span>
              <span class="text-[48px] lg:text-[56px] font-extrabold leading-none" style={inter}>$<span data-total>{defaultTotal}</span></span>
              <div class="flex h-[18px] w-full rounded-full overflow-hidden">
                <div data-bar-fee class="bg-[#8B95A5] transition-all" style={`width:${(defaultFee / defaultTotal * 100).toFixed(1)}%`}></div>
                <div data-bar-rec class="bg-[#B9C0CB] transition-all" style={`width:${(recordFee / defaultTotal * 100).toFixed(1)}%`}></div>
                <div data-bar-course class="bg-primary transition-all" style={`width:${(coursePrice / defaultTotal * 100).toFixed(1)}%`}></div>
              </div>
              <div class="flex flex-col gap-2 text-[17px]">
                <div class="flex justify-between gap-3"><span>Court fee, paid to the court</span><strong>$<span data-fee-out>{defaultFee}</span></strong></div>
                <div class="flex justify-between gap-3"><span>Type 3A record, from Texas DPS</span><strong>$<span data-rec-out>{recordFee}</span></strong></div>
                <div class="flex justify-between gap-3"><span>The course, certificate included</span><strong class="text-primary">{price}</strong></div>
              </div>
              <p class="border-t border-border pt-3.5 text-base text-text-body m-0">Paying the ticket instead? The fine is often $150 to $300, and the conviction stays on your insurance for three years.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== Legal floor ===== -->
      <section class={`${wrap} pt-16 pb-6`}>
        <h2 class={h2c} style={inter}>What's the cheapest a course can legally be?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">{floor}. Texas law sets that as the minimum for every approved course (Tex. Educ. Code §1001.352). Anything advertised for less is either not approved or not showing you the real price.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          <div class={card}>
            <p class="font-bold text-[19px] m-0 mb-1.5">Is there a free course?</p>
            <p class="text-base text-text-body leading-6 m-0">No. A free course can't be TDLR-approved, so its certificate won't dismiss anything. "Free" in ads means free retakes, free mailing or a free preview.</p>
          </div>
          <div class={card}>
            <p class="font-bold text-[19px] m-0 mb-1.5">What's closest to free?</p>
            <p class="text-base text-text-body leading-6 m-0">Some employers reimburse it, and an insurance discount can pay the fee back over your policy term. <a href="/texas/insurance-discount" class="text-primary hover:text-primary-deep font-medium">What insurers give</a></p>
          </div>
        </div>
      </section>

      <!-- ===== Added fees ===== -->
      <section id="fees" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>Which fees get added after the advertised price?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Up to six lines can sit between the ad and your final total. Read the certificate one twice: if your court has a deadline, paying for a fast certificate is paying for your own deadline.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {addons.map((a) => (
            <div class={`rounded-[14px] border p-5 lg:p-[22px] flex flex-col gap-1.5 ${a.hot ? 'bg-amber-50 border-amber-200' : 'bg-white border-border'}`}>
              <span class="flex justify-between gap-2.5 items-baseline"><span class="font-bold text-[19px]">{a.t}</span><span class={`text-sm font-bold px-2.5 py-0.5 rounded-full whitespace-nowrap ${a.hot ? 'text-white bg-amber-800' : 'text-text-body bg-[#F6F6F9]'}`}>{a.pill}</span></span>
              <span class="text-base text-text-body leading-6" set:html={a.b} />
            </div>
          ))}
        </div>
        <div class="mt-5 rounded-[14px] bg-primary-deep text-white px-6 py-5 lg:px-7 max-w-[820px]">
          <span class="text-sm font-bold uppercase tracking-[0.06em] text-info-border">One question for any checkout</span>
          <p class="text-[20px] lg:text-[22px] font-bold leading-[1.3] m-0 mt-1" style={inter}>"When I finish, is the certificate in my hands today at no extra cost?" <a href="/texas/best-defensive-driving-course" class="text-info-border text-base font-semibold hover:underline" style={sans}>How to pick a course →</a></p>
        </div>
      </section>
      <CoursePlanCards id="course" ctaPrefix="cost-choose" heading="What does Road Ready Safety charge?" subhead={`${price} all-in, certificate included. Audio is an optional add-on.`} />

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[780px] mt-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-white p-5">
              <h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3>
              <p class="m-0 text-text-body leading-7">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== Keep reading + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Keep reading</p>
        <div class="flex flex-wrap gap-2.5 mb-7">
          {[
            ['/texas/best-defensive-driving-course', 'How to pick a course'],
            ['/texas/ticket-dismissal', 'How ticket dismissal works'],
            ['/texas/traffic-ticket-fines', 'Speeding ticket fines'],
            ['/texas/type-3a-driving-record', 'Order a Type 3A record'],
            ['/texas/insurance-discount', 'Insurance discount'],
            ['/texas/pricing', 'Our pricing policy'],
          ].map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[780px] leading-6">General information, not legal advice. Sources: Tex. Educ. Code §1001.352 as amended by HB 3012, eff. Sept. 1, 2025 (price floor); court fee range from our verified court dataset ({S.fee.known} courts); Type 3A fee per Texas DPS. Fee-line categories come from checkout flows we reviewed in 2026. No provider is named or priced on this page. Road Ready Safety is a TDLR-licensed provider ({TEXAS_COURSE.providerNumber}). Last updated October 6, 2026.</p>
      </section>

      <StickyCta afterId="total" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-calc]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var course = +root.getAttribute('data-course'), recordFee = +root.getAttribute('data-record');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          var fee = 144, rec = true;
          function pick(group, sel) { group.forEach(function (x) { var s = x === sel; x.setAttribute('aria-pressed', s ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, s); }); off.forEach(function (c) { x.classList.toggle(c, !s); }); }); }
          function render() {
            var r = rec ? recordFee : 0, total = fee + r + course, pct = function (n) { return (n / total * 100).toFixed(1) + '%'; };
            root.querySelector('[data-total]').textContent = total; root.querySelector('[data-fee-out]').textContent = fee; root.querySelector('[data-rec-out]').textContent = r;
            root.querySelector('[data-bar-fee]').style.width = pct(fee); root.querySelector('[data-bar-rec]').style.width = pct(r); root.querySelector('[data-bar-course]').style.width = pct(course);
          }
          var feeBtns = root.querySelectorAll('[data-fee]'), recBtns = root.querySelectorAll('[data-rec]');
          feeBtns.forEach(function (b) { b.addEventListener('click', function () { fee = +b.getAttribute('data-fee'); pick(feeBtns, b); render(); }); });
          recBtns.forEach(function (b) { b.addEventListener('click', function () { rec = b.getAttribute('data-rec') === '1'; pick(recBtns, b); render(); }); });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

# Copy to .env.local and set values as needed.
# All vars are baked in at build time (SSG — no server runtime). VITE_* vars are exposed to client.
# Pipeline: npm run build:qa loads .env.qa (Texas on, QA URLs); npm run build:prod loads .env.production.
# For local overrides, use .env.local.

# Marketing site's own URL — used in SEO metadata, canonical links, and sitemap
VITE_SITE_URL=https://roadreadysafety.com

# Portal application URL — used for enrollment links on non-partner courses
VITE_PORTAL_URL=https://app.roadreadysafety.com

# Analytics — leave blank for QA/dev, set for prod
VITE_GTM_ID=
VITE_ENABLE_ANALYTICS=false

# When true, components use course.qa_link instead of course.affiliate_link for enrollment CTAs
VITE_IS_QA=false


# Texas routes: set to "true" to enable /texas and related routes (e.g. QA build).
# Leave unset or "false" for prod (no /texas).
# VITE_TEXAS_ROUTES_ENABLED=true

# Texas enrollment URL: when set, all Texas "Start Course" / "Enroll" CTAs use this URL.
# VITE_TEXAS_ENROLLMENT_URL=https://app.qa.roadreadysafety.com/public/checkout?sku=tx-bdi

# Contact Us URL — where /support and all "Help Center" links redirect.
# VITE_CONTACT_US_URL=https://app.roadreadysafety.com/contact

# Portal login URL — when set, header "Log In" goes here. Leave unset to hide button.
# VITE_LOGIN_URL=https://app.qa.roadreadysafety.com/public/login

# Adult Driver Education (ADE-1317) routes: set to "true" to enable /adult-drivers-ed/*.
# ⚠️ MUST stay false until the TDLR Driver Education Provider license is approved —
# 16 TAC §84.80(e) bars provider-name advertising, enrollment, and payment before approval.
# Also fill in provider.deLicenseNumber in src/data/ade-texas.json before flipping this.
# VITE_ADE_ROUTES_ENABLED=true

# ADE enrollment URL — separate SKU and checkout from the driving-safety course, because
# the two carry different TDLR license numbers (§84.503(j)(4)).
# VITE_ADE_ENROLLMENT_URL=https://app.qa.roadreadysafety.com/public/checkout?sku=tx-ade

# Per-state course sites: comma-separated state codes to enable (/ohio, /north-dakota, /idaho,
# /missouri). Set on QA and locally. Production ALSO requires provider.approvalNumber to be filled
# in src/data/courses/<key>.json — every one of these states bars advertising a course before it
# is approved (e.g. Ohio OAC 4501-21-08(C)), so the guard lives in code, not in an env file.
# VITE_STATE_COURSES_ENABLED=oh,nd,id,mo

# Optional per-state enrollment URL overrides. Default: $VITE_PORTAL_URL/public/checkout?sku=<key>
# VITE_OH_ENROLLMENT_URL=https://app.qa.roadreadysafety.com/public/checkout?sku=oh-bdi

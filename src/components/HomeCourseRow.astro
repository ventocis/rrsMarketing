---
/**
 * "Pick your state" cards (Jackson, 2026-09-30; redesigned 2026-10-02).
 *
 * Compact on purpose: state and approval, the outcome in a few words, hours and price on one
 * line, then Start now and Learn more side by side. Proof (the review, secure checkout) lives
 * once in the hero above, not repeated on every card.
 *
 * State courses appear only when their pages are live AND the approval is on file, in every
 * environment, so QA matches production. Texas alone still renders; a new state joins
 * automatically once its approval number is filled in.
 */
import { FEATURED_COURSES } from '../data/featured-courses';
import nd from '../data/courses/nd-ddc.json';
import mo from '../data/courses/mo-dip.json';
import type { CourseData } from '../data/courses/types';
import { isEnabled, isLicensed, enrollUrl as stateEnrollUrl } from '../lib/courseFlags';

interface Card {
  id: string;
  state: string;
  seal: string;
  sealAlt: string;
  approval: string;
  name: string;
  line: string;
  hours: string;
  price: string;
  enrollUrl: string;
  learnMoreHref: string;
}

const tx = FEATURED_COURSES[0];
const cards: Card[] = [
  {
    id: tx.id,
    state: 'Texas',
    seal: '/assets/images/badges/texas-approved-tdlr.png',
    sealAlt: 'Texas approved: TDLR-approved course',
    approval: tx.credential,
    name: tx.name,
    line: 'Dismiss your ticket.',
    hours: '6',
    price: tx.price,
    enrollUrl: import.meta.env.VITE_TEXAS_ENROLLMENT_URL || tx.enrollFallback,
    learnMoreHref: tx.learnMoreHref,
  },
];

const ndCourse = nd as CourseData;
if (isEnabled(ndCourse) && isLicensed(ndCourse)) {
  cards.push({
    id: ndCourse.course.key,
    state: 'North Dakota',
    seal: '/assets/images/badges/north-dakota-approved.png',
    sealAlt: 'North Dakota approved: NDDOT-approved course',
    approval: `${ndCourse.state.agencyShort}-approved`,
    name: ndCourse.course.name,
    line: 'Take 3 points off your record.',
    hours: String(ndCourse.course.hours),
    price: ndCourse.course.priceUsd,
    enrollUrl: stateEnrollUrl(ndCourse),
    learnMoreHref: ndCourse.state.route,
  });
}

const moCourse = mo as CourseData;
if (isEnabled(moCourse) && isLicensed(moCourse)) {
  cards.push({
    id: moCourse.course.key,
    state: 'Missouri',
    seal: '/assets/images/badges/missouri-approved.png',
    sealAlt: 'Missouri approved: Missouri Safety Center-approved program',
    approval: `MSC-approved · ${moCourse.provider.approvalNumber}`,
    name: moCourse.course.name,
    line: 'Keep the points off your record.',
    hours: String(moCourse.course.hours),
    price: moCourse.course.priceUsd,
    enrollUrl: stateEnrollUrl(moCourse),
    learnMoreHref: moCourse.state.route,
  });
}

interface Props { /** Rendered inside the hero: no section wrapper, no heading, lighter panel. */ embedded?: boolean }
const { embedded = false } = Astro.props;
// Texas alone still renders: with the hero's purchase panel gone, this is the homepage's buy button.
const show = cards.length > 0;
const cols = cards.length >= 3 ? 'md:grid-cols-3' : cards.length === 2 ? 'md:grid-cols-2 max-w-3xl mx-auto' : 'max-w-md mx-auto';
const Outer = embedded ? 'div' : 'section';
---

{show && (
  <Outer
    class={embedded ? '' : 'bg-white py-14 lg:py-20 border-b border-border'}
    style={embedded ? undefined : "font-family: 'Inter', sans-serif;"}
    aria-labelledby={embedded ? undefined : 'pick-state-heading'}
  >
    <div class={embedded ? '' : 'max-w-[1152px] mx-auto px-4 sm:px-6 lg:px-8'}>
      {!embedded && (
        <h2 id="pick-state-heading" class="text-[28px] lg:text-[36px] font-bold text-text tracking-[-0.02em] leading-[1.2] text-center m-0 mb-8">Pick your state</h2>
      )}
      <ul class={`grid grid-cols-1 ${cols} gap-4 lg:gap-5 list-none p-0 m-0`} aria-label="Courses we offer">
        {cards.map((c) => (
          <li class="bg-white rounded-[20px] border border-border p-6 flex flex-col gap-5 text-left shadow-[0_12px_32px_-18px_rgba(17,23,34,0.25)]">
            <div class="flex items-center gap-3">
              <img src={c.seal} width="44" height="44" alt={c.sealAlt} class="w-11 h-11 shrink-0" loading="lazy" decoding="async" />
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-text leading-6 m-0">{c.state}</h3>
                <p class="text-xs font-semibold text-primary-deep leading-5 m-0">{c.approval}</p>
              </div>
            </div>
            <div class="flex-1">
              <p class="text-xl font-bold text-text leading-7 tracking-[-0.01em] m-0">{c.line}</p>
              <p class="text-sm text-text-body leading-6 m-0 mt-1">{c.name}</p>
            </div>
            <p class="flex items-baseline gap-2 m-0">
              <span class="text-[28px] leading-none font-extrabold text-text tracking-[-0.02em]">${c.price}</span>
              <span class="text-sm text-text-body">all-in · {c.hours} hours online</span>
            </p>
            <div class="grid grid-cols-2 gap-2.5">
              <a href={c.enrollUrl} data-course-row-enroll={c.id} class="bg-primary hover:bg-primary-hover text-white h-11 px-3 rounded-full text-[15px] font-semibold inline-flex items-center justify-center gap-1.5 no-underline whitespace-nowrap transition-colors">
                Start now
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href={c.learnMoreHref} class="border-[1.5px] border-primary hover:bg-info text-primary-deep bg-white h-11 px-3 rounded-full text-[15px] font-semibold inline-flex items-center justify-center no-underline whitespace-nowrap transition-colors">Learn more</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Outer>
)}

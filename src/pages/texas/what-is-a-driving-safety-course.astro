---
import TexasLayout from '../../layouts/TexasLayout.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import reviews from '../../data/texas-reviews.json';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const price = TEXAS_PRICE_LABEL;
const review = reviews.find((r: any) => r.name === 'Ryan Johnson');

// Rebuilt 2026-10-06 from Jackson's design canvas "Course Explainer Redesign" (Main.dc.html + Serp.dc.html),
// implemented as the spec: his copy, section order, the ticket/insurance picker, CTAs. Deviations flagged in
// the PR: "Check my ticket in 4 questions" is worded "Does my ticket qualify?" (house rule), and the design
// has no video so the previous YouTube card is not carried over.

const faqs = [
  { q: 'Is a driving safety course the same as defensive driving?', a: 'Yes. Same six-hour course, same certificate. Texas law says “driving safety course”; most people say defensive driving.' },
  { q: 'How long is it?', a: 'Six hours: at least five of instruction plus breaks (16 TAC ch. 84). You can spread it over several days.' },
  { q: 'Can I take the course first and ask the court later?', a: 'No. The court has to approve it first, and you have to ask by the appearance date. A certificate the court never authorized won’t count. <a href="/texas/request-defensive-driving" class="text-primary-deep font-medium hover:underline">How to ask</a>' },
  { q: 'Does it remove points?', a: 'Texas has no license points since 2019. Dismissal keeps the conviction off your record, which is what insurers read.' },
  { q: 'Can one course do both, the ticket and the discount?', a: 'Yes. Send the court copy to the court and the insurance copy to your insurer.' },
];
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'What is a Texas driving safety course?',
  description: 'The 6-hour, state-approved course that dismisses an eligible ticket or earns an insurance discount. Who can take it, how it works, and what it costs.',
  datePublished: '2026-10-06',
  dateModified: '2026-10-06',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/what-is-a-driving-safety-course`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) });

const picks = [
  { k: 'ticket', label: 'I got a ticket', headline: 'Get an eligible ticket dismissed, and kept off your record',
    steps: ['Ask the court for the course by the appearance date on your ticket. Don’t pay the ticket.', `Once the court says yes, take the ${TEXAS_COURSE.hours}-hour course within its deadline, usually 90 days.`, 'Send the court your certificate and, if asked, your $12 Type 3A record. The court dismisses the charge.'],
    cta: ['/texas/request-defensive-driving', 'How to ask the court →'], cta2: ['/texas/ticket-dismissal', 'See the full dismissal process'] },
  { k: 'insurance', label: 'I want an insurance discount', headline: 'Lower your insurance. No ticket, no court.',
    steps: ['Check that your insurer offers a course discount. Each company sets its own.', `Take the ${TEXAS_COURSE.hours}-hour course whenever it suits you.`, 'Send the insurance copy of your certificate to your insurer.'],
    cta: [enrollUrl, `Start the ${price} course →`], cta2: ['/texas/insurance-discount', 'What insurers actually give'] },
];
const cants = [
  { t: '✕  Remove points', b: 'Texas hasn’t had license points since 2019. What it protects is the conviction on your record.' },
  { t: '✕  Undo a paid ticket', b: 'Paying is a conviction. Once it’s entered, there’s nothing left to dismiss. <a href="/texas/already-paid-ticket" class="text-primary hover:text-primary-deep font-medium">Already paid?</a>' },
  { t: '✕  Dismiss it on its own', b: 'The court does that, after it approves the course and gets your paperwork.' },
];
const how = [
  ['Phone, tablet or computer', 'It saves your place when you switch.'],
  ['Short quizzes', 'Unlimited retakes with us, and no final exam.'],
  ['Listen instead of read', 'An optional <a href="/texas/audio-course" class="text-primary hover:text-primary-deep font-medium">audio version</a> reads each lesson aloud.'],
  ['No shortcuts', 'A “2-hour course” isn’t this course. <a href="/texas/what-the-course-looks-like" class="text-primary hover:text-primary-deep font-medium">Where the time goes</a>'],
];
const table = [
  ['Texas driving safety course', 'Licensed drivers', '✓ Yes, if eligible', true],
  ['Driver education', 'Getting a license', '✕ No', false],
  ['New York “5-hour course”', 'New York drivers', '✕ No', false],
];
const nextSteps = [
  ['/texas/request-defensive-driving', 'Have a ticket, haven’t asked yet?', 'How to request the course →'],
  ['/texas/defensive-driving-vs-deferred-disposition', 'Weighing your options?', 'Course vs. deferred disposition →'],
  ['/texas/ticket-dismissal', 'Want the full process?', 'Texas ticket dismissal guide →'],
  ['/texas/insurance-discount', 'No ticket, just the discount?', 'What insurers actually give →'],
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5 lg:p-[22px]';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
---

{isEnabled ? (
  <TexasLayout
    title="What Is a Texas Driving Safety Course? (Defensive Driving)"
    description="The 6-hour, state-approved course that dismisses an eligible ticket or earns an insurance discount. Who can take it, how it works, and what it costs."
    keywords="what is a driving safety course texas, what is defensive driving course texas, texas driving safety course, defensive driving course explained, is the driving safety course the same as defensive driving, how long is the defensive driving course texas"
    url="/texas/what-is-a-driving-safety-course"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><span>What the course is</span></p>
        <div class="max-w-[820px] pt-8 pb-8">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>What is a Texas driving safety course?</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">It's a {TEXAS_COURSE.hours}-hour, state-approved course you take online to <strong>get an eligible ticket dismissed</strong> or to <strong>earn an insurance discount</strong>. Most people call it defensive driving. You get your certificate the moment you finish.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">If you're here because of a ticket, there's one rule that matters more than the course itself: the court has to say yes <em>before</em> you start.</p>
          <p class="text-[15px] text-text-muted m-0">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber}. We run one of these courses, so every rule here points at its source. · Published October 6, 2026</p>
        </div>
        <div class="flex flex-wrap items-center gap-3 pb-12">
          <span class="bg-white border border-border rounded-full px-[18px] py-2.5 font-bold">Driving safety course</span>
          <span class="font-extrabold text-primary" style={inter}>=</span>
          <span class="bg-white border border-border rounded-full px-[18px] py-2.5 font-bold">Defensive driving</span>
          <span class="font-extrabold text-primary" style={inter}>=</span>
          <span class="bg-white border border-border rounded-full px-[18px] py-2.5 font-bold">DSC</span>
          <span class="text-base text-text-body">Same course. The law, courts and providers just use different names.</span>
        </div>
      </div>

      <!-- ===== Why do you need it (picker) ===== -->
      <section id="why" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`} data-picker>
          <h2 class={h2c} style={inter}>Why do you need it?</h2>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Pick yours. The course is identical, but what you do before and after is different.</p>
          <div class="flex flex-wrap gap-2.5 mb-6">
            {picks.map((p, i) => <button type="button" data-pick={p.k} aria-pressed={i === 0 ? 'true' : 'false'} class={`font-bold text-[17px] min-h-[48px] px-5 rounded-full border-2 transition-colors ${i === 0 ? pillOn : pillOff}`}>{p.label}</button>)}
          </div>
          {picks.map((p, i) => (
            <div data-panel={p.k} hidden={i !== 0}>
              <div class="rounded-2xl border border-info-border bg-info p-6 lg:p-7 max-w-[860px] flex flex-col gap-4">
                <p class="text-[24px] lg:text-[26px] font-extrabold leading-[1.2] m-0" style={inter}>{p.headline}</p>
                <ol class="flex flex-col gap-2 list-none p-0 m-0">
                  {p.steps.map((s, j) => <li class="flex gap-3 items-start text-[17px]"><span class="flex-none w-7 h-7 rounded-full bg-primary text-white font-bold text-sm flex items-center justify-center">{j + 1}</span><span>{s}</span></li>)}
                </ol>
                <div class="flex flex-wrap gap-3 items-center">
                  <a href={p.cta[0]} class="no-underline bg-primary hover:bg-primary-hover text-white font-bold px-[22px] py-3 rounded-full">{p.cta[1]}</a>
                  <a href={p.cta2[0]} class="font-semibold text-primary hover:text-primary-deep">{p.cta2[1]}</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== What it can't do ===== -->
      <section class={`${wrap} pt-16 pb-6`}>
        <h2 class={h2c} style={inter}>What can't the course do?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Three things people expect from it that it doesn't deliver.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
          {cants.map((c) => <div class={card}><p class="font-bold text-[19px] m-0 mb-1.5">{c.t}</p><p class="text-base text-text-body leading-6 m-0" set:html={c.b} /></div>)}
        </div>
      </section>

      <!-- ===== Who can take it ===== -->
      <section id="eligible" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>Who can take it for a ticket?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Any licensed driver can take it for insurance. For a ticket, the law sets four conditions and a short list of exclusions.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-info-border bg-info p-6">
            <p class="font-bold text-[19px] m-0 mb-3">You need</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-base text-text-body">
              <li>✓&nbsp; A valid Texas license or permit (military families can use any state's)</li>
              <li>✓&nbsp; Proof of insurance</li>
              <li>✓&nbsp; To ask the court by your appearance date</li>
              <li>✓&nbsp; No dismissal course in the 12 months before this ticket <a href="/texas/12-month-rule" class="text-primary hover:text-primary-deep font-medium">How it counts</a></li>
            </ul>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[19px] m-0 mb-3">It's ruled out for</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-base text-text-body">
              <li>✕&nbsp; 25+ mph over, or 95 mph and up</li>
              <li>✕&nbsp; A work zone with workers present</li>
              <li>✕&nbsp; Passing a stopped school bus or leaving the scene</li>
              <li>✕&nbsp; Anyone with a CDL, even in a personal car</li>
            </ul>
            <p class="text-[15px] text-text-body m-0 mt-3.5">Course ruled out? <a href="/texas/deferred-disposition" class="text-primary hover:text-primary-deep font-medium">Deferred disposition</a> usually isn't.</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3.5 items-center mt-[18px]">
          <a href="/texas/eligibility-tracker" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold px-[22px] py-3 rounded-full">Does my ticket qualify? 4 questions →</a>
          <span class="text-[15px] text-text-body">Expired registration or no insurance? Those use a different fix: <a href="/texas/expired-registration-ticket" class="text-primary hover:text-primary-deep font-medium">registration</a> · <a href="/texas/no-insurance-ticket" class="text-primary hover:text-primary-deep font-medium">insurance</a></span>
        </div>
      </section>

      <!-- ===== Six hours ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How do the six hours actually work?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Six hours is the state rule: at least five hours of lessons plus required breaks, enforced by timers. You don't have to do it in one sitting.</p>
        <div class="max-w-[860px] mb-5">
          <div class="flex h-10 rounded-[10px] overflow-hidden">
            <div class="bg-primary w-[84%] text-white font-bold text-[15px] flex items-center px-3">5+ hours of lessons and quizzes</div>
            <div class="bg-info-border w-[16%] text-primary-deep font-bold text-[15px] flex items-center justify-center">Breaks</div>
          </div>
          <div class="flex justify-between text-sm text-text-muted mt-1.5"><span>Start</span><span>6 hours</span></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {how.map(([t, b]) => <div class="rounded-[14px] border border-border bg-white p-[18px]"><strong>{t}</strong><br /><span class="text-[15px] text-text-body" set:html={b} /></div>)}
        </div>
        <a href="/texas/what-the-course-looks-like" class="inline-block mt-4 font-bold text-primary hover:text-primary-deep">See every module →</a>
      </section>

      <!-- ===== Deadlines and cost ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How long do you have, and what does it cost?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">For a ticket: two deadlines and three payments, to three different places. For insurance: just the course.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-3">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep">Deadlines</span>
            <p class="m-0"><strong>Ask the court</strong> by the appearance date on your ticket. Miss it and the option is usually gone.</p>
            <p class="m-0"><strong>Finish and send the certificate</strong> within the court's deadline, 90 days unless it says otherwise.</p>
            <a href="/texas/deadline-calculator" class="font-bold text-primary hover:text-primary-deep">Work out your dates →</a>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-3">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep">Costs</span>
            <div class="flex justify-between gap-3"><span>The course (ours, all-in)</span><strong class="text-primary">{price}</strong></div>
            <div class="flex justify-between gap-3"><span>Court fee, if it's a ticket</span><strong>~$144</strong></div>
            <div class="flex justify-between gap-3"><span>Type 3A record, if the court asks</span><strong>$12</strong></div>
            <p class="text-[15px] text-text-body m-0">{floor} is the legal minimum for any course. Watch for certificate fees added at checkout. <a href="/texas/cost" class="text-primary hover:text-primary-deep font-medium">Every fee explained</a></p>
          </div>
        </div>
      </section>

      <!-- ===== Certificate ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>What do you get at the end?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">One certificate, two copies. It's the same document whichever approved course you take.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[860px]">
          <div class="rounded-2xl border-2 border-primary bg-white p-6">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep">Court copy</span>
            <p class="font-bold text-[19px] m-0 my-1.5">Goes back to the court that approved you</p>
            <p class="text-base text-text-body leading-6 m-0">With your driving record if required, before the court's deadline. <a href="/texas/defensive-driving-certificate" class="text-primary hover:text-primary-deep font-medium">How courts accept it</a></p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">Insurance copy</span>
            <p class="font-bold text-[19px] m-0 my-1.5">Goes to your insurer, any time</p>
            <p class="text-base text-text-body leading-6 m-0">Each insurer sets its own discount. <a href="/texas/insurance-discount" class="text-primary hover:text-primary-deep font-medium">What insurers give</a></p>
          </div>
        </div>
        <div class="mt-4 rounded-xl border border-info-border bg-info p-4 max-w-[860px] leading-7"><strong>Don't finish on deadline day.</strong> TDLR says a new certificate can take up to 5 days to appear in its validation system.</div>
      </section>

      <!-- ===== Driver's ed ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>Is it the same as driver's ed?</h2>
        <p class="text-base leading-7 m-0 mb-5 max-w-[780px]">No. Driver's ed gets you a license. This course is for people who already have one.</p>
        <div class="overflow-x-auto max-w-[860px]">
          <table class="w-full min-w-[540px] border-collapse rounded-[14px] border border-border overflow-hidden bg-white" style="border-spacing:0;">
            <thead><tr class="bg-[#F6F6F9] text-left font-bold"><th class="px-4 py-3 font-bold">Course</th><th class="px-4 py-3 font-bold">Who it's for</th><th class="px-4 py-3 font-bold">Helps a Texas ticket?</th></tr></thead>
            <tbody>{table.map((r) => <tr class="border-t border-border"><th scope="row" class="px-4 py-3 font-semibold text-left">{r[0]}</th><td class="px-4 py-3">{r[1]}</td><td class={`px-4 py-3 ${r[3] ? 'text-primary-deep font-bold' : ''}`}>{r[2]}</td></tr>)}</tbody>
          </table>
        </div>
      </section>

      <!-- ===== Course band ===== -->
      <section id="course" class={`${wrap} py-14 scroll-mt-28`}>
        <div class="rounded-3xl bg-primary-deep text-white px-6 py-12 lg:px-8 lg:py-14 flex flex-col items-center text-center gap-7">
          <div class="flex flex-col gap-2.5 max-w-[680px]">
            <span class="text-sm font-bold uppercase tracking-[0.08em] text-info-border">Ready? The course is the easy part</span>
            <h2 class="text-[30px] lg:text-[40px] font-extrabold leading-[1.1] m-0" style={inter}>One course for your ticket or your insurance discount. {price} total.</h2>
          </div>
          {review && (
            <div class="rounded-[18px] bg-white text-text px-7 py-7 max-w-[640px] w-full flex flex-col gap-3">
              <span class="text-accent text-[22px] tracking-[3px]" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
              <blockquote class="m-0 text-[19px] lg:text-[21px] font-bold leading-[1.45]" style={inter}>"{review.quote}"</blockquote>
              <div class="flex items-center gap-3 text-left">
                <span class="w-10 h-10 rounded-full bg-primary text-white font-bold text-[15px] flex items-center justify-center" aria-hidden="true">{review.initials}</span>
                <span class="flex flex-col text-[15px] leading-[1.35]"><strong>{review.name}</strong><span class="text-text-muted">{review.verified ? 'Verified via Trustpilot' : 'Trustpilot'} · {review.date}</span></span>
              </div>
            </div>
          )}
          <ul class="flex flex-wrap justify-center gap-2.5 list-none p-0 m-0 max-w-[820px]">
            {[`${price} all-in, nothing added`, `TDLR-approved · ${TEXAS_COURSE.providerNumber}`, 'Court and insurance copies', 'Unlimited quiz retakes'].map((t) => <li class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-[15px]"><span class="text-info-border font-extrabold" aria-hidden="true">✓</span>{t}</li>)}
          </ul>
          <div class="flex flex-col items-center gap-3">
            <a href={enrollUrl} class="no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-8 py-4 rounded-full" style={inter}>Start the {price} course →</a>
            <a href="/texas/request-defensive-driving" class="no-underline text-white hover:underline">For a ticket? Ask your court first</a>
          </div>
        </div>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7" set:html={f.a} /></div>)}
        </div>
      </section>

      <!-- ===== Where to go + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Where to go from here</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
          {nextSteps.map(([href, t, s]) => <a href={href} class="no-underline text-text rounded-[14px] border border-border bg-white p-4 hover:border-primary-deep"><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{s}</span></a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). General information, not legal advice. Eligibility is set by statute; fees, forms and deadlines are set by each court. Confirm with the court on your citation. Last updated October 6, 2026. Sources: 16 TAC ch. 84 (course length and curriculum); Tex. Code Crim. Proc. ch. 45A (dismissal and eligibility); Tex. Educ. Code §1001.352 (price floor); our verified court dataset (court fees); Texas DPS (Type 3A fee).</p>
      </section>

      <StickyCta afterId="why" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-picker]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          var btns = root.querySelectorAll('[data-pick]'), panels = root.querySelectorAll('[data-panel]');
          btns.forEach(function (b) { b.addEventListener('click', function () {
            var k = b.getAttribute('data-pick');

---
import TexasLayout from '../../layouts/TexasLayout.astro';
import CourseBand from '../../components/texas/CourseBand.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { courtStats as S } from '../../lib/court-stats';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;

// Rebuilt 2026-10-06 from Jackson's design canvas "Type 3A Page Redesign" (Main.dc.html + Serp.dc.html), funnel
// map gap 6: the page's biggest query ("do I need to print out the Type 3A", 2,117 impressions, 0 clicks) is now
// the title and the first answer. Implemented as the spec: his copy, order, the "how my court takes paperwork"
// picker, the record table, the order checklist, the timing strip, the four mistakes, course band, quick answers.
// Data adaptation, flagged in the PR: the court counts print from court-stats.ts (same normalizing rule as the
// rest of the site) instead of the design's typed numbers. Record types and fees match the DPS driver-records
// page and form DR-1 as checked October 5, 2026 (unchanged from the previous version of this page). Sherman and
// Deer Park facts are from our court research (grayson-municipal-sherman, harris-municipal-deer-park).
// Design has no video, so the previous VideoEmbed is not carried over.

const T = S.type3a;           // requiresType3A: yes / no / known
const M = S.type3aSubmit;     // electronic vs paper-only among courts that require it and list a method
const researched = T.known;
const dpsOrderUrl = 'https://txapps.texas.gov/tolapp/txldrcdr/TXDPSLicenseeManager';

const methods = [
  { k: 'email', label: 'Email', send: true, action: 'Attach the original PDF.', detail: 'Send it with your course certificate. Don’t screenshot or convert it.' },
  { k: 'portal', label: 'Online upload', send: true, action: 'Upload the original PDF.', detail: 'Upload it alongside your certificate in the court’s portal.' },
  { k: 'mail', label: 'Mail', send: false, action: 'Print every page.', detail: 'Mail it with your certificate and any affidavit. Keep the PDF.' },
  { k: 'person', label: 'In person', send: false, action: 'Print every page.', detail: 'Bring it with the rest of your paperwork, or use the drop box.' },
  { k: 'fax', label: 'Fax', send: false, action: 'Print it to fax it.', detail: 'Keep the printout and the original PDF.' },
];
const records = [
  { name: 'Type 1', what: 'Status only', cert: 'No', ddc: 'No', price: '$4.50 / $4.00', hl: false },
  { name: 'Type 2', what: '3-year history', cert: 'No', ddc: 'No', price: '$6.50 / $6.00', hl: false },
  { name: 'Type 2A', what: '3-year history', cert: 'Yes', ddc: 'No', price: '$12.00 / $10.00', hl: false },
  { name: 'Type 3', what: 'Complete record', cert: 'No', ddc: 'No', price: '$7.50 / $7.00', hl: false },
  { name: 'Type 3A', what: 'Complete record', cert: 'Yes', ddc: '✓ Yes', price: '$12.00 / $10.00', hl: true },
  { name: 'Type AR', what: 'Certified abstract', cert: 'Yes', ddc: 'No', price: '$22.00 / $20.00', hl: false },
];
const faqs = [
  { q: 'Do I need to print my Type 3A for court?', a: `Only if your court takes paperwork on paper. If it accepts email or uploads, send the PDF. Of the ${M.known} Texas courts that require a Type 3A and say how they take paperwork, ${M.electronic} (${M.pctElectronic}%) take it electronically.` },
  { q: 'Can I email my Type 3A to the court?', a: 'Yes, if it accepts email filings. Attach the original PDF from DPS with your certificate. Don’t screenshot it or re-save it as an image.' },
  { q: 'Is a printout of the online Type 3A accepted?', a: 'Yes. The PDF is the certified record, and a printout of it is what paper-filing courts expect. Print every page and don’t write on it.' },
  { q: 'How much is a Type 3A, and how fast?', a: '$12 online ($10 DPS fee plus $2 Texas.gov fee), as an instant PDF. By mail it’s $10 and takes about three weeks.' },
  { q: 'Do all Texas courts require one?', a: `No. ${T.pctNo}% of the ${researched.toLocaleString("en-US")} courts we’ve researched don’t. Check your court’s page. If unsure, get it: it’s $12, and a missing record often delays dismissal.` },
  { q: 'Can my course provider get it for me?', a: 'Some sell it as a marked-up add-on. We don’t. Ordering straight from DPS costs $12 and takes two minutes.' },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Texas Type 3A driving record: do you need to print it?',
  description: 'Only if your court takes paper. The $12 Type 3A from DPS is a PDF: email or upload it, or print every page. Which record to order, how, and when.',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11', dateModified: '2026-10-06',
  mainEntityOfPage: `${siteUrl}/texas/type-3a-driving-record`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });

const nextSteps = [
  ['/texas/defensive-driving-certificate', 'Ready to send everything?', 'How to submit to your court →'],
  ['/texas/request-defensive-driving', 'Haven’t asked the court yet?', 'How to request the course →'],
  ['/texas/courts', 'Need your court’s rules?', 'Search the court directory →'],
  ['/texas/ticket-dismissal', 'Want the full process?', 'Texas ticket dismissal guide →'],
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-[18px]';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
const link = 'text-primary hover:text-primary-deep font-medium';
---

{isEnabled ? (
  <TexasLayout
    title="Texas Type 3A Driving Record: Do You Need to Print It?"
    description="Only if your court takes paper. The $12 Type 3A from DPS is a PDF: email or upload it, or print every page. How to order the right one."
    keywords="type 3a driving record, type 3a driving record texas, do i need to print type 3a, texas driving record for defensive driving, certified driving record texas, type 3a vs type 3, order driving record texas, DR-1 form texas"
    url="/texas/type-3a-driving-record"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead + picker ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><a href="/texas/speeding-ticket" class="text-text-body hover:underline">Speeding ticket guide</a><span class="mx-1.5">›</span><span>Type 3A driving record</span></p>
        <div class="max-w-[820px] pt-8 pb-7">
          <h1 class="text-[34px] lg:text-[54px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>Texas Type 3A driving record: do you need to print it?</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-3.5">Only if your court takes paperwork on paper. The Type 3A you buy online from Texas DPS is a <strong>$12 PDF</strong>. If your court takes email or uploads, send the PDF. If it only takes mail or in-person filings, print every page.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0">More than half of Texas courts take it electronically. Tap how your court takes paperwork:</p>
        </div>
        <div id="print" class="rounded-[20px] border border-border bg-white p-6 lg:p-[26px] flex flex-wrap gap-7 scroll-mt-28" style="box-shadow:0 10px 30px rgba(14,19,36,0.06);" data-picker>
          <div class="flex-[1_1_380px] min-w-0 flex flex-col gap-3.5">
            <p class="font-bold text-base m-0">My court takes paperwork by…</p>
            <div class="flex flex-wrap gap-2">
              {methods.map((m, i) => <button type="button" data-pick={m.k} aria-pressed={i === 0 ? 'true' : 'false'} class={`font-bold text-base min-h-[44px] px-[18px] rounded-full border-2 transition-colors ${i === 0 ? pillOn : pillOff}`}>{m.label}</button>)}
            </div>
            {methods.map((m, i) => (
              <div data-panel={m.k} hidden={i !== 0}>
                <div class={`rounded-[14px] border px-5 py-[18px] flex flex-col gap-1.5 ${m.send ? 'bg-info border-info-border' : 'bg-amber-50 border-amber-200'}`}>
                  <span class={`text-[13px] font-extrabold uppercase tracking-[0.06em] ${m.send ? 'text-primary-deep' : 'text-amber-800'}`}>{m.send ? 'No printing needed' : 'Print it'}</span>
                  <span class="text-[24px] font-extrabold leading-[1.2]" style={inter}>{m.action}</span>
                  <span class="text-base text-text-body">{m.detail}</span>
                </div>
              </div>
            ))}
            <p class="text-[15px] text-text-body m-0">Not sure? It's on <a href="/texas/courts" class={link}>your court's page</a>, or in the letter the court sent when it granted defensive driving.</p>
          </div>
          <div class="flex-[1_1_280px] min-w-0 flex flex-col gap-3">
            <div class="rounded-[14px] bg-info p-[18px]"><p class="text-[36px] font-extrabold text-primary leading-none m-0" style={inter}>{M.pctElectronic}%</p><p class="text-[15px] text-text-body m-0 mt-1">of courts that require a Type 3A and list a method take it by email or online ({M.electronic} of {M.known}). Send the PDF.</p></div>
            <div class="rounded-[14px] bg-[#F6F6F9] p-[18px]"><p class="text-[36px] font-extrabold text-text leading-none m-0" style={inter}>{M.pctPaper}%</p><p class="text-[15px] text-text-body m-0 mt-1">list only in-person, mail or fax ({M.paperOnly} of {M.known}). Print it.</p></div>
            <p class="text-[13px] text-text-muted m-0">From our research of {researched.toLocaleString('en-US')} Texas municipal and justice courts; {T.yes} require a Type 3A. Payment-only portals not counted.</p>
          </div>
        </div>
        <p class="text-lg leading-8 m-0 max-w-[820px] pt-2 pb-12">Printing is the easy part. The mistake that actually gets submissions sent back is <strong>ordering the wrong record</strong>. Three of them look almost the same.</p>
      </div>

      <!-- ===== Which record ===== -->
      <section id="which" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={inter}>Which driving record does the court want?</h2>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">The Type 3A: the certified copy of your complete record. DPS marks it as the one "acceptable for Defensive Driving Course (DDC)." Nothing else on the menu works.</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 mb-6">
            <div class="rounded-2xl border-2 border-primary bg-info p-[22px]"><p class="text-[13px] font-extrabold uppercase tracking-[0.06em] text-primary-deep m-0">✓ Order this one</p><p class="text-[26px] font-extrabold m-0 my-1" style={inter}>Type 3A</p><p class="text-[15px] text-text-body m-0">Certified, complete record. $12 online.</p></div>
            <div class="rounded-2xl border border-border bg-white p-[22px]"><p class="text-[13px] font-extrabold uppercase tracking-[0.06em] text-amber-800 m-0">✕ Common mix-up</p><p class="text-[26px] font-extrabold m-0 my-1" style={inter}>Type 3</p><p class="text-[15px] text-text-body m-0">Same content, not certified. Saves $4.50, costs you a rejection.</p></div>
            <div class="rounded-2xl border border-border bg-white p-[22px]"><p class="text-[13px] font-extrabold uppercase tracking-[0.06em] text-amber-800 m-0">✕ Common mix-up</p><p class="text-[26px] font-extrabold m-0 my-1" style={inter}>Type 2A</p><p class="text-[15px] text-text-body m-0">Certified, but only 3 years. DPS says it's not acceptable.</p></div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse rounded-[14px] border border-border overflow-hidden text-[15px]" style="border-spacing:0;">
              <thead><tr class="bg-[#F6F6F9] text-left"><th class="px-3.5 py-2.5 font-bold">Record</th><th class="px-3.5 py-2.5 font-bold">Contains</th><th class="px-3.5 py-2.5 font-bold">Certified?</th><th class="px-3.5 py-2.5 font-bold">For defensive driving?</th><th class="px-3.5 py-2.5 font-bold">Online / mail</th></tr></thead>
              <tbody>{records.map((r) => <tr class={`border-t border-border ${r.hl ? 'bg-info' : 'bg-white'}`}><th scope="row" class="px-3.5 py-2.5 font-bold text-left">{r.name}</th><td class="px-3.5 py-2.5">{r.what}</td><td class="px-3.5 py-2.5">{r.cert}</td><td class={`px-3.5 py-2.5 font-bold ${r.hl ? 'text-primary-deep' : ''}`}>{r.ddc}</td><td class="px-3.5 py-2.5 whitespace-nowrap">{r.price}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="text-[13px] text-text-muted m-0 mt-2.5">Mail prices are DPS base fees; online adds the Texas.gov fee. Source: Texas DPS driver-records page and form DR-1, checked October 5, 2026.</p>
        </div>
      </section>

      <!-- ===== How to order ===== -->
      <section id="order" class={`${wrap} pt-16 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>How do you order it?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Online at <a href={dpsOrderUrl} class={link} rel="noopener" target="_blank">texas.gov</a> in about two minutes, for $12. You get the certified PDF right away. Have these four things ready, and they must match what DPS has on file:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {[['License or ID number', 'Your Texas DL or ID'], ['Date of birth', 'As DPS has it'], ['Last 4 of your SSN', 'Must already be on file'], ['Audit number', 'Printed on your license card']].map(([t, b]) => <div class={card}><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{b}</span></div>)}
        </div>
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 max-w-[820px] leading-7"><strong>Won't verify you online?</strong> Usually your SSN isn't on file. The fallback is mail (form DR-1, $10), but DPS says to allow three weeks. Tell your court clerk early.</div>
      </section>

      <!-- ===== When ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>When should you order it?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">After the court approves you, and around when you finish the course. Some courts reject a record dated too early. Sherman, for example, wants one dated after approval. Deer Park wants it turned in together with your certificate.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-y-6 lg:gap-0 list-none p-0 m-0 max-w-[960px]">
          <li class="border-t-[6px] border-info-border pt-3.5 pr-4"><p class="font-bold m-0">1. Court approves you</p><p class="text-[15px] text-text-body m-0"><a href="/texas/request-defensive-driving" class={link}>How to ask</a></p></li>
          <li class="border-t-[6px] border-[#46A2F2] pt-3.5 pr-4"><p class="font-bold m-0">2. Take the course</p><p class="text-[15px] text-text-body m-0">{TEXAS_COURSE.hours} hours online</p></li>
          <li class="border-t-[6px] border-primary pt-3.5 pr-4"><p class="font-bold m-0">3. Order the Type 3A</p><p class="text-[15px] text-text-body m-0">Same day you finish</p></li>
          <li class="border-t-[6px] border-primary-deep pt-3.5 pr-4"><p class="font-bold m-0">4. Send both together</p><p class="text-[15px] text-text-body m-0"><a href="/texas/defensive-driving-certificate" class={link}>How to submit</a></p></li>
        </ol>
      </section>

      <!-- ===== Mistakes ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>What gets a submission sent back?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Four avoidable mistakes.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {[['The wrong type', 'Type 3 or 2A instead of 3A.'], ['A screenshot', 'Email the original PDF. Don’t convert it to an image.'], ['Names that don’t match', 'Use your legal name, exactly as on your license, everywhere.'], ['Waiting on the mail', 'Three weeks can eat half your 90-day window.']].map(([t, b]) => <div class={card}><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{b}</span></div>)}
        </div>
        <p class="text-[15px] text-text-body m-0 mt-4">Already had one sent back? <a href="/texas/certificate-rejected" class={link}>Why courts reject submissions, and how to fix it</a></p>
      </section>
      <CourseBand />

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7">{f.a}</p></div>)}
        </div>
      </section>

      <!-- ===== Next step + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Your next step</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
          {nextSteps.map(([href, t, s]) => <a href={href} class="no-underline text-text rounded-[14px] border border-border bg-white p-4 hover:border-primary-deep"><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{s}</span></a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">General information, not legal advice. Record requirements and timing are set by your court. Road Ready Safety is a TDLR-licensed course provider ({TEXAS_COURSE.providerNumber}), not a court. Sources: Texas DPS driver-records page and form DR-1 (checked October 5, 2026); Tex. Code Crim. Proc. ch. 45A; Road Ready Safety research of {researched.toLocaleString('en-US')} Texas municipal and justice courts. Last updated October 6, 2026.</p>
      </section>

      <StickyCta afterId="which" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-picker]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          var btns = root.querySelectorAll('[data-pick]'), panels = root.querySelectorAll('[data-panel]');
          btns.forEach(function (b) { b.addEventListener('click', function () {
            var k = b.getAttribute('data-pick');
            btns.forEach(function (x) { var sel = x === b; x.setAttribute('aria-pressed', sel ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, sel); }); off.forEach(function (c) { x.classList.toggle(c, !sel); }); });
            panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== k; });
          }); });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

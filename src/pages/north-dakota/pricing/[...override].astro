---
/**
 * North Dakota pricing page in the landing-v2 design. Same content as the shared
 * [state]/pricing.astro, with two changes Jackson asked for on 2026-09-23: the old
 * "$24.99. That is the whole number." intro is gone, and the price card (shared with the ND
 * landing page) opens the page. The closing band matches the landing page.
 *
 * Same routing trick as the landing page: overrides [state]/pricing for
 * /north-dakota/pricing only, and emits nothing while ND is disabled (production today).
 */
import CourseLayout from '../../../layouts/CourseLayout.astro';
import PriceBlock from '../../../components/landing-v2/PriceBlock.astro';
import FinalBand from '../../../components/landing-v2/FinalBand.astro';
import CompareTable from '../../../components/course/CompareTable.astro';
import Faq from '../../../components/course/Faq.astro';
import nd from '../../../data/courses/nd-ddc.json';
import type { CourseData } from '../../../data/courses/types';
import { isEnabled, enrollUrl as buildEnrollUrl, contactUrl } from '../../../lib/courseFlags';

export function getStaticPaths() {
  return isEnabled(nd as CourseData) ? [{ params: { override: undefined } }] : [];
}

const course = nd as CourseData;
const enrollUrl = buildEnrollUrl(course);
const route = course.state.route;
const price = course.course.priceUsd;

const priceFaqs = course.faqs.filter((f) => /\$|refund|price|cost|fee|insurance/i.test(f.q + f.a)).slice(0, 5);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: priceFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<CourseLayout
  course={course}
  title={`${course.course.shortName} Pricing — $${price} Total | Road Ready Safety`}
  description={`What the ${course.course.name} costs and everything included in the $${price}: certificate, exam retake and support, with no fees added at checkout.`}
  url={`${route}/pricing`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section id="whats-included" class="bg-white scroll-mt-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-4 lg:pt-20 lg:pb-4">
      <PriceBlock
        price={price}
        label={course.course.shortName}
        totalLabel={course.pricing.totalLabel}
        included={course.pricing.included}
        notCharged={course.pricing.notCharged}
        lineItems={course.pricing.lineItems}
        refundNote={course.pricing.refundNote}
        refundHref={`${route}/refund`}
        enrollUrl={enrollUrl}
        heading={course.pricing.heading}
        headingTag="h1"
      />
    </div>
  </section>

  <CompareTable course={course} />

  <section class="pt-10 pb-4 lg:pt-16 lg:pb-4 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-surface-muted border border-border rounded-[24px] p-8 lg:p-10 flex flex-col gap-4">
        <h2 class="text-2xl font-bold text-text" style="font-family:'Outfit',sans-serif;">Refunds, in one sentence</h2>
        <p class="text-base text-text-body leading-7">{course.pricing.refundNote} Once you have passed the final exam and the certificate has been issued, it has been earned and reported, and no refund is available.</p>
        <a href={`${route}/refund`} class="text-primary font-semibold underline underline-offset-2 w-fit">Read the full refund policy</a>
      </div>
    </div>
  </section>

  <Faq faqs={priceFaqs} contactUrl={contactUrl} heading="Questions about the price" moreHref={`${route}/faq`} />
  <FinalBand
    heading="Take three points off your North Dakota record"
    copy={`Four hours online. $${price}, certificate included. Start tonight and finish on your own schedule.`}
    ctaLabel={`Start the Course \u2014 $${price}`}
    ctaHref={enrollUrl}
  />
</CourseLayout>

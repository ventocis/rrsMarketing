---
import TexasLayout from '../../layouts/TexasLayout.astro';
import YouTubeCard from '../../components/YouTubeCard.astro';
import NextStepBlock from '../../components/texas/NextStepBlock.astro';
import { courtStats as S } from '../../lib/court-stats';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const price = TEXAS_PRICE_LABEL;

// Cluster G entrance (SEO playbook §2b, decided 2026-10-06): the top-of-funnel explainer for people who
// have just been told to "take defensive driving" and do not yet know what that is. Texas-specific on
// purpose; it links down to the decision pages (cluster B) and the course page (/texas). No competitor
// names or prices. Sources: 16 TAC ch. 84 (course length and curriculum), Tex. Code Crim. Proc. ch. 45A
// (dismissal), Tex. Educ. Code §1001.352 (price floor), Tex. Transp. Code ch. 708 repeal (no points since 2019).

const faqs = [
  { q: 'Is a driving safety course the same as defensive driving?', a: 'Yes. Texas law calls it a driving safety course; courts, insurers and most people call it defensive driving, and providers also say DSC or driver safety course. Same six-hour course, same certificate.' },
  { q: 'How long is the Texas driving safety course?', a: 'Six hours, by rule: at least five hours of instruction plus the required breaks. Every TDLR-approved course, online or in a classroom, is the same length, and online courses enforce it with timers. You can spread it over several days.' },
  { q: 'Does the course remove points from my Texas license?', a: 'Texas has had no driver license points since the surcharge program was repealed in 2019, so there are no points to remove. What the course protects is the conviction line on your driving record, which is what insurers read.' },
  { q: 'Can I take the course first and then ask the court?', a: 'No. The court has to grant the course before you take it, and the request has to reach the court on or before the appearance date printed on your citation. A certificate from a course the court never authorized will not count.' },
  { q: `What does the course cost in Texas?`, a: `By law at least ${floor} for the course itself. Ours is ${price} total with the certificate included. Separately, the court charges its own fee when it grants the course (set locally; $${S.fee.min} to $${S.fee.max} across the courts we have verified, most commonly $144), and the Type 3A driving record is $12 from Texas DPS if your court requires it.` },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'What a Texas Driving Safety Course Is, What It Does for a Ticket, and Who Can Take It',
  description: 'The Texas driving safety course (defensive driving, DSC) explained for someone who has just been told to take one: what it does and does not do, who qualifies, how the six online hours work, what it costs all in, and what happens to the certificate.',
  datePublished: '2026-10-06',
  dateModified: '2026-10-06',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/what-is-a-driving-safety-course`,
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---

{isEnabled ? (
  <TexasLayout
    title="What Is a Texas Driving Safety Course? What It Does, Who Can Take It, and What It Costs (2026)"
    description={`The Texas driving safety course, also called defensive driving or DSC, explained plainly: a six-hour TDLR-approved course that dismisses an eligible ticket or earns an insurance discount. Who qualifies, how the online hours work, the all-in cost, and what to do with the certificate.`}
    keywords="what is a driving safety course texas, what is defensive driving course texas, texas driving safety course, defensive driving course explained, is the driving safety course the same as defensive driving, how long is the defensive driving course texas"
    url="/texas/what-is-a-driving-safety-course"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-16 lg:pb-24">
      <div class="max-w-[880px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14">

        <p class="text-sm text-text-body mb-6" style="font-family: 'DM Sans', sans-serif;">
          <a href="/texas" class="text-primary-deep font-medium hover:underline">Texas defensive driving course</a>
          <span class="mx-2 text-text-subtle">›</span>
          <span class="text-text">What the course is</span>
        </p>

        <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-primary-navy leading-tight tracking-[-0.02em] mb-6" style="font-family: 'Outfit', sans-serif;">
          What a Texas Driving Safety Course Is, What It Does for a Ticket, and Who Can Take It
        </h1>

        <div class="bg-info border border-info-border rounded-2xl p-6 mb-10">
          <p class="text-sm font-semibold text-primary-deep mb-2" style="font-family: 'Outfit', sans-serif;">Short answer</p>
          <p class="text-text-body text-base leading-7" style="font-family: 'DM Sans', sans-serif;">
            A Texas driving safety course is a six-hour course, approved by the Texas Department of Licensing and Regulation, that a licensed driver takes for one of two reasons: <strong class="text-text">to get an eligible traffic ticket dismissed</strong>, or <strong class="text-text">to earn a discount from an insurer</strong>. Most people call it defensive driving. You take it online, at your own pace, and you get a certificate the moment you finish. For a ticket, the court has to say yes before you start.
          </p>
        </div>

        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>Most people meet this course on the back of a citation: the officer, a friend or the court's website says "you can take defensive driving for that." This page is for that moment. It explains what the course is, what it does and does not do, who is allowed to take it, how the six hours work online, what the whole thing costs, and what happens to the certificate. We run one of the approved courses (Road Ready Safety, {TEXAS_COURSE.providerNumber}), so read it as a seller explaining the rules, with every rule pointed at its source.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Why does the same course have three names?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>The statute says <strong class="text-text">driving safety course</strong>. Courts and insurers say <strong class="text-text">defensive driving</strong>. Providers shorten it to <strong class="text-text">DSC</strong> or write "driver safety course." They are the same thing: a course on a curriculum TDLR writes and approves (16 Texas Administrative Code chapter 84), six hours long, ending in a uniform certificate of completion. If a website offers a "driving safety course" and the court letter says "defensive driving," you are in the right place.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What does the course actually do for you?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p><strong class="text-text">Ticket dismissal.</strong> For an eligible moving violation, Texas law gives you the right to ask the court for the course. You ask by the appearance date on the citation, pay the court's fee, finish the course within the deadline the court sets (90 days is standard), and send back the certificate and, if the court asks, your driving record. The court then dismisses the charge, and a dismissed charge cannot appear on your driving record as a conviction (Code of Criminal Procedure chapter 45A). The whole route, step by step, is on the <a href="/texas/ticket-dismissal" class="text-primary-deep font-medium hover:underline">ticket-dismissal guide</a>.</p>
          <p><strong class="text-text">An insurance discount.</strong> No ticket needed. You finish the same course, send the insurance copy of the certificate to your insurer, and the insurer applies whatever discount its filed rates allow. It is the insurer's choice, not a state rule, and it varies by company; the <a href="/texas/insurance-discount" class="text-primary-deep font-medium hover:underline">insurance discount page</a> lists what eight Texas insurers publish. One completion can serve both purposes.</p>
          <p><strong class="text-text">What it does not do.</strong> It does not remove points, because Texas has had no license points since the surcharge program ended in 2019. It does not erase a conviction once the court has entered one, so paying the ticket first closes the door. And it does not dismiss anything by itself: the court does, after it has approved the course and received your paperwork.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Who can take it, and who can't?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-4" style="font-family: 'DM Sans', sans-serif;">
          <p>For an insurance discount, any licensed driver can take it. For a ticket, the statute sets the conditions (articles 45A.351 to 45A.353):</p>
          <ul class="list-disc pl-6 space-y-2">
            <li>You hold a valid Texas driver license or permit (active-duty military and their dependents qualify with any state's license).</li>
            <li>You have proof of insurance and you ask the court on or before the appearance date.</li>
            <li>You have not used a driving safety course to dismiss a ticket in the 12 months before this offense. The <a href="/texas/12-month-rule" class="text-primary-deep font-medium hover:underline">12-month rule</a> explains how the clock runs.</li>
            <li>The ticket is a moving violation the law allows. Excluded: speeding 25 mph or more over the limit or 95 mph and up, an offense in a work zone with workers present, passing a stopped school bus, leaving the scene, and any ticket held by a commercial driver license holder, even in a personal car.</li>
          </ul>
          <p>Two common tickets are not course situations at all: <a href="/texas/expired-registration-ticket" class="text-primary-deep font-medium hover:underline">expired registration</a> and <a href="/texas/no-insurance-ticket" class="text-primary-deep font-medium hover:underline">no insurance</a> are dismissed by fixing the problem and showing proof, usually for a small fee. If the course is closed to you, <a href="/texas/deferred-disposition" class="text-primary-deep font-medium hover:underline">deferred disposition</a> usually is not; <a href="/texas/defensive-driving-vs-deferred-disposition" class="text-primary-deep font-medium hover:underline">which to choose</a> is its own page. The <a href="/texas/eligibility-tracker" class="text-primary-deep font-medium hover:underline">eligibility checker</a> asks four questions and takes a minute.</p>
        </div>

        <NextStepBlock page="what-is-a-driving-safety-course" lead="precourt" />

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">How do the six online hours actually work?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>Six hours is the rule, not a sales pitch: at least five hours of instruction plus the required breaks, and every approved online course enforces it with timers on each section. A course that promises to finish in two or three hours is either not approved or is describing something other than this course. You do not have to do it in one sitting. You log in on a phone, tablet or computer, the course saves your place, and you come back when you can. Short quizzes follow each unit; ours has unlimited retakes and no final exam. <a href="/texas/what-the-course-looks-like" class="text-primary-deep font-medium hover:underline">What the course looks like</a> walks through every module, and the <a href="/texas/fastest-defensive-driving-course" class="text-primary-deep font-medium hover:underline">fastest-course page</a> shows where the time goes.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">How long do you have?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>Two dates matter. The <strong class="text-text">appearance date on the citation</strong> is the deadline to ask the court for the course; miss it and the option is usually gone. Once the court grants the course, you have <strong class="text-text">the deadline it sets</strong>, 90 days by statute unless the court says otherwise, to finish and return the certificate. The <a href="/texas/deadline-calculator" class="text-primary-deep font-medium hover:underline">deadline calculator</a> works both out from your citation date; the <a href="/texas/dismissal-timeline" class="text-primary-deep font-medium hover:underline">dismissal timeline</a> shows where the days disappear.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What does it cost, all in?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>Three separate payments to three different people. <strong class="text-text">The course:</strong> by law at least {floor} (Texas Education Code §1001.352). Ours is {price} total, with the certificate included and nothing added at checkout; many courses advertise the course fee and add certificate or processing charges later, which the <a href="/texas/cost" class="text-primary-deep font-medium hover:underline">cost page</a> explains line by line. <strong class="text-text">The court:</strong> its own fee when it grants the course, set locally, <a href="/texas/dsc-fees-by-court" class="text-primary-deep font-medium hover:underline">${S.fee.min} to ${S.fee.max}</a> across the courts we have verified and most commonly $144. <strong class="text-text">Texas DPS:</strong> $12 for the <a href="/texas/type-3a-driving-record" class="text-primary-deep font-medium hover:underline">Type 3A driving record</a> if your court makes you order it. For an insurance discount you pay only the course.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What do you get at the end, and where does it go?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>A uniform certificate of completion, the same document whichever approved provider issued it, with a court copy and an insurance copy. With us it downloads the moment you finish. The court copy goes back to the court that approved you, with the driving record if required, before the court's deadline; the <a href="/texas/defensive-driving-certificate" class="text-primary-deep font-medium hover:underline">certificate page</a> covers what each court accepts (upload, email, mail or in person varies). TDLR notes a new certificate can take up to five days to appear in its validation tool, so do not finish on deadline day. The insurance copy goes to your insurer whenever you like.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Is it the same as driver's ed?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>No. Driver education is for getting a license; the driving safety course is for people who already have one. New York's "5-hour course" is a different state's program and does nothing for a Texas ticket. Texas also used to have a separate four-hour course for child-seat tickets; that rule was repealed, and the <a href="/texas/child-seat-ticket" class="text-primary-deep font-medium hover:underline">child seat page</a> explains what applies now. If you need a Texas license, that is a different course and a different page.</p>
        </div>

        <YouTubeCard id="WVJ0ORmWv1Q" blurb="The six hours, the breaks, the quizzes, and how the certificate arrives." />

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Frequently asked questions</h2>
        <div class="space-y-8 mb-12">
          {faqs.map(item => (
            <div>
              <h3 class="text-lg font-semibold text-text mb-2" style="font-family: 'Outfit', sans-serif;">{item.q}</h3>
              <p class="text-text-body text-base leading-7" style="font-family: 'DM Sans', sans-serif;">{item.a}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Where to go from here</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <ul class="list-disc pl-6 space-y-2">
            <li>You have a ticket and have not asked the court yet: <a href="/texas/request-defensive-driving" class="text-primary-deep font-medium hover:underline">how to request defensive driving from your court</a>.</li>
            <li>You are weighing the course against deferred disposition or fighting it: <a href="/texas/defensive-driving-vs-deferred-disposition" class="text-primary-deep font-medium hover:underline">which should you choose</a>.</li>
            <li>The court already approved you: <a href="/texas" class="text-primary-deep font-medium hover:underline">the course, {price} total, certificate included</a>.</li>
            <li>No ticket, just the discount: <a href="/texas/insurance-discount" class="text-primary-deep font-medium hover:underline">what insurers actually give</a>.</li>
          </ul>
        </div>

        <div class="pt-4 border-t border-border">
          <a
            href={enrollUrl}
            class="inline-flex bg-primary hover:bg-primary-hover text-white h-[56px] px-8 rounded-[16px] text-lg font-semibold items-center justify-center no-underline"
            style="font-family: 'DM Sans', sans-serif; box-shadow: 0px 10px 15px -3px rgba(17,23,34,0.08), 0px 4px 6px -4px rgba(17,23,34,0.05);"
          >
            Start the {price} course, certificate included
          </a>
        </div>

        <div class="pt-6 mt-10 border-t border-border space-y-2" style="font-family: 'DM Sans', sans-serif;">
          <p class="text-sm text-text-subtle">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). This page is informational and not legal advice; eligibility is set by statute, but fees, forms and deadlines are set by each court. Confirm with the court on your citation.</p>
          <p class="text-xs text-text-subtle">Published October 6, 2026. Course length and curriculum per 16 TAC chapter 84; dismissal procedure and eligibility per Tex. Code Crim. Proc. ch. 45A; price floor per Tex. Educ. Code §1001.352 (HB 3012, eff. Sept. 1, 2025); court fee range from our verified court dataset; Type 3A fee per Texas DPS.</p>
        </div>

      </div>
    </article>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

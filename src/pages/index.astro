---
/**
 * Homepage, rebuilt from Jackson's "Home Page Redesign v2" canvas (2026-10-07). Section order, copy,
 * CTAs and interactions follow the canvas (desktop 1280 + mobile 390 artboards); fonts and colors are
 * our tokens (Inter headings, DM Sans body).
 *
 * Rules kept from the previous homepage: prices and hours come from texas-course.ts and the state course
 * JSON; a state card renders only when courseFlags says the state is live; no competitor names or prices;
 * no Review/AggregateRating schema (reviews are for people). Title and meta are unchanged (the canvas has
 * no search-preview artboard).
 *
 * Deviations from the canvas (flagged in the PR):
 *  - "Start now" on each state card goes to that course's checkout; "Learn more" goes to the state page.
 *    The canvas pointed both at the state page.
 *  - Short reviews lead (Ryan Johnson, Chelsie Gates, Bliss James); MW's long review opens "Show more",
 *    shown in full, per Jackson's /texas feedback. No 4-line clamp.
 *  - The phone mockup is hidden on phones, per Jackson's /texas feedback on the progress mockup.
 *  - "Texas defensive driving course providers, compared" reads "…: the full TDLR list"; that page is a
 *    directory, not a comparison.
 *  - The finder's partner states (FL, IL, LA, MI, NY, TN, VA) link to their /find/<STATE>/multi page.
 *  - The site-wide Header and Footer stay; the canvas header is the shared one.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../data/texas-course';
import texasReviews from '../data/texas-reviews.json';
import allCourses from '../data/courses.json';
import nd from '../data/courses/nd-ddc.json';
import mo from '../data/courses/mo-dip.json';
import type { CourseData } from '../data/courses/types';
import { isEnabled, enrollUrl as buildEnrollUrl } from '../lib/courseFlags';
import { stateNames } from '../utils/states';

const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const texasEnrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || '/support';
const trustpilotUrl = 'https://www.trustpilot.com/review/roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";

const ICONS: Record<string, string> = {
  self: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7 V12 L15 14\"/></svg>",
  short: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 3 L5 14 H12 L11 21 L19 10 H12 Z\"/></svg>",
  device: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"7\" y=\"3\" width=\"10\" height=\"18\" rx=\"2\"/><path d=\"M11 18 H13\"/></svg>",
  refund: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z\"/><path d=\"M9 12 L11.2 14.2 L15.5 9.8\"/></svg>",
  state: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 4 L3 6 V20 L9 18 L15 20 L21 18 V4 L15 6 Z\"/><path d=\"M9 4 V18 M15 6 V20\"/></svg>",
  online: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M10 8 L15 11 L10 14 Z\"/><path d=\"M8 21 H16\"/></svg>",
  cert: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"13\" rx=\"2\"/><path d=\"M8 8 H16 M8 11 H13\"/><circle cx=\"16\" cy=\"18\" r=\"3\"/><path d=\"M14.5 20.5 L14 23 L16 22 L18 23 L17.5 20.5\"/></svg>",
  submit: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 3 L10 14\"/><path d=\"M21 3 L14 21 L10 14 L3 10 Z\"/></svg>",
  covered: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z\"/><path d=\"M9 12 L11.2 14.2 L15.5 9.8\"/></svg>",
  pay: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11 V8 a4 4 0 0 1 8 0 V11\"/></svg>",
  counts: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"9\" r=\"6\"/><path d=\"M8.5 14 L7 22 L12 19.5 L17 22 L15.5 14\"/></svg>",
  email: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7 L12 13 L21 7\"/></svg>",
  phone: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4 H9 L11 9 L8.5 10.5 a11 11 0 0 0 5 5 L15 13 L20 15 V19 a2 2 0 0 1 -2 2 A16 16 0 0 1 3 6 a2 2 0 0 1 2 -2\"/></svg>",
  help: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5 a2 2 0 0 1 2 -2 H20 V19 H6 a2 2 0 0 0 -2 2 Z\"/><path d=\"M4 19 V21\"/></svg>",
};

const ndCourse = nd as CourseData;
const moCourse = mo as CourseData;

// State cards: Texas always; the others only when courseFlags says the state is live.
const states = [
  {
    abbr: 'TX', name: 'Texas', url: '/texas', badge: '/assets/images/badges/texas-approved-tdlr.png', badgeAlt: 'Texas approved course seal',
    approval: `TDLR-approved · CP#${TEXAS_COURSE.providerNumber.replace(/^CP/, '')}`, course: 'Texas Defensive Driving Course',
    price, hours: TEXAS_COURSE.hours, enroll: texasEnrollUrl, live: true,
  },
  {
    abbr: 'ND', name: 'North Dakota', url: ndCourse.state.route, badge: '/assets/images/badges/north-dakota-approved.png', badgeAlt: 'North Dakota approved course seal',
    approval: 'NDDOT-approved', course: ndCourse.course.name,
    price: `$${ndCourse.course.priceUsd}`, hours: ndCourse.course.hours, enroll: buildEnrollUrl(ndCourse), live: isEnabled(ndCourse),
  },
  {
    abbr: 'MO', name: 'Missouri', url: moCourse.state.route, badge: '/assets/images/badges/missouri-approved.png', badgeAlt: 'Missouri approved course seal',
    approval: `MSC-approved · ${moCourse.provider.approvalNumber}`, course: moCourse.course.name,
    price: `$${moCourse.course.priceUsd}`, hours: moCourse.course.hours, enroll: buildEnrollUrl(moCourse), live: isEnabled(moCourse),
  },
].filter((s) => s.live);

// Reviews: the canvas's six, short ones first (Jackson's /texas feedback), MW's long one opens "Show more".
type Review = { name: string; initials: string; date: string; rating: number; verified: boolean; quote: string };
const ORDER = ['Ryan Johnson', 'Chelsie Gates', 'Bliss James', 'MW', 'Jeffrey', 'Colleen Minor'];
const reviews = ORDER.map((n) => (texasReviews as Review[]).find((r) => r.name === n)).filter(Boolean) as Review[];
const REVIEWS_SHOWN = 3;

const why = [
  { icon: 'self', title: 'Self-paced online course', body: 'Start, stop and pick up anytime. Your progress saves automatically, so you can finish in one sitting or over a few days.' },
  { icon: 'short', title: 'Shortest state-approved course', body: `Only the hours your state requires: ${TEXAS_COURSE.hours} in Texas, ${ndCourse.course.hours} in North Dakota, ${moCourse.course.hours} in Missouri. No filler.` },
  { icon: 'device', title: 'Works on phone, tablet or computer', body: 'Built mobile-first. Switch devices anytime and pick up right where you left off.' },
  { icon: 'refund', title: 'Refund-backed guarantee', body: 'Not happy before you finish? Request a refund. Terms vary by state and are listed on each course page.' },
];

const steps = [
  { icon: 'state', title: 'Choose your state', body: 'Pick where you’re licensed and why you need the course: a ticket, points or an insurance discount.' },
  { icon: 'online', title: 'Take it online', body: 'Short, clear modules you can start, stop and finish at your own pace.' },
  { icon: 'cert', title: 'Get your certificate', body: 'Your certificate is ready to download the moment you finish.' },
  { icon: 'submit', title: 'Submit if required', body: 'Some courts or insurers need a copy. Your course page shows exactly where it goes.' },
];

const covered = [
  { icon: 'covered', title: 'Changed your mind? You’re covered.', body: 'Ask for a refund before you finish. Terms vary by state and are spelled out on each course page.' },
  { icon: 'pay', title: 'Your payment stays safe', body: 'Checkout runs through Stripe with TLS/SSL encryption, so your card details go straight to them.' },
  { icon: 'counts', title: 'Your certificate counts', body: 'Every course is approved by its state, so the court, DMV or insurer that asked for it will accept it.' },
];

const support = [
  { icon: 'email', label: 'Email us anytime', value: 'info@roadreadysafety.com', note: '', href: 'mailto:info@roadreadysafety.com' },
  { icon: 'phone', label: 'Call us', value: '(888) 885-5707', note: 'Mon–Fri, 9 a.m.–5 p.m. ET', href: 'tel:+18888855707' },
  { icon: 'help', label: 'Help Center', value: 'Answers to common questions', note: 'Open 24/7', href: '/support' },
];

const faqs = [
  { q: 'Is this accepted in my state?', a: `Every Road Ready course is approved by its state: Texas (TDLR, CP#${TEXAS_COURSE.providerNumber.replace(/^CP/, '')}), North Dakota (NDDOT) and Missouri (MSC, ${moCourse.provider.approvalNumber}). Each course page lists the approval and any special instructions.` },
  { q: 'How long is the course?', a: `It depends on your state: Texas is ${TEXAS_COURSE.hours} hours, North Dakota is ${ndCourse.course.hours} hours and Missouri is ${moCourse.course.hours} hours. Start and stop anytime; your progress saves.` },
  { q: 'How do I get my certificate?', a: 'Download it the moment you finish. Some courts and insurers need you to send them a copy; your course page explains exactly how.' },
  { q: 'Will this dismiss my ticket or remove points?', a: 'It depends on your state. In Texas, the course can dismiss an eligible ticket once your court approves it. In North Dakota, it can take 3 points off your record. In Missouri, a court-approved Driver Improvement Program keeps the points off. Your course page walks you through the steps.' },
  { q: 'Can I use my phone?', a: 'Absolutely. Every course works on phone, tablet or computer, and your progress saves so you can switch devices anytime.' },
  { q: 'What languages are available?', a: 'Language options vary by course and state. Check the course page for your state.' },
  { q: 'How do refunds work?', a: 'If you haven’t completed the course and need a refund, contact Support. Eligibility can vary by state requirements.' },
  { q: 'How do I contact support?', a: 'Email us anytime, or call Monday–Friday, 9–5. You can also browse the Help Center.' },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const websiteSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Road Ready Safety', url: siteUrl });

// Finder: our live states first, then the partner-course states from courses.json, in the canvas's order.
const partnerCodes = ['FL', 'IL', 'LA', 'MI', 'NY', 'TN', 'VA'].filter((c) => (allCourses as { state: string }[]).some((x) => x.state === c));
const finder = [
  ...states.map((s) => ({
    key: s.abbr, name: s.name, title: s.course,
    sub: `${s.approval} · ${s.price} all-in · ${s.hours} hours online`, cta: 'Start now →', href: s.enroll,
  })),
  ...partnerCodes.map((c) => {
    const n = stateNames[c] || c;
    return { key: c, name: n, title: `${n} courses`, sub: `See the approved options for ${n}.`, cta: `See ${n} courses →`, href: `/find/${c}/multi` };
  }),
];

const guides = [
  { href: '/texas/ways-to-dismiss-ticket', label: 'Every way to dismiss a traffic ticket in Texas' },
  { href: '/texas/how-much-is-a-speeding-ticket', label: 'How much a traffic ticket costs in Texas' },
  { href: '/texas/stop-sign-ticket', label: 'Running a stop sign in Texas: fines, points and options' },
  { href: '/texas/defensive-driving-certificate', label: 'Texas defensive driving certificate: how to get and submit it' },
  { href: '/texas/tdlr-approved', label: 'How to check if a course is TDLR-approved' },
  { href: '/texas/providers', label: 'Texas defensive driving course providers: the full TDLR list' },
];

const eyebrow = 'text-sm font-bold uppercase tracking-[0.08em] text-primary-deep';
const h2 = 'm-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-[#0B2160]';
const iconBox = 'flex-none w-11 h-11 rounded-xl bg-white border border-[#DCE4EF] flex items-center justify-center [&>svg]:w-6 [&>svg]:h-6';
---

<Layout
  title={`Road Ready Safety: State-Approved Online Driving Courses — Texas Defensive Driving ${price} Total, North Dakota, Missouri`}
  description={`Online driving courses approved by the state and accepted by courts and insurers. Texas defensive driving: TDLR ${TEXAS_COURSE.providerNumber}, ${price} total with the certificate included, ${TEXAS_COURSE.hours} hours, no final exam. North Dakota point reduction and the Missouri Driver Improvement Program.`}
  keywords="road ready safety, defensive driving course online, driving safety course, texas defensive driving, north dakota defensive driving, missouri driver improvement program"
  image="/assets/rrs (1200 x 630 px).png"
  url="/"
>
  <script type="application/ld+json" slot="head" set:html={websiteSchema} />
  <script type="application/ld+json" slot="head" set:html={faqSchema} />

  <Header />

  <main class="text-text" style={sans}>
    <!-- 1. Hero + state cards -->
    <section class="bg-[#EEF6FD]">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-10 lg:pt-14 pb-14 lg:pb-[72px] flex flex-col gap-8 lg:gap-10">
        <div class="flex flex-wrap gap-10 items-center justify-between">
          <div class="flex-[999_1_520px] min-w-0 flex flex-col gap-[18px]">
            <h1 class="m-0 font-extrabold text-[34px] sm:text-[44px] lg:text-[56px] leading-[1.06] tracking-[-0.02em] text-[#0B2160]" style={inter}>State-Approved Online Defensive Driving Courses</h1>
            <p class="m-0 text-[17px] lg:text-[19px] leading-[1.5] text-text-body max-w-[560px]">Dismiss a ticket, take points off your record, or save on insurance with a course your state approves. 100% online and self-paced, with your certificate ready the moment you finish.</p>
          </div>
          <div class="hidden md:flex flex-[1_1_340px] max-w-[440px] bg-white rounded-[20px] px-7 py-[26px] flex-col gap-3 shadow-[0_18px_44px_rgba(11,33,96,0.10)]">
            <div class="flex items-center gap-2.5"><span class="text-accent text-lg tracking-[2px]" aria-label="5 out of 5 stars">★★★★★</span><span class="text-sm text-text-muted">Verified via Trustpilot</span></div>
            <p class="m-0 font-bold text-xl leading-[1.4] text-[#0B2160]" style={inter}>“Simple. No hidden fees. Seamless experience.”</p>
            <span class="text-[15px] text-text-body">Ryan Johnson</span>
          </div>
        </div>

        <div id="states" class="flex flex-col gap-4 scroll-mt-28">
          <span class={eyebrow}>Pick your state</span>
          <ul class="list-none p-0 m-0 grid gap-4 lg:gap-5 grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))]">
            {states.map((c) => (
              <li class="bg-white border border-border rounded-[20px] p-5 lg:p-6 flex flex-col gap-3 lg:gap-3.5 shadow-[0_10px_28px_rgba(11,33,96,0.07)]">
                <div class="flex items-center gap-3">
                  <img src={c.badge} alt={c.badgeAlt} width="44" height="44" class="flex-none w-11 h-11 object-contain" loading="lazy" decoding="async" />
                  <div class="flex flex-col leading-[1.25] min-w-0 flex-1">
                    <h3 class="m-0 font-extrabold text-[22px] lg:text-[26px] leading-[1.15]" style={inter}><a href={c.url} class="text-[#0B2160] no-underline hover:underline">{c.name}</a></h3>
                    <span class="text-[13px] font-bold text-primary-deep">{c.approval}</span>
                  </div>
                  <span class="md:hidden font-extrabold text-2xl text-[#0B2160]" style={inter}>{c.price}</span>
                </div>
                <a href={c.url} class="text-[15px] text-text-muted underline decoration-[#CBD3DF] underline-offset-[3px] hover:text-text">{c.course}</a>
                <span class="md:hidden text-[15px] text-text-body -mt-1">{c.hours} hours online</span>
                <p class="hidden md:flex m-0 items-baseline gap-2"><span class="font-extrabold text-[32px] text-[#0B2160]" style={inter}>{c.price}</span><span class="text-[15px] text-text-body">all-in · {c.hours} hours online</span></p>
                <div class="flex gap-2.5 mt-auto">
                  <a href={c.enroll} data-rrs-cta={`home-start-${c.abbr.toLowerCase()}`} class="flex-1 text-center no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-base px-2.5 py-[13px] rounded-full whitespace-nowrap">Start now&nbsp;→</a>
                  <a href={c.url} class="flex-1 text-center no-underline text-[#0B2160] font-bold text-base px-2.5 py-3 rounded-full border border-[#CBD3DF] hover:border-[#0B2160] whitespace-nowrap">Learn more</a>
                </div>
              </li>
            ))}
          </ul>
          <p class="m-0 mt-1 text-[15px] text-text-body flex flex-wrap items-center gap-x-1.5 gap-y-2">Don’t see your state? <a href="#finder" class="inline-flex items-center gap-1.5 font-bold text-[#0B2160] no-underline bg-white border border-[#CBD3DF] rounded-full px-3.5 py-1.5 text-sm hover:border-[#0B2160]">Find your state <span aria-hidden="true">→</span></a></p>
          <!-- Adult driver ed: the partner referral page until our own TDLR driver-ed license is approved (Jackson, 2026-10-07). -->
          <p class="m-0 text-[15px] text-text-body flex flex-wrap items-center gap-x-1.5 gap-y-2">Need a Texas driver license? <a href="/courses/tx-adult-ed" class="inline-flex items-center gap-1.5 font-bold text-[#0B2160] no-underline bg-white border border-[#CBD3DF] rounded-full px-3.5 py-1.5 text-sm hover:border-[#0B2160]">Adult driver education <span aria-hidden="true">→</span></a></p>
          <div class="hidden md:flex flex-wrap gap-x-7 gap-y-2.5 text-[15px] text-text-body">
            <span>✓&nbsp; Works on your phone</span><span>✓&nbsp; Certificate the moment you finish</span><span>✓&nbsp; Secure checkout</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Reviews -->
    <section class="bg-white">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 py-14 lg:py-[72px] flex flex-col gap-[22px]">
        <div class="flex flex-col gap-2 items-center text-center">
          <h2 class={h2} style={inter}>Reviews</h2>
          <a href={trustpilotUrl} target="_blank" rel="noopener" class="font-semibold text-sm text-text-muted no-underline border-b border-[#CBD3DF] hover:text-text">Verified reviews on Trustpilot ↗</a>
        </div>
        <div class="grid gap-3.5 grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]">
          {reviews.map((r, i) => (
            <div data-more={i >= REVIEWS_SHOWN ? '' : undefined} hidden={i >= REVIEWS_SHOWN}>
              <div class="h-full bg-white border border-border rounded-[14px] p-5 flex flex-col gap-2.5 shadow-[0_4px_14px_rgba(11,33,96,0.05)]">
                <div class="flex justify-between items-center gap-2.5"><span class="text-accent text-[15px] tracking-[2px]" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span><span class="text-xs text-text-muted">{r.date}</span></div>
                <p class="m-0 text-[15px] leading-[1.5] text-text flex-1">“{r.quote}”</p>
                <div class="flex items-center gap-2.5 pt-2.5 border-t border-[#EEF2F7]"><span class="w-[30px] h-[30px] rounded-full bg-[#DDEBFD] text-primary-deep font-bold text-xs flex items-center justify-center" aria-hidden="true">{r.initials}</span><span class="text-sm font-bold">{r.name}</span><span class="text-xs text-text-muted ml-auto">{r.verified ? 'Verified via Trustpilot' : 'via Trustpilot'}</span></div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" id="home-reviews-toggle" aria-expanded="false" class="self-center font-bold text-base min-h-12 px-6 py-2.5 rounded-full cursor-pointer bg-white text-[#0B2160] border-2 border-[#CBD3DF] hover:border-text-muted">Show more reviews</button>
      </div>
    </section>

    <!-- 3. Why choose us -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 py-16 lg:py-20 flex flex-wrap gap-12 items-center">
        <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-4">
          <span class={eyebrow}>Why choose us</span>
          <h2 class={h2} style={inter}>An online course built around your schedule</h2>
          <p class="hidden md:block m-0 text-[17px] text-text-body max-w-[560px]">A state-approved defensive driving course that fits your day, your device and your state’s rules.</p>
          <div class="grid gap-x-7 gap-y-6 mt-3 grid-cols-[repeat(auto-fit,minmax(min(250px,100%),1fr))]">
            {why.map((w) => (
              <div class="flex gap-3.5 items-start">
                <span class={iconBox} set:html={ICONS[w.icon]} />
                <div class="flex flex-col gap-0.5"><h3 class="m-0 font-extrabold text-[17px] leading-[1.3] text-[#0B2160]" style={inter}>{w.title}</h3><p class="m-0 text-[15px] leading-[1.5] text-text-body">{w.body}</p></div>
              </div>
            ))}
          </div>
          <a href="#states" class="hidden md:inline-block self-start mt-3 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-[17px] px-[26px] py-3.5 rounded-full whitespace-nowrap">Find my course&nbsp;→</a>
        </div>
        <div class="hidden lg:flex flex-[1_1_300px] justify-center py-5 pr-10" aria-hidden="true">
          <div class="relative w-[260px]">
            <div class="w-[260px] h-[520px] border-[9px] border-surface-dark rounded-[46px] bg-white px-5 pt-11 pb-6 flex flex-col gap-3.5 shadow-[0_30px_60px_rgba(11,33,96,0.18)]">
              <div class="absolute top-[18px] left-1/2 -ml-[50px] w-[100px] h-6 rounded-full bg-surface-dark"></div>
              <div class="flex gap-2.5 items-center"><span class="w-10 h-10 rounded-xl bg-primary-deep"></span><span class="flex-1 h-3 rounded-full bg-border"></span></div>
              <div class="bg-info rounded-2xl p-4 flex flex-col gap-2"><strong class="text-sm text-primary-deep">Your course</strong><div class="bg-[#B9D3F6] rounded-full h-2"><div class="w-[66%] h-2 rounded-full bg-primary-deep"></div></div><span class="text-xs text-primary-deep">4 of 6 modules complete</span></div>
              {[true, true, false].map((done) => (
                <div class="flex gap-3 items-center bg-surface-muted rounded-[14px] p-3.5">
                  {done ? <span class="w-[26px] h-[26px] rounded-full bg-primary text-white text-[13px] font-extrabold flex items-center justify-center">✓</span> : <span class="w-[26px] h-[26px] rounded-full border-2 border-[#CBD3DF]"></span>}
                  <span class="flex-1 h-2.5 rounded-full bg-border"></span>
                </div>
              ))}
              <span class="mt-auto text-center bg-info text-primary-deep font-extrabold text-base p-3.5 rounded-[14px]">Continue Module</span>
            </div>
            <div class="absolute top-24 -right-[58px] bg-white rounded-2xl px-[18px] py-3.5 flex gap-3 items-center shadow-[0_14px_34px_rgba(11,33,96,0.16)]"><span class="w-[38px] h-[38px] rounded-full bg-[#E3F6EC] text-[#1E8E53] font-extrabold flex items-center justify-center">✓</span><span class="flex flex-col"><strong class="text-sm">State-approved</strong><span class="text-xs text-text-muted">TX · ND · MO</span></span></div>
            <div class="absolute bottom-[120px] -left-12 bg-white rounded-2xl px-4 py-3 flex gap-2.5 items-center shadow-[0_14px_34px_rgba(11,33,96,0.16)]"><span class="w-2.5 h-2.5 rounded-full bg-[#1E8E53]"></span><strong class="text-sm">Progress saved</strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. How it works -->
    <section id="how-it-works" class="bg-white border-t border-border scroll-mt-28">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 py-16 lg:py-20 flex flex-col gap-9">
        <div class="flex flex-col gap-3 max-w-[640px]">
          <span class={eyebrow}>How it works</span>
          <h2 class={h2} style={inter}>From signup to certificate in four simple steps</h2>
          <p class="m-0 text-[17px] text-text-body">No classroom, no waiting on mail. Everything happens online, and we tell you exactly what to do next.</p>
        </div>
        <ol class="list-none p-0 m-0 grid gap-4 lg:gap-5 grid-cols-1 lg:grid-cols-4">
          {steps.map((s, i) => (
            <li class="relative flex lg:flex-col gap-4">
              <div class="relative flex-none w-10 lg:w-auto lg:h-10">
                {i < steps.length - 1 && <span class="hidden lg:block absolute top-[19px] left-[calc(50%+28px)] right-[calc(-50%+8px)] border-t-2 border-dashed border-[#B9D3F6]" aria-hidden="true"></span>}
                {i < steps.length - 1 && <span class="lg:hidden absolute left-[19px] top-12 -bottom-4 border-l-2 border-dashed border-[#B9D3F6]" aria-hidden="true"></span>}
                <span class="lg:absolute lg:top-0 lg:left-1/2 lg:-ml-5 w-10 h-10 rounded-full bg-[#0B2160] text-white font-extrabold text-[17px] flex items-center justify-center" style={inter}>{i + 1}</span>
              </div>
              <div class="flex-1 bg-white border border-border rounded-[18px] p-5 lg:p-[22px] flex flex-col gap-2.5 shadow-[0_8px_22px_rgba(11,33,96,0.05)]">
                <div class="flex lg:flex-col items-center lg:items-start gap-3 lg:gap-2.5">
                  <span class="flex-none w-[46px] h-[46px] rounded-xl bg-info flex items-center justify-center [&>svg]:w-6 [&>svg]:h-6" set:html={ICONS[s.icon]} />
                  <h3 class="m-0 lg:mt-1 font-extrabold text-[19px] text-[#0B2160]" style={inter}>{s.title}</h3>
                </div>
                <p class="m-0 text-[15px] leading-[1.55] text-text-body">{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <a href="#states" class="self-center mt-2 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-[17px] px-[30px] py-[15px] rounded-full text-center max-w-full sm:whitespace-nowrap">Pick your state and start&nbsp;→</a>
      </div>
    </section>

    <!-- 5. Peace of mind + support -->
    <section class="bg-white">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-6 pb-16 lg:pb-[88px]">
        <div class="bg-[#F4F8FD] border border-border rounded-[28px] px-5 sm:px-8 lg:px-12 py-10 lg:py-[52px] flex flex-wrap gap-12 items-center">
          <div class="flex-[999_1_460px] min-w-0 flex flex-col gap-4">
            <span class={eyebrow}>Peace of mind</span>
            <h2 class="m-0 font-extrabold text-[30px] lg:text-[38px] leading-[1.12] text-[#0B2160]" style={inter}>You’re covered from checkout to certificate</h2>
            <p class="m-0 text-[17px] leading-[1.6] text-text-body max-w-[540px]">Getting a ticket or a points notice is stressful enough. We keep the rest simple: a fair price, a course your state accepts, and real people ready to help if anything goes sideways.</p>
            <div class="flex flex-col gap-[18px] mt-2.5">
              {covered.map((c) => (
                <div class="flex gap-4 items-start">
                  <span class={`${iconBox} w-[46px] h-[46px]`} set:html={ICONS[c.icon]} />
                  <div class="flex flex-col gap-0.5"><h3 class="m-0 font-extrabold text-lg text-[#0B2160]" style={inter}>{c.title}</h3><p class="m-0 text-[15px] leading-[1.55] text-text-body">{c.body}</p></div>
                </div>
              ))}
            </div>
          </div>
          <div class="flex-[1_1_320px] max-w-[400px] min-w-0 bg-white border border-border rounded-[22px] p-6 lg:p-7 flex flex-col gap-1.5 shadow-[0_18px_44px_rgba(11,33,96,0.08)]">
            <span class="text-[13px] font-bold uppercase tracking-[0.08em] text-primary-deep">Support</span>
            <h3 class="m-0 mb-1 font-extrabold text-[22px] text-[#0B2160]" style={inter}>Real people, real help</h3>
            <p class="m-0 mb-2 text-[15px] text-text-body">Typo in your name or email? Stuck on a module? We’ll sort it out.</p>
            {support.map((s) => (
              <a href={s.href} class="flex gap-3 items-center py-3 border-t border-[#EEF2F7] no-underline group">
                <span class="flex-none w-[38px] h-[38px] rounded-[10px] bg-info flex items-center justify-center [&>svg]:w-5 [&>svg]:h-5" set:html={ICONS[s.icon]} />
                <span class="flex flex-col leading-[1.35] min-w-0"><span class="text-[13px] text-text-muted">{s.label}</span><strong class="text-[15px] text-[#0B2160] break-words group-hover:underline">{s.value}</strong>{s.note && <span class="text-[13px] text-text-muted">{s.note}</span>}</span>
              </a>
            ))}
            <div class="mt-2.5 bg-surface-muted rounded-[14px] px-4 py-3.5 flex flex-col gap-1.5">
              <span class="text-accent text-[13px] tracking-[2px]" aria-label="5 out of 5 stars">★★★★★</span>
              <span class="text-sm leading-[1.5] text-text">“I typed my email wrong when I signed up for the class, I called them, and customer service fixed it right away, and it was during the weekend.”</span>
              <span class="text-xs text-text-muted">MW · Verified via Trustpilot</span>
            </div>
            <a href={contactUrl} class="mt-3 text-center no-underline bg-white text-[#0B2160] font-bold text-base p-3 rounded-full border border-[#CBD3DF] hover:border-[#0B2160]">Contact Support&nbsp;→</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. About us -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[920px] mx-auto px-4 sm:px-6 py-14 lg:py-[72px]">
        <div class="relative overflow-hidden bg-white border border-border rounded-[28px] px-6 sm:px-12 pt-11 pb-10 flex flex-col gap-[22px] shadow-[0_18px_44px_rgba(11,33,96,0.06)]">
          <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-primary-deep via-primary to-[#B9E2FE]" aria-hidden="true"></div>
          <div class="flex flex-col gap-2.5">
            <span class={eyebrow}>About us</span>
            <h2 class="m-0 font-extrabold text-[30px] lg:text-[38px] leading-[1.12] text-[#0B2160]" style={inter}>Why we built Road Ready Safety</h2>
          </div>
          <div class="flex flex-col gap-4 border-t border-border pt-7">
            <span class="font-extrabold text-[64px] leading-[0.6] text-[#B9E2FE]" style={inter} aria-hidden="true">“</span>
            <p class="m-0 text-[19px] lg:text-[22px] leading-[1.45] font-bold text-[#0B2160]" style={inter}>Our goal is simple: fair, transparent, state-approved courses, plus plain-English guides so nobody is left confused, frustrated or upset about what their state requires.</p>
            <p class="m-0 text-[17px] leading-[1.65] text-text-body">A lot of drivers have had bad experiences with surprise fees, confusing options and no one to help. Our refund policy is compliant and clear, because we want to earn back the trust those experiences cost.</p>
            <p class="m-0 text-[17px] leading-[1.65] text-text-body">We hope you leave with a great course and a great experience, and that you trust us enough to tell your friends.</p>
            <div class="flex justify-between items-end gap-4 mt-1"><span class="font-bold text-base text-[#0B2160]" style={inter}>— The Road Ready Safety team</span><span class="font-extrabold text-[64px] leading-[0.6] text-[#B9E2FE]" style={inter} aria-hidden="true">”</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. FAQ -->
    <section id="faq" class="bg-white border-t border-border scroll-mt-28">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 py-16 lg:py-20 flex flex-col gap-2.5">
        <h2 class={`${h2} text-center mb-[18px]`} style={inter}>Frequently Asked Questions</h2>
        {faqs.map((f, i) => (
          <details name="home-faq" open={i === 0} class="group bg-white border border-border rounded-[14px] open:border-[#B9D3F6] open:shadow-[0_8px_20px_rgba(11,33,96,0.06)]">
            <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 px-[22px] py-[18px] cursor-pointer">
              <h3 class="m-0 font-bold text-[17px] text-[#0B2160]" style={inter}>{f.q}</h3>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none transition-transform group-open:rotate-180"><path d="M6 9 L12 15 L18 9" stroke="#2454E6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="m-0 px-[22px] pb-5 text-base leading-[1.6] text-text-body">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 8. Finder -->
    <section id="finder" class="bg-[#EEF6FD] border-t border-[#D6E8FA] scroll-mt-28">
      <div class="max-w-[900px] mx-auto px-4 sm:px-6 pt-16 lg:pt-20 pb-20 lg:pb-24 flex flex-col gap-[18px] items-center text-center">
        <h2 class={h2} style={inter}>Find the right course</h2>
        <p class="m-0 text-[17px] text-text-body">Pick your state. We’ll show you the approved option.</p>
        <div class="flex flex-wrap justify-center gap-2 mt-2" role="group" aria-label="Pick your state" data-home-finder>
          {finder.map((f, i) => (
            <button type="button" data-pick={f.key} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['font-bold text-[15px] min-h-11 px-4 py-2 rounded-full cursor-pointer border-2', i === 0 ? 'bg-[#0B2160] text-white border-[#0B2160]' : 'bg-white text-[#0B2160] border-[#CBD3DF]']}>{f.name}</button>
          ))}
        </div>
        {finder.map((f, i) => (
          <div data-panel={f.key} hidden={i !== 0} class="w-full max-w-[620px]">
            <div class="bg-white border border-[#DCE4EF] rounded-[18px] p-6 flex flex-wrap gap-3.5 items-center justify-between text-left mt-2">
              <div class="flex flex-col gap-0.5 min-w-0"><strong class="text-[19px] text-[#0B2160]" style={inter}>{f.title}</strong><span class="text-[15px] text-text-body">{f.sub}</span></div>
              <a href={f.href} class="no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-base px-[22px] py-[13px] rounded-full whitespace-nowrap">{f.cta.replace(' →', '')}&nbsp;→</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 9. Guides -->
    <section class="bg-white border-t border-border">
      <div class="max-w-[1000px] mx-auto px-4 sm:px-6 pt-16 lg:pt-[72px] pb-20 lg:pb-[88px] flex flex-col gap-2.5">
        <span class="text-[13px] font-bold uppercase tracking-[0.08em] text-primary-deep">Driver guides</span>
        <h2 class="m-0 font-extrabold text-[28px] lg:text-[34px] leading-[1.15] text-[#0B2160]" style={inter}>Helpful guides</h2>
        <p class="m-0 mb-1.5 text-[17px] text-text-body">Plain-English answers about tickets, points and certificates.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 md:gap-x-10">
          {guides.map((g) => (
            <a href={g.href} class="flex justify-between items-center gap-3 px-1 py-4 border-b border-border no-underline text-[#0B2160] font-bold text-base lg:text-[17px] hover:text-primary">{g.label}<span aria-hidden="true" class="text-primary">→</span></a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      if (window.__rrsHomeV3) return;
      window.__rrsHomeV3 = true;
      // One delegated listener (no dependency on the ViewTransitions router): reviews toggle + state finder.
      document.addEventListener('click', function (e) {
        var rt = e.target.closest('#home-reviews-toggle');
        if (rt) {
          var open = rt.getAttribute('aria-expanded') !== 'true';
          document.querySelectorAll('[data-more]').forEach(function (el) { el.hidden = !open; });
          rt.setAttribute('aria-expanded', open ? 'true' : 'false');
          rt.textContent = open ? 'Show fewer reviews' : 'Show more reviews';
          return;
        }
        var b = e.target.closest('[data-home-finder] [data-pick]');
        if (!b) return;
        var key = b.getAttribute('data-pick');
        document.querySelectorAll('[data-home-finder] [data-pick]').forEach(function (x) {
          var on = x === b;
          x.setAttribute('aria-pressed', on ? 'true' : 'false');
          ['bg-[#0B2160]', 'text-white', 'border-[#0B2160]'].forEach(function (c) { x.classList.toggle(c, on); });
          ['bg-white', 'text-[#0B2160]', 'border-[#CBD3DF]'].forEach(function (c) { x.classList.toggle(c, !on); });
        });
        document.querySelectorAll('#finder [data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== key; });
      });
    })();
  </script>
</Layout>

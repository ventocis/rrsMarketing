---
/**
 * Missouri landing page on the /texas page structure (Jackson, 2026-10-08), via the shared StateLanding
 * layout. Facts from mo-dip.json and the Missouri facts verified 2026-09-29 (memory: rrs-missouri-guides):
 * RSMo 302.302.5 (court must order; once per 36 months; within 60 days), MSC process sheet (Form 4444,
 * clerk signature, DOR within 15 days; no out-of-state licenses or tickets), no CDL / CMV.
 * Banned on MO pages: "insurance discount", dismissal wording, "erases points" (mo-dip.json claims.banned).
 *
 * Why a rest-param route: `missouri/[...override]` outranks `[state]/index.astro` for /missouri only, and
 * getStaticPaths returns nothing when the state is disabled.
 */
import CourseLayout from '../../layouts/CourseLayout.astro';
import StateLanding from '../../components/state-landing/StateLanding.astro';
import mo from '../../data/courses/mo-dip.json';
import type { CourseData } from '../../data/courses/types';
import { isEnabled } from '../../lib/courseFlags';

export function getStaticPaths() {
  return isEnabled(mo as CourseData) ? [{ params: { override: undefined } }] : [];
}

const course = mo as CourseData;
const layoutCourse: CourseData = { ...course, headerStyle: 'minimal' };
const route = course.state.route;
const price = `$${course.course.priceUsd}`;
const hours = course.course.hours;
const exam = course.exam;
const modules = course.course.modules.filter((m) => !/quiz|exam/i.test(m.title));

// The "$10 courses" answer names competitors' prices, which landing pages don't do. It stays on /missouri/faq.
const faqs = course.faqs.filter((f) => !f.q.includes('$10'));
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const bullets = [
  { label: 'MSC-Approved', text: `Approved by the Missouri Safety Center, provider ${course.provider.approvalNumber}.` },
  { label: 'Keep the Points Off', text: 'When your court orders the program, the points for that ticket aren’t assessed.' },
  { label: `${hours} Hours, Your Pace`, text: 'Missouri’s required length. Pause anytime, pick up on any device.' },
  { label: 'Form 4444 Included', text: 'Your completion form is ready to download the moment you pass.' },
  { label: `${price} All-In`, text: 'Certificate and form included. Nothing added at checkout.' },
];

const cardChecks = [
  { strong: `${hours}-hour MSC-approved program`, rest: ' to keep a ticket’s points off your record' },
  { rest: `${modules.length} short modules in plain English` },
  { rest: `${exam.questions}-question final quiz, unlimited retakes` },
  { rest: 'Certificate and MO Form 4444 ready the moment you pass' },
  { rest: 'Phone, tablet or computer: start, stop and resume anytime' },
  { rest: 'Real customer support' },
];

const tabs = [
  {
    key: 'rules', label: 'Missouri Rules',
    intro: 'Missouri’s Driver Improvement Program keeps a ticket’s points off your record, but only when a court orders it (RSMo 302.302.5):',
    items: [
      ['Ask the court first', 'The points are waived only when the court handling your ticket authorizes the program. Ask before you enroll, and before you pay: paying the ticket is a guilty plea.'],
      ['Which tickets qualify', 'Moving violations such as speeding, general moving violations and careless and imprudent driving. Not violations in a commercial vehicle, not CDL holders, and not out-of-state licenses or out-of-state tickets.'],
      ['Finish within 60 days', 'Complete the program within 60 days of your guilty plea or conviction. You can use it once every 36 months.'],
      ['Get MO Form 4444 signed', 'When you pass, you get MO Form 4444. Take it to the clerk of the court that ordered the program to sign. It goes to the Department of Revenue within 15 days of completion; ask the clerk whether they send it or hand it back to you to mail.'],
      ['What it does and doesn’t do', 'The points for that ticket aren’t assessed. The conviction still records, and the program doesn’t remove points already on your record.'],
    ] as [string, string][],
    note: 'Every court handles requests a little differently, so follow your court’s instructions first.',
  },
  {
    key: 'topics', label: 'Topics Covered',
    intro: course.curriculum.intro,
    items: [
      ...modules.map((m) => [m.title, m.blurb] as [string, string]),
      ['The final quiz', `${exam.questions} questions; ${exam.passCount} correct passes. ${exam.failNote}`],
    ] as [string, string][],
  },
  {
    key: 'support', label: 'Support',
    intro: 'We’re here to help throughout your course, from questions about the material to login or account access. Browse our help articles anytime, or contact us and a real person will help.',
    items: [] as [string, string][],
    link: true,
  },
  {
    key: 'after', label: 'After the Course',
    intro: 'Once you pass, your certificate and MO Form 4444 are ready to download right away.',
    items: [
      ['Get the form signed', 'Take MO Form 4444 to the clerk of the court that ordered the program.'],
      ['Make sure it reaches the DOR', 'It must reach the Department of Revenue within 15 days of completion. The DOR also accepts it by mail at the Driver License Bureau, PO Box 200, Jefferson City, MO 65105-0200.'],
      ['Check your record', 'Once the DOR processes it, that ticket’s points won’t be assessed. You can check your Missouri driving record with the DOR to confirm.'],
    ] as [string, string][],
  },
];

const resources = [
  { href: `${route}/blog/missouri-driver-improvement-program`, tag: 'How it works', title: 'Missouri Driver Improvement Program: how it works', blurb: 'Who qualifies, what it does, and the steps from court to DOR.' },
  { href: `${route}/blog/how-to-ask-missouri-court-for-driver-improvement-program`, tag: 'Step 1', title: 'How to ask a Missouri court for the program', blurb: 'What to say, and when to ask.' },
  { href: `${route}/blog/which-tickets-qualify-missouri-driver-improvement`, tag: 'Eligibility', title: 'Which tickets qualify', blurb: 'The moving violations the program covers, and the ones it doesn’t.' },
  { href: `${route}/blog/missouri-form-4444`, tag: 'Paperwork', title: 'Missouri Form 4444: what to do with it', blurb: 'Clerk signature, and getting it to the DOR on time.' },
  { href: `${route}/blog/missouri-driver-improvement-60-day-deadline`, tag: 'Deadline', title: 'The 60-day deadline', blurb: 'When the clock starts and what happens if you miss it.' },
  { href: `${route}/blog/missouri-points-by-violation`, tag: 'Points', title: 'Missouri points by violation', blurb: 'How many points each ticket carries.' },
];
---
<CourseLayout
  course={layoutCourse}
  title={course.seo.title}
  description={course.seo.description}
  keywords={course.seo.keywords}
  url={route}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <StateLanding
    course={course}
    seal={{ src: '/assets/images/badges/missouri-approved.png', alt: `Missouri approved: Missouri Safety Center-approved Driver Improvement Program, provider ${course.provider.approvalNumber}`, label: `MSC-Approved Provider ${course.provider.approvalNumber}` }}
    h1="Keep Points Off Your Record with Missouri’s Driver Improvement Program Online"
    bullets={bullets}
    heroNote="Your court has to approve the program first. Ask before you pay the ticket."
    cardChecks={cardChecks}
    tabs={tabs}
    resources={resources}
    aboutWho="Missourians"
    sampleNumber="MO-000123"
    faqs={faqs}
  />
</CourseLayout>

---
/**
 * /contact — redirect to the portal's contact page (the same target as the footer's "Contact Us").
 * The URL was linked and requested often enough to show up as a 404 in the 2026-10-13 site audit.
 * Meta refresh + JS redirect, like /support, so it works in SSG without server-side redirects.
 */
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || 'https://app.roadreadysafety.com/contact';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${contactUrl}`} />
    <title>Contact Road Ready Safety</title>
    <script define:vars={{ contactUrl }}>
      window.location.replace(contactUrl);
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem; color: #616d7b;">
      Redirecting to Contact Us…
      <a href={contactUrl} style="color: #0667D1;">Click here if you are not redirected.</a>
    </p>
  </body>
</html>

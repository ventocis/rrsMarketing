---
/**
 * Missouri landing page in the landing-v2 design, laid out like the Texas ADE page
 * (src/pages/adult-drivers-ed/texas/index.astro) as of 2026-09-28.
 *
 * Same routing trick as North Dakota: `missouri/[...override]` outranks the shared
 * `[state]/index.astro` for /missouri only, and getStaticPaths returns nothing while Missouri
 * is disabled, so production (no Missouri approval number yet) emits no file at all.
 * Every other /missouri page still uses the shared templates; the minimal header is applied
 * to this page only, by passing a copy of the course data to CourseLayout.
 *
 * Facts (price, hours, modules, exam, FAQs) come from mo-dip.json, the
 * same file every other Missouri page reads. Only headings and connecting copy live here.
 * Law checked 2026-09-28 against RSMo 302.302 (version effective 28 Aug 2026) and the DOR's
 * Tickets and Points FAQ.
 */
import CourseLayout from '../../layouts/CourseLayout.astro';
import Rating from '../../components/landing-v2/Rating.astro';
import RoadPhoto from '../../components/landing-v2/RoadPhoto.astro';
import PriceBlock from '../../components/landing-v2/PriceBlock.astro';
import FinalBand from '../../components/landing-v2/FinalBand.astro';
import mo from '../../data/courses/mo-dip.json';
import reviews from '../../data/reviews.json';
import type { CourseData } from '../../data/courses/types';
import { isEnabled, enrollUrl as buildEnrollUrl, contactUrl } from '../../lib/courseFlags';

export function getStaticPaths() {
  return isEnabled(mo as CourseData) ? [{ params: { override: undefined } }] : [];
}

const course = mo as CourseData;
const layoutCourse: CourseData = { ...course, headerStyle: 'minimal' };
const enrollUrl = buildEnrollUrl(course);
const route = course.state.route;
const price = course.course.priceUsd;
const hours = course.course.hours;
const modules = course.course.modules;
const lessons = modules.filter((m) => !m.isFinal);
const exam = course.exam;
const deadline = course.deadline;
const statuteHref = 'https://revisor.mo.gov/main/OneSection.aspx?section=302.302';
const dorHref = 'https://dor.mo.gov/faq/driver-license/tickets-points.html';
const ctaLabel = course.hero.ctaLabel;

const chips = [`${hours} hours, self-paced`, 'Works on your phone', 'Instant certificate included'];

// Two plain lists, per Jackson 2026-09-29: who the course is for and who it is not for.
// Same facts as the law paragraph under the cards (RSMo 302.302) and the FAQs.
const audiences = [
  {
    title: 'This course is for you if',
    yes: true,
    items: [
      'Your court, or the Fine Collection Center, said you can take a Driver Improvement Program',
      'Your ticket is for speeding or another ordinary moving violation',
      "You haven't used the program in the last 36 months",
      'You can finish within 60 days of your plea or conviction',
    ],
  },
  {
    title: "It's not for you if",
    yes: false,
    items: [
      "You haven't asked your court yet. Ask first, then come back",
      'You have a commercial driver license, or got the ticket in a commercial vehicle',
      'You want to remove points already on your record. The course only stops the points from this ticket',
    ],
  },
];

const stepNum = (n: number) => String(n).padStart(2, '0');
const steps = [
  {
    n: 1,
    where: 'At your court',
    title: "Get the court's OK",
    body: 'Ask your court, or the Fine Collection Center, if you can take the program.',
  },
  {
    n: 2,
    where: 'With us',
    title: 'Take the course',
    body: `${hours} hours online, at your own pace. Download your certificate the moment you pass.`,
  },
  {
    n: 3,
    where: 'By mail',
    title: 'Mail your form',
    body: 'Send your completion form to the Missouri Department of Revenue. Give your court a copy if it asks for one.',
  },
];

// The "$10 courses" answer names competitors' prices, which landing pages don't do. It stays on /missouri/faq.
const faqs = course.faqs.filter((f) => !f.q.includes('$10'));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

type Review = { initials: string; name: string; date: string; quote: string };
const reviewList = reviews as Review[];

const btnPrimary =
  'bg-primary hover:bg-primary-hover text-white h-[52px] px-8 rounded-full text-base font-semibold inline-flex items-center justify-center gap-2 no-underline transition-colors shadow-[0_8px_20px_-8px_rgba(36,84,230,0.55)]';
const btnSecondary =
  'bg-info hover:brightness-95 text-info-text h-[52px] px-8 rounded-full text-base font-semibold inline-flex items-center justify-center no-underline transition-colors';
const h2 = 'font-extrabold tracking-[-0.02em] leading-[1.1]';
const outfit = "font-family:'Outfit',sans-serif;";
const check = 'M4.8 8.2l2.1 2.1 4.3-4.4';
---

<CourseLayout
  course={layoutCourse}
  title={course.seo.title}
  description={course.seo.description}
  keywords={course.seo.keywords}
  url={route}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ============ 1. HERO ============ -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-14 lg:pt-24 lg:pb-28 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="flex flex-col gap-6 items-start">
        <h1 class={`text-[34px] lg:text-[56px] text-primary-navy ${h2}`} style={outfit}>
          Missouri Driver Improvement Program Online
        </h1>

        <p class="text-lg lg:text-xl text-text-body leading-8 max-w-[36rem] m-0">
          Keep the points from your ticket off your record.
          Once your court says yes, take the {hours}-hour course online, at your own pace, for ${price}.
        </p>

        <ul class="flex flex-wrap gap-3 list-none p-0 m-0" aria-label="Course basics">
          {chips.map((t) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-border bg-white px-4 py-2 text-sm font-medium text-text">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#16A34A" opacity="0.14"/><path d={check} stroke="#16A34A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {t}
            </li>
          ))}
        </ul>

        <a href={enrollUrl} class={`${btnPrimary} w-full sm:w-auto mt-2`}>{ctaLabel} &mdash; ${price}</a>
      </div>

      <!-- Photo with the course-progress card. Dropped on phones so the headline and button come first. -->
      <div class="relative hidden lg:block pb-16">
        <RoadPhoto class="w-full aspect-[4/3] rounded-[28px]" position="50% 60%" eager desktopOnly />
        <div class="absolute right-6 top-6 rounded-2xl bg-white shadow-[0_20px_25px_-5px_rgba(17,23,34,0.15)] px-4 py-3" aria-hidden="true">
          <p class="text-[22px] font-bold text-primary-navy leading-6 m-0" style={outfit}>${price}</p>
          <p class="text-xs text-text-body leading-4 m-0">all in</p>
        </div>
        <div class="absolute -left-8 bottom-0 w-[340px] rounded-[20px] bg-white ring-1 ring-border shadow-[0_24px_48px_-16px_rgba(2,25,84,0.35)] p-5 flex flex-col gap-3" aria-hidden="true">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-primary-deep">{course.hero.mockProgressLabel}</span>
            <span class="text-xs font-semibold text-text tabular-nums">7 of {lessons.length} modules complete</span>
          </div>
          <div class="h-2 rounded-full bg-info overflow-hidden"><div class="h-full w-[58%] bg-primary rounded-full"></div></div>
          <ul class="flex flex-col gap-1.5 list-none p-0 m-0">
            {lessons.slice(0, 4).map((m) => (
              <li class="flex items-center gap-3 rounded-xl bg-surface-muted px-3 py-2">
                <span class="w-5 h-5 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.2 2.2 4.8-4.8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="text-[13px] text-text-body truncate">{m.title}</span>
              </li>
            ))}
          </ul>
          <div class="rounded-xl bg-primary text-white text-sm font-semibold text-center py-2.5">{course.hero.mockContinueLabel}</div>
          <div class="flex items-center gap-3 border-t border-border pt-3">
            <span class="w-8 h-8 rounded-full bg-info flex items-center justify-center flex-shrink-0">
              <img src="/assets/icons/texas/check-circle.svg" alt="" class="w-4 h-4" />
            </span>
            <span class="text-sm font-semibold text-text leading-5">{course.hero.mockCalloutTitle} <span class="block text-xs font-normal text-text-body">{course.hero.mockCalloutBody}</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. WHO IT'S FOR ============ -->
  <section id="who-needs-it" class="relative overflow-hidden bg-primary-navy text-white scroll-mt-28">
    <div class="absolute inset-0 opacity-40 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(60% 80% at 80% 0%, rgba(36,84,230,.55), transparent 70%), radial-gradient(50% 70% at 0% 100%, rgba(124,195,249,.25), transparent 70%);"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 flex flex-col items-center gap-8 text-center">
      <h2 class={`text-[32px] lg:text-[44px] ${h2}`} style={outfit}>{course.audiences.heading}</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 w-full max-w-5xl list-none p-0 m-0">
        {audiences.map((a) => (
          <li class={`flex flex-col gap-5 rounded-[20px] px-6 py-7 lg:px-8 lg:py-8 text-left ${a.yes ? 'bg-white text-primary-navy' : 'border border-white/25 bg-white/5'}`}>
            <h3 class="text-[22px] lg:text-2xl font-bold leading-tight m-0" style={outfit}>{a.title}</h3>
            <ul class={`flex flex-col gap-3 list-none p-0 m-0 text-base lg:text-lg leading-7 ${a.yes ? 'text-text-body' : 'text-info-border'}`}>
              {a.items.map((item) => (
                <li class="flex items-start gap-3">
                  {a.yes ? (
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" class="mt-1 flex-shrink-0" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#16A34A" opacity="0.14"/><path d={check} stroke="#16A34A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" class="mt-1 flex-shrink-0" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#FFFFFF" opacity="0.14"/><path d="M5.5 5.5l5 5M10.5 5.5l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  )}
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
      <!-- First sentence shows; the rest sits in a <details> so it stays in the HTML for search engines. -->
      <div class="rrs-readmore max-w-3xl text-base lg:text-lg text-info-border leading-8">
        <p class="m-0">
          Missouri law lets a court accept an {hours}-hour driver-improvement program in place of the points for a ticket
          (<a href={statuteHref} class="underline text-white" target="_blank" rel="noopener noreferrer">RSMo 302.302</a>)<span class="rrs-readmore-period">.</span><span class="rrs-readmore-dots" aria-hidden="true">&hellip;</span>
        </p>
        <details class="rrs-readmore-details">
          <summary class="rrs-readmore-toggle mt-2 inline-flex cursor-pointer list-none font-semibold text-white underline underline-offset-4">
            <span class="rrs-readmore-more">Read more</span><span class="rrs-readmore-less">Read less</span>
          </summary>
          <div class="flex flex-col gap-4 mt-3">
            <p class="m-0">
              It covers speeding, careless and imprudent driving, and other ordinary moving violations.
              It does not cover a violation in a commercial vehicle, or a driver who holds or needs a commercial driver license.
            </p>
            <p class="m-0">
              You can use it once in any 36 months, and you must finish within 60 days of your plea or conviction.
              The conviction still goes on your record; the points for it do not.
              Missouri suspends a license at 8 points in 18 months.
              More from the <a href={dorHref} class="underline text-white" target="_blank" rel="noopener noreferrer">Missouri Department of Revenue</a>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ============ 3. TABS: what's included (#pricing) / what you'll learn (#curriculum) ============ -->
  <section id="pricing" class="bg-white pt-20 lg:pt-24 pb-20 lg:pb-24 scroll-mt-28">
    <span id="curriculum" class="block scroll-mt-28" aria-hidden="true"></span>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5 text-center">
      <h2 class={`text-[32px] lg:text-[44px] text-text ${h2}`} style={outfit}>A course you'll actually finish</h2>
      <p class="text-lg text-text-body leading-8 max-w-2xl m-0">
        Self-paced and saves as you go. No quizzes along the way. Most people finish across three or four sittings.
      </p>

      <div class="mt-6 inline-flex rounded-full bg-info p-1.5 max-w-full overflow-x-auto" role="tablist" aria-label="Course details">
        <button type="button" role="tab" id="mo-tab-learn" aria-controls="mo-panel-learn" aria-selected="false" tabindex="-1"
          class="mo-tab rounded-full px-6 h-11 text-base font-semibold whitespace-nowrap transition-colors aria-selected:bg-primary aria-selected:text-white text-text-body">What you'll learn</button>
        <button type="button" role="tab" id="mo-tab-price" aria-controls="mo-panel-price" aria-selected="true"
          class="mo-tab rounded-full px-6 h-11 text-base font-semibold whitespace-nowrap transition-colors aria-selected:bg-primary aria-selected:text-white text-text-body">What's included</button>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
      <div id="mo-panel-learn" role="tabpanel" aria-labelledby="mo-tab-learn" hidden class="mo-panel"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-base text-text-body leading-7 mt-0 mb-6">{course.curriculum.intro}</p>
          <div class="border-t border-border">
            {modules.map((m, i) => (
              <details class="group border-b border-border" open={i === 0}>
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4 py-5">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-left">
                    <span class="text-sm font-bold tabular-nums text-text-subtle" style={outfit}>{stepNum(m.n)}</span>
                    <span class="text-lg font-bold text-text" style={outfit}>{m.title}</span>
                    {m.isFinal && <span class="text-[10px] font-bold uppercase tracking-wider text-primary-deep bg-info px-2 py-0.5 rounded-full">Final exam</span>}
                  </span>
                  <svg class="flex-shrink-0 w-5 h-5 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <p class="text-base text-text-body leading-7 pb-5 m-0">{m.blurb}</p>
              </details>
            ))}
          </div>
        </div>

        <!-- The final exam, from the exam facts in mo-dip.json. -->
        <div class="rounded-[28px] bg-info p-8 lg:p-10">
          <div class="rounded-[20px] bg-white shadow-[0_24px_48px_-20px_rgba(2,25,84,0.35)] p-7 flex flex-col gap-5">
            <span class="text-sm font-semibold text-text-muted uppercase tracking-wider">The final exam</span>
            <p class="text-[56px] font-extrabold text-primary-navy leading-none m-0 tabular-nums" style={outfit}>{exam.questions}<span class="text-2xl font-bold text-text-body"> questions</span></p>
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-surface-muted px-4 py-3"><p class="text-2xl font-bold text-text m-0 tabular-nums" style={outfit}>{exam.passCount}</p><p class="text-sm text-text-body m-0">correct to pass</p></div>
              <div class="rounded-xl bg-surface-muted px-4 py-3"><p class="text-2xl font-bold text-text m-0" style={outfit}>Unlimited</p><p class="text-sm text-text-body m-0">retakes</p></div>
            </div>
            <p class="text-base text-text-body leading-7 m-0">{exam.failNote}</p>
          </div>
        </div>
      </div></div>

      <div id="mo-panel-price" role="tabpanel" aria-labelledby="mo-tab-price" class="mo-panel">
        <PriceBlock
          price={price}
          label={course.course.shortName}
          totalLabel={`${course.pricing.totalLabel} Nothing added at checkout.`}
          included={course.pricing.included}
          notCharged={course.pricing.notCharged}
          notChargedLabel="And what we never charge for"
          lineItems={course.pricing.lineItems}
          totalRow={{ label: 'What you pay', value: `$${price}` }}
          refundNote={course.pricing.refundNote}
          refundHref={`${route}/refund`}
          enrollUrl={enrollUrl}
          ctaLabel={ctaLabel}
        />
      </div>
    </div>
  </section>

  <!-- ============ 4. THREE STEPS, then the 60-day rule as a small note ============ -->
  <section class="bg-white pb-20 lg:pb-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-[28px] border border-info-border overflow-hidden">
        <div class="bg-info px-6 py-10 lg:px-14 lg:py-14 grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
          <div class="flex flex-col gap-5 items-start">
            <h2 class={`text-[40px] lg:text-[64px] text-primary-navy ${h2}`} style={outfit}>
              Your path to
              <span class="relative inline-block">
                no new points
                <svg class="absolute left-0 -bottom-4 w-full h-4" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12 C 60 2, 140 2, 197 9" fill="none" stroke="#2454E6" stroke-width="3.5" stroke-linecap="round"/></svg>
              </span>
            </h2>
          </div>
          <div class="flex flex-col gap-5 items-start lg:items-end">
            <a href={enrollUrl} class={btnPrimary}>{ctaLabel}</a>
          </div>
        </div>
        <ol class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-info-border list-none p-0 m-0 border-t border-info-border">
          {steps.map((s) => (
            <li class="bg-white px-6 py-10 lg:px-10 flex flex-col gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-[44px] font-extrabold leading-none text-primary tabular-nums mr-2" style={outfit}>{stepNum(s.n)}</span>
                <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full ${s.where === 'With us' ? 'bg-primary-deep text-white' : 'bg-surface-muted text-text-muted border border-border'}`}>{s.where}</span>
              </div>
              <h3 class="text-2xl font-bold text-text m-0" style={outfit}>{s.title}</h3>
              <p class="text-base text-text-body leading-7 m-0">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
      {deadline && (
        <div class="mt-6 mx-auto max-w-3xl rounded-2xl border border-border bg-surface-muted px-5 py-4 flex items-start gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-primary-deep" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <p class="text-sm lg:text-base text-text-body leading-6 m-0">
            <strong class="text-text">{deadline.eyebrow}.</strong>
            Finish the course within 60 days of your plea or conviction to keep the points off your record.
            <a href={statuteHref} class="underline text-primary whitespace-nowrap" target="_blank" rel="noopener noreferrer">RSMo 302.302</a>
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- ============ 5. REVIEWS ============ -->
  <section class="bg-surface-dark text-white py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[minmax(0,24rem)_1fr] gap-10 lg:gap-16 items-center">
      <div class="flex flex-col gap-6">
        <Rating tone="dark" />
        <h2 class={`text-[34px] lg:text-[46px] ${h2}`} style={outfit}>{course.reviewsHeading}</h2>
        <p class="text-base text-info-border leading-7 m-0">Recent reviews from our students on Trustpilot.</p>
        <div class="flex gap-3">
          <button type="button" class="mo-rev-prev w-14 h-14 rounded-2xl bg-white/10 hover:bg-white/15 flex items-center justify-center" aria-label="Previous review">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button type="button" class="mo-rev-next w-14 h-14 rounded-2xl bg-primary hover:bg-primary-hover flex items-center justify-center" aria-label="Next review">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
      <ul class="mo-rev-track flex gap-6 overflow-x-auto snap-x snap-mandatory list-none p-0 m-0 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {reviewList.map((r) => (
          <li class="snap-start flex-shrink-0 w-[85%] sm:w-[440px] rounded-[24px] bg-primary-deep flex flex-col">
            <div class="p-8 flex flex-col gap-5 flex-1">
              <span class="self-start rounded-full bg-white text-surface-dark text-xs font-bold px-3 py-1.5">Verified via Trustpilot</span>
              <span class="flex gap-1" aria-label="5 out of 5 stars">
                {[0, 1, 2, 3, 4].map(() => <img src="/assets/icons/texas/star-testimonial.svg" alt="" class="w-6 h-6" />)}
              </span>
              <blockquote class="text-xl lg:text-2xl leading-snug m-0">&ldquo;{r.quote}&rdquo;</blockquote>
            </div>
            <div class="border-t border-white/15 px-8 py-5 text-sm font-semibold text-info-border">{r.name} &middot; Texas Driver Safety Course &middot; {r.date}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 6. FAQ ============ -->
  <section id="faq" class="bg-white py-20 lg:py-28 scroll-mt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[minmax(0,26rem)_1fr] gap-10 lg:gap-20 items-start">
      <div class="flex flex-col gap-5 lg:sticky lg:top-32">
        <h2 class={`text-[36px] lg:text-[52px] text-text ${h2}`} style={outfit}>Questions people actually ask</h2>
        <p class="text-lg text-text-body leading-8 m-0">Still have a question? Ask us before you pay. Real people answer by phone and email.</p>
        <div class="flex flex-wrap gap-3">
          <a href={contactUrl} class={btnSecondary}>Contact us</a>
        </div>
        <a href={`${route}/faq`} class="text-primary font-semibold underline underline-offset-2">See every question</a>
      </div>
      <div class="border-t border-border">
        {faqs.map((f, i) => (
          <details class="group border-b border-border" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-start justify-between gap-6 py-6">
              <h3 class="text-lg lg:text-xl font-bold text-text m-0" style={outfit}>{f.q}</h3>
              <svg class="mt-1 flex-shrink-0 w-5 h-5 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="text-base text-text-body leading-7 pb-6 pr-10 m-0">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 7. FINAL CALL TO ACTION ============ -->
  <FinalBand
    heading={course.finalCta.heading}
    copy={course.finalCta.body}
    ctaLabel={`${ctaLabel} — $${price}`}
    ctaHref={enrollUrl}
  />
  <script is:inline>
    (function () {
      if (window.__rrsMoLandingV2) return;
      window.__rrsMoLandingV2 = true;
      // Tabs + review carousel: one delegated listener, no dependency on the ViewTransitions router.
      function selectTab(tab) {
        document.querySelectorAll('.mo-tab').forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          var panel = document.getElementById(t.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
      }
      // #pricing and #curriculum open the matching tab, then land on the section.
      function fromHash() {
        var id = { '#pricing': 'mo-tab-price', '#curriculum': 'mo-tab-learn' }[location.hash];
        var tab = id && document.getElementById(id);
        if (!tab) return;
        selectTab(tab);
        var target = document.getElementById(location.hash.slice(1));
        if (target) target.scrollIntoView();
      }
      document.addEventListener('click', function (e) {
        var tab = e.target.closest && e.target.closest('.mo-tab');
        if (tab) { selectTab(tab); return; }
        var prev = e.target.closest && e.target.closest('.mo-rev-prev');
        var next = e.target.closest && e.target.closest('.mo-rev-next');
        if (prev || next) {
          var track = document.querySelector('.mo-rev-track');
          if (!track) return;
          var card = track.querySelector('li');
          var step = card ? card.getBoundingClientRect().width + 24 : 400;
          track.scrollBy({ left: next ? step : -step, behavior: 'smooth' });
        }
      });
      document.addEventListener('keydown', function (e) {
        var tab = e.target.closest && e.target.closest('.mo-tab');
        if (!tab || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.mo-tab'));
        var n = tabs[(tabs.indexOf(tab) + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        n.focus(); n.click();
      });
      window.addEventListener('hashchange', fromHash);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fromHash); else fromHash();
    })();
  </script>

  <style is:global>
    /* "Read more" on the law paragraph */
    .rrs-readmore-toggle::-webkit-details-marker { display: none; }
    .rrs-readmore-less { display: none; }
    .rrs-readmore-details[open] .rrs-readmore-more { display: none; }
    .rrs-readmore-details[open] .rrs-readmore-less { display: inline; }
    .rrs-readmore-period { display: none; }
    .rrs-readmore:has(.rrs-readmore-details[open]) .rrs-readmore-dots { display: none; }
    .rrs-readmore:has(.rrs-readmore-details[open]) .rrs-readmore-period { display: inline; }
    .rrs-readmore-details[open] > summary { order: 2; }
    .rrs-readmore-details[open] { display: flex; flex-direction: column; }
    /* Tailwind base styles are off in this repo, so make [hidden] win explicitly. */
    .mo-panel[hidden] { display: none !important; }
  </style>
</CourseLayout>

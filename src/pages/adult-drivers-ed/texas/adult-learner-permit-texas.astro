---
/**
 * /adult-drivers-ed/texas/adult-learner-permit-texas — "adult learner's permit texas".
 *
 * Rewritten 2026-10-29 from DPS-RULES-CONFIRMED.md §b (REPORT v3 step 19). The statutory learner license is for 15
 * to 17 (Transp. Code §521.222(a)(1)). Adults get a driver license with a "B" restriction (a licensed driver 21 or
 * older in the front seat; 37 TAC §15.55(a)(3)) at the first DPS visit, and DPS asks for that license, or a learner
 * license, at the driving test, including at a third-party school. The official pages state no holding period for
 * adults, so this page states none.
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import { law, itd, CLAIM, WAIVER_LAPSE } from '../../../data/ade-eligibility';

const base = '/adult-drivers-ed/texas';
const answer = 'Not by that name. The Texas learner license is for ages 15 to 17. Adults get a driver license with a B restriction at their first DPS visit: you may drive only with a licensed driver 21 or older in the front seat, and you bring it to your road test.';

const faqs = [
  { q: 'Can an adult get a learner permit in Texas?', a: answer },
  { q: 'What is a B restriction?', a: 'A restriction on a Texas driver license that lets you drive only with a licensed driver 21 or older in the front seat. DPS issues it to first-time adult applicants before the driving test, and you take that license to the test.' },
  { q: 'When do I get the restricted license?', a: `At your first DPS visit: the application, your documents, the vision test and the knowledge test (unless your driver education certificate covers its sign and traffic law parts). Then you book the road test.` },
  { q: 'Do I need it for a road test at a driving school?', a: 'Yes. DPS lists a valid restricted driver license among the requirements for third-party skills testing at 18 and over, the same as for a road test at DPS.' },
  { q: 'Do adults have to hold it for six months?', a: 'Texas’s official pages state no holding period for adults. The six-month rule on DPS’s third-party testing page is listed for 16- and 17-year-olds.' },
  { q: 'Do I still need the six-hour course?', a: `If you are ${law.requiredBand} and this is a first license, yes, before your first DPS visit. Its final exam ${CLAIM}. ${WAIVER_LAPSE}` },
];

const next = [
  { href: `${base}/how-to-get-a-texas-license-as-an-adult#never-driven`, title: 'Never had a license, and you are an adult', blurb: 'There is no age limit on a first Texas license. What the process looks like from zero.' },
  { href: `${base}/third-party-skills-testing`, title: 'Taking the road test at a driving school', blurb: 'DPS-certified schools give the Class C test. Bring the restricted license.' },
  { href: `${base}/texas-driving-test`, title: 'The driving test', blurb: 'What the examiner scores, and what to bring.' },
  { href: `${base}/requirements`, title: 'Everything you need, by age', blurb: 'The full checklist for a first Texas license.' },
];
---

<AdeGuide
  title="Do Texas Adults Get a Learner's Permit?"
  description={answer}
  url={`${base}/adult-learner-permit-texas`}
  eyebrow="Before the road test"
  h1="Texas adults: the restricted license before your road test"
  lede={`${answer} Here is when you get it, what it lets you do, and why the road test needs it.`}
  faqs={faqs}
  dateModified="2026-10-29"
  updated="October 29, 2026"
  band={{ eyebrow: 'At 18 to 24, the course comes before your first DPS visit' }}
  next={next}
  sources={[
    { label: 'Tex. Transp. Code §521.222, Learner License', href: 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm' },
    { label: 'Texas DPS, Schedule your Driving Test Appointment', href: 'https://www.dps.texas.gov/section/driver-license/schedule-your-driving-test-appointment' },
    { label: 'Texas DPS, Third Party Skills Testing Program', href: 'https://www.dps.texas.gov/section/driver-license/third-party-skills-testing-program' },
    { label: '37 TAC §15.55(a)(3), definition of an unrestricted license' },
  ]}
>
  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Who gets a Texas learner license?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      People 15 or older but under 18. §521.222 authorizes the learner license for a person who &ldquo;is 15 years of age or older but
      under 18 years of age&rdquo;. It is the first stage of the graduated system Texas built for teenagers, and adults are outside it.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What do adults get instead?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      A driver license with a B restriction. At your first DPS visit you apply, show your documents, and pass the vision test and the
      knowledge test (unless your driver education certificate covers its sign and traffic law parts). DPS then issues a license that
      lets you drive only with a licensed driver 21 or older in the front seat.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      That license is what you bring to the road test. DPS&rsquo;s driving test page asks for &ldquo;your Texas learner license or Texas
      driver license with B restriction&rdquo;, and its third-party testing page asks applicants 18 and over for &ldquo;a valid restricted
      driver license&rdquo;. Bring your printed {itd.adultName} certificate too, dated within {itd.certValidDays} days.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">How does an adult practice before the road test?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      With lessons from a driving school, or with a licensed driver 21 or older in the front seat once you hold the restricted license.
      Never drive alone on it, and never drive before you have it. Some driving schools are also DPS-certified to give the road test itself.
    </p>
  </section>
</AdeGuide>

---
/**
 * MetroHub — the redesigned city hub page (Jackson's Dallas mockup, 2026-10-07), rendered from
 * src/data/metro-hubs/<city>.json. The old hubs were long prose plus a 25-row table and one money
 * link; this is a router: find your court and deadline first, then the four steps, eligibility, the
 * all-in cost, the course, quick answers. Brought in line with Jackson's design file (Dallas Page
 * Redesign2.html, artboard 00) on 2026-10-06: Inter headings, deep-blue course band with a white
 * button, short court-card notes and deadline/fee labels from the data file, no video. Court facts come from the data file; nothing
 * is added beyond what the old page said. The court finder is plain HTML filtered by a tiny inline
 * script, so every court card is in the page source for Google and the assistants.
 */
import TexasLayout from '../../layouts/TexasLayout.astro';
import CourseBand from './CourseBand.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';

interface Court { slug: string; name: string; note: string; deadlineDays: number | null; fee: string | null; feeLabel?: string | null; deadlineLabel?: string | null }
interface Faq { q: string; a: string }
interface Data { slug: string; city: string; county: string; dateModified?: string | null; title?: string; description?: string; faqs: Faq[]; courts: Court[] }
const { data } = Astro.props as { data: Data };

const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;
const city = data.city;
const courts = data.courts;
const urgent = courts.filter((c) => c.deadlineDays).sort((a, b) => (a.deadlineDays || 99) - (b.deadlineDays || 99));
const rest = courts.filter((c) => !c.deadlineDays);
const minDays = urgent.length ? urgent[0].deadlineDays : null;
const n = courts.length;
const verified = data.dateModified ? new Date(data.dateModified + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

const title = data.title || `${city} Traffic Ticket Dismissal: Deadlines & Fees for All ${n} Courts (2026)`;
const description = data.description || (minDays
  ? `Some ${city}-area courts give you as little as ${minDays} days to ask for defensive driving. Find your court's deadline and fee before you pay anything; then the four steps, who qualifies, and the all-in cost.`
  : `Every ${city}-area court sets its own fee and deadline for defensive driving. Find your court before you pay anything; then the four steps, who qualifies, and the all-in cost.`);
const shortName = (name: string) => name === `${city} Municipal Court` ? `${city} Municipal` : name.replace(/ Municipal Court$/, '');
const feeOf = (c: Court) => c.feeLabel || c.fee;

const extraFaq: Faq = { q: 'Can a course website approve me for defensive driving?', a: 'No. Only the court on your citation can. Course providers, including us, and directory sites cannot grant it; they can only tell you how to ask.' };
const faqs = [...data.faqs, extraFaq];

const neighbors: Record<string, string[]> = {
  houston: ['dallas', 'san-antonio'], dallas: ['fort-worth', 'houston'], austin: ['san-antonio', 'waco'], 'san-antonio': ['austin', 'houston'],
  'fort-worth': ['dallas', 'wichita-falls'], 'el-paso': ['lubbock', 'san-antonio'], lubbock: ['amarillo', 'el-paso'], amarillo: ['lubbock', 'wichita-falls'],
  waco: ['austin', 'dallas'], 'wichita-falls': ['fort-worth', 'amarillo'], tyler: ['dallas', 'houston'],
};
const label = (s: string) => s.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: `${city} Traffic Ticket Dismissal: Deadlines and Fees for All ${n} Courts`,
  description,
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-13', dateModified: '2026-10-07',
  mainEntityOfPage: `${siteUrl}/texas/${data.slug}`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });

const outfit = "font-family:'Inter',sans-serif;"; // headings: Inter, per Jackson's design brief (2026-10-06)
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const card = 'rounded-2xl border border-border bg-white p-5 flex flex-col gap-2 no-underline text-text hover:border-primary-deep transition-colors';
---

{isEnabled ? (
  <TexasLayout title={title} description={description} keywords={`${city.toLowerCase()} traffic ticket dismissal, ${city.toLowerCase()} defensive driving, ${city.toLowerCase()} municipal court defensive driving, dismiss ticket ${city.toLowerCase()} texas`} url={`/texas/${data.slug}`}>
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-24 lg:pb-16" style={sans}>
      <!-- ===== Lead ===== -->
      <div class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-8 lg:pt-12">
        <p class="text-sm text-text-body mb-6">
          <a href="/texas" class="text-primary-deep font-medium hover:underline">Texas defensive driving course</a>
          <span class="mx-2 text-text-subtle">›</span>
          <a href="/texas/ticket-dismissal" class="text-primary-deep font-medium hover:underline">Ticket dismissal</a>
          <span class="mx-2 text-text-subtle">›</span>
          <span class="text-text">{city}</span>
        </p>
        <div class="max-w-[760px]">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] text-text m-0 mb-5" style={outfit}>Got a {city} ticket? Don't pay it yet.</h1>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-3">You can likely get it dismissed and kept off your record with a 6-hour defensive driving course. But you have to ask the court first{minDays ? <>, and some {city}-area courts give you as little as <strong class="text-text">{minDays} days</strong></> : <>, by the appearance date on your citation</>}.</p>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-5">So the first question isn't <em>how</em>. It's <strong class="text-text">which court has your ticket, and how long do you have?</strong></p>
          <p class="text-sm text-text-subtle m-0">By Road Ready Safety, TDLR-licensed provider {TEXAS_COURSE.providerNumber}{verified && <> · Court rules checked {verified}</>}</p>
        </div>

        <!-- ===== Router ===== -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8 mb-14">
          <a href="#find-court" class={card}>
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-amber-800">I just got a ticket</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>Find my court's deadline</span>
            <span class="text-primary-deep font-semibold">Check your court ↓</span>
          </a>
          <a href={enrollUrl} class="rounded-2xl border border-primary bg-primary p-5 flex flex-col gap-2 no-underline text-white hover:bg-primary-hover transition-colors">
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-info-border">The court approved me</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>Take the course: {price} total</span>
            <span class="font-semibold">Start now →</span>
          </a>
          <a href="#eligible" class={card}>
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-text-subtle">25+ over, CDL or work zone</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>See my other options</span>
            <span class="text-primary-deep font-semibold">Check eligibility ↓</span>
          </a>
        </div>
      </div>

      <!-- ===== Court finder ===== -->
      <section id="find-court" class="bg-surface-muted border-y border-border scroll-mt-28">
        <div class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-14">
          <h2 class={h2c} style={outfit}>Which court has your ticket, and how long do you have?</h2>
          <p class="text-base text-text-body leading-7 m-0 mb-2 max-w-[760px]">It's the court printed on your citation, and {n >= 10 ? 'most' : 'many'} {city}-area tickets aren't handled by the City of {city}. Each of these {n} courts sets its own deadline and fee{urgent.length ? <>; {urgent.length} of them give you three weeks or less</> : null}.</p>
          <p class="text-sm text-text-subtle leading-6 m-0 mb-6 max-w-[760px]">Stopped outside city limits by a constable or sheriff's deputy? Your ticket goes to a {data.county} County Justice of the Peace court instead. <a href="/texas/courts" class="text-primary-deep font-medium hover:underline">Find your JP court</a>.</p>

          <div class="flex flex-col gap-1.5 max-w-[520px] mb-7">
            <label for={`court-search-${data.slug}`} class="font-bold text-base text-text">Which city is on your ticket?</label>
            <input id={`court-search-${data.slug}`} type="search" data-court-search placeholder={`Try ${rest.filter((c) => !c.name.startsWith(city)).slice(0, 3).map((c) => shortName(c.name)).join(', ')}…`} class="w-full text-lg px-4 py-3.5 rounded-xl border-2 border-border bg-white text-text focus:border-primary-deep focus:outline-none" autocomplete="off" />
          </div>

          {urgent.length > 0 && (
            <>
              <p class="text-xl font-bold text-text m-0 mb-3" style={outfit} data-court-heading="urgent">Short deadlines: act this week</p>
              <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 list-none p-0 m-0 mb-9" data-court-list>
                {urgent.map((c) => (
                  <li data-court-name={c.name.toLowerCase()}>
                    <a href={c.slug} class="rounded-xl border border-amber-300 bg-amber-50 p-4 flex flex-col gap-2 no-underline text-text hover:border-primary-deep">
                      <span class="flex justify-between items-baseline gap-2"><span class="font-bold text-[19px]">{shortName(c.name)}</span><span class="text-[15px] font-bold text-white bg-amber-800 px-2.5 py-0.5 rounded-full whitespace-nowrap">{c.deadlineLabel || `${c.deadlineDays} days`}</span></span>
                      {feeOf(c) && <span class="text-base"><strong>Court fee:</strong>{' '}{feeOf(c)}</span>}
                      <span class="text-sm text-text-body leading-6">{c.note}</span>
                      <span class="text-sm font-semibold text-primary-deep">Full court steps →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}

          <p class="text-xl font-bold text-text m-0 mb-3" style={outfit} data-court-heading="rest">{urgent.length ? 'Everyone else: by the appearance date on your citation' : 'By the appearance date on your citation'}</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 list-none p-0 m-0" data-court-list>
            {rest.map((c) => (
              <li data-court-name={c.name.toLowerCase()}>
                <a href={c.slug} class={card}>
                  <span class="flex justify-between items-baseline gap-2"><span class="font-bold text-[19px]">{shortName(c.name)}</span><span class="text-sm font-semibold text-text-body bg-[#F6F6F9] px-2.5 py-0.5 rounded-full whitespace-nowrap">{c.deadlineLabel || 'Appearance date'}</span></span>
                  {feeOf(c) && <span class="text-base"><strong>Court fee:</strong>{' '}{feeOf(c)}</span>}
                  <span class="text-sm text-text-body leading-6">{c.note}</span>
                  <span class="text-sm font-semibold text-primary-deep">Full court steps →</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="hidden rounded-xl bg-white border border-border p-4 mt-4 text-text-body" data-court-empty>Not one of these {n}? <a href="/texas/courts" class="text-primary-deep font-medium hover:underline">Search every Texas court in our directory</a>.</p>
        </div>
      </section>

      <!-- ===== Steps ===== -->
      <section id="steps" class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-4 scroll-mt-28">
        <h2 class={h2c} style={outfit}>How do you get a {city} ticket dismissed?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Four steps, the same at every {city}-area court. Only the deadlines and fees change.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 list-none p-0 m-0">
          {[
            { n: 1, t: 'Ask the court', b: 'Request defensive driving instead of paying.', when: "By your court's deadline", us: false },
            { n: 2, t: 'Pay the court fee', b: 'Usually $144, or $169 in a school zone.', when: 'When the court approves you', us: false },
            { n: 3, t: 'Take a 6-hour course', b: `Any TDLR-approved course, fully online. Ours is ${price}.`, when: 'Within 90 days', us: true },
            { n: 4, t: 'Send in your proof', b: 'Your certificate plus a certified DPS Type 3A driving record.', when: 'Before day 90', us: false },
          ].map((s) => (
            <li class={`rounded-2xl p-5 flex flex-col gap-1.5 ${s.us ? 'bg-primary text-white' : 'bg-white border border-border'}`}>
              <span class={`text-[32px] font-extrabold leading-none ${s.us ? 'text-info-border' : 'text-primary-deep'}`} style={outfit}>{s.n}</span>
              <span class="font-bold text-[18px]">{s.t}</span>
              <span class={`text-sm leading-6 ${s.us ? 'text-info' : 'text-text-body'}`}>{s.b}</span>
              <span class={`text-sm font-bold ${s.us ? 'text-white' : 'text-amber-800'}`}>{s.when}</span>
            </li>
          ))}
        </ol>
        <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4 max-w-[760px] text-text leading-7"><strong>The one mistake that ends all of this:</strong> paying the ticket online. Paying counts as a guilty plea and a conviction. Ask the court first.</div>
      </section>

      <!-- ===== Eligibility ===== -->
      <section id="eligible" class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-4 scroll-mt-28">
        <h2 class={h2c} style={outfit}>Can you take defensive driving for your ticket?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Most drivers can, once every 12 months. Four situations rule it out.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[18px] m-0 mb-3">You're likely eligible if you have</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-[17px]">
              {['A valid Texas driver license', 'Proof of insurance', 'No dismissal in the last 12 months', 'A plea of guilty or no contest'].map((t) => <li class="flex gap-3"><span class="text-green-600 font-bold" aria-hidden="true">✓</span><span>{t}</span></li>)}
            </ul>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[18px] m-0 mb-3">It's off the table if you were</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-[17px]">
              {['Going 25+ mph over (or 95+ mph)', 'Driving on a CDL', 'Passing a stopped school bus', 'In a work zone with workers present'].map((t) => <li class="flex gap-3"><span class="text-text-subtle font-bold" aria-hidden="true">✕</span><span>{t}</span></li>)}
            </ul>
            <a href="/texas/speeding-25-over" class="inline-block mt-4 font-bold text-primary-deep hover:underline">What to do instead →</a>
          </div>
        </div>
      </section>

      <!-- ===== Cost ===== -->
      <section class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-4">
        <h2 class={h2c} style={outfit}>How much does it cost to dismiss a {city} ticket?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Usually about $144 to the court, plus the DPS record and the course. The court fee is the same whichever course you pick. The course is the only part you shop for.</p>
        <div class="rounded-2xl border border-border bg-white p-6 max-w-[760px] flex flex-col gap-4">
          {[
            { l: 'Court fee', v: 'up to ~$144 ($169 school zone)', w: '100%', c: 'bg-[#8B95A5]' },
            { l: 'Certified DPS Type 3A record', v: '$12', w: '8%', c: 'bg-[#B9C0CB]' },
            { l: 'The course (ours, certificate included)', v: price, w: '19%', c: 'bg-primary' },
          ].map((r) => (
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between gap-4 text-[17px]"><span>{r.l}</span><strong class={r.c === 'bg-primary' ? 'text-primary-deep' : ''}>{r.v}</strong></div>
              <div class={`h-3.5 rounded-full ${r.c}`} style={`width:${r.w}`}></div>
            </div>
          ))}
        </div>
      </section>
      <CourseBand />

      <!-- ===== Quick answers ===== -->
      <section class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-6">
        <h2 class={h2c} style={outfit}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[760px] mt-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-white p-5">
              <h3 class="font-bold text-base m-0 mb-1 text-text">{f.q}</h3>
              <p class="m-0 text-text-body leading-7">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== Keep reading + legal ===== -->
      <section class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-10">
        <p class="font-bold m-0 mb-2.5">Keep reading</p>
        <div class="flex flex-wrap gap-2.5 mb-7">
          {[
            ['/texas/just-got-a-ticket', 'Just got a ticket? Start here'],
            ['/texas/ticket-dismissal', 'How Texas ticket dismissal works'],
            ['/texas/what-is-a-driving-safety-course', 'What a driving safety course is'],
            ['/texas/cost', 'What the whole dismissal costs'],
            ['/texas/type-3a-driving-record', 'How to order a Type 3A record'],
            ...(neighbors[data.slug] || []).map((s) => [`/texas/${s}`, label(s)]),
          ].map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-sm text-text-subtle m-0 max-w-[760px] leading-6">General information, not legal advice. Courts set their own fees and deadlines, so confirm with the court on your citation. Sources: Tex. Code Crim. Proc. ch. 45A; each court's published procedures. Road Ready Safety is a TDLR-licensed course provider ({TEXAS_COURSE.providerNumber}), not a court.{verified && <> Last updated {verified}.</>}</p>
      </section>

      <!-- ===== Sticky mobile CTA (appears after the steps section) ===== -->
      <div data-sticky-cta class="fixed inset-x-0 bottom-0 z-40 lg:hidden translate-y-full transition-transform duration-300 bg-white/95 backdrop-blur border-t border-border px-4 py-3">
        <a href={enrollUrl} class="flex items-center justify-center h-12 rounded-xl bg-primary text-white font-semibold no-underline">Start the {price} course, certificate included</a>
      </div>
    </article>

    <script is:inline>
      (function () {
        document.addEventListener('input', function (e) {
          var input = e.target.closest('[data-court-search]'); if (!input) return;
          var q = input.value.trim().toLowerCase(); var root = input.closest('section'); var any = false;
          root.querySelectorAll('[data-court-list]').forEach(function (list) {
            var shown = 0;
            list.querySelectorAll('[data-court-name]').forEach(function (li) { var on = !q || li.getAttribute('data-court-name').indexOf(q) !== -1; li.hidden = !on; if (on) shown++; });
            var kind = list.previousElementSibling; if (kind && kind.hasAttribute('data-court-heading')) kind.hidden = shown === 0;
            if (shown) any = true;
          });
          var empty = root.querySelector('[data-court-empty]'); if (empty) empty.classList.toggle('hidden', any);
        });
        var bar = document.querySelector('[data-sticky-cta]'); var steps = document.getElementById('steps'); var course = document.getElementById('course');
        if (bar && steps && course && 'IntersectionObserver' in window) {
          var past = false, nearCourse = false;
          function render() { bar.style.transform = past && !nearCourse ? 'translateY(0)' : ''; }
          new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.boundingClientRect.top < 0 && !en.isIntersecting) past = true; if (en.isIntersecting || en.boundingClientRect.top > 0) past = en.boundingClientRect.top < 0; render(); }); }, { threshold: 0 }).observe(steps);
          new IntersectionObserver(function (es) { es.forEach(function (en) { nearCourse = en.isIntersecting; render(); }); }, { threshold: 0.1 }).observe(course);
        }
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

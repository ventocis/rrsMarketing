---
/**
 * North Dakota guides index, grouped by hub. Overrides the shared `[state]/blog/index.astro`
 * for /north-dakota/blog only (static segment outranks dynamic). Hubs come first with their
 * guides under them; guides without a hub are listed at the end. Emits nothing while North
 * Dakota is disabled.
 */
import CourseLayout from '../../../layouts/CourseLayout.astro';
import PageIntro from '../../../components/course/PageIntro.astro';
import FinalCta from '../../../components/course/FinalCta.astro';
import nd from '../../../data/courses/nd-ddc.json';
import { postsFor, type StatePost } from '../../../data/blog/index';
import { isEnabled, enrollUrl as buildEnrollUrl } from '../../../lib/courseFlags';
import type { CourseData } from '../../../data/courses/types';

export function getStaticPaths() {
  return isEnabled(nd as CourseData) ? [{}] : [];
}

const course = nd as CourseData;
const route = course.state.route;
const enrollUrl = buildEnrollUrl(course);
const posts = postsFor('ND');
const hubs = posts.filter((p) => p.kind === 'hub');
const groups = hubs.map((h) => ({ hub: h, guides: posts.filter((p) => p.hub === h.slug) }));
const loose = posts.filter((p) => p.kind !== 'hub' && !hubs.some((h) => h.slug === p.hub));
const outfit = "font-family:'Outfit',sans-serif;";

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}
---

<CourseLayout course={course} title={`${course.blog.title} | Road Ready`} description={course.blog.intro} url={`${route}/blog`}>
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-surface-muted">
    <div class="max-w-4xl mx-auto">
      <PageIntro chip="Guides" title={course.blog.title} subtitle={course.blog.intro} />

      <div class="flex flex-col gap-12">
        {groups.map(({ hub, guides }) => (
          <section class="flex flex-col gap-4">
            <article class="bg-white border border-border rounded-[20px] p-7 lg:p-8 flex flex-col gap-3">
              <time class="text-xs text-text-muted" datetime={hub.updated ?? hub.date}>Updated {formatDate(hub.updated ?? hub.date)}</time>
              <h2 class="text-[24px] font-bold text-text leading-8 m-0" style={outfit}>
                <a href={`${route}/blog/${hub.slug}`} class="no-underline hover:text-primary transition-colors">{hub.title}</a>
              </h2>
              <p class="text-base text-text-body leading-7 m-0">{hub.description}</p>
            </article>
            {guides.length > 0 && (
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0 m-0 sm:pl-6">
                {guides.map((g) => (
                  <li class="bg-white border border-border rounded-2xl p-5 flex flex-col gap-1">
                    <a href={`${route}/blog/${g.slug}`} class="font-semibold text-text no-underline hover:text-primary">{g.title}</a>
                    <span class="text-sm text-text-body leading-6">{g.description}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {loose.length > 0 && (
          <section class="flex flex-col gap-4">
            <h2 class="text-[22px] font-bold text-text m-0" style={outfit}>More guides</h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0 m-0">
              {loose.map((g) => (
                <li class="bg-white border border-border rounded-2xl p-5 flex flex-col gap-1">
                  <a href={`${route}/blog/${g.slug}`} class="font-semibold text-text no-underline hover:text-primary">{g.title}</a>
                  <span class="text-sm text-text-body leading-6">{g.description}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </section>
  <FinalCta course={course} enrollUrl={enrollUrl} />
</CourseLayout>

---
import TexasLayout from '../../layouts/TexasLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import reviews from '../../data/texas-reviews.json';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;

// Redesigned 2026-10-06 from Jackson's "Dallas Page Redesign" file (artboard 10) on the pattern in
// ~/Claude/SEO/DESIGN-STANDARD.md: lead → four-question eligibility check → the three options →
// five steps as a graphic (+ the 4-steps video, canonical here) → cost bars → points → 2025 law →
// court chips → course band with a verified Trustpilot review → quick answers → chips. Every fact,
// statute and internal link from the previous version is kept. Two deliberate departures from the
// design file: the "Check my ticket" wording is not used (house rule: never imply we look a ticket
// up), and the promo-code sentence from the old page is dropped because the design omits it and
// pricing is a tabled decision with Sam.

const review = reviews.find((r: any) => r.name === 'Ryan Johnson');

const faqs = [
  { q: 'Can you dismiss a speeding ticket in Texas?', a: 'Yes, most everyday ones. Get the court’s permission by the answer date on your citation, take a 6-hour TDLR-approved driver safety course, and submit the certificate. You need a valid Texas license and no dismissal course in the 12 months before the offense.' },
  { q: 'How far over the limit disqualifies you?', a: '25 mph or more over the posted limit, or 95 mph or faster, rules out the course. Deferred disposition may still be available.' },
  { q: 'Does Texas have a point system for traffic tickets?', a: 'No. Texas eliminated its surcharge points when the Driver Responsibility Program was repealed on September 1, 2019. DPS still counts moving-violation convictions, and four or more in 12 months (or seven in 24) can trigger a license suspension. What matters is keeping convictions off your record.' },
  { q: 'Will a speeding ticket raise my insurance?', a: 'A conviction usually does, often for about three years. A dismissed ticket never reaches your driving record, so there’s nothing for your insurer to see.' },
  { q: 'How long do I have?', a: 'Ask by the answer date on your citation. Once approved, you usually have 90 days to finish the course and submit the certificate. Courts can extend that for good cause, but don’t count on it.' },
  { q: 'Can a CDL holder use defensive driving?', a: 'No, even for a ticket in a personal car. Federal anti-masking rules (49 CFR 384.226) keep moving violations on a CDL record, and Texas excludes anyone who holds a CDL or held one at the time of the offense (art. 45A.351). CDL holders can still take the course voluntarily for a possible insurance discount.' },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Got a speeding ticket in Texas? Don’t pay it yet.',
  description: 'Most Texas speeding tickets can be dismissed and kept off your record with a 6-hour course. Four questions tell you whether yours qualifies, then the steps, the cost, the deadlines, and the truth about Texas points.',
  author: { '@type': 'Person', name: 'Jackson Maitner', jobTitle: 'Co-founder', worksFor: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl } },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11',
  dateModified: '2026-10-06',
  mainEntityOfPage: `${siteUrl}/texas/speeding-ticket`,
});

const steps = [
  { n: 1, t: 'Ask the court', b: 'In person, by certified mail, or through the court’s email or portal where offered. You must ask before you take the course.', when: 'By your answer date', us: false },
  { n: 2, t: 'Pay the court fee', b: 'Plus proof of a valid Texas license and insurance.', when: 'When approved', us: false },
  { n: 3, t: 'Take the course', b: `${TEXAS_COURSE.hours} hours, online, on your phone. ${price} with us, certificate the moment you finish.`, when: 'Within 90 days', us: true },
  { n: 4, t: 'Get a Type 3A record', b: '$12 online from Texas DPS, if your court asks you to supply it. Some courts pull it for you for a small fee.', when: 'Before you submit', us: false },
  { n: 5, t: 'Submit and you’re done', b: 'Certificate plus record. The charge is dismissed and, by law, can’t be part of your driving record.', when: 'Before day 90', us: false },
];

const howToSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to dismiss a speeding ticket in Texas',
  step: steps.map(s => ({ '@type': 'HowToStep', name: s.t, text: `${s.b} (${s.when}.)` })),
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

// The four-question check. The script below reads the answers and shows one of these panels, in this
// order of precedence (a CDL beats everything else).
const questions = [
  { k: 'license', text: 'Do you have a valid Texas driver license? (Active-duty military and their families can use any state’s.)' },
  { k: 'speed', text: 'Were you under 25 mph over the limit, and under 95 mph?' },
  { k: 'cdl', text: 'Do you hold a CDL, or did you when you got the ticket?' },
  { k: 'recent', text: 'Have you taken a dismissal course in the 12 months before this ticket?' },
];
const warn = { panel: 'bg-amber-50 border-amber-200', eye: 'text-amber-800' };
const results = [
  { k: 'default', panel: 'bg-surface-muted border-border', eye: 'text-text-body', eyebrow: 'Your result', title: 'Answer all four to see your route.', body: 'Most everyday speeding tickets qualify.', cta: ['/texas/eligibility-tracker', 'Or use the full eligibility checker →'] },
  { k: 'cdl', ...warn, eyebrow: 'Course not available', title: 'CDL holders can’t dismiss with a course.', body: 'Federal rules keep moving violations on a CDL record, even in a personal car, and deferred disposition is excluded too.', cta: ['/texas/cdl-defensive-driving', 'What works for CDL drivers →'] },
  { k: 'speed', ...warn, eyebrow: 'Course not available', title: 'At 25+ over or 95+, the course is out. Deferred disposition isn’t.', body: 'Deferred disposition has no speed cutoff. Ask your court about it before your answer date.', cta: ['/texas/speeding-25-over', 'Options at 25+ over →'] },
  { k: 'recent', ...warn, eyebrow: 'Too soon for another course', title: 'You’ve used it in the last 12 months.', body: 'Deferred disposition is usually the route for a second ticket. Ask your court before your answer date.', cta: ['/texas/deferred-disposition', 'How deferred disposition works →'] },
  { k: 'license', ...warn, eyebrow: 'Check with your court', title: 'The course route needs a Texas license.', body: 'Unless you’re active-duty military or family, ask your court about deferred disposition instead.', cta: ['/texas/out-of-state-driver', 'Options for out-of-state drivers →'] },
  { k: 'ok', panel: 'bg-info border-info-border', eye: 'text-primary-deep', eyebrow: 'Good news', title: 'Your ticket can likely be dismissed.', body: 'Ask your court for a driving safety course by the answer date on your citation. Once approved, the course is the easy part.', cta: ['/texas/request-defensive-driving', 'How to ask the court →'] },
];

const metros = [
  ['houston', 'Houston'], ['dallas', 'Dallas'], ['fort-worth', 'Fort Worth'], ['san-antonio', 'San Antonio'], ['austin', 'Austin'], ['el-paso', 'El Paso'],
  ['waco', 'Waco'], ['lubbock', 'Lubbock'], ['amarillo', 'Amarillo'], ['wichita-falls', 'Wichita Falls'], ['tyler', 'Tyler'],
];

const outfit = "font-family:'Inter',sans-serif;"; // headings: Inter, per Jackson's design brief (2026-10-06)
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[36px] font-extrabold tracking-[-0.02em] leading-[1.12] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const pillOff = 'bg-white text-text border-border hover:border-primary-deep';
---

{isEnabled ? (
  <TexasLayout
    title="Speeding Ticket in Texas? How to Get It Dismissed (2026)"
    description="Don't pay it yet. Most Texas speeding tickets can be dismissed and kept off your record. Find out if yours qualifies in four questions, then see the steps and the cost."
    keywords="speeding ticket texas, dismiss speeding ticket texas, texas defensive driving speeding ticket, texas traffic ticket dismissal, texas points system, texas driver safety course"
    url="/texas/speeding-ticket"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={howToSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-24 lg:pb-16" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={`${wrap} pt-8 lg:pt-12`}>
        <p class="text-sm text-text-body mb-4">
          <a href="/texas" class="text-primary-deep font-medium hover:underline">Texas defensive driving course</a>
          <span class="mx-2 text-text-subtle">›</span>
          <span class="text-text">Speeding ticket guide</span>
        </p>
        <div class="max-w-[760px] pb-12">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] text-text m-0 mb-5" style={outfit}>Got a speeding ticket in Texas? Don't pay it yet.</h1>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-3">Paying is a guilty plea, and the conviction goes on your record. Most everyday Texas speeding tickets can instead be <strong class="text-text">dismissed with a 6-hour course</strong>, and by law a dismissed ticket can't be part of your driving record or used for any purpose (Code Crim. Proc. art. 45A.357).</p>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-6">The question is whether <em>your</em> ticket qualifies. Four questions will tell you.</p>
          <div class="flex flex-wrap gap-3 items-center">
            <a href="#check" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold text-[17px] px-6 py-3.5 rounded-xl">Does my ticket qualify? ↓</a>
            <a href="#video" class="font-semibold text-primary-deep hover:underline">▶ Watch: dismiss it in 4 steps (0:57)</a>
          </div>
          <p class="text-sm text-text-subtle m-0 mt-6">By Jackson Maitner, co-founder of Road Ready Safety (TDLR provider {TEXAS_COURSE.providerNumber}) · Checked against Tex. Code Crim. Proc. ch. 45A · Updated October 6, 2026</p>
        </div>
      </div>

      <!-- ===== Four-question check ===== -->
      <section id="check" class="bg-surface-muted border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`} data-checker>
          <h2 class={h2c} style={outfit}>Can your speeding ticket be dismissed?</h2>
          <p class="text-base text-text-body leading-7 m-0 mb-7 max-w-[760px]">Usually yes, if all four of these line up. Answer them and you'll know your route.</p>
          <div class="flex flex-wrap gap-8">
            <div class="flex-[1_1_460px] min-w-0 flex flex-col gap-6">
              {questions.map((q) => (
                <div class="flex flex-col gap-2.5">
                  <p class="font-bold text-[17px] text-text m-0">{q.text}</p>
                  <div class="flex gap-2.5">
                    <button type="button" data-q={q.k} data-v="1" aria-pressed="false" class={`font-bold text-base min-h-[44px] min-w-[96px] px-5 rounded-full border-2 transition-colors ${pillOff}`}>Yes</button>
                    <button type="button" data-q={q.k} data-v="0" aria-pressed="false" class={`font-bold text-base min-h-[44px] min-w-[96px] px-5 rounded-full border-2 transition-colors ${pillOff}`}>No</button>
                  </div>
                </div>
              ))}
            </div>
            <div class="flex-[1_1_380px] min-w-0">
              {results.map((r) => (
                <div data-result={r.k} hidden={r.k !== 'default'}>
                <div class={`rounded-2xl border p-6 lg:p-7 flex flex-col gap-3 ${r.panel}`}>
                  <p class={`text-sm font-bold uppercase tracking-[0.06em] m-0 ${r.eye}`}>{r.eyebrow}</p>
                  <p class="text-[24px] lg:text-[26px] font-extrabold leading-[1.15] text-text m-0" style={outfit}>{r.title}</p>
                  <p class="text-[17px] text-text-body leading-7 m-0">{r.body}</p>
                  <a href={r.cta[0]} class="mt-1 text-center no-underline bg-primary hover:bg-primary-hover text-white font-bold px-5 py-3 rounded-xl">{r.cta[1]}</a>
                  <p class="text-sm text-text-subtle leading-6 m-0">Also excluded: a <a href="/texas/construction-zone-ticket" class="text-primary-deep hover:underline">work zone with workers present</a>, passing a stopped school bus (§545.066), leaving the scene of a crash (§§550.022–.023), and a serious traffic violation as defined for commercial vehicles.</p>
                </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ===== Three options ===== -->
      <section class={`${wrap} pt-14 pb-4`}>
        <h2 class={h2c} style={outfit}>What are your options with a Texas speeding ticket?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Three. Only two keep it off your record, and doing nothing is the worst choice of all.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-text-subtle">Fastest, costs most later</span>
            <span class="text-[24px] font-extrabold text-text leading-tight" style={outfit}>Pay it</span>
            <span class="text-base text-text-body leading-7">A guilty plea and a conviction. It goes on your record, and insurers typically react for about three years. <a href="/texas/look-up-your-ticket" class="text-primary-deep font-medium hover:underline">Weigh it first</a>.</span>
            <span class="font-bold text-amber-800 mt-auto">On your record</span>
          </div>
          <div class="rounded-2xl border border-primary bg-primary text-white p-6 flex flex-col gap-2">
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-info-border">Best for most tickets</span>
            <span class="text-[24px] font-extrabold leading-tight" style={outfit}>Dismiss it with a course</span>
            <span class="text-base text-info leading-7">Get the court's OK, take a 6-hour online course, send the certificate. Once every 12 months.</span>
            <span class="font-bold mt-auto">Off your record</span>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-text-subtle">When the course isn't allowed</span>
            <span class="text-[24px] font-extrabold text-text leading-tight" style={outfit}>Deferred disposition</span>
            <span class="text-base text-text-body leading-7">Court probation of up to 180 days (art. 45A.302). Stay clean and it's dismissed. Works for 25+ over or a second ticket; CDL holders are excluded here too. <a href="/texas/defensive-driving-vs-deferred-disposition" class="text-primary-deep font-medium hover:underline">Compare them</a></span>
            <span class="font-bold text-primary-deep mt-auto">Off your record</span>
          </div>
        </div>
        <p class="text-base text-text-body leading-7 m-0 mt-4 max-w-[760px]">Ignoring it is worse than any of these: a missed answer date can bring a failure-to-appear charge and a hold on renewing your license, and a course does not clear that hold.</p>
      </section>

      <!-- ===== Five steps ===== -->
      <section id="steps" class={`${wrap} pt-12 pb-4 scroll-mt-28`}>
        <h2 class={h2c} style={outfit}>How do you get a Texas speeding ticket dismissed?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-7 max-w-[760px]">Five steps. The only one with real risk is the first: ask the court before your answer date.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 list-none p-0 m-0">
          {steps.map((s) => (
            <li class={`rounded-2xl p-5 flex flex-col gap-1.5 ${s.us ? 'bg-primary text-white border border-primary' : 'bg-white border border-border'}`}>
              <span class={`text-[32px] font-extrabold leading-none ${s.us ? 'text-info-border' : 'text-primary-deep'}`} style={outfit}>{s.n}</span>
              <span class="font-bold text-[18px]">{s.t}</span>
              <span class={`text-sm leading-6 ${s.us ? 'text-info' : 'text-text-body'}`}>{s.b}</span>
              <span class={`text-sm font-bold mt-auto ${s.us ? '' : 'text-amber-800'}`}>{s.when}</span>
            </li>
          ))}
        </ol>
        <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4 max-w-[760px] text-text leading-7"><strong>Leave a few days of cushion.</strong> TDLR says a certificate can take up to 5 days to appear in its validation system, so don't submit on the last afternoon. <a href="/texas/ticket-dismissal" class="text-primary-deep font-medium hover:underline">Full dismissal guide</a> · <a href="/texas/tdlr-approved" class="text-primary-deep font-medium hover:underline">How to verify a course is TDLR-approved</a></div>
        <div id="video" class="mt-8 max-w-[760px] scroll-mt-28">
          <VideoEmbed id="GDdhttCVEkY" />
        </div>
      </section>

      <!-- ===== Cost ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>What does dismissing a speeding ticket cost?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">About $184 at the most common court fee. The court's fee is the big part, and you pay it whichever course you choose.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-border bg-white p-5 flex flex-col gap-1">
            <span class="text-sm text-text-subtle">Court fee</span>
            <span class="text-[32px] font-extrabold text-text leading-none" style={outfit}>~$144</span>
            <span class="text-sm text-text-body leading-6">Often $169 in a school zone. Set by each court. <a href="/texas/dsc-fees-by-court" class="text-primary-deep font-medium hover:underline">Fees by court</a></span>
          </div>
          <div class="rounded-2xl border border-border bg-white p-5 flex flex-col gap-1">
            <span class="text-sm text-text-subtle">Type 3A record</span>
            <span class="text-[32px] font-extrabold text-text leading-none" style={outfit}>$12</span>
            <span class="text-sm text-text-body leading-6">From DPS, if the court asks you for it. <a href="/texas/type-3a-driving-record" class="text-primary-deep font-medium hover:underline">How to order it</a></span>
          </div>
          <div class="rounded-2xl border border-info-border bg-info p-5 flex flex-col gap-1">
            <span class="text-sm text-primary-deep font-semibold">The course</span>
            <span class="text-[32px] font-extrabold text-primary-deep leading-none" style={outfit}>{price}</span>
            <span class="text-sm text-text-body leading-6">All-in with us, certificate included. {floor} is the legal minimum (Educ. Code §1001.352).</span>
          </div>
        </div>
        <p class="m-0 mt-4 text-base leading-7"><a href="/texas/cost" class="text-primary-deep font-bold hover:underline">Work out your exact total →</a> <span class="text-text-subtle">·</span> <a href="/texas/how-much-is-a-speeding-ticket" class="text-primary-deep font-medium hover:underline">What the fine itself costs</a> <span class="text-text-subtle">·</span> <a href="/texas/traffic-ticket-fines" class="text-primary-deep font-medium hover:underline">Fines by violation</a></p>
      </section>

      <!-- ===== Points ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>Does Texas still use points? No. Convictions are what count.</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Texas dropped its points system on September 1, 2019, when H.B. 2048 repealed the Driver Responsibility Program. Any site promising to "keep points off your record" is selling something that doesn't exist.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[19px] text-text m-0 mb-1.5">What a conviction does to insurance</p>
            <p class="text-base text-text-body leading-7 m-0">Insurers price off your driving record, and a speeding conviction typically raises premiums for about three years. A dismissed ticket never reaches them. Many insurers also discount a voluntary course. <a href="/texas/insurance-discount" class="text-primary-deep font-medium hover:underline">Insurance discounts</a></p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[19px] text-text m-0 mb-1.5">What it does to your license</p>
            <p class="text-base text-text-body leading-7 m-0">DPS still counts convictions. Four moving violations in 12 months, or seven in 24, can mean a habitual-violator suspension (Transp. Code §521.292). <a href="/texas/do-tickets-have-points" class="text-primary-deep font-medium hover:underline">More on points vs convictions</a></p>
          </div>
        </div>
      </section>

      <!-- ===== 2025 law ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>What changed in Texas ticket law in 2025?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Two things worth knowing. If a site still cites "Article 45.0511," its information is out of date.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-[0.06em] text-primary-deep m-0">January 1, 2025</p>
            <p class="font-bold text-[19px] text-text m-0 mt-1 mb-1.5">The law moved</p>
            <p class="text-base text-text-body leading-7 m-0">Dismissal rules moved from art. 45.0511 to Code of Criminal Procedure chapter 45A (arts. 45A.351–.359). The substance carried over.</p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="text-xs font-bold uppercase tracking-[0.06em] text-primary-deep m-0">September 1, 2025</p>
            <p class="font-bold text-[19px] text-text m-0 mt-1 mb-1.5">Easier requests, one course for one stop</p>
            <p class="text-base text-text-body leading-7 m-0">S.B. 296 lets courts take requests by certified mail, email or portal, and one course can now dismiss several eligible charges from the same stop. Courts are still rolling out the mechanics, so ask yours. <a href="/texas/ticket-law-changes-2025" class="text-primary-deep font-medium hover:underline">Full breakdown</a></p>
          </div>
        </div>
      </section>

      <!-- ===== Courts ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>How does your court handle it?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-5 max-w-[760px]">Each court sets its own fee, deadline and request method. Some give you only 15 or 20 days to ask. Find yours:</p>
        <div class="flex flex-wrap gap-2.5">
          <a href="/texas/courts" class="no-underline bg-primary hover:bg-primary-hover text-white rounded-full px-4 py-2 text-base font-semibold">Search all Texas courts</a>
          {metros.map(([slug, name]) => <a href={`/texas/${slug}`} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{name}</a>)}
        </div>
      </section>

      <!-- ===== Course band ===== -->
      <section id="course" class={`${wrap} py-12 scroll-mt-28`}>
        <div class="rounded-[20px] bg-surface-dark text-white p-8 lg:p-10 flex flex-wrap gap-8 items-center justify-between">
          <div class="flex-[999_1_440px] min-w-0">
            {review && (
              <>
                <p class="text-xs font-bold uppercase tracking-[0.06em] text-accent m-0 mb-2">{review.title}</p>
                <blockquote class="m-0 mb-4 text-[20px] lg:text-[22px] font-bold leading-snug" style={outfit}>"{review.quote}"</blockquote>
                <div class="flex items-center gap-3 mb-4">
                  <span class="w-10 h-10 rounded-full bg-primary text-white font-bold text-[15px] flex items-center justify-center" aria-hidden="true">{review.initials}</span>
                  <span class="flex flex-col text-[15px] leading-tight"><strong>{review.name}</strong><span class="text-text-subtle">{review.verified ? 'Verified via Trustpilot' : 'Trustpilot'} · {review.date}</span></span>
                </div>
              </>
            )}
            <p class="m-0 text-info-border leading-7">{TEXAS_COURSE.hours} hours, fully online · {price} all-in · TDLR-approved ({TEXAS_COURSE.providerNumber}) · Certificate the moment you finish · Nothing added at checkout</p>
          </div>
          <div class="flex-[1_1_240px] flex flex-col gap-3">
            <a href={enrollUrl} class="text-center no-underline bg-accent hover:brightness-110 text-surface-dark font-extrabold text-lg px-7 py-4 rounded-xl" style={outfit}>Start the {price} course →</a>
            <a href="#check" class="text-center no-underline text-white font-semibold hover:underline">Not sure yet? Answer the four questions</a>
          </div>
        </div>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={outfit}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[800px] mt-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-white p-5">
              <h3 class="font-bold text-base m-0 mb-1 text-text" style={outfit}>{f.q}</h3>
              <p class="m-0 text-text-body leading-7">{f.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== Go deeper + legal ===== -->
      <section class={`${wrap} pt-4 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Go deeper</p>
        <div class="flex flex-wrap gap-2.5 mb-7">
          {[
            ['/texas/ticket-dismissal', 'Ticket dismissal guide'],
            ['/texas/speeding-25-over', '25+ mph over'],
            ['/texas/12-month-rule', 'The 12-month rule'],
            ['/texas/deferred-disposition', 'Deferred disposition'],
            ['/texas/traffic-ticket-fines', 'Fines by violation'],
            ['/texas/type-3a-driving-record', 'Order a Type 3A'],
            ['/texas/certificate-rejected', 'Certificate rejected?'],
            ['/texas/is-speeding-a-felony', 'Is speeding a felony?'],
            ['/texas/cdl-defensive-driving', 'CDL drivers'],
            ['/texas/eligibility-tracker', 'Full eligibility checker'],
            ['/texas/faq', 'Course FAQ'],
          ].map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-sm text-text-subtle m-0 max-w-[800px] leading-6">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). General information, not legal advice; eligibility and procedures vary by court, judge and the charge on your citation, so confirm with the court on your ticket before enrolling. Last updated October 6, 2026. Sources: Tex. Code Crim. Proc. ch. 45A (arts. 45A.301, 45A.302, 45A.351–.359); Tex. Educ. Code §1001.352; Tex. Transp. Code §§472.022, 521.292; 49 CFR 384.226; Texas DPS; Texas Department of Insurance; TDLR.</p>
      </section>

      <StickyCta afterId="check" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-checker]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-border', 'hover:border-primary-deep'];
          var s = {};
          var btns = root.querySelectorAll('[data-q]'), panels = root.querySelectorAll('[data-result]');
          function key() {
            if (s.cdl === true) return 'cdl';
            if (s.speed === false) return 'speed';
            if (s.recent === true) return 'recent';
            if (s.license === false) return 'license';
            if (s.license === true && s.speed === true && s.cdl === false && s.recent === false) return 'ok';
            return 'default';
          }
          btns.forEach(function (b) {
            b.addEventListener('click', function () {
              var q = b.getAttribute('data-q'), v = b.getAttribute('data-v') === '1';
              s[q] = v;
              btns.forEach(function (x) {
                if (x.getAttribute('data-q') !== q) return;
                var sel = x === b;
                x.setAttribute('aria-pressed', sel ? 'true' : 'false');
                on.forEach(function (c) { x.classList.toggle(c, sel); });
                off.forEach(function (c) { x.classList.toggle(c, !sel); });
              });
              var k = key();
              panels.forEach(function (p) { p.hidden = p.getAttribute('data-result') !== k; });
            });
          });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

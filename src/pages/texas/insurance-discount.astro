---
import TexasLayout from '../../layouts/TexasLayout.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import { INSURERS } from '../../data/texas-insurers';
import reviews from '../../data/texas-reviews.json';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;
const coursePrice = TEXAS_COURSE.price;
const review = reviews.find((r: any) => r.name === 'Ryan Johnson');

// Rebuilt 2026-10-06 from Jackson's design canvas "Insurance Discount Redesign" (Main.dc.html + Serp.dc.html),
// implemented as the spec: his copy, section order, the insurer picker and the two-mode calculator. The insurer
// rows come from src/data/texas-insurers.ts (quotes read from each insurer's site on 2026-09-04), and each
// "Read X's own page" link goes to our per-insurer page, which carries the source link. Design has no video, so
// the previous card is not carried over.

const verifiedOn = new Date(INSURERS[0].verified + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const generic = 'Confirms a course-based discount exists in some form, but leaves terms to an agent. Ask yours for the number.';
const notes: Record<string, string> = {
  geico: 'GEICO requires the course be completed “on a voluntary basis (not as a result of an order of a court or other governmental entity).” A course you took to dismiss a ticket won’t count here.',
  farmers: 'Farmers publishes “over age 55.” If you’re younger, the discount may not apply to your policy.',
  nationwide: 'Nationwide notes “you may have to be 55 or over.” Check with your agent before you enroll.',
};
const insurers = INSURERS.map((i) => ({
  slug: i.slug, name: i.name,
  age: i.ageGate || 'None published',
  amount: i.amount || 'Not published',
  court: i.courtOrdered === 'excluded' ? 'Excluded' : 'Not stated',
  note: notes[i.slug] || generic,
}));

const faqs = [
  { q: 'Does defensive driving lower car insurance in Texas?', a: 'Often, but it’s up to the insurer. Typical discounts are a few percent for about three years. Only your insurer’s quote counts.' },
  { q: 'Is there an age requirement?', a: 'At several big insurers, yes. Farmers publishes “over age 55,” Nationwide “you may have to be 55 or over,” and GEICO requires at least 50.' },
  { q: 'Can I take the course just for the discount?', a: 'Yes. TDLR recognizes the same 6-hour course for “ticket dismissal or insurance discounts.” No ticket or court needed.' },
  { q: 'Does a course taken for a ticket also count?', a: 'Sometimes. GEICO requires the course be taken “on a voluntary basis,” which excludes court-ordered ones. Others don’t say, so ask.' },
  { q: 'Isn’t a 10% discount required by law?', a: 'Not since Texas moved to file-and-use rating in 2003–2004. Each insurer now sets its own discounts.' },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Will defensive driving lower your insurance in Texas?',
  description: 'There’s no required 10% in Texas. What GEICO, State Farm, Farmers and five more insurers actually publish, including the age limits most people miss, and what the course is worth on your own numbers.',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11', dateModified: '2026-10-06',
  mainEntityOfPage: `${siteUrl}/texas/insurance-discount`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });

const claim = [
  ['“Do you offer it, and how much?”', 'Get the number, and which coverages it applies to.'],
  ['“How long does it last?”', 'Three years is common. Confirm yours, and when to renew.'],
  ['“What do you need from me?”', 'Usually the insurance copy of your certificate.'],
  ['“Does it need to be TDLR-approved?”', 'Most expect the standard 6-hour approved course. <a href="/texas/tdlr-approved" class="text-primary hover:text-primary-deep font-medium">Check any provider</a>'],
];
const nextSteps = [
  ['/texas/ticket-dismissal', 'Have a ticket?', 'Get it dismissed first →'],
  ['/texas/what-is-a-driving-safety-course', 'New to the course?', 'What it is and how it works →'],
  ['/texas/ticket-insurance-impact', 'What a ticket really costs', 'Fines plus 3 years of premium →'],
  ['/texas/best-defensive-driving-course', 'Comparing courses?', 'How to pick one →'],
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5 lg:p-[22px]';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
const eyebrow = 'text-sm font-bold uppercase tracking-[0.06em] text-primary-deep';
const input = 'text-lg px-3.5 py-3 rounded-[10px] border-2 border-[#CBD3DF] bg-white text-text focus:border-primary-deep focus:outline-none';
---

{isEnabled ? (
  <TexasLayout
    title="Texas Defensive Driving Insurance Discount: Insurer by Insurer"
    description="No, there's no required 10%. See what GEICO, State Farm, Farmers and 5 more actually publish, including the age limits most people miss."
    keywords="defensive driving insurance discount texas, defensive driving course for insurance discount, does defensive driving lower insurance texas, which insurers give defensive driving discount texas, texas auto insurance discount course, defensive driving 10 percent discount, voluntary defensive driving texas"
    url="/texas/insurance-discount"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><a href="/texas/speeding-ticket" class="text-text-body hover:underline">Speeding ticket guide</a><span class="mx-1.5">›</span><span>Insurance discount</span></p>
        <div class="max-w-[820px] pt-8 pb-12">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>Will defensive driving lower your insurance in Texas?</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">Often, but it's your insurer's call. Texas doesn't require a discount, and each company sets its own terms. Anyone promising a guaranteed 10% is quoting a law that ended in 2004.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">The catch most people find out too late isn't the course. It's <strong>your age</strong>. Here's what each major insurer actually publishes.</p>
          <div class="flex flex-wrap gap-3 items-center">
            <a href="#insurers" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold text-[17px] px-6 py-3.5 rounded-full">Check my insurer ↓</a>
            <a href="#math" class="font-semibold text-primary hover:text-primary-deep">Or run the numbers</a>
          </div>
          <p class="text-[15px] text-text-muted m-0 mt-6">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber}. Not affiliated with any insurer. Insurer terms read from each company's website on {verifiedOn} · Updated October 6, 2026</p>
        </div>
      </div>

      <!-- ===== The 10% myth ===== -->
      <section id="myth" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={inter}>Do Texas insurers have to give a 10% discount?</h2>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">No. That rule died when Texas moved auto insurance to "file and use" rating.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-2xl border border-border bg-[#F6F6F9] p-6">
              <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">The myth</span>
              <p class="text-[24px] font-extrabold leading-tight m-0 my-1.5 line-through" style={inter}>"A guaranteed 10% for 3 years"</p>
              <p class="text-base text-text-body leading-6 m-0">True under the old benchmark system. S.B. 14 (2003) ended it, and the benchmark era closed in 2004.</p>
            </div>
            <div class="rounded-2xl border border-info-border bg-info p-6">
              <span class={eyebrow}>The real rule today</span>
              <p class="text-[20px] font-bold leading-[1.4] m-0 my-1.5" style={inter}>"Each company sets its own discount terms."</p>
              <p class="text-base text-text-body leading-6 m-0">Texas Department of Insurance. Some insurers offer it, some don't, and the amount is theirs to set.</p>
            </div>
          </div>
          <p class="text-base text-text-body leading-7 m-0 mt-5 max-w-[780px]">A page still promising the mandatory 10% hasn't been updated since 2004. Same tell as a site promising to "remove points": Texas hasn't had points since 2019.</p>
        </div>
      </section>

      <!-- ===== Insurer picker ===== -->
      <section id="insurers" class={`${wrap} pt-16 pb-6 scroll-mt-28`} data-insurers>
        <h2 class={h2c} style={inter}>What does your insurer actually offer?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Several big insurers only give it above a certain age. Pick yours to see what it publishes, word for word. Where it publishes nothing, we say so.</p>
        <div class="flex flex-wrap gap-2.5 mb-5">
          {insurers.map((i, idx) => <button type="button" data-pick={i.slug} aria-pressed={idx === 0 ? 'true' : 'false'} class={`font-bold text-base min-h-[44px] px-[18px] rounded-full border-2 transition-colors ${idx === 0 ? pillOn : pillOff}`}>{i.name}</button>)}
        </div>
        {insurers.map((i, idx) => (
          <div data-panel={i.slug} hidden={idx !== 0}>
            <div class="rounded-2xl border-2 border-primary bg-white p-6 lg:p-7 max-w-[860px] flex flex-col gap-4">
              <p class="text-[26px] lg:text-[28px] font-extrabold m-0" style={inter}>{i.name}</p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                <div><p class={`${eyebrow} m-0`}>Age condition</p><p class="text-lg font-bold m-0">{i.age}</p></div>
                <div><p class={`${eyebrow} m-0`}>Published amount</p><p class="text-lg font-bold m-0">{i.amount}</p></div>
                <div><p class={`${eyebrow} m-0`}>Court-ordered course</p><p class="text-lg font-bold m-0">{i.court}</p></div>
              </div>
              <p class="text-base text-text-body bg-surface-muted rounded-[10px] px-4 py-3.5 m-0">{i.note}</p>
              <a href={`/texas/insurance-discount/${i.slug}`} class="font-bold text-primary hover:text-primary-deep">Read {i.name}'s own page →</a>
            </div>
          </div>
        ))}
        <div class="overflow-x-auto max-w-[860px] mt-6">
          <table class="w-full min-w-[600px] border-collapse rounded-[14px] border border-border overflow-hidden bg-white" style="border-spacing:0;">
            <thead><tr class="bg-[#F6F6F9] text-left"><th class="px-4 py-3 font-bold">Insurer</th><th class="px-4 py-3 font-bold">Age condition</th><th class="px-4 py-3 font-bold">Published amount</th><th class="px-4 py-3 font-bold">Court-ordered course</th></tr></thead>
            <tbody>{insurers.map((i) => <tr class="border-t border-border"><th scope="row" class="px-4 py-3 font-bold text-left"><a href={`/texas/insurance-discount/${i.slug}`} class="text-text hover:text-primary-deep no-underline">{i.name}</a></th><td class="px-4 py-3">{i.age}</td><td class="px-4 py-3">{i.amount}</td><td class="px-4 py-3">{i.court}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="text-sm text-text-muted m-0 mt-3 max-w-[860px]">Read from each insurer's own website on {verifiedOn}. Road Ready Safety is not affiliated with or endorsed by any insurer listed. Terms change without notice, so confirm with your agent.</p>
      </section>

      <!-- ===== Calculator ===== -->
      <section id="math" class={`${wrap} pt-12 pb-6 scroll-mt-28`} data-calc data-course={coursePrice}>
        <h2 class={h2c} style={inter}>What is it worth to you?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Your numbers, your assumptions. We don't guess your discount, because nobody honestly can.</p>
        <div class="flex flex-wrap gap-2.5 mb-6">
          <button type="button" data-mode="ticket" aria-pressed="true" class={`font-bold text-[17px] min-h-[48px] px-5 rounded-full border-2 transition-colors ${pillOn}`}>I have a ticket</button>
          <button type="button" data-mode="discount" aria-pressed="false" class={`font-bold text-[17px] min-h-[48px] px-5 rounded-full border-2 transition-colors ${pillOff}`}>No ticket, just the discount</button>
        </div>
        <div class="flex flex-wrap gap-7">
          <div class="flex-[1_1_380px] min-w-0 rounded-2xl border border-border bg-white p-6 flex flex-col gap-5">
            <label class="flex flex-col gap-1.5 font-bold text-base">Your yearly car insurance premium ($) <input type="number" data-premium value="2000" min="0" class={input} /><span class="font-normal text-sm text-text-muted">On your declarations page. Paying monthly? Multiply by 12.</span></label>
            <div data-only="ticket" class="flex flex-col gap-5">
              <label class="flex flex-col gap-1.5 font-bold text-base">If convicted, how much would your premium rise? <span class="text-primary"><span data-rise-out>25</span>%</span><input type="range" data-rise min="5" max="50" step="1" value="25" class="accent-primary" /><span class="font-normal text-sm text-text-muted">Typical increases run roughly 15–40% for about three years. Insurers don't publish these.</span></label>
              <label class="flex flex-col gap-1.5 font-bold text-base">Your court's defensive driving fee ($) <input type="number" data-fee value="144" min="0" class={input} /><span class="font-normal text-sm text-text-muted">$144 is common, $169 in a school zone. <a href="/texas/dsc-fees-by-court" class="text-primary hover:text-primary-deep font-medium">Find your court's fee</a></span></label>
            </div>
            <div data-only="discount" hidden>
              <label class="flex flex-col gap-1.5 font-bold text-base">The discount your insurer quoted you <span class="text-primary"><span data-disc-out>5</span>%</span><input type="range" data-disc min="1" max="15" step="1" value="5" class="accent-primary" /><span class="font-normal text-sm text-text-muted">Ask your agent for the real figure. Discounts commonly last about three years.</span></label>
            </div>
          </div>
          <div class="flex-[1_1_340px] min-w-0 rounded-2xl border border-info-border bg-info p-6 flex flex-col gap-3.5">
            <span class={eyebrow}>Over three years</span>
            <div class="flex justify-between gap-3 text-[17px]"><span data-line-a>Extra premium if convicted</span><strong>$<span data-val-a>1,500</span></strong></div>
            <div class="flex justify-between gap-3 text-[17px]"><span data-line-b>Court fee + our course ({price})</span><strong>$<span data-val-b>172</span></strong></div>
            <p data-verdict class="border-t border-info-border pt-3.5 text-[20px] font-extrabold leading-snug m-0" style={inter}>Dismissing costs $1,328 less than a conviction.</p>
            <p class="text-sm text-text-body m-0">Arithmetic on your numbers, not a quote. Your insurer sets its own terms.</p>
          </div>
        </div>
      </section>

      <!-- ===== Claim it ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How do you claim the discount?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Five minutes on the phone first. It beats six hours on a maybe. Ask your agent:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {claim.map(([t, b], i) => <div class="rounded-[14px] border border-border bg-white p-5 flex flex-col gap-1.5"><span class="text-[28px] font-extrabold text-primary leading-none" style={inter}>{i + 1}</span><span class="font-bold">{t}</span><span class="text-[15px] text-text-body leading-6" set:html={b} /></div>)}
        </div>
        <p class="text-base leading-7 m-0 mt-[18px] max-w-[780px]">Then take the course and send the insurance copy. With us, both copies download the moment you finish.</p>
      </section>

      <!-- ===== Ticket + discount ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>Got a ticket? Can one course do both?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Sometimes. And even when your ticket can't be dismissed, the discount door can still be open.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6"><p class="font-bold text-[19px] m-0 mb-1.5">The dismissal is the bigger prize</p><p class="text-base text-text-body leading-6 m-0">A conviction can raise your premium for about three years. Dismissing it keeps it off your record. <a href="/texas/ticket-dismissal" class="text-primary hover:text-primary-deep font-medium">How dismissal works</a></p></div>
          <div class="rounded-2xl border border-border bg-white p-6"><p class="font-bold text-[19px] m-0 mb-1.5">The discount may stack, or not</p><p class="text-base text-text-body leading-6 m-0">GEICO excludes court-ordered courses in writing. Most others don't say. Ask before you assume both.</p></div>
          <div class="rounded-2xl border border-info-border bg-info p-6"><p class="font-bold text-[19px] m-0 mb-1.5">Can't dismiss your ticket?</p><p class="text-base text-text-body leading-6 m-0">CDL holders, 25+ over, or a second ticket within 12 months can still take the course for the discount.</p></div>
        </div>
      </section>

      <!-- ===== Course band ===== -->
      <section id="course" class={`${wrap} py-14 scroll-mt-28`}>
        <div class="rounded-3xl bg-primary-deep text-white px-6 py-12 lg:px-8 lg:py-14 flex flex-col items-center text-center gap-7">
          <div class="flex flex-col gap-2.5 max-w-[680px]">
            <span class="text-sm font-bold uppercase tracking-[0.08em] text-info-border">Confirmed with your agent?</span>
            <h2 class="text-[30px] lg:text-[40px] font-extrabold leading-[1.1] m-0" style={inter}>Six hours online. Insurance copy the moment you finish.</h2>
          </div>
          {review && (
            <div class="rounded-[18px] bg-white text-text px-7 py-7 max-w-[640px] w-full flex flex-col gap-3">
              <span class="text-accent text-[22px] tracking-[3px]" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
              <blockquote class="m-0 text-[19px] lg:text-[21px] font-bold leading-[1.45]" style={inter}>"{review.quote}"</blockquote>
              <div class="flex items-center gap-3 text-left">
                <span class="w-10 h-10 rounded-full bg-primary text-white font-bold text-[15px] flex items-center justify-center" aria-hidden="true">{review.initials}</span>
                <span class="flex flex-col text-[15px] leading-[1.35]"><strong>{review.name}</strong><span class="text-text-muted">{review.verified ? 'Verified via Trustpilot' : 'Trustpilot'} · {review.date}</span></span>
              </div>
            </div>
          )}
          <ul class="flex flex-wrap justify-center gap-2.5 list-none p-0 m-0 max-w-[820px]">
            {[`${price} all-in, nothing added`, `TDLR-approved · ${TEXAS_COURSE.providerNumber}`, 'Insurance and court copies', 'No ticket or court needed'].map((t) => <li class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-[15px]"><span class="text-info-border font-extrabold" aria-hidden="true">✓</span>{t}</li>)}
          </ul>
          <div class="flex flex-col items-center gap-3">
            <a href={enrollUrl} class="no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-8 py-4 rounded-full" style={inter}>Start the {price} course →</a>
            <a href="/texas/cost" class="no-underline text-white hover:underline">See exactly what we charge</a>
          </div>
        </div>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7">{f.a}</p></div>)}
        </div>
      </section>

      <!-- ===== Where to go + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Where to go from here</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
          {nextSteps.map(([href, t, s]) => <a href={href} class="no-underline text-text rounded-[14px] border border-border bg-white p-4 hover:border-primary-deep"><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{s}</span></a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). Informational, not insurance advice. Discount availability, size and terms are set solely by your insurer. Last updated October 6, 2026. Sources: Texas Department of Insurance consumer guidance; S.B. 14 (2003); TDLR course-use guidance; each insurer's own website, read {verifiedOn}. Typical ranges are industry practice, not state requirements.</p>
      </section>

      <StickyCta afterId="myth" hideAtId="course" label={`Start the ${price} course, insurance copy included`} />
    </article>

    <script is:inline>
      (function () {
        var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
        function pick(group, sel) { group.forEach(function (x) { var s = x === sel; x.setAttribute('aria-pressed', s ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, s); }); off.forEach(function (c) { x.classList.toggle(c, !s); }); }); }
        document.querySelectorAll('[data-insurers]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var btns = root.querySelectorAll('[data-pick]'), panels = root.querySelectorAll('[data-panel]');
          btns.forEach(function (b) { b.addEventListener('click', function () { var k = b.getAttribute('data-pick'); pick(btns, b); panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== k; }); }); });
        });
        document.querySelectorAll('[data-calc]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var course = +root.getAttribute('data-course'), mode = 'ticket';
          var q = function (s) { return root.querySelector(s); };
          var fmt = function (n) { return Math.round(n).toLocaleString('en-US'); }, num = function (v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; };
          function render() {
            var premium = num(q('[data-premium]').value), rise = num(q('[data-rise]').value), fee = num(q('[data-fee]').value), disc = num(q('[data-disc]').value);
            q('[data-rise-out]').textContent = rise; q('[data-disc-out]').textContent = disc;
            root.querySelectorAll('[data-only]').forEach(function (el) { el.hidden = el.getAttribute('data-only') !== mode; });
            if (mode === 'ticket') {
              var extra = premium * rise / 100 * 3, cost = fee + course;
              q('[data-line-a]').textContent = 'Extra premium if convicted'; q('[data-val-a]').textContent = fmt(extra);
              q('[data-line-b]').textContent = 'Court fee + our course ($' + course + ')'; q('[data-val-b]').textContent = fmt(cost);
              q('[data-verdict]').textContent = extra > cost ? 'Dismissing costs $' + fmt(extra - cost) + ' less than a conviction.' : 'On these numbers, dismissal costs about the same. It still keeps your record clean.';
            } else {
              var saved = premium * disc / 100 * 3;
              q('[data-line-a]').textContent = 'Discount over 3 years'; q('[data-val-a]').textContent = fmt(saved);
              q('[data-line-b]').textContent = 'Our course'; q('[data-val-b]').textContent = course;
              q('[data-verdict]').textContent = saved > course ? 'You’d come out about $' + fmt(saved - course) + ' ahead.' : 'On these numbers, the course costs more than it saves.';
            }
          }
          var modes = root.querySelectorAll('[data-mode]');
          modes.forEach(function (b) { b.addEventListener('click', function () { mode = b.getAttribute('data-mode'); pick(modes, b); render(); }); });
          root.querySelectorAll('input').forEach(function (i) { i.addEventListener('input', render); });
          render();
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

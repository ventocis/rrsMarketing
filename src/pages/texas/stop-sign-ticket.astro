---
import TexasLayout from '../../layouts/TexasLayout.astro';
import CourseBand from '../../components/texas/CourseBand.astro';
import NextStepBlock from '../../components/texas/NextStepBlock.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;

// Rebuilt 2026-10-06 from Jackson's design canvas "Stop Sign Page Redesign" (artboard + search preview),
// implemented as the spec: his copy, order, the complete-stop cards, the "just the stop sign / plus a crash"
// picker, the three options, four steps, course band, quick answers. Facts unchanged from the previous version
// (Transp. Code §544.010 stop location, §542.401 $1–$200 fine range, §521.292 four-in-12-months suspension;
// Code Crim. Proc. arts. 45A.351–.353). "Check my ticket" is worded "Does my ticket qualify?" (house rule).
// The lead's video link points to our 0:57 four-steps video (canonical on the speeding page).

const faqs = [
  { q: 'Can I take defensive driving for a stop sign ticket in Texas?', a: 'Yes. Failure to stop (§544.010) has no special exclusions. The normal rules apply: Texas license, insurance, ask by your answer date, no course in the last 12 months.' },
  { q: 'How much is a stop sign ticket in Texas?', a: 'The fine is set locally within the $1–$200 range for these offenses, plus court costs. Paid, it typically lands around $200–$275.' },
  { q: 'Does a stop sign ticket raise insurance?', a: 'A conviction usually does, for about three years. A dismissed ticket never reaches your record. <a href="/texas/ticket-insurance-impact" class="text-primary-deep font-medium hover:underline">Insurance details</a>' },
  { q: 'Should I fight a rolling stop or take the course?', a: 'Fight it if you have dashcam footage of a full stop. Without evidence, the course is the near-certain way out.' },
  { q: 'I rolled a stop sign and got in a crash. Same answer?', a: 'No. Charges like failing to stop and give information or render aid are excluded from the course. Call the clerk, and consider a lawyer.' },
];
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Got a stop sign ticket in Texas? It’s one of the easiest to get dismissed.',
  description: 'A rolling stop qualifies for defensive driving, which keeps it off your record. What counts as a complete stop, what it costs, when to fight it, and the four steps.',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11', dateModified: '2026-10-06',
  mainEntityOfPage: `${siteUrl}/texas/stop-sign-ticket`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) });

const picks = [
  { k: 'bare', label: 'Just the stop sign', good: true, eyebrow: 'Textbook dismissal', title: 'You can likely get it dismissed.', body: 'No speed bars, no special exclusions. Ask your court for the course by your answer date, then take it once the court says yes.', cta: ['/texas/request-defensive-driving', 'How to ask the court →'], cta2: [enrollUrl, `Already approved? ${price} course`] },
  { k: 'crash', label: 'Stop sign + a crash', good: false, eyebrow: 'Different situation', title: 'A crash changes the answer.', body: 'Charges that often come with it, like failing to stop and give information or render aid, are excluded from the course. Judges look harder at crash cases. Call the clerk about your options, and consider a lawyer.', cta: ['/texas/fight-or-dismiss', 'See your other options →'], cta2: ['/texas/courts', 'Find your court'] },
];
const steps = [
  { n: 1, t: 'Ask the court', b: 'Don’t pay first. <a href="/texas/request-defensive-driving" class="text-primary hover:text-primary-deep font-medium">How to ask</a>', when: 'By your answer date' },
  { n: 2, t: 'Get approved', b: 'Pay the court’s fee when it says yes.', when: '' },
  { n: 3, t: 'Take the course', b: `${TEXAS_COURSE.hours} hours online. ${price} with us.`, when: 'Within 90 days', us: true },
  { n: 4, t: 'Send it in', b: 'Certificate plus <a href="/texas/type-3a-driving-record" class="text-primary hover:text-primary-deep font-medium">Type 3A record</a>. Dismissed.', when: '' },
];
const nextSteps = [
  ['/texas/request-defensive-driving', 'Ask the court for the course', 'With a letter template →'],
  ['/texas/eligibility-tracker', 'Check every condition', 'Eligibility in 4 questions →'],
  ['/texas/red-light-ticket', 'Got a red light ticket too?', 'Same idea, different rules →'],
  ['/texas/ticket-dismissal', 'The whole process', 'Texas ticket dismissal guide →'],
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
const link = 'text-primary hover:text-primary-deep font-medium';
---

{isEnabled ? (
  <TexasLayout
    title="Texas Stop Sign Ticket: Can You Get It Dismissed?"
    description="Usually yes. A rolling stop qualifies for defensive driving, which keeps it off your record. What it costs, when to fight it, and the 4 steps."
    keywords="stop sign ticket texas, rolling stop ticket texas, dismiss stop sign ticket, 544.010 texas, failure to stop at stop sign texas, how much is a stop sign ticket in texas"
    url="/texas/stop-sign-ticket"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><a href="/texas/speeding-ticket" class="text-text-body hover:underline">Speeding ticket guide</a><span class="mx-1.5">›</span><span>Stop sign tickets</span></p>
        <div class="max-w-[820px] pt-8 pb-11">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>Got a stop sign ticket in Texas? It's one of the easiest to get dismissed.</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">A rolling stop is a standard moving violation with none of the speed limits that trip up speeding tickets. If you qualify, a {TEXAS_COURSE.hours}-hour course gets it dismissed, and by law it never touches your record.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">So should you fight it instead? Probably not, unless you have one specific thing. First, the question everyone asks the officer.</p>
          <div class="flex flex-wrap gap-3 items-center">
            <a href="#check" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold text-[17px] px-6 py-3.5 rounded-full">Does my ticket qualify? ↓</a>
            <a href="#video" class="font-semibold text-primary hover:text-primary-deep">▶ Watch: dismiss it in 4 steps (0:57)</a>
          </div>
          <p class="text-[15px] text-text-muted m-0 mt-6">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber} · Checked against Tex. Transp. Code §§542.401, 544.010 and Tex. Code Crim. Proc. arts. 45A.351–.353 · Updated October 6, 2026</p>
        </div>
      </div>

      <!-- ===== Complete stop ===== -->
      <section class="bg-white border-y border-border">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={inter}>What counts as a complete stop in Texas?</h2>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Wheels fully stopped, at the first of these that exists (Transp. Code §544.010). There's no "basically stopped" in the law. Rolling at walking speed is citable.</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            {[['1st', 'At the stop line', 'If there’s a painted line, stop there.', true], ['2nd', 'Before the crosswalk', 'No line? Stop before the crosswalk.', false], ['3rd', 'Before the intersection', 'Neither one? Stop before you enter it.', false]].map(([n, t, b, hl]) => (
              <div class={`rounded-2xl p-[22px] ${hl ? 'bg-info border-2 border-primary' : 'bg-white border border-border'}`}>
                <p class="text-[28px] font-extrabold text-primary leading-none m-0 mb-1.5" style={inter}>{n}</p>
                <p class="font-bold text-[19px] m-0">{t}</p>
                <p class="text-[15px] text-text-body m-0">{b}</p>
              </div>
            ))}
          </div>
          <p class="text-base leading-7 m-0 mt-5 max-w-[780px]">Arguing "I almost stopped" won't win. The good news is you don't need to win. You need to know if your ticket qualifies.</p>
        </div>
      </section>

      <!-- Path-to-purchase test (#182): restored after the canvas redesign dropped it. Keep until the R2 read. -->
      <div class={wrap}><div class="max-w-[780px]"><NextStepBlock page="stop-sign-ticket" lead="precourt" /></div></div>

      <!-- ===== Picker ===== -->
      <section id="check" class={`${wrap} pt-16 pb-6 scroll-mt-28`} data-picker>
        <h2 class={h2c} style={inter}>Can your stop sign ticket be dismissed?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Usually yes. The one thing that changes it is a crash. What's on your citation?</p>
        <div class="flex flex-wrap gap-2.5 mb-5">
          {picks.map((p, i) => <button type="button" data-pick={p.k} aria-pressed={i === 0 ? 'true' : 'false'} class={`font-bold text-[17px] min-h-[48px] px-5 rounded-full border-2 transition-colors ${i === 0 ? pillOn : pillOff}`}>{p.label}</button>)}
        </div>
        {picks.map((p, i) => (
          <div data-panel={p.k} hidden={i !== 0}>
            <div class={`rounded-2xl border p-6 lg:p-7 max-w-[860px] flex flex-col gap-3 ${p.good ? 'bg-info border-info-border' : 'bg-amber-50 border-amber-200'}`}>
              <p class={`text-sm font-bold uppercase tracking-[0.06em] m-0 ${p.good ? 'text-primary-deep' : 'text-amber-800'}`}>{p.eyebrow}</p>
              <p class="text-[24px] lg:text-[26px] font-extrabold leading-[1.2] m-0" style={inter}>{p.title}</p>
              <p class="text-[17px] text-text-body leading-7 m-0">{p.body}</p>
              <div class="flex flex-wrap gap-3 items-center">
                <a href={p.cta[0]} class="no-underline bg-primary hover:bg-primary-hover text-white font-bold px-[22px] py-3 rounded-full">{p.cta[1]}</a>
                <a href={p.cta2[0]} class="font-semibold text-primary hover:text-primary-deep">{p.cta2[1]}</a>
              </div>
            </div>
          </div>
        ))}
        <div class="flex flex-wrap gap-x-[22px] gap-y-2.5 mt-[18px] text-base text-text-body">
          <span>You'll also need:</span><span>✓&nbsp; A valid Texas license</span><span>✓&nbsp; Proof of insurance</span><span>✓&nbsp; To ask by your answer date</span><span>✓&nbsp; No course in the <a href="/texas/12-month-rule" class={link}>last 12 months</a></span>
        </div>
      </section>

      <!-- ===== Three options ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>Dismiss it, pay it, or fight it?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Paying looks cheapest today. It's the most expensive over three years.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="rounded-2xl bg-primary text-white p-6 flex flex-col gap-2">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-info-border">The sure thing</span>
            <span class="text-[24px] font-extrabold leading-tight" style={inter}>Dismiss it</span>
            <span class="text-base text-info leading-6">Court fee (often ~$144) + {price} course + $12 record. Then it's gone from your record.</span>
            <span class="font-bold mt-auto">Off your record · you control it</span>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">The expensive souvenir</span>
            <span class="text-[24px] font-extrabold leading-tight" style={inter}>Pay it</span>
            <span class="text-base text-text-body leading-6">Typically $200–$275 with court costs. Plus a conviction your insurer sees for about three years, and one step toward a suspension (4 in 12 months).</span>
            <span class="font-bold text-amber-800 mt-auto">On your record</span>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">Only with proof</span>
            <span class="text-[24px] font-extrabold leading-tight" style={inter}>Fight it</span>
            <span class="text-base text-text-body leading-6">Your word against the officer's. Worth it with dashcam footage of a full stop or a real procedural defect. Lose, and the sure thing is gone.</span>
            <span class="font-bold mt-auto">A coin flip</span>
          </div>
        </div>
        <a href="/texas/fight-or-dismiss" class="inline-block mt-4 font-bold text-primary hover:text-primary-deep">Fight it or take the course? The full comparison →</a>
      </section>

      <!-- ===== Steps ===== -->
      <section id="steps" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>How do you get it dismissed?</h2>
        <p class="text-base leading-7 m-0 mb-7 max-w-[780px]">Four steps. The order matters: ask the court before you take the course.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 list-none p-0 m-0">
          {steps.map((s) => (
            <li class={`rounded-[14px] p-5 flex flex-col gap-1.5 ${s.us ? 'bg-primary text-white' : 'bg-white border border-border'}`}>
              <span class={`text-[28px] font-extrabold leading-none ${s.us ? 'text-info-border' : 'text-primary'}`} style={inter}>{s.n}</span>
              <span class="font-bold">{s.t}</span>
              <span class={`text-[15px] leading-6 ${s.us ? 'text-info' : 'text-text-body'}`} set:html={s.b} />
              {s.when && <span class={`text-sm font-bold mt-auto ${s.us ? '' : 'text-primary-deep'}`}>{s.when}</span>}
            </li>
          ))}
        </ol>
        <div id="video" class="mt-8 max-w-[800px] scroll-mt-28"><VideoEmbed id="GDdhttCVEkY" /></div>
      </section>
      <CourseBand />

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7" set:html={f.a} /></div>)}
        </div>
      </section>

      <!-- ===== Next step + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Your next step</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
          {nextSteps.map(([href, t, s]) => <a href={href} class="no-underline text-text rounded-[14px] border border-border bg-white p-4 hover:border-primary-deep"><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{s}</span></a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">General information, not legal advice. Procedures vary by court and judge; confirm with the court on your citation. Road Ready Safety is a TDLR-licensed course provider ({TEXAS_COURSE.providerNumber}), not a court. Sources: Tex. Transp. Code §544.010 (stop location), §542.401 (fine range), §521.292 (habitual violator); Tex. Code Crim. Proc. arts. 45A.351–.353 (eligibility and exclusions). Last updated October 6, 2026.</p>
      </section>

      <StickyCta afterId="check" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-picker]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          var btns = root.querySelectorAll('[data-pick]'), panels = root.querySelectorAll('[data-panel]');
          btns.forEach(function (b) { b.addEventListener('click', function () {
            var k = b.getAttribute('data-pick');
            btns.forEach(function (x) { var sel = x === b; x.setAttribute('aria-pressed', sel ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, sel); }); off.forEach(function (c) { x.classList.toggle(c, !sel); }); });
            panels.forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== k; });
          }); });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

---
/**
 * FeaturedCourses — a direct route to checkout from the root homepage.
 *
 * WHY: homepage visitors are mostly brand searchers who arrived ready to buy,
 * about half of them in Texas, and Texas is the only course on sale. Without
 * this card their path is state dropdown → reason dropdown → "Find course" →
 * /texas → buy button. The card makes it one tap, and leaves the finder
 * untouched underneath for everyone else.
 *
 * FLAG: renders only when VITE_HOME_FEATURED_COURSES === 'true'. On in QA, not
 * set in production — turn it on there once checkout has had a stable week, so
 * a bad checkout week cannot be misread as the card failing.
 *
 * MEASUREMENT: the primary button pushes `enroll_click` with
 * cta_location 'home_featured' to the GTM dataLayer. Even before GTM is
 * configured to receive it, a GA4 path of "/" → /public/checkout with no /texas
 * in between can only have come from this button. Baseline to beat: the
 * homepage converted 17–18% of visits to purchases, June–mid-September 2026.
 */
import { FEATURED_COURSES } from '../data/featured-courses';

const enabled = import.meta.env.VITE_HOME_FEATURED_COURSES === 'true';
// Vite only substitutes env vars that are read by their literal name, so a
// dynamic import.meta.env[key] lookup silently yields undefined and every button
// would fall back to the course page. Map each course id to its literal here.
const ENROLL_URLS: Record<string, string | undefined> = {
  'tx-bdi': import.meta.env.VITE_TEXAS_ENROLLMENT_URL,
};
const courses = FEATURED_COURSES.map((c) => ({
  ...c,
  enrollUrl: ENROLL_URLS[c.id] || c.enrollFallback,
}));
---

{enabled && courses.length > 0 && (
  <div class:list={["grid gap-4 mb-4", courses.length > 1 && "sm:grid-cols-2"]} style="font-family: 'Inter', sans-serif;">
    {courses.map((c) => (
      <div class="bg-white border-2 border-primary rounded-[12px] p-5 text-left" style="box-shadow: 0px 1px 2px 0px rgba(16, 24, 40, 0.05);">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
          <span class="bg-info text-info-text text-xs font-semibold leading-4 px-2.5 py-1 rounded-full">{c.badge}</span>
          <span class="text-xs leading-4 text-text-body">{c.credential}</span>
        </div>
        <h2 class="text-xl leading-[30px] font-medium text-text mb-1">{c.name}</h2>
        <p class="text-sm leading-5 text-text-body mb-4">{c.facts}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={c.enrollUrl}
            data-featured-enroll={c.id}
            class="bg-primary hover:bg-primary-hover text-white h-12 px-6 rounded-[12px] text-base font-semibold inline-flex items-center justify-center no-underline transition-colors"
          >
            Start now &mdash; ${c.price}
          </a>
          <a
            href={c.learnMoreHref}
            class="border border-border hover:border-primary text-text h-12 px-6 rounded-[12px] text-base font-medium inline-flex items-center justify-center no-underline transition-colors bg-white"
          >
            Learn more
          </a>
        </div>
      </div>
    ))}
  </div>
)}

{enabled && (
  <script is:inline>
    (function () {
      if (window.__rrsFeaturedTagged) return;
      window.__rrsFeaturedTagged = true;
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest && e.target.closest('a[data-featured-enroll]');
        if (!link) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'enroll_click',
          cta_location: 'home_featured',
          course_id: link.getAttribute('data-featured-enroll'),
        });
      });
    })();
  </script>
)}

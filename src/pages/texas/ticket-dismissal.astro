---
import TexasLayout from '../../layouts/TexasLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { courtStats as S } from '../../lib/court-stats';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import reviews from '../../data/texas-reviews.json';
import { alternatesFor, translationsOf, langLabel } from '../../lib/i18n';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const alternates = alternatesFor('/texas/ticket-dismissal');
const translations = translationsOf('/texas/ticket-dismissal');
const price = TEXAS_PRICE_LABEL;
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const review = reviews.find((r: any) => r.name === 'Ryan Johnson');

// Rebuilt 2026-10-06 from Jackson's design canvas "Ticket Dismissal Redesign" (Main.dc.html + Serp.dc.html),
// implemented as the spec: his copy, section order, the four-question check, CTAs. Flagged deviations: "Check
// my ticket" is worded "Does my ticket qualify?" (house rule); the refund chip matches our policy (full refund
// within the three-day cancellation window); the court fee range prints from court-stats.ts. The 294,534
// figure (tickets dismissed with a course, FY2024) is the Office of Court Administration number already used
// on /texas/defensive-driving-statistics and the translated versions of this page.

const faqs = [
  { q: 'Can a defensive driving course dismiss a ticket in Texas?', a: 'Yes. If you qualify and ask by the appearance date, the court must dismiss an eligible moving violation once you finish a TDLR-approved course and submit the certificate and record (Code Crim. Proc. ch. 45A).' },
  { q: 'Can I do the whole thing online?', a: 'Often. Many courts take requests by email or portal since September 2025, the course is online, and courts like Harris County JP handle filing through portals. Others still want paper.' },
  { q: 'Can one course dismiss more than one ticket?', a: 'Only for charges from the same stop. Since September 1, 2025, one course can dismiss several eligible charges from one stop. Separate stops are limited to once every 12 months. <a href="/texas/multiple-tickets" class="text-primary-deep font-medium hover:underline">Multiple tickets</a>' },
  { q: 'What happens after it’s dismissed?', a: 'It’s gone from your driving record and can’t be used for any purpose. Keep the court’s notice and your certificate for a year in case your insurer asks.' },
  { q: 'Does Texas still use points?', a: 'No, not since 2019. What dismissal protects is the conviction on your record, which is what insurers price on.' },
  { q: 'Did the law change in 2025?', a: 'Yes. The rules moved from art. 45.0511 to chapter 45A on January 1, 2025, and from September 1, 2025 courts can take requests by mail, email or portal. A site still citing 45.0511 is out of date.' },
];
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const steps = [
  { n: 1, t: 'Don’t pay the ticket', b: 'Paying is a plea. Once it’s a conviction, there’s nothing to dismiss.', when: '', us: false },
  { n: 2, t: 'Ask the court', b: 'In person, certified mail, or the court’s email or portal.', when: 'By the appearance date', us: false },
  { n: 3, t: 'Send what it needs', b: 'License, insurance, court fee, and a $12 Type 3A record.', when: '', us: false },
  { n: 4, t: 'Take the course', b: `${TEXAS_COURSE.hours} hours, online. ${price} with us, certificate included.`, when: 'Within 90 days', us: true },
  { n: 5, t: 'Submit, then it’s dismissed', b: 'Certificate, record and any affidavit your court requires.', when: '', us: false },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'How to get a Texas ticket dismissed with a 6-hour course',
  description: 'Get a Texas ticket dismissed and kept off your record with a 6-hour course. Whether yours qualifies, the five steps in order, the two deadlines, and what it costs.',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11', dateModified: '2026-10-06',
  mainEntityOfPage: `${siteUrl}/texas/ticket-dismissal`,
});
const howToSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'How to get a Texas ticket dismissed with a driving safety course', step: steps.map(s => ({ '@type': 'HowToStep', name: s.t, text: s.when ? `${s.b} (${s.when}.)` : s.b })) });
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })) });

const questions = [
  { k: 'license', text: 'Do you have a valid Texas driver license? (Active-duty military and their families can use any state’s.)' },
  { k: 'excluded', text: 'Was it 25+ over, 95+ mph, in a work zone with workers, passing a school bus, or leaving a crash?' },
  { k: 'cdl', text: 'Do you hold a CDL, or did you when you got the ticket?' },
  { k: 'recent', text: 'Have you used a dismissal course in the 12 months before this ticket?' },
];
const warn = { panel: 'bg-[#F6F6F9] border-[#CBD3DF]', eye: 'text-text-body' };
const results = [
  { k: 'default', panel: 'bg-white border-border', eye: 'text-text-muted', eyebrow: 'Your result', title: 'Answer all four to see your route.', body: 'Most everyday moving violations qualify.', cta: ['/texas/eligibility-tracker', 'Or use the full eligibility checker →'] },
  { k: 'cdl', ...warn, eyebrow: 'Course not available', title: 'CDL holders can’t dismiss with a course.', body: 'Federal rules keep moving violations on a CDL record, even in a personal car.', cta: ['/texas/cdl-defensive-driving', 'What works for CDL drivers →'] },
  { k: 'excluded', ...warn, eyebrow: 'Course not available', title: 'This ticket is excluded by law.', body: 'For 25+ over or 95+, ask about deferred disposition. Work-zone tickets with workers present are barred from both.', cta: ['/texas/speeding-25-over', 'See what still works →'] },
  { k: 'recent', ...warn, eyebrow: 'Too soon for another course', title: 'You’ve used it in the last 12 months.', body: 'Deferred disposition is usually the route for a second ticket. Ask your court before the appearance date.', cta: ['/texas/deferred-disposition', 'How deferred disposition works →'] },
  { k: 'license', ...warn, eyebrow: 'Check with your court', title: 'The course needs a Texas license.', body: 'Unless you’re active-duty military or family, out-of-state drivers usually go the deferred route.', cta: ['/texas/out-of-state-driver', 'Out-of-state drivers →'] },
  { k: 'ok', panel: 'bg-info border-info-border', eye: 'text-primary-deep', eyebrow: 'Good news', title: 'Your ticket likely qualifies.', body: 'Ask your court for the course by the appearance date on your ticket. Once it says yes, the course is the easy part.', cta: ['/texas/request-defensive-driving', 'How to ask the court →'] },
];

const types = [
  ['/texas/speeding-ticket', 'Speeding'], ['/texas/speeding-25-over', '25+ over'], ['/texas/red-light-ticket', 'Red light'], ['/texas/stop-sign-ticket', 'Stop sign'], ['/texas/cell-phone-ticket', 'Cell phone'], ['/texas/seat-belt-ticket', 'Seat belt'], ['/texas/child-seat-ticket', 'Child seat'], ['/texas/school-zone-ticket', 'School zone'], ['/texas/construction-zone-ticket', 'Construction zone'], ['/texas/no-insurance-ticket', 'No insurance'], ['/texas/expired-registration-ticket', 'Expired registration'], ['/texas/expired-license-ticket', 'Expired license'], ['/texas/equipment-violation-ticket', 'Equipment'], ['/texas/motorcycle-ticket', 'Motorcycle'], ['/texas/cdl-defensive-driving', 'CDL'], ['/texas/under-25-ticket', 'Under 25'], ['/texas/minor-traffic-ticket', 'Minors'], ['/texas/out-of-state-driver', 'Out-of-state drivers'], ['/texas/multiple-tickets', 'Several tickets, one stop'], ['/texas/court-appearance', 'Do I have to appear in court?'], ['/texas/traffic-ticket-report', 'Texas Traffic Ticket Report'],
];
const metros = [['houston', 'Houston'], ['dallas', 'Dallas'], ['fort-worth', 'Fort Worth'], ['san-antonio', 'San Antonio'], ['austin', 'Austin'], ['tyler', 'Tyler']];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5 lg:p-[22px]';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
const link = 'text-primary hover:text-primary-deep font-medium';
---

{isEnabled ? (
  <TexasLayout
    title="Texas Ticket Dismissal: 5 Steps, Deadlines & Who Qualifies"
    description="Get a Texas ticket dismissed and kept off your record with a 6-hour course. Check if yours qualifies, the steps in order, and the deadline people miss."
    keywords="texas ticket dismissal, dismiss traffic ticket texas, defensive driving ticket dismissal texas, driving safety course dismissal, how to get a ticket dismissed in texas, texas ticket dismissal requirements"
    url="/texas/ticket-dismissal"
    alternates={alternates}
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={howToSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <div class="flex flex-wrap justify-between gap-2 text-[15px] text-text-body pt-5">
          <span><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span>Ticket dismissal</span>
          {translations.length > 0 && <span>Also in: {translations.map((t, i) => <><a href={`/texas/${t.slug}`} hreflang={t.lang} lang={t.lang} class="text-text-body hover:underline">{langLabel(t.lang)}</a>{i < translations.length - 1 && ' · '}</>)}</span>}
        </div>
        <div class="max-w-[820px] pt-8 pb-10">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>How to get a Texas ticket dismissed with a 6-hour course</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">Ask your court for a driving safety course by the appearance date on your ticket, pay the court's fee, finish the course within 90 days, and send in the certificate. The court dismisses the charge, and by law it can't appear on your driving record.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">Simple, but only in the right order. The mistake we see most is taking the course <strong>before</strong> the court says yes. First, make sure your ticket qualifies.</p>
          <div class="flex flex-wrap gap-3 items-center">
            <a href="#check" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold text-[17px] px-6 py-3.5 rounded-full">Does my ticket qualify? ↓</a>
            <a href="#video" class="font-semibold text-primary hover:text-primary-deep">▶ Watch: dismiss it in 4 steps (0:57)</a>
          </div>
          <p class="text-[15px] text-text-muted m-0 mt-6">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber}. We run one of the approved courses and track how roughly 1,700 Texas courts handle dismissal. · Checked against Tex. Code Crim. Proc. ch. 45A · Updated October 6, 2026</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pb-12">
          {[['294,534', 'Texas tickets dismissed with a course in fiscal 2024 (Office of Court Administration)'], ['90 days', 'to finish the course once the court approves you'], ['0', 'convictions on your record when it’s dismissed']].map(([n, t]) => (
            <div class="rounded-[14px] border border-border bg-white p-5"><p class="text-[30px] font-extrabold text-primary leading-none m-0 mb-1.5" style={inter}>{n}</p><p class="text-[15px] text-text-body m-0">{t}</p></div>
          ))}
        </div>
      </div>

      <!-- ===== Three ways ===== -->
      <section class="bg-white border-y border-border">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={inter}>Which way off your record fits your ticket?</h2>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">There are three. Paying isn't one of them: it's a guilty plea and a conviction.</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="rounded-2xl bg-primary text-white p-6 flex flex-col gap-2">
              <span class="text-sm font-bold uppercase tracking-[0.06em] text-info-border">This page · you control it</span>
              <span class="text-[24px] font-extrabold leading-tight" style={inter}>Driving safety course</span>
              <span class="text-base text-info leading-6">If you qualify, it's your right by law. Finish the course and the court must dismiss it.</span>
            </div>
            <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
              <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">The judge decides</span>
              <span class="text-[24px] font-extrabold leading-tight" style={inter}>Deferred disposition</span>
              <span class="text-base text-text-body leading-6">Up to 180 days of probation, then dismissal. Takes tickets the course can't, like 25+ over. <a href="/texas/defensive-driving-vs-deferred-disposition" class={link}>Which should I choose?</a></span>
            </div>
            <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-2">
              <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">If you didn't earn it</span>
              <span class="text-[24px] font-extrabold leading-tight" style={inter}>Contest it</span>
              <span class="text-base text-text-body leading-6">Yourself or with a lawyer. Slower, and the result is never certain. <a href="/texas/fight-or-dismiss" class={link}>Fight it or take the course?</a></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== Four-question check ===== -->
      <section id="check" class={`${wrap} pt-16 pb-6 scroll-mt-28`} data-checker>
        <h2 class={h2c} style={inter}>Does your ticket qualify?</h2>
        <p class="text-base leading-7 m-0 mb-7 max-w-[780px]">Four questions. If all four line up, the court has to let you take the course.</p>
        <div class="flex flex-wrap gap-8">
          <div class="flex-[1_1_460px] min-w-0 flex flex-col gap-[22px]">
            {questions.map((q) => (
              <div class="flex flex-col gap-2.5">
                <p class="font-bold text-[17px] m-0">{q.text}</p>
                <div class="flex gap-2.5">
                  <button type="button" data-q={q.k} data-v="1" aria-pressed="false" class={`font-bold text-base min-h-[44px] min-w-[88px] px-[18px] rounded-full border-2 transition-colors ${pillOff}`}>Yes</button>
                  <button type="button" data-q={q.k} data-v="0" aria-pressed="false" class={`font-bold text-base min-h-[44px] min-w-[88px] px-[18px] rounded-full border-2 transition-colors ${pillOff}`}>No</button>
                </div>
              </div>
            ))}
            <p class="text-[15px] text-text-body bg-white border border-border rounded-xl p-4 m-0">Expired registration or no insurance? Those aren't dismissed with a course. Fix the problem and show proof instead. <a href="/texas/expired-registration-ticket" class={link}>Registration</a> · <a href="/texas/no-insurance-ticket" class={link}>Insurance</a></p>
          </div>
          <div class="flex-[1_1_380px] min-w-0">
            {results.map((r) => (
              <div data-result={r.k} hidden={r.k !== 'default'}>
                <div class={`rounded-2xl border p-6 lg:p-7 flex flex-col gap-3 ${r.panel}`}>
                  <p class={`text-sm font-bold uppercase tracking-[0.06em] m-0 ${r.eye}`}>{r.eyebrow}</p>
                  <p class="text-[24px] lg:text-[26px] font-extrabold leading-[1.2] m-0" style={inter}>{r.title}</p>
                  <p class="text-[17px] text-text-body leading-7 m-0">{r.body}</p>
                  <a href={r.cta[0]} class="mt-1.5 text-center no-underline bg-primary hover:bg-primary-hover text-white font-bold px-5 py-3 rounded-full">{r.cta[1]}</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== Five steps ===== -->
      <section id="steps" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>What are the five steps, in order?</h2>
        <p class="text-base leading-7 m-0 mb-7 max-w-[780px]">The order matters more than any single step. Course first, permission second, and the court won't count your certificate.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 list-none p-0 m-0">
          {steps.map((s) => (
            <li class={`rounded-[14px] p-5 flex flex-col gap-1.5 ${s.us ? 'bg-primary text-white' : 'bg-white border border-border'}`}>
              <span class={`text-[28px] font-extrabold leading-none ${s.us ? 'text-info-border' : 'text-primary'}`} style={inter}>{s.n}</span>
              <span class="font-bold">{s.t}</span>
              <span class={`text-[15px] leading-6 ${s.us ? 'text-info' : 'text-text-body'}`}>{s.b}</span>
              {s.when && <span class={`text-sm font-bold mt-auto ${s.us ? '' : 'text-primary-deep'}`}>{s.when}</span>}
            </li>
          ))}
        </ol>
        <div class="flex flex-wrap gap-5 mt-[18px]">
          <a href="/texas/request-defensive-driving" class="font-bold text-primary hover:text-primary-deep">What to say to the court, with a letter template →</a>
          <a href="/texas/dismissal-timeline" class="font-bold text-primary hover:text-primary-deep">The calendar from ticket to dismissal →</a>
        </div>
        <div id="video" class="mt-8 max-w-[800px] scroll-mt-28"><VideoEmbed id="GDdhttCVEkY" /></div>
      </section>

      <!-- ===== Deadlines ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>What are the deadlines?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Two, and the first is the one people miss.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border-2 border-primary bg-white p-6">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep">Deadline 1 · the one people miss</span>
            <p class="text-[24px] font-extrabold leading-tight m-0 my-1.5" style={inter}>Ask by your appearance date</p>
            <p class="text-base text-text-body leading-6 m-0">It's printed on your ticket. Miss it and the court can refuse the course. Some courts set their own paperwork deadlines from 10 to 180 days. <a href="/texas/dsc-deadlines-by-court" class={link}>Deadlines by court</a></p>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-text-muted">Deadline 2</span>
            <p class="text-[24px] font-extrabold leading-tight m-0 my-1.5" style={inter}>Finish within 90 days</p>
            <p class="text-base text-text-body leading-6 m-0">Counted from the day the court grants the course. Leave a cushion: TDLR says a new certificate can take up to 5 days to show in its system.</p>
          </div>
        </div>
      </section>

      <!-- ===== Why denied ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>Why do courts deny the course?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Either the law rules it out, or the paperwork went wrong. You can't change the first list. You can avoid everything on the second.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[19px] m-0 mb-3">Ruled out by law</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-base text-text-body">
              <li>✕&nbsp; Asked after the appearance date</li>
              <li>✕&nbsp; Used a course in the 12 months before this offense <a href="/texas/12-month-rule" class={link}>How it counts</a></li>
              <li>✕&nbsp; No valid Texas license (military excepted) <a href="/texas/out-of-state-driver" class={link}>Out of state?</a></li>
              <li>✕&nbsp; No insurance at the time of the offense</li>
              <li>✕&nbsp; 25+ over, 95+ mph, work zone with workers, school bus, leaving the scene</li>
              <li>✕&nbsp; Holds or held a CDL <a href="/texas/cdl-defensive-driving" class={link}>CDL guide</a></li>
            </ul>
          </div>
          <div class="rounded-2xl border border-info-border bg-info p-6">
            <p class="font-bold text-[19px] m-0 mb-3">Avoidable paperwork mistakes</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-base text-text-body">
              <li>✓&nbsp; Don't pay the fine first <a href="/texas/already-paid-ticket" class={link}>Already paid?</a></li>
              <li>✓&nbsp; Don't take the course before approval</li>
              <li>✓&nbsp; Send the certified Type 3A, not Type 3 or 2A <a href="/texas/type-3a-driving-record" class={link}>Order it</a></li>
              <li>✓&nbsp; Include the court copy and any notarized affidavit <a href="/texas/notarized-affidavit" class={link}>Which courts</a></li>
              <li>✓&nbsp; Ask for an extension before the deadline runs out</li>
              <li>✓&nbsp; Leave 5 days for the certificate to validate <a href="/texas/certificate-rejected" class={link}>Rejected?</a></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ===== Cost ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How much does dismissal cost?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">About ${144 + 12 + TEXAS_COURSE.price} at the most common court fee. Paying the ticket usually costs about the same up front, plus a conviction your insurer can see for three years.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 max-w-[860px]">
          <div class={card}><p class="text-[15px] text-text-muted m-0">Court fee</p><p class="text-[32px] font-extrabold leading-none m-0 my-1.5" style={inter}>~$144</p><p class="text-[15px] text-text-body m-0">${S.fee.min}–${S.fee.max} across courts we've verified. $169 is typical in school zones.</p></div>
          <div class={card}><p class="text-[15px] text-text-muted m-0">Type 3A record</p><p class="text-[32px] font-extrabold leading-none m-0 my-1.5" style={inter}>$12</p><p class="text-[15px] text-text-body m-0">Online from DPS, if the court asks you to order it.</p></div>
          <div class="rounded-[14px] border border-info-border bg-info p-5 lg:p-[22px]"><p class="text-[15px] text-primary-deep m-0">The course</p><p class="text-[32px] font-extrabold text-primary leading-none m-0 my-1.5" style={inter}>{price}</p><p class="text-[15px] text-text-body m-0">All-in with us. {floor} is the legal minimum. Check for certificate fees elsewhere.</p></div>
        </div>
        <a href="/texas/cost" class="inline-block mt-4 font-bold text-primary hover:text-primary-deep">Work out your exact total →</a>
      </section>

      <!-- ===== Your court ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How does your court handle it?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">The law is statewide. The paperwork isn't. Three things to know before you send anything:</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
          <div class={card}><p class="font-bold text-[18px] m-0 mb-1.5">Some courts are e-file only</p><p class="text-base text-text-body leading-6 m-0">Harris County's justice courts and Dallas County JP 1-1 don't take paper. A mailed letter wastes your deadline.</p></div>
          <div class={card}><p class="font-bold text-[18px] m-0 mb-1.5">Some want a notarized affidavit</p><p class="text-base text-text-body leading-6 m-0">A minority of courts require a sworn statement with the certificate. <a href="/texas/notarized-affidavit" class={link}>See the list</a></p></div>
          <div class={card}><p class="font-bold text-[18px] m-0 mb-1.5">City court or JP court?</p><p class="text-base text-text-body leading-6 m-0">City police tickets go to municipal court. Sheriff and trooper tickets usually go to a JP court. <a href="/texas/municipal-vs-jp-court" class={link}>Which is yours?</a></p></div>
        </div>
        <div class="flex flex-wrap gap-2.5 mt-5">
          <a href="/texas/courts" class="no-underline bg-primary hover:bg-primary-hover text-white rounded-full px-[18px] py-2 font-semibold">Search all Texas courts</a>
          {metros.map(([slug, name]) => <a href={`/texas/${slug}`} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-text hover:border-primary-deep">{name}</a>)}
        </div>
      </section>

      <!-- ===== Course band ===== -->
      <section id="course" class={`${wrap} py-14 scroll-mt-28`}>
        <div class="rounded-3xl bg-primary-deep text-white px-6 py-12 lg:px-8 lg:py-14 flex flex-col items-center text-center gap-7">
          <div class="flex flex-col gap-2.5 max-w-[680px]">
            <span class="text-sm font-bold uppercase tracking-[0.08em] text-info-border">Approved? The course is the easy part</span>
            <h2 class="text-[30px] lg:text-[40px] font-extrabold leading-[1.1] m-0" style={inter}>{TEXAS_COURSE.hours} hours online. {price} total. Certificate the moment you finish.</h2>
          </div>
          {review && (
            <div class="rounded-[18px] bg-white text-text px-7 py-7 max-w-[640px] w-full flex flex-col gap-3">
              <span class="text-accent text-[22px] tracking-[3px]" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
              <blockquote class="m-0 text-[19px] lg:text-[21px] font-bold leading-[1.45]" style={inter}>"{review.quote}"</blockquote>
              <div class="flex items-center gap-3 text-left">
                <span class="w-10 h-10 rounded-full bg-primary text-white font-bold text-[15px] flex items-center justify-center" aria-hidden="true">{review.initials}</span>
                <span class="flex flex-col text-[15px] leading-[1.35]"><strong>{review.name}</strong><span class="text-text-muted">{review.verified ? 'Verified via Trustpilot' : 'Trustpilot'} · {review.date}</span></span>
              </div>
            </div>
          )}
          <ul class="flex flex-wrap justify-center gap-2.5 list-none p-0 m-0 max-w-[820px]">
            {[`${price} all-in, nothing added`, `TDLR-approved · ${TEXAS_COURSE.providerNumber}`, 'Court copy the moment you finish', 'Full refund within three days of enrolling'].map((t) => <li class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-2 text-[15px]"><span class="text-info-border font-extrabold" aria-hidden="true">✓</span>{t}</li>)}
          </ul>
          <div class="flex flex-col items-center gap-3">
            <a href={enrollUrl} class="no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-8 py-4 rounded-full" style={inter}>Start the {price} course →</a>
            <a href="#check" class="no-underline text-white hover:underline">Not approved yet? See if your ticket qualifies first</a>
          </div>
        </div>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7" set:html={f.a} /></div>)}
        </div>
      </section>

      <!-- ===== Ticket types + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Find your ticket type</p>
        <div class="flex flex-wrap gap-2 mb-7">
          {types.map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-3.5 py-1.5 text-[15px] text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">General information, not legal advice. Fees, forms and deadlines are set by each court; confirm with the court on your citation. Road Ready Safety is a TDLR-licensed course provider ({TEXAS_COURSE.providerNumber}), not a court. Sources: Tex. Code Crim. Proc. arts. 45A.351–.359; 49 CFR 384.226; Tex. Educ. Code §1001.352; Texas DPS; Office of Court Administration court activity data; our verified court dataset, refreshed August 2026. Last updated October 6, 2026.</p>
      </section>

      <StickyCta afterId="check" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-checker]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          var s = {}, btns = root.querySelectorAll('[data-q]'), panels = root.querySelectorAll('[data-result]');
          function key() {
            if (s.cdl === true) return 'cdl'; if (s.excluded === true) return 'excluded'; if (s.recent === true) return 'recent'; if (s.license === false) return 'license';
            if (s.license === true && s.excluded === false && s.cdl === false && s.recent === false) return 'ok'; return 'default';
          }
          btns.forEach(function (b) { b.addEventListener('click', function () {
            var q = b.getAttribute('data-q'); s[q] = b.getAttribute('data-v') === '1';
            btns.forEach(function (x) { if (x.getAttribute('data-q') !== q) return; var sel = x === b; x.setAttribute('aria-pressed', sel ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, sel); }); off.forEach(function (c) { x.classList.toggle(c, !sel); }); });
            var k = key(); panels.forEach(function (p) { p.hidden = p.getAttribute('data-result') !== k; });
          }); });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

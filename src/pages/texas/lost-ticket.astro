---
import TexasLayout from '../../layouts/TexasLayout.astro';
import YouTubeCard from '../../components/YouTubeCard.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import { alternatesFor, translationsOf, langLabel } from '../../lib/i18n';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const alternates = alternatesFor('/texas/lost-ticket');
const translations = translationsOf('/texas/lost-ticket');
const price = TEXAS_PRICE_LABEL;

// Redesigned 2026-10-07 on Jackson's Dallas-mockup pattern (~/Claude/SEO/DESIGN-STANDARD.md): lead →
// router → "who stopped you" decides the court → the recovery steps as a graphic → what the clerk can
// tell you / what you don't need → protect the deadline → course band → quick answers. Every fact,
// FAQ and source from the previous version is kept; nothing added. Our #1 page by Google clicks
// (358 in 3 months); the reader has a deadline and no paper.

const faqs = [
  { q: 'How do I find my traffic ticket if I lost it in Texas?', a: "Work out the jurisdiction (city officer → that city's municipal court; deputy or DPS trooper → the county JP court), then search the court's online citation portal by name and date of birth, or call the clerk with your name, DOB, and license number. The clerk can give you the citation number, charge, and answer date." },
  { q: 'Is there a statewide ticket lookup for Texas?', a: 'No — Texas has roughly 1,700 independent municipal and JP courts and no unified citation database. Recovery is jurisdiction-first: identify the likely court from where the stop happened and who made it, then use that court\'s portal or clerk. Our court directory covers the contact details.' },
  { q: "What if I don't remember my citation number?", a: "You don't need it — courts can find your case by name and date of birth (a driver's license number helps). The citation number speeds things up but is never the only key. The clerk will read you everything that was on the paper." },
  { q: 'How long do I have before the lost ticket becomes a problem?', a: "The answer date on the citation — typically 10 to 21 days after the stop. Respond by then (a course request, a plea, or any appearance) and nothing is harmed by the lost paper. Miss it and the case escalates exactly as if you'd ignored it: FTA charge, possible warrant, renewal hold." },
  { q: "The stop was yesterday and the court can't find me — why?", a: 'Citations take a few business days to be filed and entered into court systems. Wait two or three days and search again, or call then. Use the gap productively: figure out the right court and how it takes course requests, so you can act the day the case appears.' },
  { q: 'Can I still do defensive driving with a lost ticket?', a: 'Absolutely — the option attaches to the case, not the paper. Recover the case details from the clerk, make your request by the answer date, and the path is identical: approval, course, certificate plus Type 3A record, dismissal. The paper was always just a reminder.' },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "Lost the Ticket? The Deadline Didn't Get Lost With It — Here's How to Find Everything",
  description: "Lost the citation? The deadline didn't get lost with it. How to identify which Texas court has your ticket, recover the citation number, and protect the dismissal option before the answer date passes.",
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11',
  dateModified: '2026-10-07',
  mainEntityOfPage: `${siteUrl}/texas/lost-ticket`,
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const steps = [
  { n: 1, t: 'Work out which court', b: 'Who stopped you decides it: a city officer means that city’s municipal court; a sheriff’s deputy or DPS trooper on a highway usually means the county justice of the peace court.', when: 'Today', us: false },
  { n: 2, t: 'Search the court’s portal', b: 'Most municipal courts and many JP courts have a citation search. Search by name and date of birth; no citation number needed.', when: 'Today, if the stop was 3+ business days ago', us: false },
  { n: 3, t: 'Call the clerk', b: 'Give your name, date of birth and driver license number. The clerk pulls the case, reads you the citation number and answer date, and tells you how to respond.', when: 'If the portal shows nothing', us: false },
  { n: 4, t: 'Still nothing? Two backstops', b: 'Call the law-enforcement agency’s records division; they can read the citation from their copy. Weeks later, an unresolved case surfaces as an OmniBase hold on your DPS record.', when: 'Before it finds you', us: false },
];

const outfit = "font-family:'Outfit',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[36px] font-extrabold tracking-[-0.02em] leading-[1.12] text-primary-navy m-0 mb-3';
const card = 'rounded-2xl border border-border bg-white p-5 flex flex-col gap-2 no-underline text-text hover:border-primary-deep transition-colors';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
---

{isEnabled ? (
  <TexasLayout
    title="Lost Your Texas Traffic Ticket? How to Find Your Court & Citation Number"
    description="Lost the citation? Every fact on it is recoverable in a day or two. Identify the court from who stopped you, search that court's portal by name and date of birth or call the clerk, and protect your dismissal deadline while you look."
    keywords="lost traffic ticket texas, find my ticket texas, lost citation number texas, what court is my ticket texas, look up traffic ticket texas"
    url="/texas/lost-ticket"
    alternates={alternates}
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-24 lg:pb-16" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={`${wrap} pt-8 lg:pt-12`}>
        <p class="text-sm text-text-body mb-4">
          <a href="/texas" class="text-primary-deep font-medium hover:underline">Texas defensive driving course</a>
          <span class="mx-2 text-text-subtle">›</span>
          <a href="/texas/speeding-ticket" class="text-primary-deep font-medium hover:underline">Speeding ticket guide</a>
          <span class="mx-2 text-text-subtle">›</span>
          <span class="text-text">Lost your ticket</span>
        </p>
        {translations.length > 0 && (
          <p class="text-xs text-text-body mb-6 flex flex-wrap items-center gap-1.5">
            <span class="text-text-subtle me-1">Also in:</span>
            {translations.map(t => <a href={`/texas/${t.slug}`} hreflang={t.lang} lang={t.lang} class="px-2 py-0.5 rounded-full border border-border text-text-body hover:border-primary-deep no-underline">{langLabel(t.lang)}</a>)}
          </p>
        )}
        <div class="max-w-[760px]">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] text-primary-navy m-0 mb-5" style={outfit}>Lost your Texas ticket? The deadline didn't get lost with it.</h1>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-3">The paper is gone, but three facts on it still run your life: <strong class="text-text">which court</strong>, <strong class="text-text">the citation number</strong>, and <strong class="text-text">the answer date</strong>, usually 10 to 21 days after the stop. Every one of them is recoverable in a day or two.</p>
          <p class="text-lg lg:text-[21px] text-text-body leading-8 m-0 mb-5">Miss that date because the ticket went through the wash and the consequences are the same as ignoring it on purpose: a failure-to-appear charge, a possible warrant, a license-renewal hold. So the lost paper costs you a phone call. <strong class="text-text">Only the lost deadline costs you the option.</strong></p>
          <p class="text-sm text-text-subtle m-0">By Road Ready Safety, TDLR-licensed provider {TEXAS_COURSE.providerNumber} · Procedures checked October 7, 2026</p>
        </div>

        <!-- ===== Router ===== -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8 mb-14">
          <a href="#find" class={card}>
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-amber-800">I can't find my ticket</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>Find my court and my deadline</span>
            <span class="text-primary-deep font-semibold">Start with who stopped you ↓</span>
          </a>
          <a href={enrollUrl} class="rounded-2xl border border-primary bg-primary p-5 flex flex-col gap-2 no-underline text-white hover:bg-primary-hover transition-colors">
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-info-border">Found it, and the court approved me</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>Take the course: {price} total</span>
            <span class="font-semibold">Start now →</span>
          </a>
          <a href="/texas/missed-court-date" class={card}>
            <span class="text-xs font-bold uppercase tracking-[0.06em] text-text-subtle">The date may have passed</span>
            <span class="text-[22px] font-bold leading-tight" style={outfit}>What happens after a missed date</span>
            <span class="text-primary-deep font-semibold">Fix it, fastest first →</span>
          </a>
        </div>
      </div>

      <!-- ===== Who stopped you ===== -->
      <section id="find" class="bg-surface-muted border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={outfit}>Which court has your ticket?</h2>
          <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Texas has roughly 1,700 independent municipal and JP courts and no statewide citation database, so the search is jurisdiction-first. Who stopped you narrows it to one or two courts immediately.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-3">
              <p class="text-xs font-bold uppercase tracking-[0.06em] text-primary-deep m-0">A city police officer stopped you</p>
              <p class="text-[22px] font-bold text-text m-0 leading-tight" style={outfit}>That city's municipal court</p>
              <p class="text-base text-text-body leading-7 m-0">Search the city's citation portal by name and date of birth, or call the clerk. The 25 largest cities' portals are on one page.</p>
              <a href="/texas/look-up-your-ticket" class="text-primary-deep font-semibold hover:underline mt-auto">Portals for the 25 largest Texas cities →</a>
            </div>
            <div class="rounded-2xl border border-border bg-white p-6 flex flex-col gap-3">
              <p class="text-xs font-bold uppercase tracking-[0.06em] text-primary-deep m-0">A sheriff's deputy or DPS trooper stopped you</p>
              <p class="text-[22px] font-bold text-text m-0 leading-tight" style={outfit}>The county justice of the peace court</p>
              <p class="text-base text-text-body leading-7 m-0">Highway stops outside city limits go to a JP precinct. The county plus the stretch of road usually points to one precinct; the clerk can confirm.</p>
              <a href="/texas/courts" class="text-primary-deep font-semibold hover:underline mt-auto">Our directory of 1,700+ Texas courts, with phone numbers →</a>
            </div>
          </div>
          <p class="text-sm text-text-subtle leading-6 m-0 mt-5 max-w-[760px]">Not sure which city or county? Think about the road, the agency on the officer's uniform or car, and the nearest town; then try the municipal court first and the county JP second. Clerks handle lost tickets constantly.</p>
        </div>
      </section>

      <!-- ===== Steps ===== -->
      <section id="steps" class={`${wrap} pt-14 pb-4 scroll-mt-28`}>
        <h2 class={h2c} style={outfit}>How do you find a ticket without the ticket?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">Four moves, fastest first. Most people are done at step two.</p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 list-none p-0 m-0">
          {steps.map((s) => (
            <li class="rounded-2xl p-5 flex flex-col gap-1.5 bg-white border border-border">
              <span class="text-[32px] font-extrabold leading-none text-primary-deep" style={outfit}>{s.n}</span>
              <span class="font-bold text-[18px]">{s.t}</span>
              <span class="text-sm leading-6 text-text-body">{s.b}</span>
              <span class="text-sm font-bold text-amber-800 mt-auto">{s.when}</span>
            </li>
          ))}
        </ol>
        <div class="mt-5 rounded-xl border border-amber-300 bg-amber-50 p-4 max-w-[760px] text-text leading-7"><strong>Stopped yesterday and the court can't find you?</strong> Citations take a few business days to be filed and entered. Try again in two or three days, and use the gap to learn how that court takes course requests, so you can act the day the case appears.</div>
      </section>

      <!-- ===== What the clerk can tell you / what you don't need ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>What do you need to recover, and what don't you?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-6 max-w-[760px]">The citation number speeds things up but is never the only key. Courts find a case by name and date of birth.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[18px] m-0 mb-3">The clerk can tell you</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-[17px]">
              {['Your citation number and the charge', 'Your answer date, the deadline that matters', 'How this court takes a driving safety course request', 'Whether you can make that request on the spot'].map((t) => <li class="flex gap-3"><span class="text-green-600 font-bold" aria-hidden="true">✓</span><span>{t}</span></li>)}
            </ul>
          </div>
          <div class="rounded-2xl border border-border bg-white p-6">
            <p class="font-bold text-[18px] m-0 mb-3">You don't need</p>
            <ul class="flex flex-col gap-2.5 list-none p-0 m-0 text-[17px]">
              {['The paper citation', 'The citation number, to start the search', 'Perfect information before you call', 'A new ticket: the option attaches to the case, not the paper'].map((t) => <li class="flex gap-3"><span class="text-text-subtle font-bold" aria-hidden="true">✕</span><span>{t}</span></li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ===== Protect the deadline ===== -->
      <section class={`${wrap} pt-12 pb-4`}>
        <h2 class={h2c} style={outfit}>How do you protect the dismissal option while you search?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-4 max-w-[760px]">The defensive driving request is due <strong class="text-text">on or before the answer date</strong>. If that window is closing while you hunt for the court, don't wait for perfect information. When you reach the right clerk, say you lost the citation and ask for two things: confirm the answer date, and take your course request on the spot or send the court's form that day. The request is what stops the clock.</p>
        <p class="text-base text-text-body leading-7 m-0 max-w-[760px]">Once you have the case in hand, everything proceeds normally: <a href="/texas/request-defensive-driving" class="text-primary-deep font-medium hover:underline">request</a>, approval, course, <a href="/texas/type-3a-driving-record" class="text-primary-deep font-medium hover:underline">Type 3A record</a>, dismissal. The whole route is on the <a href="/texas/ticket-dismissal" class="text-primary-deep font-medium hover:underline">ticket-dismissal guide</a>.</p>
      </section>

      <!-- ===== Course band ===== -->
      <section id="course" class={`${wrap} py-12 scroll-mt-28`}>
        <div class="rounded-[20px] bg-surface-dark text-white p-8 lg:p-10 flex flex-wrap gap-8 items-center justify-between">
          <div class="flex-[999_1_420px] min-w-0">
            <p class="text-xs font-bold uppercase tracking-[0.06em] text-amber-300 m-0 mb-2">Found the case and the court said yes? Lock it in today.</p>
            <h2 class="text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] m-0 mb-3" style={outfit}>The 6-hour Texas course. {price} all-in.</h2>
            <p class="m-0 text-info-border leading-7">TDLR-approved ({TEXAS_COURSE.providerNumber}) · Fully online · Accepted by every Texas court · Certificate downloads the moment you finish · Nothing added at checkout</p>
          </div>
          <a href={enrollUrl} class="flex-[1_1_220px] text-center no-underline bg-amber-400 hover:bg-amber-300 text-surface-dark font-extrabold text-lg px-7 py-4 rounded-xl" style={outfit}>Start the {price} course →</a>
        </div>
        <YouTubeCard id="FYfE_HmhKac" blurb="Finding your citation online when the paper is gone." />
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={outfit}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[760px] mt-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-white p-5">
              <h3 class="font-bold text-base m-0 mb-1 text-text" style={outfit}>{f.q}</h3>
              <p class="m-0 text-text-body leading-7" set:html={f.a} />
            </div>
          ))}
        </div>
      </section>

      <!-- ===== Keep reading + legal ===== -->
      <section class={`${wrap} pt-4 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Keep reading</p>
        <div class="flex flex-wrap gap-2.5 mb-7">
          {[
            ['/texas/look-up-your-ticket', 'Ticket lookup portals, city by city'],
            ['/texas/courts', 'Every Texas court, with contacts'],
            ['/texas/missed-court-date', 'Missed the date? What happens next'],
            ['/texas/request-defensive-driving', 'How to request the course'],
            ['/texas/ticket-dismissal', 'How ticket dismissal works'],
            ['/texas/what-is-a-driving-safety-course', 'What a driving safety course is'],
          ].map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-sm text-text-subtle m-0 max-w-[760px] leading-6">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). This page is informational and not legal advice; procedures vary by court and judge, so confirm with the court on your citation. Last updated October 7, 2026. Verified against Tex. Code Crim. Proc. ch. 45A, Tex. Transp. Code §543.009 and ch. 706, and the published citation-search procedures of Texas municipal and JP courts.</p>
      </section>

      <StickyCta afterId="find" hideAtId="course" />
    </article>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

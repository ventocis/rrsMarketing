---
/**
 * Homepage hero (Jackson, 2026-10-02): three courses, one page.
 *
 *   desktop  [ headline + one line + three promises ] [ one review card ]
 *            [ Texas card ] [ North Dakota card ] [ Missouri card ]
 *   mobile   headline → cards → review (buy buttons first on a phone)
 *
 * The headline no longer says "dismiss": only Texas dismisses; North Dakota takes points off
 * and Missouri keeps them off. The line under it names what each live state's course does,
 * built from the same approval gate as the cards, so a state appears only once approved.
 * Proof sits once, in the review card, instead of on every course card (HomeCourseRow.astro).
 */
import { FEATURED_COURSES } from '../data/featured-courses';
import reviews from '../data/texas-reviews.json';
import nd from '../data/courses/nd-ddc.json';
import mo from '../data/courses/mo-dip.json';
import type { CourseData } from '../data/courses/types';
import { isEnabled, isLicensed } from '../lib/courseFlags';
import HomeCourseRow from './HomeCourseRow.astro';

const course = FEATURED_COURSES[0];

// The homepage quotes a customer. Refuse to build if the excerpt is not their words.
const review = (reviews as Array<{ name: string; quote: string; rating: number; verified: boolean }>)
  .find((r) => r.name === course.proof.reviewerName);
if (!review || !review.quote.includes(course.proof.reviewExcerpt)) {
  throw new Error(`featured-courses: "${course.proof.reviewExcerpt}" is not a verbatim excerpt of ${course.proof.reviewerName}'s review`);
}

const live = (c: unknown) => isEnabled(c as CourseData) && isLicensed(c as CourseData);
const outcomes = [
  'dismiss a Texas ticket',
  ...(live(nd) ? ['take points off in North Dakota'] : []),
  ...(live(mo) ? ['keep them off in Missouri'] : []),
];
const sub = outcomes.length > 1
  ? `${outcomes.slice(0, -1).join(', ')}${outcomes.length > 2 ? ',' : ''} or ${outcomes[outcomes.length - 1]}.`
  : `${outcomes[0]}.`;
const promises = ['Works on your phone', 'Certificate the moment you finish', 'Nothing added at checkout'];
---

<section
  class="rrs-hero relative border-b border-border pt-12 pb-12 lg:pt-20 lg:pb-20 overflow-hidden"
  id="find-course"
  style="font-family: 'Inter', sans-serif;"
>
  <!-- Soft blue wash with a faint dot grid fading in from the right. Decorative only. -->
  <div class="rrs-hero-wash absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="rrs-hero-dots absolute inset-y-0 right-0 w-1/2 pointer-events-none hidden lg:block" aria-hidden="true"></div>

  <div class="relative max-w-[1152px] mx-auto px-4 sm:px-6 lg:px-8 z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-x-12 gap-y-8 lg:gap-y-14 items-center">
      <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
        <h1 class="text-[32px] leading-[40px] lg:text-[48px] lg:leading-[56px] font-extrabold text-text tracking-[-0.02em] m-0 mb-4">
          State-approved traffic courses, online.
        </h1>
        <p class="text-lg lg:text-xl text-text-body leading-8 m-0 mb-6 max-w-[34rem] mx-auto lg:mx-0">
          {sub.charAt(0).toUpperCase() + sub.slice(1)}
        </p>
        <ul class="list-none p-0 m-0 flex flex-col sm:flex-row sm:flex-wrap items-center lg:items-start justify-center lg:justify-start gap-x-5 gap-y-2">
          {promises.map((pt) => (
            <li class="flex items-center gap-2 text-[15px] leading-6 text-text">
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="10" class="fill-primary"/><path d="M6 10.4l2.6 2.6L14 7.4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {pt}
            </li>
          ))}
        </ul>
      </div>

      <!-- One review: proof once, not on every card -->
      <aside class="order-3 lg:order-none lg:col-start-2 lg:row-start-1 bg-white rounded-[20px] p-6 lg:p-7 border border-border shadow-[0_24px_60px_-20px_rgba(17,23,34,0.28)] text-left" aria-label="What a customer said">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="flex gap-0.5" aria-label={`Rated ${review.rating} out of 5 stars`}>
            {[...Array(5)].map((_, i) => (
              <svg class:list={["w-[18px] h-[18px]", i < review.rating ? "text-accent" : "text-border"]} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.7-5.1-2.7-5.1 2.7 1-5.7-4.1-4 5.7-.8z"/></svg>
            ))}
          </div>
          <span class="text-xs text-text-body">{review.verified ? 'Verified via Trustpilot' : 'via Trustpilot'}</span>
        </div>
        <blockquote class="text-xl leading-8 font-semibold text-text m-0 mb-2">&ldquo;{course.proof.reviewExcerpt}&rdquo;</blockquote>
        <p class="text-sm text-text-body m-0 mb-5">{review.name}</p>
        <p class="flex items-center gap-2 text-sm text-text-body pt-4 border-t border-border m-0">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="9" width="12" height="8" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M6.8 9V6.6a3.2 3.2 0 016.4 0V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          Secure checkout
        </p>
      </aside>

      <!-- Cards: under the headline on phones (review after them), full width under both on desktop -->
      <div class="order-2 lg:order-none lg:col-span-2 lg:row-start-2">
        <h2 class="text-sm font-bold uppercase tracking-wider text-primary-deep text-center lg:text-left m-0 mb-4">Pick your state</h2>
        <HomeCourseRow embedded />
      </div>
    </div>
  </div>
</section>

<style>

  .rrs-hero-wash {
    background:
      radial-gradient(90% 120% at 100% 100%, rgba(36, 84, 230, 0.16), transparent 60%),
      linear-gradient(180deg, var(--color-info-bg) 0%, #eef4fb 55%, #e4ecf7 100%);
  }
  .rrs-hero-dots {
    background-image: radial-gradient(rgba(36, 84, 230, 0.22) 1px, transparent 1.5px);
    background-size: 18px 18px;
    -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.55), transparent 85%);
            mask-image: linear-gradient(to left, rgba(0,0,0,0.55), transparent 85%);
  }
</style>

<script is:inline>
  (function () {
    if (window.__rrsHomeHeroTagged) return;
    window.__rrsHomeHeroTagged = true;
    document.addEventListener('click', function (e) {
      var link = e.target && e.target.closest && e.target.closest('a[data-featured-enroll]');
      if (!link) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'enroll_click', cta_location: 'home_featured', course_id: link.getAttribute('data-featured-enroll') });
    });
  })();
</script>

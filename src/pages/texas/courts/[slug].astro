<script is:inline>
            (function(){
              function init(){
                var card=document.getElementById('rrs-coupon-card');
                if(!card) return;
                var form=document.getElementById('rrs-coupon-form');
                var emailEl=document.getElementById('rrs-coupon-email');
                var def=document.getElementById('rrs-coupon-default');
                var ok=document.getElementById('rrs-coupon-success');
                var err=document.getElementById('rrs-coupon-error');
                var copy=document.getElementById('rrs-coupon-copy');
                var cta=document.getElementById('rrs-coupon-cta');
                var COMPANY='U3BbdX';
                var LIST=card.getAttribute('data-list');
                var qs=new URLSearchParams(location.search);
                function utm(k){return qs.get(k)||'';}
                if(cta){try{var u=new URL(cta.getAttribute('href'),location.origin);u.searchParams.set('utm_source','klaviyo');u.searchParams.set('utm_medium','court-page');u.searchParams.set('utm_campaign','court-coupon');cta.setAttribute('href',u.toString());}catch(e){}}
                if(copy){copy.addEventListener('click',function(){try{navigator.clipboard.writeText('READY3');copy.textContent='Copied';setTimeout(function(){copy.textContent='Copy';},1500);}catch(e){}});}
                form.addEventListener('submit',function(e){
                  e.preventDefault();
                  err.style.display='none';
                  var email=(emailEl.value||'').trim();
                  if(!email){return;}
                  var btn=form.querySelector('button[type=submit]');
                  if(btn){btn.disabled=true;btn.textContent='Sending…';}
                  var payload={data:{type:'subscription',attributes:{custom_source:'Court Coupon Widget',profile:{data:{type:'profile',attributes:{email:email,properties:{signup_court:card.getAttribute('data-court'),signup_court_url:location.href,signup_source:'court-coupon-widget',utm_source:utm('utm_source'),utm_medium:utm('utm_medium'),utm_campaign:utm('utm_campaign')}}}}},relationships:{list:{data:{type:'list',id:LIST}}}}};
                  fetch('https://a.klaviyo.com/client/subscriptions/?company_id='+COMPANY,{method:'POST',headers:{'Content-Type':'application/json','revision':'2024-10-15'},body:JSON.stringify(payload)})
                    .then(function(r){ if(r.status>=200&&r.status<300){def.style.display='none';ok.style.display='flex';} else { throw new Error('status '+r.status); } })
                    .catch(function(){ if(btn){btn.disabled=false;btn.textContent='Email my $3 code';} err.style.display='block'; });
                });
              }
              if(document.readyState!=='loading'){init();}else{document.addEventListener('DOMContentLoaded',init);}

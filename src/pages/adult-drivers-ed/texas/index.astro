---
import AdeLayout from '../../../layouts/AdeLayout.astro';
import ade from '../../../data/ade-texas.json';
import Pill from '../../../components/landing-v2/Pill.astro';
import Rating from '../../../components/landing-v2/Rating.astro';
import RoadPhoto from '../../../components/landing-v2/RoadPhoto.astro';
import PriceBlock from '../../../components/landing-v2/PriceBlock.astro';
import FinalBand from '../../../components/landing-v2/FinalBand.astro';
import { law, tpst } from '../../../data/ade-eligibility';

// 16 TAC §84.80(e) bars provider-name advertising, enrollment and payment before the
// TDLR Driver Education Provider license is approved. So production additionally requires
// provider.deLicenseNumber to be filled in; QA and local previews need only the flag.
// This lives here rather than in .env.production on purpose: it cannot be undone by an
// env edit, and it still holds if a developer's local flag leaks into a production build.
const isProdSite =
  import.meta.env.VITE_ENABLE_ANALYTICS === 'true' && import.meta.env.VITE_IS_QA !== 'true';
const isLicensed = Boolean(ade.provider.deLicenseNumber);
const isEnabled =
  import.meta.env.VITE_ADE_ROUTES_ENABLED === 'true' && (isLicensed || !isProdSite);
const enrollUrl = import.meta.env.VITE_ADE_ENROLLMENT_URL || '#';
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || '/contact';

const price = ade.course.priceUsd;

const included = [
  'All six hours Texas requires',
  'The final exam',
  'Two more attempts if you do not pass the first time',
  'Your certificate',
  `${ade.course.completionDays} days to finish, stopping and resuming anytime`,
  'A licensed Texas instructor you can reach',
];

const notCharged = ['Certificate fees', 'Processing fees', 'Faster delivery', 'Exam retakes'];

const audiences = [
  {
    age: 'Under 18',
    status: 'Not yet',
    tone: 'muted',
    heading: 'Your course is a different one',
    body: 'Drivers under 18 take a longer course that includes supervised driving hours behind the wheel. This one begins at 18.',
  },
  {
    age: '18 to 24',
    status: 'Required',
    tone: 'primary',
    heading: 'Texas requires this course',
    body: 'If you are 18 to 24 and getting your first Texas license, the state requires these six hours. You have to finish all of it.',
  },
  {
    age: '25 and over',
    status: 'Optional',
    tone: 'info',
    heading: 'Not required. Still worth it.',
    body: 'Texas does not require the course once you turn 25. People take it anyway because the sign and traffic law exam is part of it.',
  },
];

const steps = [
  {
    n: 1,
    title: 'Finish the six hours',
    time: '6 hours, split over as many sittings as you like',
    body: 'Nine modules, self-paced. Most people finish across two or three sittings.',
  },
  {
    n: 2,
    title: 'Pass the final exam',
    time: 'Included in the course',
    body: `${ade.exam.questions} questions — ${ade.exam.signsQuestions} on highway signs, ${ade.exam.lawsQuestions} on traffic laws. Miss it and you get two more tries.`,
  },
  {
    n: 3,
    title: 'Get your certificate',
    time: 'After your instructor signs off',
    body: 'A licensed Texas instructor signs off on your record and we email your certificate. It is called an ADE-1317 — the state\'s name for the adult driver education certificate. Print it; a paper copy is what gets accepted.',
  },
  {
    n: 4,
    title: 'Watch Impact Texas Adult Drivers (ITAD)',
    where: 'On the DPS site',
    required: true,
    time: 'Online, before your DPS visit',
    body: 'A free one-hour video from Texas DPS, required once you hold an ADE-1317 certificate. You watch it on the DPS site, not here, and DPS emails you the certificate. It stays valid 90 days — watch it close to your skills test, because if 90 days pass before you pass, you start over.',
    link: { href: 'https://impacttexasdrivers.dps.texas.gov/itad', label: 'Take ITAD on the DPS site' },
  },
  {
    n: 5,
    title: 'Go to the DPS',
    time: 'One visit, by appointment',
    body: 'The Department of Public Safety (DPS) is where Texas issues licenses. Bring your certificates and your documents. You still take the vision screening and the driving test there.',
  },
];

const testimonials = [
  {
    initials: 'P',
    name: 'Princess',
    date: 'May 26, 2026',
    quote: 'Not difficult to understand. When a problem occurred they replied immediately and helped me sort it out. 5 stars.',
  },
  {
    initials: 'TG',
    name: 'Tommie Garner',
    date: 'May 13, 2026',
    quote: 'Easy to access and informative. I had no problems navigating the system and the customer support services were superb.',
  },
  {
    initials: 'VR',
    name: 'Vamsi Raju',
    date: 'August 3, 2026',
    quote: 'Fantastic service and very user-friendly course. Support was quick to assist me when I needed a course update. Five stars!',
  },
  {
    initials: 'CM',
    name: 'Colleen Minor',
    date: 'August 15, 2026',
    quote: "Covered practical everyday 'real life' experiences — and also a great refresher course for basics.",
  },
];

const faqs = [
  {
    q: 'Who has to take Texas adult drivers ed?',
    a: 'Anyone 18 to 24 getting a first Texas driver license has to complete a six-hour approved course. Drivers 25 and over do not have to. Drivers under 18 take a different, longer course that includes supervised driving hours.',
  },
  {
    q: 'Do I still take the written test at the DPS?',
    a: `Completing this course ${ade.exam.claimPhrasing}. You still take the vision screening and the driving test at the DPS.`,
  },
  {
    q: 'What is in the six hours?',
    a: 'Nine modules: getting your license, right-of-way, signs and signals, speed and lane use, alcohol and drugs, sharing the road, managing risk, and the final exam.',
  },
  {
    q: 'Do adults need behind-the-wheel hours in Texas?',
    a: 'No. Texas does not require adults to log practice hours. You still have to pass the driving test, so if you have never driven, get a learner license and practice first.',
  },
  {
    q: 'What if I fail the final exam?',
    a: 'You get two more attempts, with different questions each time. A third failure means starting over with a new enrollment — that limit is set by the state.',
  },
  {
    q: 'What is Impact Texas Drivers?',
    a: 'A free one-hour video program from the Texas Department of Public Safety about the consequences of distracted driving. If you complete this course and get your ADE-1317 certificate, DPS requires you to watch Impact Texas Adult Drivers (ITAD) before you take your driving skills test. It is separate from our course — you take it on the DPS site and DPS issues that certificate, not us. Drivers 25 and over take ITAD too; drivers 15 to 17 take a different two-hour program, ITTD. The certificate is valid for 90 days, so watch it close to your test date rather than early — if 90 days pass before you take the skills test, you have to redo it. It is tied to the skills test, so someone moving to Texas with a valid out-of-state license, who takes no skills test, does not need it.',
  },
  {
    q: 'How long do I have to finish?',
    a: `${ade.course.completionDays} days from the day you sign up. Stop whenever you need to and pick up where you left off.`,
  },
  {
    q: 'When do I get my certificate?',
    a: 'After you pass, a licensed Texas instructor reviews your record and signs your certificate. We email it as soon as that is done.',
  },
  {
    q: `Is it really $${price}?`,
    a: 'Yes. The certificate is included. No processing fee, no delivery fee, no retake fee, and no upgraded version of the course.',
  },
  {
    q: 'I am 25 or older. Should I take this?',
    a: 'You do not have to. People over 25 take it because the sign and traffic law exam is part of the course, on their own schedule.',
  },
  {
    q: 'Do I need a learner permit first?',
    a: 'No. You can take the course before you have any license or permit at all.',
  },
  {
    q: 'Can I do this on my phone?',
    a: 'Yes. Your progress saves as you go, so ten minutes on a break counts.',
  },
  {
    q: 'Can I get a refund?',
    a: 'Yes. Full refund if you cancel within three days of signing up, and a partial refund after that based on how much of the course you have not taken.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// ---- landing-v2 design (2026-09-23). Everything below only arranges the facts above. ----
const guideHref = '/adult-drivers-ed/texas/do-i-need-adult-drivers-ed';
const statuteHref = 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm';
const ctaLabel = 'Start the Course';

const chips = ['Exam built in', 'Works on your phone', 'Certificate included'];

// DPS's own sentences, split so the waiver and the 25+ note read as quotes (ade-eligibility.ts, DPS-APP).
const dpsBand = law.dpsRequirementText.split('. ')[0];
const dpsWaiver = 'waived for new residents 18 or older who are surrendering a valid, unexpired driver license from another state';

const stepTag = (s: (typeof steps)[number]) => s.where ?? (s.n <= 3 ? 'With us' : 'At the DPS');
const stepNum = (n: number) => String(n).padStart(2, '0');

const lineItems = [
  { label: 'Course', value: `$${price}` },
  { label: 'Certificate', value: 'Included', good: true },
  { label: 'Processing fee', value: '$0.00', good: true },
  { label: 'Exam retakes', value: '$0.00', good: true },
];

const texasLinks = [
  { label: 'Texas Department of Licensing and Regulation (TDLR)', href: 'https://www.tdlr.texas.gov/' },
  { label: 'Tex. Transp. Code §521.1601: driver education under 25', href: statuteHref },
  { label: 'DPS: apply for a Texas driver license', href: 'https://www.dps.texas.gov/section/driver-license/apply-texas-driver-license' },
  { label: 'DPS: Impact Texas Adult Drivers (ITAD)', href: 'https://impacttexasdrivers.dps.texas.gov/itad' },
];

const btnPrimary =
  'bg-primary hover:bg-primary-hover text-white h-[52px] px-8 rounded-full text-base font-semibold inline-flex items-center justify-center gap-2 no-underline transition-colors shadow-[0_8px_20px_-8px_rgba(36,84,230,0.55)]';
const btnSecondary =
  'bg-info hover:brightness-95 text-info-text h-[52px] px-8 rounded-full text-base font-semibold inline-flex items-center justify-center no-underline transition-colors';
const h2 = 'font-extrabold tracking-[-0.02em] leading-[1.1]';
const outfit = "font-family:'Outfit',sans-serif;";
const check = 'M4.8 8.2l2.1 2.1 4.3-4.4';
---

{!isEnabled && <meta http-equiv="refresh" content="0;url=/" />}

{isEnabled && (
<AdeLayout
  title={`Texas Adult Drivers Ed Online — 6 Hours, $${price} Flat | Road Ready Safety`}
  description={`TDLR-approved Texas adult driver education for ages 18 and up. All six hours the state requires, the exam built in, and one flat price of $${price} with the certificate included.`}
  url="/adult-drivers-ed/texas"
  headerStyle="minimal"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ============ 1. HERO ============ -->
  <section class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-14 lg:pt-24 lg:pb-28 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="flex flex-col gap-6 items-start">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-info text-info-text text-sm font-semibold px-4 py-2">
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1l1.12 2.27L10 3.64l-2 1.95.47 2.75L6 7.02 3.53 8.34 4 5.59 2 3.64l2.88-.37L6 1z" fill="currentColor"/></svg>
          TDLR-Approved &middot; Texas {ade.course.code}
        </span>

        <h1 class={`text-[34px] lg:text-[56px] text-primary-navy ${h2}`} style={outfit}>
          Texas Adult Drivers Ed Online &mdash; All 6 Hours for ${price}
        </h1>

        <p class="text-lg lg:text-xl text-text-body leading-8 max-w-[36rem] m-0">
          The 6 hours Texas requires for a first driver license, at one flat price with the
          certificate included. The highway sign and traffic law exam happens right here,
          inside the course. No classroom, no behind-the-wheel hours.
        </p>

        <ul class="flex flex-wrap gap-3 list-none p-0 m-0" aria-label="Course basics">
          {chips.map((t) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-border bg-white px-4 py-2 text-sm font-medium text-text">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#16A34A" opacity="0.14"/><path d={check} stroke="#16A34A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {t}
            </li>
          ))}
        </ul>

        <a href={enrollUrl} class={`${btnPrimary} w-full sm:w-auto mt-2`}>{ctaLabel} &mdash; ${price}</a>
        <p class="text-sm text-text-muted leading-6 m-0">
          Self-paced &middot; Stop and resume anytime &middot; {ade.course.completionDays} days to finish.
          <a href="#who-needs-it" class="text-primary font-semibold underline underline-offset-2 whitespace-nowrap">Do I even need this?</a>
        </p>
      </div>

      <!-- Photo with the course-progress card. Not a certificate: the ADE-1317 is a TDLR-controlled form. -->
      <div class="relative hidden lg:block pb-16">
        <RoadPhoto class="w-full aspect-[4/3] rounded-[28px]" position="50% 60%" eager desktopOnly />
        <div class="absolute right-6 top-6 rounded-2xl bg-white shadow-[0_20px_25px_-5px_rgba(17,23,34,0.15)] px-4 py-3" aria-hidden="true">
          <p class="text-[22px] font-bold text-primary-navy leading-6 m-0" style={outfit}>${price}</p>
          <p class="text-xs text-text-body leading-4 m-0">all in</p>
        </div>
        <div class="absolute -left-8 bottom-0 w-[340px] rounded-[20px] bg-white ring-1 ring-border shadow-[0_24px_48px_-16px_rgba(2,25,84,0.35)] p-5 flex flex-col gap-3" aria-hidden="true">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-primary-deep">Course Progress</span>
            <span class="text-xs font-semibold text-text tabular-nums">6 of 9 modules complete</span>
          </div>
          <div class="h-2 rounded-full bg-info overflow-hidden"><div class="h-full w-2/3 bg-primary rounded-full"></div></div>
          <ul class="flex flex-col gap-1.5 list-none p-0 m-0">
            {ade.modules.slice(0, 4).map((m) => (
              <li class="flex items-center gap-3 rounded-xl bg-surface-muted px-3 py-2">
                <span class="w-5 h-5 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.2 2.2 4.8-4.8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="text-[13px] text-text-body truncate">{m.title}</span>
              </li>
            ))}
          </ul>
          <div class="rounded-xl bg-primary text-white text-sm font-semibold text-center py-2.5">Continue Module 7</div>
          <div class="flex items-center gap-3 border-t border-border pt-3">
            <span class="w-8 h-8 rounded-full bg-info flex items-center justify-center flex-shrink-0">
              <img src="/assets/icons/texas/check-circle.svg" alt="" class="w-4 h-4" />
            </span>
            <span class="text-sm font-semibold text-text leading-5">Exam included <span class="block text-xs font-normal text-text-body">Signs + traffic laws</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. WHO IT'S FOR ============ -->
  <section id="who-needs-it" class="relative overflow-hidden bg-primary-navy text-white scroll-mt-28">
    <div class="absolute inset-0 opacity-40 pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(60% 80% at 80% 0%, rgba(36,84,230,.55), transparent 70%), radial-gradient(50% 70% at 0% 100%, rgba(124,195,249,.25), transparent 70%);"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 flex flex-col items-center gap-8 text-center">
      <h2 class={`text-[32px] lg:text-[44px] ${h2}`} style={outfit}>Is this course for you?</h2>
      <Pill tone="dark">It depends on your age</Pill>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6 w-full list-none p-0 m-0">
        {audiences.map((a) => (
          <li class={`flex flex-col gap-4 rounded-[20px] px-6 py-7 text-left ${a.tone === 'primary' ? 'bg-white text-primary-navy' : 'border border-white/25 bg-white/5'}`}>
            <div class="flex items-center justify-between gap-3">
              <span class="text-[26px] font-bold leading-none" style={outfit}>{a.age}</span>
              <span class={`text-[11px] font-bold uppercase tracking-[0.12em] px-2.5 py-1 rounded-full whitespace-nowrap ${a.tone === 'primary' ? 'bg-primary text-white' : 'bg-white/10 text-info-border ring-1 ring-white/20'}`}>{a.status}</span>
            </div>
            <h3 class="text-xl font-bold leading-7 m-0" style={outfit}>{a.heading}</h3>
            <p class={`text-base leading-7 m-0 ${a.tone === 'primary' ? 'text-text-body' : 'text-info-border'}`}>{a.body}</p>
          </li>
        ))}
      </ul>
      <div class="flex flex-col gap-4 max-w-3xl text-base lg:text-lg text-info-border leading-8">
        <p class="m-0">
          Texas won't issue a first license to anyone under 25 who hasn't finished driver education
          (<a href={statuteHref} class="underline text-white" target="_blank" rel="noopener noreferrer">Transportation Code §521.1601</a>).
          The Department of Public Safety (DPS) puts it this way: &ldquo;{dpsBand}.&rdquo; The requirement is {dpsWaiver}.
        </p>
        <p class="m-0">
          For first-time applicants over 25, DPS says you are &ldquo;not required to have completed driver education, however it is highly recommended.&rdquo;
          Not sure where you fit? <a href={guideHref} class="underline text-white font-semibold">Do I need adult drivers ed?</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ 3. FIVE STEPS ============ -->
  <section class="bg-white py-20 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-[28px] border border-info-border overflow-hidden">
        <div class="bg-info px-6 py-10 lg:px-14 lg:py-14 grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
          <div class="flex flex-col gap-5 items-start">
            <Pill tone="tint">{steps.length} steps</Pill>
            <h2 class={`text-[40px] lg:text-[64px] text-primary-navy ${h2}`} style={outfit}>
              Your path to
              <span class="relative inline-block">
                the DPS
                <svg class="absolute left-0 -bottom-4 w-full h-4" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12 C 60 2, 140 2, 197 9" fill="none" stroke="#2454E6" stroke-width="3.5" stroke-linecap="round"/></svg>
              </span>
            </h2>
          </div>
          <p class="text-lg lg:text-xl text-text-body leading-8 m-0 lg:text-right">
            We handle the first three steps. The last two are at the DPS.
          </p>
        </div>
        <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-info-border list-none p-0 m-0 border-t border-info-border">
          {steps.map((s) => (
            <li class="bg-white px-6 py-10 lg:px-10 flex flex-col gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-[44px] font-extrabold leading-none text-primary tabular-nums mr-2" style={outfit}>{stepNum(s.n)}</span>
                <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full ${s.n <= 3 ? 'bg-primary-deep text-white' : 'bg-surface-muted text-text-muted border border-border'}`}>{stepTag(s)}</span>
                {s.required && <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-full bg-error-bg text-error">Required</span>}
              </div>
              <h3 class="text-2xl font-bold text-text m-0" style={outfit}>{s.title}</h3>
              <p class="text-xs font-bold uppercase tracking-[0.12em] text-text-muted m-0">{s.time}</p>
              <p class="text-base text-text-body leading-7 m-0">{s.body}</p>
              {s.link && (
                <a href={s.link.href} rel="noopener" class="text-base font-semibold text-primary underline w-fit">{s.link.label} &rarr;</a>
              )}
            </li>
          ))}
          <li class="bg-info px-6 py-10 lg:px-10 flex flex-col gap-4 justify-center items-start">
            <p class="text-2xl font-bold text-primary-navy m-0" style={outfit}>Steps 1 to 3 start here.</p>
            <a href={enrollUrl} class={btnPrimary}>{ctaLabel}</a>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 4. TABS: what's included (#pricing) / what you'll learn (#curriculum) ============ -->
  <section id="pricing" class="bg-white pb-20 lg:pb-28 scroll-mt-28">
    <span id="curriculum" class="block scroll-mt-28" aria-hidden="true"></span>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-5 text-center">
      <h2 class={`text-[32px] lg:text-[44px] text-text ${h2}`} style={outfit}>A course you'll actually finish</h2>
      <p class="text-lg text-text-body leading-8 max-w-2xl m-0">
        Self-paced and saves as you go. Ten minutes at a time is fine. Most people finish across two or three sittings.
      </p>

      <div class="mt-6 inline-flex rounded-full bg-info p-1.5 max-w-full overflow-x-auto" role="tablist" aria-label="Course details">
        <button type="button" role="tab" id="ade-tab-learn" aria-controls="ade-panel-learn" aria-selected="false" tabindex="-1"
          class="ade-tab rounded-full px-6 h-11 text-base font-semibold whitespace-nowrap transition-colors aria-selected:bg-primary aria-selected:text-white text-text-body">What you'll learn</button>
        <button type="button" role="tab" id="ade-tab-price" aria-controls="ade-panel-price" aria-selected="true"
          class="ade-tab rounded-full px-6 h-11 text-base font-semibold whitespace-nowrap transition-colors aria-selected:bg-primary aria-selected:text-white text-text-body">What's included</button>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
      <div id="ade-panel-learn" role="tabpanel" aria-labelledby="ade-tab-learn" hidden class="ade-panel"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-base text-text-body leading-7 mt-0 mb-6">Nine modules, set by the state. Two of them include short required videos.</p>
          <div class="border-t border-border">
            {ade.modules.map((m, i) => (
              <details class="group border-b border-border" open={i === 0}>
                <summary class="cursor-pointer list-none flex items-center justify-between gap-4 py-5">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-left">
                    <span class="text-sm font-bold tabular-nums text-text-subtle" style={outfit}>{stepNum(m.n)}</span>
                    <span class="text-lg font-bold text-text" style={outfit}>{m.title}</span>
                    {m.n === ade.modules.length && <span class="text-[10px] font-bold uppercase tracking-wider text-primary-deep bg-info px-2 py-0.5 rounded-full">Final exam</span>}
                    {m.n === 7 && <span class="text-[10px] font-bold uppercase tracking-wider text-primary-deep bg-info px-2 py-0.5 rounded-full">2 videos</span>}
                  </span>
                  <svg class="flex-shrink-0 w-5 h-5 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <p class="text-base text-text-body leading-7 pb-5 m-0">{m.blurb}</p>
              </details>
            ))}
          </div>
        </div>

        <!-- The final exam, from facts already on this page. -->
        <div class="rounded-[28px] bg-info p-8 lg:p-10">
          <div class="rounded-[20px] bg-white shadow-[0_24px_48px_-20px_rgba(2,25,84,0.35)] p-7 flex flex-col gap-5">
            <span class="text-sm font-semibold text-text-muted uppercase tracking-wider">The final exam</span>
            <p class="text-[56px] font-extrabold text-primary-navy leading-none m-0 tabular-nums" style={outfit}>{ade.exam.questions}<span class="text-2xl font-bold text-text-body"> questions</span></p>
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-surface-muted px-4 py-3"><p class="text-2xl font-bold text-text m-0 tabular-nums" style={outfit}>{ade.exam.signsQuestions}</p><p class="text-sm text-text-body m-0">on highway signs</p></div>
              <div class="rounded-xl bg-surface-muted px-4 py-3"><p class="text-2xl font-bold text-text m-0 tabular-nums" style={outfit}>{ade.exam.lawsQuestions}</p><p class="text-sm text-text-body m-0">on traffic laws</p></div>
            </div>
            <p class="text-base text-text-body leading-7 m-0">Included in the course. Miss it and you get two more tries, with different questions each time.</p>
          </div>
        </div>
      </div></div>

      <div id="ade-panel-price" role="tabpanel" aria-labelledby="ade-tab-price" class="ade-panel">
        <PriceBlock
          price={price}
          label="Texas Adult Drivers Ed"
          totalLabel="Total. Not a deposit, not a starting price. Nothing added at checkout."
          included={included}
          notCharged={notCharged}
          notChargedLabel="And what we never charge for"
          lineItems={lineItems}
          totalRow={{ label: 'What you pay', value: `$${price}` }}
          refundNote="Full refund if you cancel within three days of signing up."
          refundHref="/adult-drivers-ed/texas/refund"
          enrollUrl={enrollUrl}
          ctaLabel={ctaLabel}
        />
      </div>
    </div>
  </section>

  <!-- ============ 5. REVIEWS ============ -->
  <section class="bg-surface-dark text-white py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[minmax(0,24rem)_1fr] gap-10 lg:gap-16 items-center">
      <div class="flex flex-col gap-6">
        <Rating tone="dark" />
        <h2 class={`text-[34px] lg:text-[46px] ${h2}`} style={outfit}>What drivers say about our Texas driving safety course</h2>
        <p class="text-base text-info-border leading-7 m-0">
          These reviews are from students of our <a href="/texas" class="text-white underline">Texas defensive driving course</a>. Reviews of the adult drivers ed course will appear here as students finish it.
        </p>
        <div class="flex gap-3">
          <button type="button" class="ade-rev-prev w-14 h-14 rounded-2xl bg-white/10 hover:bg-white/15 flex items-center justify-center" aria-label="Previous review">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <button type="button" class="ade-rev-next w-14 h-14 rounded-2xl bg-primary hover:bg-primary-hover flex items-center justify-center" aria-label="Next review">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      </div>
      <ul class="ade-rev-track flex gap-6 overflow-x-auto snap-x snap-mandatory list-none p-0 m-0 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {testimonials.map((t) => (
          <li class="snap-start flex-shrink-0 w-[85%] sm:w-[440px] rounded-[24px] bg-primary-deep flex flex-col">
            <div class="p-8 flex flex-col gap-5 flex-1">
              <span class="self-start rounded-full bg-white text-surface-dark text-xs font-bold px-3 py-1.5">Verified via Trustpilot</span>
              <span class="flex gap-1" aria-label="5 out of 5 stars">
                {[0, 1, 2, 3, 4].map(() => <img src="/assets/icons/texas/star-testimonial.svg" alt="" class="w-6 h-6" />)}
              </span>
              <blockquote class="text-xl lg:text-2xl leading-snug m-0">&ldquo;{t.quote}&rdquo;</blockquote>
            </div>
            <div class="border-t border-white/15 px-8 py-5 text-sm font-semibold text-info-border">{t.name} &middot; Texas Driver Safety Course &middot; {t.date}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 6. FAQ ============ -->
  <section id="faq" class="bg-white py-20 lg:py-28 scroll-mt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[minmax(0,26rem)_1fr] gap-10 lg:gap-20 items-start">
      <div class="flex flex-col gap-5 lg:sticky lg:top-32">
        <h2 class={`text-[36px] lg:text-[52px] text-text ${h2}`} style={outfit}>Questions people actually ask</h2>
        <p class="text-lg text-text-body leading-8 m-0">Still have a question? Ask us before you pay.</p>
        <div class="flex flex-wrap gap-3">
          <a href={contactUrl} class={btnSecondary}>Contact us</a>
        </div>
        <a href={guideHref} class="text-primary font-semibold underline underline-offset-2">Do I need adult drivers ed?</a>
      </div>
      <div class="border-t border-border">
        {faqs.map((f, i) => (
          <details class="group border-b border-border" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-start justify-between gap-6 py-6">
              <h3 class="text-lg lg:text-xl font-bold text-text m-0" style={outfit}>{f.q}</h3>
              <svg class="mt-1 flex-shrink-0 w-5 h-5 text-text-muted transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <p class="text-base text-text-body leading-7 pb-6 pr-10 m-0">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 7. MADE FOR TEXAS — only sentences already on this page, plus official links ============ -->
  <section class="bg-primary-navy text-white py-20 lg:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-6 text-center">
      <Pill tone="dark">Built for Texas's rules</Pill>
      <h2 class={`text-[32px] lg:text-[44px] ${h2}`} style={outfit}>Made for Texas's adult driver education rules</h2>
      <p class="text-base lg:text-lg text-info-border leading-8 max-w-3xl m-0">
        Approved by the Texas Department of Licensing and Regulation (TDLR) &mdash; the agency that signs off on driver education in Texas.
        Nine modules, set by the state. Finish the course and you have satisfied the highway sign and traffic law portions of the DPS knowledge exam.
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6 w-full list-none p-0 m-0 mt-4">
        {texasLinks.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="flex items-center h-full gap-4 rounded-[20px] border border-white/25 bg-white/5 px-6 py-6 text-left text-lg font-semibold text-white underline underline-offset-4 decoration-info-border hover:bg-white/10">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 8. FINAL CALL TO ACTION ============ -->
  <FinalBand
    heading="Six hours. One flat price. Start whenever you want."
    copy="Stop whenever you need to and come back to the exact spot you left."
    ctaLabel={`${ctaLabel} — $${price}`}
    ctaHref={enrollUrl}
  />
  <script is:inline>
    (function () {
      if (window.__rrsAdeLandingV2) return;
      window.__rrsAdeLandingV2 = true;
      // Tabs + review carousel: one delegated listener, no dependency on the ViewTransitions router.
      function selectTab(tab) {
        document.querySelectorAll('.ade-tab').forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          var panel = document.getElementById(t.getAttribute('aria-controls'));
          if (panel) panel.hidden = !on;
        });
      }
      // #pricing and #curriculum are linked from every ADE page's header and footer:
      // open the matching tab, then land on the section.
      function fromHash() {
        var id = { '#pricing': 'ade-tab-price', '#curriculum': 'ade-tab-learn' }[location.hash];
        var tab = id && document.getElementById(id);
        if (!tab) return;
        selectTab(tab);
        var target = document.getElementById(location.hash.slice(1));
        if (target) target.scrollIntoView();
      }
      document.addEventListener('click', function (e) {
        var tab = e.target.closest && e.target.closest('.ade-tab');
        if (tab) { selectTab(tab); return; }
        var prev = e.target.closest && e.target.closest('.ade-rev-prev');
        var next = e.target.closest && e.target.closest('.ade-rev-next');
        if (prev || next) {
          var track = document.querySelector('.ade-rev-track');
          if (!track) return;
          var card = track.querySelector('li');
          var step = card ? card.getBoundingClientRect().width + 24 : 400;
          track.scrollBy({ left: next ? step : -step, behavior: 'smooth' });
        }
      });
      document.addEventListener('keydown', function (e) {
        var tab = e.target.closest && e.target.closest('.ade-tab');
        if (!tab || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
        var tabs = Array.prototype.slice.call(document.querySelectorAll('.ade-tab'));
        var n = tabs[(tabs.indexOf(tab) + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        n.focus(); n.click();
      });
      window.addEventListener('hashchange', fromHash);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fromHash); else fromHash();
    })();
  </script>
  
  <style is:global>
    /* Tailwind base styles are off in this repo, so make [hidden] win explicitly. */
    .ade-panel[hidden] { display: none !important; }
  </style>
</AdeLayout>
)}


---
import AccessibilityPage from '../../components/course/pages/AccessibilityPage.astro';
import { stateRouteCourses, stateParam } from '../../data/courses/index';
import type { CourseData } from '../../data/courses/types';

export function getStaticPaths() {
  return stateRouteCourses.map((course) => ({ params: { state: stateParam(course) }, props: { course } }));
}

const { course } = Astro.props as { course: CourseData };
---

<AccessibilityPage course={course} />

---
/**
 * /texas/pricing — consolidated into /texas/cost on 2026-10-05 (SEO playbook §2c).
 * Google had swapped this page in for /texas/cost (796 impressions, 0 clicks in the prior
 * 3 months) and neither page earned clicks; one all-in cost page now carries both.
 * This is a meta-refresh shell with a canonical to the target. A true 301 belongs in
 * the CloudFront rules in infra/ (not Claude-owned); ask Sam to add it.
 */
const siteUrl = (import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com').replace(/\/$/, '');
const target = '/texas/cost';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={`${siteUrl}${target}`} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Redirecting…</title>
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem; color: #616d7b;">
      Redirecting to the Texas defensive driving cost page…
      <a href={target} style="color: #0667D1;">Click here if you are not redirected.</a>
    </p>
  </body>
</html>

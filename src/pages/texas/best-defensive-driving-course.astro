---
import TexasLayout from '../../layouts/TexasLayout.astro';
import CourseBand from '../../components/texas/CourseBand.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import YouTubeCard from '../../components/YouTubeCard.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL, TEXAS_PRICE_CENTS_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || 'https://roadreadysafety.com/support';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;
const priceCents = TEXAS_PRICE_CENTS_LABEL;
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const cp = TEXAS_COURSE.providerNumber;

// Restored 2026-10-18 to the June/July structure (the version Google ranked for "best" and "cheapest"
// Texas defensive driving searches): answer-first short answer, how to choose, picks by need, a named
// price table, why we recommend ourselves, FAQs. Prices re-verified October 18, 2026 on each provider's
// public site or checkout page without buying. Our own figures are imported, never typed.
const verified = 'October 18, 2026';

const picks = [
  { provider: 'Road Ready Safety', cp, total: priceCents, instantCert: 'Free, included (instant download)', best: 'Best overall value: certificate included, nothing added at checkout', highlight: true },
  { provider: 'I Drive Safely', cp: 'CP022', total: '$28.00', instantCert: 'Free (electronic)', best: 'Same total; text, video or audio format' },
  { provider: 'IMPROV', cp: 'CP342', total: '$28.95', instantCert: 'Free (electronic)', best: 'Comedy format with the certificate included (sale price; list $37.95)' },
  { provider: 'Comedy Driving', cp: 'CP319', total: '$25.00', instantCert: 'Paid add-on (fee shown at signup); mail free', best: 'Animated comedy course at the legal floor; instant download costs extra' },
  { provider: 'DefensiveDriving.com', cp: 'CP284', total: '$25.00 (text course)', instantCert: '$25.00 add-on; mail free; FedEx $45', best: 'Known national brand; instant certificate doubles the price' },
  { provider: 'GetDefensive.com', cp: 'CP021', total: '$25.00', instantCert: 'None. Mailed in 2 to 3 business days; same-day processing $10, still mailed', best: 'Best bilingual (English / Spanish) pick' },
  { provider: 'Aceable', cp: 'CP262', total: '$44.00', instantCert: '$15.00 (sale price; $20 list)', best: 'Polished app and audio option; course $29 on sale ($49 list) plus the certificate fee' },
];

const faqs = [
  { q: 'What is the best Texas defensive driving course?', a: `Every TDLR-approved Texas defensive driving course teaches the same state-mandated 6-hour curriculum, so for ticket dismissal the "best" course is the one with the lowest all-in price and the fastest certificate. On verified ${verified} pricing, Road Ready Safety is the best overall value: ${priceCents} all-in with a free instant certificate download and nothing added at checkout. I Drive Safely matches that total with a free electronic certificate, and IMPROV is $28.95 with the certificate included. If you need a bilingual course, GetDefensive.com (English / Spanish) is the pick, but its certificate comes by mail.` },
  { q: 'Are all Texas defensive driving courses the same?', a: 'The course content is essentially the same. TDLR (the Texas Department of Licensing and Regulation) approves every provider against the same required curriculum, and any TDLR-approved course your court accepts will dismiss an eligible ticket. The differences that actually matter are the total price at checkout, whether the certificate is free and instant, the format (read, video or audio), language options, and the quality of the app and support.' },
  { q: 'What is the cheapest Texas defensive driving course in 2026?', a: `Texas law sets a ${floor} minimum course price (Education Code §1001.352), and Comedy Driving, DefensiveDriving.com and GetDefensive.com all advertise that floor. None of the three includes an instant certificate at that price: you either wait for the mail or pay a fee of $10 to $25 to get it today. Road Ready Safety is ${priceCents} all-in with the instant certificate included, so on a court deadline it is the cheapest way to be done the same day. See the full breakdown on our Texas defensive driving cost page.` },
  { q: 'How do I choose the right defensive driving course?', a: 'Confirm the provider is TDLR-approved (look for a CP license number), then compare the all-in checkout total (base fee, any processing fee, any certificate fee), how fast you get the certificate, and whether it works well on your phone. For ticket dismissal on a deadline, a free instant certificate is the single most important feature: it lets you submit to your court the same day you finish.' },
  { q: 'Is the cheapest defensive driving course any good?', a: 'Yes, because price has nothing to do with whether the course dismisses your ticket. The court only cares that the certificate comes from a TDLR-approved provider. Paying more does not get your ticket dismissed faster or more reliably; it usually pays for branding or a paid certificate. The lowest-friction choice is an approved course at the cheapest total with a free instant certificate.' },
  { q: 'Is Road Ready Safety a legitimate, court-accepted course?', a: `Yes. Road Ready Safety is TDLR-approved (license ${cp}) and its certificate is accepted by Texas courts statewide for dismissal of an eligible citation. The course is the full state-required 6 hours, completed online on any device, with a certificate you download the moment you finish.` },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Best Texas Defensive Driving Course (2026): Honest Comparison',
  description: 'Every TDLR-approved course teaches the same material, so the best one is the cheapest with the fastest certificate. Verified all-in prices for seven providers and the best pick for each need.',
  datePublished: '2026-06-15',
  dateModified: '2026-10-18',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/best-defensive-driving-course`,
});
const courseSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Texas Defensive Driving Course (Driver Safety Course)',
  description: `TDLR-approved ${TEXAS_COURSE.hours}-hour online Texas defensive driving course for traffic ticket dismissal and insurance discounts. Free instant certificate download.`,
  provider: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  offers: { '@type': 'Offer', price: TEXAS_COURSE.price.toFixed(2), priceCurrency: 'USD', url: `${siteUrl}/courses/tx-defensive` },
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const sans = "font-family: 'DM Sans', sans-serif;";
const head = "font-family: 'Outfit', sans-serif;";
const h2 = 'text-2xl font-bold text-text mt-10 mb-4';
const prose = 'space-y-4 text-text-body text-base leading-7 mb-10';
const link = 'text-primary-deep font-medium hover:underline';
---

{isEnabled ? (
  <TexasLayout
    title="Best Texas Defensive Driving Course 2026: Honest Comparison"
    description="Every TDLR-approved course teaches the same material, so the best one is the cheapest with the fastest certificate. We compare verified all-in prices for seven providers and name the best pick for each need."
    keywords="best defensive driving course texas, cheapest defensive driving course texas, texas defensive driving course comparison, tdlr approved defensive driving course"
    url="/texas/best-defensive-driving-course"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={courseSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-16 lg:pb-24">
      <div class="max-w-[880px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14">

        <p class="text-sm text-text-body mb-6" style={sans}>
          <a href="/texas" class={link}>Texas defensive driving</a><span class="mx-1.5">›</span><span>Best course</span>
        </p>

        <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-text leading-tight tracking-[-0.02em] mb-6" style={head}>
          The Best Texas Defensive Driving Course in 2026
        </h1>

        <!-- Answer-first short answer -->
        <div class="bg-info border border-info-border rounded-2xl p-6 mb-10">
          <p class="text-sm font-semibold text-primary-deep mb-2" style={head}>Short answer</p>
          <p class="text-text-body text-base leading-7" style={sans}>
            Every TDLR-approved Texas defensive driving course teaches the same state-required 6-hour material, so any of them will dismiss an eligible ticket. That makes the <strong class="text-text">best course the one with the lowest all-in price and the fastest certificate</strong>. On pricing verified {verified}, <strong class="text-text">Road Ready Safety is the best overall value at {priceCents} all-in</strong> with a <strong class="text-text">free instant certificate download</strong>, so you can submit to your court the same day. I Drive Safely matches the total with a free electronic certificate; IMPROV is $28.95 with the certificate included. The three courses advertised at the {floor} legal minimum either mail the certificate or charge a fee to get it today. Need English/Spanish? <strong class="text-text">GetDefensive.com</strong> is the bilingual pick.
          </p>
        </div>

        <div class={prose} style={sans}>
          <p>"What's the best defensive driving course in Texas?" is the most common question drivers ask after a ticket, but it is slightly the wrong question. Because Texas regulates the curriculum, the course material barely differs between providers. What changes is what you pay and how fast you get your certificate.</p>
          <p>This guide explains the few things that actually separate one course from another, names the best pick for each situation, and shows verified all-in prices. It is written by the Road Ready Safety team. We run one of the courses below, so we have laid out the criteria honestly and linked our <a href="/texas/cost" class={link}>fee-by-fee cost breakdown</a> so you can check our work.</p>
        </div>

        <h2 class={h2} style={head}>How to choose: the 4 things that actually matter</h2>
        <div class={prose} style={sans}>
          <ul class="list-disc pl-6 space-y-3">
            <li><strong class="text-text">TDLR approval.</strong> Only a course approved by the Texas Department of Licensing and Regulation will be accepted by your court. Every provider should show a CP license number. If it doesn't, walk away. <a href="/texas/tdlr-approved" class={link}>How to check a license</a>.</li>
            <li><strong class="text-text">All-in price.</strong> The advertised price is rarely what you pay. Texas law sets a {floor} minimum course price, and several providers add a processing fee or a certificate fee at the last checkout screen. Compare the <em>final</em> total, not the headline price.</li>
            <li><strong class="text-text">Certificate speed and cost.</strong> This is the one that trips people up. If you're on a court deadline, a free instant certificate download lets you submit the same day. Providers that only mail a certificate, or charge a fee of $10 to $25 to get it instantly, add cost and risk.</li>
            <li><strong class="text-text">Format, language, and device.</strong> Read-based, video or audio, English or bilingual, and whether it works smoothly on your phone with your progress saved. These are preference, not pass/fail.</li>
          </ul>
          <p>Notice what is <em>not</em> on the list: price has no effect on whether your ticket gets dismissed. The court only cares that the certificate comes from a TDLR-approved provider.</p>
        </div>

        <h2 class={h2} style={head}>Best Texas defensive driving courses, by need</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-6" style={sans}>
          <ul class="list-disc pl-6 space-y-3">
            <li><strong class="text-text">Best overall value:</strong> Road Ready Safety, {priceCents} all-in with a free instant certificate and nothing added at checkout.</li>
            <li><strong class="text-text">Best if you need a same-day certificate on a deadline:</strong> Road Ready Safety, I Drive Safely or IMPROV. All three include an electronic certificate at no extra cost; the other four either mail it or charge for the download.</li>
            <li><strong class="text-text">Best bilingual (English / Spanish):</strong> GetDefensive.com, $25.00 plus a certificate by mail in 2 to 3 business days.</li>
            <li><strong class="text-text">Best known national brand:</strong> DefensiveDriving.com, $25.00 for the text course, but the instant certificate is a $25.00 fee on top.</li>
            <li><strong class="text-text">Best app and audio experience:</strong> Aceable, well reviewed, but $44.00 all-in once the instant certificate fee is included.</li>
            <li><strong class="text-text">Cheapest headline price:</strong> Comedy Driving, DefensiveDriving.com and GetDefensive.com all advertise $25.00. None includes an instant certificate at that price.</li>
          </ul>
        </div>

        <div class="mb-2">
          <a
            href={enrollUrl}
            class="inline-flex bg-primary hover:bg-primary-hover text-white h-[44px] px-6 rounded-[12px] text-base font-semibold items-center justify-center no-underline"
            style={sans}
          >
            Start course
          </a>
        </div>

        <h2 id="comparison" class={h2} style={head}>Verified all-in price comparison ({verified})</h2>
        <div class="overflow-x-auto -mx-4 px-4 sm:mx-0 sm:px-0 mb-4 rounded-xl border border-border">
          <table class="w-full min-w-[760px] text-sm border-collapse">
            <thead>
              <tr class="bg-surface-muted text-left border-b border-border">
                {['Provider', 'TDLR license', 'All-in total', 'Instant certificate', 'Best for'].map(h => (
                  <th class="py-3 px-3 font-semibold text-text" style={sans}>{h}</th>
                ))}
              </tr>
            </thead>
            <tbody style={sans}>
              {picks.map(row => (
                <tr class={row.highlight ? 'bg-info border-b border-info-border' : 'border-b border-border'}>
                  <td class={row.highlight ? 'py-3 px-3 font-semibold text-text' : 'py-3 px-3 text-text'}>{row.provider}</td>
                  <td class="py-3 px-3 text-text-body">{row.cp}</td>
                  <td class={row.highlight ? 'py-3 px-3 font-bold text-primary-deep' : 'py-3 px-3 font-bold text-text'}>{row.total}</td>
                  <td class="py-3 px-3 text-text-body">{row.instantCert}</td>
                  <td class="py-3 px-3 text-text-body">{row.best}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-sm text-text-body mb-2" style={sans}>All-in totals are the course price plus any required processing fee, before the certificate options shown. Read on each provider's public site or checkout page on {verified}, without buying; Aceable and IMPROV were showing sale prices that day. Course fees are set by each provider and may change. Confirm at checkout.</p>
        <p class="text-text-body text-base leading-7 mb-10" style={sans}>Want every fee line explained, including the certificate add-ons and the court's own fee? See our <a href="/texas/cost" class={link}>Texas defensive driving cost page</a>.</p>

        <h2 class={h2} style={head}>Why a {floor} course ends up costing $40 or more</h2>
        <div class={prose} style={sans}>
          <p>Because at the {floor} legal minimum the certificate is usually free only by mail, in two to four weeks. You find that out after you finish. Your court has a deadline, so you pay a $10 to $25 fee to get it today, and the "cheapest" course becomes one of the most expensive. The one question that stops it: <strong class="text-text">"When I finish, is the certificate in my hands today at no extra cost?"</strong></p>
        </div>

        <h2 class={h2} style={head}>Why we recommend Road Ready Safety</h2>
        <div class={prose} style={sans}>
          <p>We'll be upfront: Road Ready Safety is our course. But the case for it is built entirely on the criteria above, and you can verify every claim on our <a href="/texas/cost" class={link}>cost page</a>:</p>
          <ul class="list-disc pl-6 space-y-3">
            <li><strong class="text-text">TDLR-approved ({cp})</strong> and accepted by Texas courts statewide for dismissal of an eligible citation.</li>
            <li><strong class="text-text">{priceCents} all-in</strong>, with no surprise checkout fees.</li>
            <li><strong class="text-text">Free instant certificate.</strong> You download it the moment you finish and can submit to your court the same day. Included, not a paid add-on.</li>
            <li><strong class="text-text">The full state-required {TEXAS_COURSE.hours} hours, online on any device</strong>, with progress saved so you can stop and resume.</li>
          </ul>
          <p>If another approved course fits your needs better, say you need it in Spanish, use it. The goal is a dismissed ticket, and any TDLR-approved certificate gets you there.</p>
        </div>

        <YouTubeCard id="Y6sT-z7uFWQ" />

        <h2 class={h2} style={head}>Frequently asked questions</h2>
        <div class="space-y-8 mb-12">
          {faqs.map(item => (
            <div>
              <h3 class="text-lg font-semibold text-text mb-2" style={head}>{item.q}</h3>
              <p class="text-text-body text-base leading-7" style={sans}>{item.a}</p>
            </div>
          ))}
        </div>

        <div class={prose} style={sans}>
          <p>Before you enroll in any course, make sure you're eligible and you've requested the course from your court. Start with <a href="/texas/request-defensive-driving" class={link}>how to request the course from your court</a>, or <a href="/texas/eligibility-tracker" class={link}>check your eligibility</a>. Found a price that looks off? <a href={contactUrl} class="text-primary-deep font-semibold hover:underline">Tell us</a> and we'll verify it.</p>
        </div>

        <div class="pt-4 border-t border-border">
          <a
            href={enrollUrl}
            class="inline-flex bg-primary hover:bg-primary-hover text-white h-[56px] px-8 rounded-[16px] text-lg font-semibold items-center justify-center no-underline"
            style={`${sans} box-shadow: 0px 10px 15px -3px rgba(17,23,34,0.08), 0px 4px 6px -4px rgba(17,23,34,0.05);`}
          >
            Take the {price} Course, Instant Certificate
          </a>
        </div>

        <p class="text-[13px] text-text-muted mt-10 leading-6" style={sans}>General information, not legal advice. Sources: 16 TAC ch. 84 (curriculum and length); Tex. Educ. Code §1001.352 (price floor); Tex. Code Crim. Proc. ch. 45A (dismissal); each provider's public pricing and checkout pages, read {verified}. Road Ready Safety is a TDLR-licensed provider ({cp}). Last updated {verified}.</p>
      </div>

      <CourseBand id="course" />
      <StickyCta afterId="comparison" hideAtId="course" />
    </article>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

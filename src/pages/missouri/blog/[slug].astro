---
/**
 * Missouri guide article. Overrides the shared `[state]/blog/[slug].astro` for /missouri/blog/*
 * only (a static path segment outranks a dynamic one), so the other states' guides are untouched.
 * Emits nothing while Missouri is disabled, exactly like the shared template. Guides that set their
 * own `path` are served there instead (see src/pages/missouri/best-driver-improvement-program).
 * The page itself is src/components/missouri/MissouriGuide.astro; posts live in src/data/blog/mo.json.
 */
import MissouriGuide from '../../../components/missouri/MissouriGuide.astro';
import mo from '../../../data/courses/mo-dip.json';
import { postsFor, type StatePost } from '../../../data/blog/index';
import { isEnabled } from '../../../lib/courseFlags';
import type { CourseData } from '../../../data/courses/types';

export function getStaticPaths() {
  if (!isEnabled(mo as CourseData)) return [];
  return postsFor('MO').filter((post) => !post.path).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: StatePost };
---

<MissouriGuide post={post} />

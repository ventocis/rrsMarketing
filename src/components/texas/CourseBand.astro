---
/**
 * CourseBand — the one course offer block for every Texas content page (Jackson, 2026-10-07: "we need this to
 * be the whole component", from the cost page's "What does Road Ready Safety charge?" band). Deep-blue panel,
 * the price as the only number, five checkmarks, the two costs we can't include with a link to the pricing
 * policy, a white "Start the course" button whose arrow never wraps to its own line, and the honest
 * "ask your court first" line. Pages pass `id` only when their sticky CTA hides at a different anchor.
 */
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
import reviews from '../../data/texas-reviews.json';
interface Props { id?: string; eyebrow?: string; review?: boolean; }
const { id = 'course', eyebrow, review: showReview = false } = Astro.props;
// Optional extras (2026-10-07, TDLR-approved canvas): an eyebrow above the heading and the verified Trustpilot card.
const review = showReview ? (reviews as any[]).find((r) => r.name === 'Ryan Johnson') : null;
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const price = TEXAS_PRICE_LABEL;
const checks = [
  `The ${TEXAS_COURSE.hours}-hour TDLR-approved course (${TEXAS_COURSE.providerNumber})`,
  'Certificate the moment you finish, court and insurance copies',
  'Unlimited quiz retakes',
  'No delivery, rush, premium or record fees',
  'Full refund if you request it before you complete the course or get your certificate',
];
const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
---
<section id={id} class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-12 scroll-mt-28 text-text" style={sans}>
  {eyebrow && <p class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep m-0 mb-2">{eyebrow}</p>}
  <h2 class="text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3" style={inter}>What does Road Ready Safety charge?</h2>
  <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">{price}, and that's the only number you'll see at checkout.</p>
  <div class="rounded-[20px] bg-primary-deep text-white p-7 lg:p-9 flex flex-wrap gap-8 items-center justify-between">
    {review && (
      <div class="w-full rounded-[18px] bg-white text-text px-6 py-6 flex flex-col gap-3">
        <span class="text-accent text-[22px] tracking-[3px]" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}</span>
        <blockquote class="m-0 text-[19px] lg:text-[21px] font-bold leading-[1.45]" style={inter}>"{review.quote}"</blockquote>
        <div class="flex items-center gap-3"><span class="w-10 h-10 rounded-full bg-primary text-white font-bold text-[15px] flex items-center justify-center" aria-hidden="true">{review.initials}</span><span class="flex flex-col text-[15px] leading-[1.35]"><strong>{review.name}</strong><span class="text-text-muted">{review.verified ? 'Verified via Trustpilot' : 'Trustpilot'} · {review.date}</span></span></div>
      </div>
    )}
    <ul class="flex-[999_1_420px] min-w-0 flex flex-col gap-3 list-none p-0 m-0 text-[17px]">
      {checks.map((c) => <li class="flex gap-2.5"><span class="text-info-border font-extrabold" aria-hidden="true">✓</span><span>{c}</span></li>)}
      <li class="flex gap-2.5 text-info text-base mt-1.5"><span class="text-info-border font-extrabold" aria-hidden="true">•</span><span>Two costs we can't include: the court's fee and the DPS record, because the court and DPS collect those. <a href="/texas/pricing" class="text-info-border font-semibold hover:underline">Our full pricing policy</a></span></li>
    </ul>
    <div class="flex-[1_1_240px] flex flex-col gap-3 justify-center">
      <a href={enrollUrl} data-rrs-cta="course-band" class="text-center no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-7 py-4 rounded-full whitespace-nowrap" style={inter}>Start the {price} course&nbsp;→</a>
      <a href="/texas/request-defensive-driving" class="text-center no-underline text-info hover:text-white font-medium">Haven't asked your court yet? Do that first.</a>
    </div>
  </div>
</section>

---
/**
 * CourseLayout — shared chrome for every per-state course site (/ohio, /north-dakota, /idaho,
 * /missouri). Generalised from AdeLayout so all state sites share one header, provider strip,
 * sticky mobile CTA and footer, driven entirely by the course data file.
 *
 * Compliance notes that apply to every state:
 *  - Only this state's approval number ever appears here. Never the Texas licence numbers.
 *  - While provider.approvalNumber is empty the page is noindex in every environment and the
 *    label reads "Approval Pending" (see src/lib/courseFlags.ts for why).
 *  - No promo codes, countdowns or compare-at prices — one flat price, stated plainly.
 */
import Layout from './Layout.astro';
import type { CourseData } from '../data/courses/types';
import { enrollUrl as buildEnrollUrl, loginUrl, contactUrl, siteUrl, isNoindex } from '../lib/courseFlags';

interface Props {
  course: CourseData;
  title: string;
  description?: string;
  keywords?: string;
  url: string;
  /** Extra JSON-LD or head tags from the page. */
  banner?: string;
}

const { course, title, description = course.seo.description, keywords = course.seo.keywords, url, banner = course.banner } = Astro.props;

const route = course.state.route;
const enrollUrl = buildEnrollUrl(course);
const currentYear = new Date().getFullYear();
const licenceLabel = course.provider.approvalNumber
  ? course.provider.approvalLabel.replace('{{number}}', course.provider.approvalNumber)
  : course.provider.approvalPendingLabel;
const noindex = isNoindex(course);

const courseLinks = [
  { href: route, label: course.course.shortName },
  { href: `${route}/pricing`, label: 'Pricing' },
  { href: `${route}/how-it-works`, label: 'How It Works' },
  { href: `${route}/faq`, label: 'FAQ' },
  { href: `${route}/blog`, label: 'Guides' },
];
const supportLinks = [
  { href: `${route}/helpcenter`, label: 'Help Center' },
  { href: contactUrl, label: 'Contact Us' },
  { href: loginUrl, label: 'Log In' },
];
// Privacy and Terms are the site-wide documents; refund and accessibility render per state.
const legalLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: `${route}/terms`, label: 'Terms' },
  { href: `${route}/refund`, label: 'Refund' },
  { href: `${route}/accessibility`, label: 'Accessibility' },
];

const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.course.name,
  description: course.seo.courseDescription,
  url: `${siteUrl}${route}`,
  provider: {
    '@type': 'Organization',
    name: course.provider.dba,
    legalName: course.provider.legalName,
    url: siteUrl,
    logo: `${siteUrl}/assets/icons/texas/logo-shield.svg`,
  },
  courseMode: 'online',
  educationalCredentialAwarded: course.seo.credential,
  timeRequired: `PT${course.course.hours}H`,
  inLanguage: 'en-US',
  isAccessibleForFree: false,
  availableLanguage: 'en',
  offers: {
    '@type': 'Offer',
    price: course.course.priceUsd,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}${route}`,
    areaServed: { '@type': 'State', name: course.state.name },
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: `PT${course.course.hours}H`,
    courseSchedule: { '@type': 'Schedule', repeatFrequency: 'P1D', repeatCount: -1 },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Road Ready Safety', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: course.course.shortName, item: `${siteUrl}${route}` },
    ...(url !== route ? [{ '@type': 'ListItem', position: 3, name: title.split(' | ')[0].split(' — ')[0], item: `${siteUrl}${url}` }] : []),
  ],
};
---

<Layout title={title} description={description} keywords={keywords} url={url} noindex={noindex}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <slot name="head" />
  </Fragment>

  <!-- Announcement banner. Flat-price statement only: no promo code, no countdown. -->
  <div class="bg-announcement-tx text-white text-sm font-semibold text-center py-2.5 px-4 leading-5 tracking-[0.01em]">
    {banner}
  </div>

  <header class="sticky top-0 z-50 bg-white border-b border-border shadow-[0px_1px_3px_0px_rgba(17,23,34,0.04)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href={route} class="flex items-center gap-2 no-underline flex-shrink-0">
          <img src="/assets/icons/texas/logo-shield.svg" alt="Road Ready Safety" class="w-9 h-9 flex-shrink-0" />
          <div class="flex flex-col leading-none">
            <span class="text-[14px] font-bold text-primary-navy leading-tight">Road Ready</span>
            <span class="text-[10px] font-medium text-text-body leading-tight">Safety &middot; {course.state.name}</span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
          {course.nav.map((item) => (
            <a href={item.href} class="text-sm font-medium text-text-body hover:text-text no-underline transition-colors">{item.label}</a>
          ))}
        </nav>

        <div class="hidden lg:flex items-center gap-3">
          <a href={loginUrl} class="h-10 px-5 border border-border text-text rounded-xl text-sm font-semibold flex items-center justify-center no-underline hover:bg-surface-muted transition-colors">Log In</a>
          <a href={enrollUrl} class="h-10 px-5 bg-primary hover:bg-primary-hover text-white rounded-xl text-sm font-semibold flex items-center justify-center no-underline transition-colors shadow-[0px_4px_6px_-1px_rgba(17,23,34,0.1)]">{course.hero.ctaLabel}</a>
        </div>

        <button
          id="course-menu-btn"
          class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg border border-border text-text-body hover:bg-surface-muted transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="course-menu"
        >
          <svg id="course-icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <svg id="course-icon-close" class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Provider identification strip: legal entity + this state's approval status. -->
    <div class="bg-surface-muted border-t border-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-1.5">
        <p class="text-[11px] text-text-muted text-center leading-4">
          {course.provider.legalName} d/b/a {course.provider.dba} &middot; {licenceLabel}
        </p>
      </div>
    </div>

    <div id="course-menu" class="hidden lg:hidden border-t border-border bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex flex-col gap-4">
        {course.nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-text-body hover:text-text no-underline py-2">{item.label}</a>
        ))}
        <hr class="border-border" />
        <div class="flex flex-col gap-3">
          <a href={loginUrl} class="h-10 px-5 border border-border text-text rounded-xl text-sm font-semibold flex items-center justify-center no-underline hover:bg-surface-muted transition-colors">Log In</a>
          <a href={enrollUrl} class="h-10 px-5 bg-primary hover:bg-primary-hover text-white rounded-xl text-sm font-semibold flex items-center justify-center no-underline transition-colors">{course.hero.ctaLabel}</a>
        </div>
      </div>
    </div>
  </header>

  <main class="pb-[72px] lg:pb-0">
    <slot />
  </main>

  <!-- Sticky mobile conversion bar. CSS only. -->
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-border shadow-[0_-4px_16px_-4px_rgba(17,23,34,0.10)]">
    <div class="flex items-center justify-between gap-3 px-4 py-3">
      <div class="flex flex-col leading-none">
        <span class="text-[19px] font-bold text-primary-navy" style="font-family:'Outfit',sans-serif;">${course.course.priceUsd}</span>
        <span class="text-[11px] text-text-muted mt-0.5">no hidden fees</span>
      </div>
      <a href={enrollUrl} class="flex-1 max-w-[220px] h-11 bg-primary hover:bg-primary-hover text-white rounded-xl text-[15px] font-semibold flex items-center justify-center no-underline transition-colors">
        {course.hero.ctaLabel}
      </a>
    </div>
  </div>

  <footer class="bg-surface-dark text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

        <div class="flex flex-col gap-6">
          <a href={route} class="flex items-center gap-2 no-underline">
            <img src="/assets/icons/texas/logo-shield.svg" alt="Road Ready Safety" class="w-10 h-10 flex-shrink-0" />
            <div class="flex flex-col leading-none">
              <span class="text-[14px] font-bold text-white leading-tight">Road Ready</span>
              <span class="text-[10px] font-medium text-text-subtle leading-tight">Safety &middot; {course.state.name}</span>
            </div>
          </a>
          <p class="text-sm text-text-subtle leading-6">{course.footer.blurb}</p>
          <div class="flex flex-col gap-1">
            <a href={`mailto:${course.provider.supportEmail}`} class="text-sm text-info-border hover:text-white no-underline transition-colors">{course.provider.supportEmail}</a>
            <a href={course.provider.supportPhoneHref} class="text-sm text-info-border hover:text-white no-underline transition-colors">{course.provider.supportPhone}</a>
            {course.provider.supportHours && <span class="text-xs text-text-muted">{course.provider.supportHours}</span>}
          </div>
          <div class="inline-flex items-center gap-2 rounded-full px-3 py-2 w-fit border border-white/15">
            <img src="/assets/icons/texas/tdlr-badge-footer.svg" alt="" class="w-4 h-4" />
            <span class="text-xs font-semibold text-info-border">{licenceLabel}</span>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Course</h3>
          <nav class="flex flex-col gap-3" aria-label="Course">
            {courseLinks.map((l) => (
              <a href={l.href} class="text-sm text-text-subtle hover:text-white no-underline transition-colors">{l.label}</a>
            ))}
            <a href={enrollUrl} class="text-sm text-text-subtle hover:text-white no-underline transition-colors">Start Course</a>
          </nav>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Support</h3>
          <nav class="flex flex-col gap-3" aria-label="Support">
            {supportLinks.map((l) => (
              <a href={l.href} class="text-sm text-text-subtle hover:text-white no-underline transition-colors">{l.label}</a>
            ))}
          </nav>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Legal</h3>
          <nav class="flex flex-col gap-3" aria-label="Legal">
            {legalLinks.map((l) => (
              <a href={l.href} class="text-sm text-text-subtle hover:text-white no-underline transition-colors">{l.label}</a>
            ))}
          </nav>
        </div>

      </div>

      <div class="border-t border-white/10 mt-12 pt-8 flex flex-col gap-4">
        <p class="text-xs text-text-muted leading-5 max-w-4xl">{course.footer.disclaimer}</p>
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <p class="text-sm text-text-muted">&copy; {currentYear} {course.provider.legalName} d/b/a {course.provider.dba}. All rights reserved.</p>
          <p class="text-xs text-text-muted">{licenceLabel}</p>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Event delegation — one listener on `document` survives full page loads AND
  // view-transition DOM swaps. Never bind to astro:page-load here (the router does not
  // ship in the production build; see the Texas layout for the bug this prevents).
  if (!(window as any).__rrsCourseMenuDelegated) {
    (window as any).__rrsCourseMenuDelegated = true;

    function setCourseMenuOpen(open: boolean) {
      const menu = document.getElementById('course-menu');
      const btn = document.getElementById('course-menu-btn');
      const iconOpen = document.getElementById('course-icon-open');
      const iconClose = document.getElementById('course-icon-close');
      if (!menu || !btn) return;
      menu.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    }

    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (target?.closest('#course-menu-btn')) {
        const menu = document.getElementById('course-menu');
        setCourseMenuOpen(menu?.classList.contains('hidden') ?? true);
        return;
      }
      if (target?.closest('#course-menu a')) {
        setCourseMenuOpen(false);
      }
    });
  }
</script>

---
/**
 * /adult-drivers-ed/texas/do-i-need-adult-drivers-ed — the eligibility router (MOFU).
 *
 * Rebuilt 2026-10-13 on the hook → answer → loop → funnel recipe (ADE-PAGE-RECIPE.md). Query family: "do you have
 * to take drivers ed in texas", "is drivers ed required in texas for adults", "how many hours of drivers ed is
 * required in texas". The answer is one age and one license, so the decision table sits directly under it; each
 * H2 after that is the next question a reader asks. The page's job is the next page: the Keep-reading cards route
 * each row of the table to its own guide, and the band speaks only to the rows that say Yes.
 *
 * Facts: src/data/ade-eligibility.ts (§521.1601, §521.167, DPS Apply and Moving to Texas pages) and
 * src/data/ade-texas.json. §84.40(j): never promise a license; exam wording is CLAIM only.
 *
 * 2026-10-29 (REPORT v3 §6, step 9): the site's one interactive checker sits above the table. Three questions
 * (age, any license, who issued it); results link into /requirements anchors. Price line on the 18–24 and 25+
 * results only, from src/data/ade-prices.ts; checkout button on the 18–24 result only. The table and FAQ below stay
 * as the crawlable version of the same logic. Script: one delegated listener (survives ViewTransitions); `hidden`
 * sits on plain wrapper divs, never on a flex element.
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import ade from '../../../data/ade-texas.json';
import { law, reciprocityCountries, fees, itd, CLAIM, WAIVER_LAPSE } from '../../../data/ade-eligibility';
import { adeEnrollUrl } from '../../../lib/ade';
import { competitors, online, checkedOn, longDate, usd } from '../../../data/ade-prices';

const base = '/adult-drivers-ed/texas';

// The one-breath answer. Same sentence in the meta description and the lede.
const answer = `Only if you're 18 to 24 and getting your first license. At ${law.ageCeiling} or older the six-hour course is optional, and a valid, unexpired license from another U.S. state waives it. Answer three questions to see your path.`;
const price = `$${ade.course.priceUsd}`;
const priceLine = `Online courses advertised ${usd(online.min)} to ${usd(online.max)} (median ${usd(online.median)}) when we checked ${competitors.length} providers on ${longDate(checkedOn)}. Ours is ${price} total.`;

// The checker's results. Keys are set by the script from the three answers.
const results = [
  { key: 'teen', need: 'Not this course', head: 'Under 18: the teen course applies', body: 'Texas drivers under 18 take a longer teen driver education course with supervised driving hours. The six-hour adult course is for 18 and over.', links: [] as { href: string; label: string }[], price: false, cta: false },
  { key: 'required', need: 'Required', head: 'You need the six-hour course', body: `Texas will not issue your first license without it (Transp. Code §521.1601). Take it before your first DPS visit; passing its final exam ${CLAIM}. ${WAIVER_LAPSE}`, links: [{ href: `${base}/requirements#18-24`, label: 'Everything you need at 18 to 24' }], price: true, cta: true },
  { key: 'transfer', need: 'Not required', head: 'Your license transfers', body: 'A valid license from another U.S. state, a U.S. territory or Canada, or one not expired over two years, is a transfer: no course, no knowledge or skills exam, no ITAD. You surrender it when you apply.', links: [{ href: `${base}/requirements#out-of-state`, label: 'What you still bring to DPS' }, { href: `${base}/new-resident-out-of-state-license`, label: 'New residents, in full' }], price: false, cta: false },
  { key: 'reciprocity', need: 'Usually not', head: 'Your country has a reciprocity agreement', body: `Texas has reciprocity with ${reciprocityCountries.join(', ')}. With a valid, unexpired license from one of them, DPS may waive the exams and the course. Check with DPS before you apply.`, links: [{ href: `${base}/foreign-license-texas`, label: 'Foreign licenses in Texas' }], price: false, cta: false },
  { key: 'optional', need: 'Optional', head: 'At 25 or older, the course is optional', body: `You still need your documents, the $${fees.newLicense18to84} fee, ${itd.adultName} and the DPS tests. DPS calls the course highly recommended for first-time applicants.`, links: [{ href: `${base}/requirements#25-plus`, label: 'Everything you need at 25 and over' }, { href: base, label: 'Take the 6-hour course anyway (optional at 25+)' }], price: true, cta: false },
];
const questions = [
  { id: 'age', q: 'How old are you?', opts: [['under18', 'Under 18'], ['18-24', '18 to 24'], ['25plus', '25 or older']] },
  { id: 'has', q: 'Do you have a driver license now, from anywhere?', opts: [['no', 'No, this is my first'], ['yes', 'Yes']] },
  { id: 'from', q: 'Who issued it, and is it current?', opts: [['state', 'Another U.S. state, a U.S. territory or Canada, valid or expired 2 years or less'], ['recip', `${reciprocityCountries.join(', ')}, valid`], ['other', 'Another country, or expired more than 2 years']] },
];

// The decision this page exists to settle. Each row is a different legal answer, not a
// rephrasing: §521.1601(a) sets the under-25 rule, (b) carves out another state's license,
// and DPS's own Moving to Texas page extends that to U.S. territories, Canada and five
// reciprocity countries.
const rows = [
  { who: 'You are 18–24 and this is your first driver license anywhere', need: 'Yes', why: 'The six-hour adult course is required before DPS can issue the license.' },
  { who: 'You are 18–24 and hold a valid license from another U.S. state', need: 'No', why: 'Surrender it when you apply. The course, the exams and ITD are all waived.' },
  { who: 'You are 18–24 and hold a valid license from a U.S. territory or Canada', need: 'No', why: 'DPS treats these as transfers, with no knowledge or skills exam.' },
  { who: `You are 18–24 and hold a valid license from ${reciprocityCountries.slice(0, -1).join(', ')} or ${reciprocityCountries.at(-1)}`, need: 'Usually no', why: 'Texas has reciprocity with these five countries, so the exams may be waived.' },
  { who: 'You are 18–24 and hold a license from any other country', need: 'Yes', why: 'A foreign license is not "another state". This is the case most people get wrong.' },
  { who: 'You are 18–24 and your out-of-state license expired more than two years ago', need: 'Yes', why: 'The waiver depends on the license being valid, or expired no more than two years.' },
  { who: 'You are 25 or older', need: 'No', why: 'No driver education requirement at any point. You may still choose the course.' },
];

const faqs = [
  {
    q: 'Do I need driver education to get a Texas driver license as an adult?',
    a: 'Only if you are under 25. Texas Transportation Code §521.1601 says the Department may not issue a driver license to a person younger than 25 without a driver education certificate. DPS applies this as a six-hour adult driver education course if you are 18 through 24 and applying for your first Texas driver license. There is no driver education requirement at 25 or older.',
  },
  {
    q: 'How many hours of drivers ed is required in Texas for adults?',
    a: `Six hours if you are 18 through 24 and getting a first license. Texas defines the adult course as ${ade.course.courseMinutes} minutes, with at least ${ade.course.instructionMinutes} minutes of instruction. At 25 and older no driver education hours are required.`,
  },
  {
    q: 'I am 22 and moving to Texas with a license from another state. Do I need the course?',
    a: 'No. §521.1601(b) says the rule does not apply to a person who holds a valid driver license issued by another state. DPS goes further on its Moving to Texas page: if you are 18 or older and hold a valid out-of-state license, or one not expired over two years, you are exempt from the knowledge and skills exams as well as the ITD and adult driver education requirements. You surrender the out-of-state license when you apply.',
  },
  {
    q: 'I have a driver license from another country. Does that exempt me?',
    a: `Usually not. The exemption in §521.1601(b) is for a license issued by another state, and a foreign license is not another state. DPS treats licenses from U.S. territories and Canada as transfers, and Texas has reciprocity with ${reciprocityCountries.join(', ')}. If your license was issued anywhere else and you are 18 through 24, you still need the six-hour adult driver education course. DPS also requires a license not in English or Spanish to be translated by a translation service or your consulate before you arrive.`,
  },
  {
    q: 'Is adult driver education required at 25 in Texas?',
    a: 'No. DPS states that there are no driver education requirements for ages 25 and older. You still take the knowledge and skills exams unless you are transferring a license, and you still need an Impact Texas Adult Drivers certificate before the driving skills test.',
  },
  {
    q: 'What does the six-hour course actually do for me?',
    a: `It ${CLAIM}. Under §521.167, finishing an approved adult driver education course means you are not required to take the highway sign and traffic law parts of the DPS examination, once a licensed driver education instructor has confirmed you passed them. It does not remove the vision test or the driving skills test, and it is not a driver license. ${WAIVER_LAPSE}`,
  },
  {
    q: 'How much is the license itself?',
    a: `A new Class C driver license for ages 18 to 84 is $${fees.newLicense18to84} and lasts ${fees.newLicenseTermYears} years. That is the DPS fee and is separate from any course.`,
  },
];

faqs.unshift({
  q: 'How do I know if I need drivers ed in Texas?',
  a: `Answer three questions. How old are you? Under 18 takes the teen course; 18 to 24 needs the six-hour adult course for a first license; 25 and over is optional. Do you hold a license now? If not, your age decides. Who issued it? A valid license from another U.S. state, a U.S. territory or Canada, or one not expired over two years, transfers with no course; a license from ${reciprocityCountries.join(', ')} may too; any other country does not.`,
});

const next = [
  { href: `${base}/first-texas-license-18-to-24`, title: 'Your row says Yes: first license at 18 to 24', blurb: 'What the law requires, and the order to do the course, the video and the tests.' },
  { href: `${base}/drivers-ed-over-25`, title: 'You are 25 or older', blurb: 'Not required. What the course still does for the knowledge exam, and what never changes.' },
  { href: `${base}/new-resident-out-of-state-license`, title: 'Moving here with an out-of-state license', blurb: 'A transfer: no course and no tests, but there is still a clock and paperwork.' },
  { href: `${base}/foreign-license-texas`, title: 'Moving here with a license from another country', blurb: 'Which countries count, and why most foreign licenses still need the course at 18 to 24.' },
];
---

<AdeGuide
  title="Do You Need Drivers Ed in Texas? 2-Minute Age Check"
  description={answer}
  url={`${base}/do-i-need-adult-drivers-ed`}
  eyebrow="Eligibility · The rule by age and license"
  h1="Do you need drivers ed in Texas? Answer 3 questions"
  lede={`${answer} The license exception is narrower than it sounds, because a license from most other countries does not count as another state.`}
  faqs={faqs}
  dateModified="2026-10-29"
  updated="October 29, 2026"
  band={{ eyebrow: 'If your row says Yes' }}
  next={next}
  sources={[
    { label: 'Tex. Transp. Code §521.1601, Driver Education Required; Exception', href: 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm' },
    { label: 'Tex. Transp. Code §521.167, Waiver of Certain Education and Examination Requirements', href: 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm' },
    { label: 'Texas DPS, Apply for a Texas Driver License', href: 'https://www.dps.texas.gov/section/driver-license/apply-texas-driver-license' },
    { label: 'Texas DPS, Moving to Texas: A Guide to Driver Licenses and IDs', href: 'https://www.dps.texas.gov/section/driver-license/moving-texas' },
  ]}
>

  <section id="check" class="flex flex-col gap-5" data-ade-check>
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Check your case</h2>
    {questions.map((q, i) => (
      <div data-q={q.id} hidden={i > 0}>
        <fieldset class="border-0 p-0 m-0">
          <legend class="text-[17px] font-semibold text-text mb-3">{i + 1}. {q.q}</legend>
          <div class="flex flex-wrap gap-2">
            {q.opts.map(([v, label]) => (
              <button type="button" data-a={q.id} data-v={v} aria-pressed="false" class="text-left text-[15px] leading-6 px-4 py-2.5 rounded-xl border border-border bg-white text-text hover:border-primary-deep aria-pressed:bg-primary aria-pressed:text-white aria-pressed:border-primary">{label}</button>
            ))}
          </div>
        </fieldset>
      </div>
    ))}
    {results.map((r) => (
      <div data-result={r.key} hidden>
        <div class="rounded-[16px] border-2 border-primary-deep bg-info p-5 flex flex-col gap-3" role="status">
          <p class="text-xs font-bold uppercase tracking-wider text-primary-deep m-0">Course: {r.need}</p>
          <p class="text-[19px] font-bold text-text m-0" style="font-family:'Outfit',sans-serif;">{r.head}</p>
          <p class="text-[16px] text-text-body leading-7 m-0">{r.body}</p>
          {r.price && <p class="text-[15px] text-text-body leading-6 m-0">{priceLine} <a class="underline hover:no-underline" href={`${base}/cost#how-much`}>See real prices</a></p>}
          {r.links.length > 0 && <p class="text-[15px] leading-6 m-0">{r.links.map((l, i) => <>{i > 0 && ' · '}<a class="underline hover:no-underline text-primary-deep" href={l.href}>{l.label}</a></>)}</p>}
          {r.cta && <p class="m-0"><a href={adeEnrollUrl} data-rrs-cta="ade-checker-required" class="inline-flex items-center justify-center min-h-12 py-3 px-6 rounded-full bg-primary hover:bg-primary-hover text-white font-semibold no-underline">Start the 6-hour course &middot; {price}</a></p>}
        </div>
      </div>
    ))}
    <p class="m-0"><button type="button" data-ade-reset class="text-[15px] underline text-text-muted bg-transparent border-0 p-0 cursor-pointer">Start over</button></p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Do you need drivers ed? Find your age and your license</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      You need it if you are 18 to 24 and do not hold a valid license from another U.S. state, a U.S.
      territory or Canada. At 25 or older you do not. Every other case is a row below.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 pr-4 text-sm font-semibold text-text align-top">Your situation</th>
            <th class="py-3 pr-4 text-sm font-semibold text-text align-top whitespace-nowrap">Course required?</th>
            <th class="py-3 text-sm font-semibold text-text align-top">Why</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-border align-top">
              <td class="py-4 pr-4 text-[15px] text-text-body leading-6">{r.who}</td>
              <td class="py-4 pr-4 text-[15px] font-semibold text-text leading-6 whitespace-nowrap">{r.need}</td>
              <td class="py-4 text-[15px] text-text-body leading-6">{r.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What does the law actually say?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Texas Transportation Code §521.1601 says the Department of Public Safety may not issue a driver
      license to a person younger than {law.ageCeiling} unless that person submits a driver education
      certificate. DPS states the same rule in plainer words on its own application page:
    </p>
    <blockquote class="border-l-4 border-border pl-5 py-1 m-0">
      <p class="text-[17px] text-text-body leading-[30px] italic m-0">&ldquo;{law.dpsRequirementText}&rdquo;</p>
      <cite class="text-sm text-text-muted not-italic">&mdash; Texas DPS, Apply for a Texas Driver License</cite>
    </blockquote>
    <p class="text-[17px] text-text-body leading-[30px]">
      So the rule turns on two things, your age and the license you already hold. How long you have
      been driving does not enter into it.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">
      Does a driver license from another country exempt you?
    </h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Usually not. The exemption in §521.1601(b) reads, in full: &ldquo;{law.exemptionText}&rdquo; A
      license from Oklahoma exempts you. A license from Mexico, India, Nigeria, the Philippines or
      Brazil does not, because none of those is a state.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      DPS softens the edges a little in practice. Its Moving to Texas page treats a license from a
      U.S. territory or Canada as a transfer with no knowledge or skills exam, and Texas holds
      reciprocity agreements with {reciprocityCountries.slice(0, -1).join(', ')} and {reciprocityCountries.at(-1)}.
      Outside that list, if you are 18 through 24, the six-hour course applies to you even though you
      have been driving legally for years somewhere else.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      The same DPS page requires a license that is not in English or Spanish to be translated by a
      translation service or your consulate <em>before</em> you arrive in Texas. People find this out
      at the counter.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What does the course do for you, and what does it leave to DPS?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Passing it {CLAIM}. Under §521.167, passing an approved adult driver education course means you
      are not required to take the highway sign and traffic law parts of the DPS examination, once a
      licensed driver education instructor confirms you passed them.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">It does not do any of the following, and any provider who tells you otherwise is overselling.</p>
    <ul class="flex flex-col gap-3 pl-5 m-0 list-disc marker:text-text-subtle">
      <li class="text-[17px] text-text-body leading-[30px]">It is not a driver license, and no course can promise you one.</li>
      <li class="text-[17px] text-text-body leading-[30px]">It does not remove the vision test.</li>
      <li class="text-[17px] text-text-body leading-[30px]">It does not remove the driving skills test, which is the part with the long queue at most DPS offices.</li>
      <li class="text-[17px] text-text-body leading-[30px]">It does not replace{' '}<a class="underline hover:no-underline" href={`${base}/impact-texas-adult-drivers`}>{itd.adultName}</a>, the {itd.adultLengthHours}-hour video you must show before the skills test.</li>
    </ul>
    <p class="text-[17px] text-text-body leading-[30px]">
      Every step, in order, is in{' '}<a class="underline hover:no-underline" href={`${base}/how-to-get-a-texas-license-as-an-adult`}>how to get a Texas driver license as an adult</a>.
    </p>
  </section>

</AdeGuide>

<script is:inline>
  // One delegated listener on document, so it keeps working after ViewTransitions swaps the page.
  (function () {
    if (window.__adeCheck) return;
    window.__adeCheck = true;
    function show(root, sel, on) { root.querySelectorAll(sel).forEach(function (el) { el.hidden = !on; }); }
    function outcome(a) {
      if (a.age === 'under18') return 'teen';
      if (!a.has) return null;
      if (a.has === 'no') return a.age === '25plus' ? 'optional' : 'required';
      if (!a.from) return null;
      if (a.from === 'state') return 'transfer';
      if (a.from === 'recip') return 'reciprocity';
      return a.age === '25plus' ? 'optional' : 'required';
    }
    function render(root) {
      var a = JSON.parse(root.dataset.answers || '{}');
      root.querySelector('[data-q="has"]').hidden = !a.age || a.age === 'under18';
      root.querySelector('[data-q="from"]').hidden = a.has !== 'yes' || a.age === 'under18';
      root.querySelectorAll('[data-a]').forEach(function (b) { b.setAttribute('aria-pressed', String(a[b.dataset.a] === b.dataset.v)); });
      var key = outcome(a);
      show(root, '[data-result]', false);
      if (key) root.querySelector('[data-result="' + key + '"]').hidden = false;
    }
    document.addEventListener('click', function (e) {
      var t = e.target instanceof Element ? e.target : null;
      if (!t) return;
      var root = t.closest('[data-ade-check]');
      if (!root) return;
      var btn = t.closest('[data-a]');
      if (btn) {
        var a = JSON.parse(root.dataset.answers || '{}');
        a[btn.dataset.a] = btn.dataset.v;
        if (btn.dataset.a === 'age') { delete a.has; delete a.from; }
        if (btn.dataset.a === 'has') { delete a.from; }
        root.dataset.answers = JSON.stringify(a);
        render(root);
      } else if (t.closest('[data-ade-reset]')) {
        root.dataset.answers = '{}';
        render(root);
      }
    });
  })();
</script>

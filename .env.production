VITE_SITE_URL=https://roadreadysafety.com
VITE_PORTAL_URL=https://app.roadreadysafety.com
# if you update gtm id, also update it in the deployment env vars
VITE_GTM_ID=GTM-WR3LFPW5
VITE_ENABLE_ANALYTICS=true
VITE_IS_QA=false
VITE_TEXAS_ROUTES_ENABLED=true
VITE_TEXAS_ENROLLMENT_URL=https://app.roadreadysafety.com/public/checkout?sku=tx-bdi
VITE_CONTACT_US_URL=https://app.roadreadysafety.com/contact
VITE_LOGIN_URL=https://app.roadreadysafety.com/public/login
# Adult Driver Education (ADE-1317) — MUST stay false until the TDLR Driver Education
# Provider licence is approved. 16 TAC §84.80(e) bars provider-name advertising,
# enrollment and payment before approval, and §84.503(j)(4) requires the DE licence
# number (not CP#1234) to be visible through registration and payment.
# Set explicitly rather than omitted: Astro loads .env.local in every mode, so an
# omitted key here would let a developer's local "true" leak into a production build.
VITE_ADE_ROUTES_ENABLED=false

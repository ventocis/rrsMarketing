---
/**
 * /adult-drivers-ed/texas/never-had-a-license — for adults getting a first license from zero ("never had a
 * drivers license", "first time driver license adult texas", "drivers license at 30").
 *
 * Rebuilt 2026-10-13 on the hook → answer → loop → funnel recipe (SEO/ADE-PAGE-RECIPE.md). The hook is that Texas
 * has no age limit and the course turns optional at 25. Sentences about learner licenses for adults are left
 * exactly as they were (being verified separately). Facts: ade-eligibility.ts and src/lib/dps-stats.ts.
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import {law, itd, fees, CLAIM} from '../../../data/ade-eligibility';
import { dpsStats as W } from '../../../lib/dps-stats';

const base = '/adult-drivers-ed/texas';

// The one-breath answer, reused in the lede and the meta description.
const answer = `Texas has no upper age limit on a first driver license. Under ${law.ageCeiling} the six-hour course is required; at ${law.ageCeiling} and over it is optional, and DPS calls it highly recommended.`;

const faqs = [
  { q: 'Can I get a driver license for the first time as an adult in Texas?', a: 'Yes, at any age. There is no upper limit and no requirement that you started as a teenager. The process is the one every adult applicant follows: documents, the tests, and the six-hour driver education course if you are under 25.' },
  { q: 'How do I get a driver license at 30 in Texas if I have never had one?', a: `The same way as at any adult age, without the course requirement. At 30 the six-hour course is optional. You still bring your documents, watch the ${itd.adultName} video within ${itd.certValidDays} days of your driving skills test, pay the $${fees.newLicense18to84} DPS fee, and pass the vision, knowledge and driving skills tests.` },
  { q: 'I am over 25 and have never driven. Do I need the course?', a: `No. DPS has no driver education requirement at 25 and older, though it calls the course highly recommended for first-time applicants. Many first-time drivers take it anyway, because it ${CLAIM} and means one fewer test to sit cold.` },
  { q: 'Do I need a learner license first?', a: 'Texas learner licenses are issued to applicants aged 15 to 17. As an adult you apply for the driver license itself. You will still want practice before the driving skills test, and driving unlicensed to get it is not an option.' },
  { q: 'How do I practice if I have never driven?', a: 'Commercial driving schools offer behind-the-wheel lessons for adults, and a licensed driver can supervise practice in some circumstances. The six-hour course is classroom material only. It does not teach you to operate a car, and no online course does.' },
  { q: 'How long will this take?', a: `Mostly as long as the wait for a driving skills test, plus the practice you need. When we read the DPS wait-time report on ${W.capturedOn}, the median wait across ${W.driveTest.measured} offices was ${W.driveTest.median} days and ${W.driveTest.over30} offices were more than a month out. The six hours of the course are the fast part.` },
];

const next = [
  { href: `${base}/do-i-need-adult-drivers-ed`, title: 'Do you need adult drivers ed?', blurb: 'The rule by age and by license, in one place.' },
  { href: `${base}/adult-learner-permit-texas`, title: 'Learner permits and adults', blurb: 'What Texas says about permits once you are 18, and how practice fits in.' },
  { href: `${base}/how-to-get-a-texas-license-as-an-adult`, title: 'The whole process, step by step', blurb: 'Seven steps from documents to the card, in the order that works.' },
  { href: `${base}/texas-driving-test`, title: 'The driving skills test', blurb: 'What DPS checks on the road, and why no course replaces practice.' },
  { href: `${base}/drivers-ed-over-25`, title: 'If you are 25 or older', blurb: 'The course is optional. What you do still need.' },
  { href: `${base}/impact-texas-adult-drivers`, title: 'The ITAD video and its 90-day limit', blurb: 'Why the free DPS video comes after you book the test.' },
];
---

<AdeGuide
  title="Never Had a Driver License? Texas Has No Age Limit, Course Optional at 25+ | Road Ready Safety"
  description={answer}
  url={`${base}/never-had-a-license`}
  eyebrow="First-time drivers"
  h1="Never had a driver license? Texas has no age limit, and at 25 the course becomes optional"
  lede={`${answer} The rest is documents, the ${itd.adultName} video and the tests. The one thing no online course can give you, time behind the wheel, is covered below.`}
  faqs={faqs}
  dateModified="2026-10-13"
  updated="October 13, 2026"
  band={{ eyebrow: 'Starting from zero' }}
  next={next}
  sources={[
    { label: 'Texas DPS, Apply for a Texas Driver License', href: 'https://www.dps.texas.gov/section/driver-license/apply-texas-driver-license' },
    { label: 'Tex. Transp. Code §521.1601 and §521.167', href: 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm' },
    { label: 'Texas DPS, Third Party Skills Testing Program', href: 'https://www.dps.texas.gov/section/driver-license/third-party-skills-testing-program' },
    { label: `Texas DPS, Driver License Appointment and Office Wait Times (read ${W.capturedOn})`, href: 'https://www.dps.texas.gov/apps/Viewer/Document/Vue/WAITTIMES' },
  ]}
>
  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Is there an age limit on a first Texas driver license?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      No. Texas has no upper age limit and no penalty for starting late. Plenty of people reach thirty,
      forty or fifty without ever getting licensed, because of city living, no car, never getting around
      to it, or a bad early experience.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What does your age change?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Only whether the six-hour course is required. Under {law.ageCeiling}, it is. At 25 and over, it is
      not, though DPS calls it &ldquo;highly recommended&rdquo; for first-time applicants over 25.
      Nothing else about the process changes with age. The documents, the fee, the vision test, the
      knowledge test, the {itd.adultName} video and the driving skills test are the same at 22 and at 52.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      The full rule for older first-timers is in{' '}
      <a class="underline hover:no-underline" href={`${base}/drivers-ed-over-25`}>drivers ed at 25 or older</a>.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Will an online course teach you to drive?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      No. The adult driver education course is classroom material. It covers the law, the signs,
      right-of-way and risk, and it {CLAIM}. It does not teach you to drive a car, and neither does any
      other online course. If you have genuinely never driven, budget for behind-the-wheel practice
      separately &mdash; a commercial driving school, or supervised practice where that is permitted.
      You cannot practice by driving unlicensed.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">How long does a first license take from zero?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Mostly as long as your practice and your wait for a road test. The rest moves quickly.
    </p>
    <ul class="flex flex-col gap-3 pl-5 m-0 list-disc marker:text-text-subtle">
      <li class="text-[17px] text-text-body leading-[30px]"><strong>Documents:</strong> an afternoon, if you have them. Longer if you need a birth certificate or Social Security card.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>The course, if required:</strong> six hours, self-paced.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>Behind-the-wheel practice:</strong> the real variable. Do not rush it.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>The skills test appointment:</strong> median {W.driveTest.median} days, {W.driveTest.over30} of {W.driveTest.measured} offices over a month.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>The {itd.adultName} video:</strong> {itd.adultLengthHours} hour, with a certificate that must be dated within {itd.certValidDays} days of the driving skills test, so watch it after you book.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>The card itself:</strong> about two to three weeks by mail after you pass, on top of the temporary license you leave with.</li>
    </ul>
    <p class="text-[17px] text-text-body leading-[30px]">
      The DPS fee for a new license at 18 to 84 is ${fees.newLicense18to84}, and it lasts{' '}
      {fees.newLicenseTermYears} years. Every step, in order, is in{' '}
      <a class="underline hover:no-underline" href={`${base}/how-to-get-a-texas-license-as-an-adult`}>how to get a Texas driver license as an adult</a>.
    </p>
  </section>
</AdeGuide>

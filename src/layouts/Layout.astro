---
import '../styles/global.css';
import { TEXAS_COURSE } from '../data/texas-course';
import { adeLicensed, ADE_LICENSE, ADE_VERIFY_URL } from '../lib/ade';
import { version } from '../../package.json';
import { isProductionSite, PROD_SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Accepted for compatibility; no longer rendered (search engines ignore meta keywords). */
  keywords?: string;
  image?: string;
  url?: string;
  noindex?: boolean;
  /** BCP-47 language of the page content (default en). */
  lang?: string;
  /** hreflang alternates: [{ lang, href }] — include the page itself and x-default. */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description = 'State-approved traffic school and defensive driving built to be simple.',
  keywords = 'traffic school, defensive driving, online course, traffic ticket',
  image = '/assets/og-default.png',
  url = '/',
  noindex = false,
  lang = 'en',
  alternates = [],
} = Astro.props;

const siteUrl = import.meta.env.VITE_SITE_URL || PROD_SITE_URL;
// The canonical (with og:url and hreflang) always names production, whatever host this build is served
// from: a QA copy that gets crawled then consolidates to the real page instead of competing with it.
const canonicalUrl = `${PROD_SITE_URL}${url}`;
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const enableAnalytics = import.meta.env.VITE_ENABLE_ANALYTICS === 'true';
const gtmId = import.meta.env.VITE_GTM_ID;
// Only the production build may be indexed (src/lib/site.ts). QA also enables analytics, so the
// old analytics-only test let QA pages go out as index,follow.
const isNoindex = noindex || !isProductionSite;
const pageTitle = title.includes('Road Ready') ? title : `${title} | Road Ready Safety`;
// Organization JSON-LD. hasCredential points at TDLR's own record of each license so an assistant or crawler can
// verify CP1234 independently (ChatGPT, 2026-10-08: "I can't independently confirm its current license status").
// The driver education license (C3705, 2026-10-13) is listed the same way; the organization holds both.
const tdlr = { '@type': 'GovernmentOrganization', name: 'Texas Department of Licensing and Regulation', alternateName: 'TDLR', url: 'https://www.tdlr.texas.gov/' };
const credentials = [
  {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'license',
    name: 'Texas Driving Safety Course Provider License',
    identifier: TEXAS_COURSE.providerNumber,
    url: TEXAS_COURSE.verifyUrl,
    recognizedBy: tdlr,
  },
  ...(adeLicensed
    ? [{
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'license',
        name: 'Texas Driver Education Provider License',
        identifier: ADE_LICENSE,
        url: ADE_VERIFY_URL,
        recognizedBy: tdlr,
      }]
    : []),
];
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Road Ready Safety',
  legalName: 'Road Ready Driver Instruction LLC',
  url: 'https://roadreadysafety.com',
  email: 'info@roadreadysafety.com',
  logo: 'https://roadreadysafety.com/assets/icons/texas/logo-shield.svg',
  contactPoint: { '@type': 'ContactPoint', telephone: '+1-888-885-5707', contactType: 'customer support' },
  sameAs: [
    'https://facebook.com/roadreadysafety',
    'https://www.youtube.com/@RoadReadySafety',
    'https://www.trustpilot.com/review/roadreadysafety.com',
  ],
  hasCredential: credentials,
};
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href.startsWith("http") ? a.href : `${PROD_SITE_URL}${a.href}`} />)}
    <meta name="robots" content={isNoindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="google-site-verification" content="VRxAjfZgmw2EG3f_aiEU6rupWURg-2h5kaOU3fr7uKo" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Road Ready Safety" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/assets/icons/texas/logo-shield.svg" />

    <!-- Fonts: preconnect first, then load with display=optional -->
    <!-- display=optional: browser uses fallback if font isn't cached — eliminates font-swap CLS entirely -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=optional"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=optional"
      rel="stylesheet"
    />

    <!-- Named slot for page-specific head content (schema, etc.) -->
    <slot name="head" />

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Google Tag Manager (via GTM Gateway) -->
    {enableAnalytics && gtmId && (
      <script define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        '/gtm/?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}
  </head>
  <body class="w-full overflow-x-hidden m-0 p-0 bg-white text-text" style="font-family: 'DM Sans', sans-serif;">
    <!-- Google Tag Manager (noscript) -->
    {enableAnalytics && gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <slot />
    <script define:vars={{ version }}>
      console.log(
        '%c Road Ready Safety %c v' + version + ' ',
        'background:#1B2B5E;color:#fff;font-weight:700;padding:2px 6px;border-radius:3px 0 0 3px;font-family:monospace;',
        'background:#2563EB;color:#fff;font-weight:700;padding:2px 6px;border-radius:0 3px 3px 0;font-family:monospace;'
      );
    </script>
  </body>
</html>

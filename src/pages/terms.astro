---
/**
 * Site-wide Terms of Service and Student Policies. One markdown source
 * (src/content/policies/terms.md) renders here, on /texas/terms and on every state course site,
 * so the document is identical everywhere.
 */
import DocLayout from '../layouts/DocLayout.astro';
import { renderPolicy } from '../lib/policies';

const html = renderPolicy('terms.md');
---

<DocLayout
  title="Terms of Service and Student Policies"
  description="Road Ready Safety's terms of service and student policies: identity verification, refunds, grievances, records, accessibility and state-specific provisions."
  url="/terms"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Terms of Service' }]}
>
  <h1>Terms of Service and Student Policies</h1>
  <p><strong>Road Ready Driver Instruction LLC d/b/a Road Ready Safety</strong></p>
  <Fragment set:html={html} />
</DocLayout>

---
import { usd, hours, truncate } from '../utils/format';
import ade from '../data/ade-texas.json';
import { adeEnabled, adeEnrollUrl } from '../lib/ade';
import { TEXAS_COURSE } from '../data/texas-course';

interface Course {
  slug: string;
  state: string;
  course_name: string;
  course_type: string;
  language: string;
  duration_hours?: number;
  price_usd?: number | string;
  blurb?: string;
  description?: string;
  provider_type?: string;
  provider_name?: string;
  affiliate_link?: string;
  qa_link?: string;
}

interface Props {
  course: Course;
}

const { course: raw } = Astro.props;

// Texas adult driver education is our own licensed course now (TDLR C3705, 2026-10-13). courses.json still
// carries the old TicketSchool reseller entry under this slug; once the license gate is on, the card shows
// our course and sends people to our landing page and checkout, the way tx-defensive maps to /texas.
const ADE_SLUG = 'tx-adult-ed';
const isAdeCard = adeEnabled && raw.slug === ADE_SLUG;
// Texas defensive driving is likewise our own TDLR-licensed course (CP1234): courses.json still carries the
// old TicketSchool reseller row, and the card used to print "Provided by TicketSchool" under a link to /texas.
const isOurTexasCard = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true' && raw.slug === 'tx-defensive';
const course: Course = isOurTexasCard
  ? { ...raw, price_usd: TEXAS_COURSE.price, provider_type: 'Road Ready Safety', provider_name: undefined, affiliate_link: undefined }
  : isAdeCard
  ? {
      ...raw,
      course_name: ade.course.name,
      price_usd: ade.course.priceUsd,
      blurb: `The six-hour TDLR-approved course Texas requires for a first license at 18 to 24, with the exam built in and the certificate included. TDLR driver education provider ${ade.provider.deLicenseNumber}.`,
      provider_type: 'Road Ready Safety',
      provider_name: undefined,
      affiliate_link: undefined,
      qa_link: undefined,
    }
  : raw;

const portalUrl = import.meta.env.VITE_PORTAL_URL || 'https://app.roadreadysafety.com';
const isQa = import.meta.env.VITE_IS_QA === 'true';
const isTexasEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const texasEnrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || 'https://app.roadreadysafety.com/public/checkout?sku=tx-bdi';
const TEXAS_SLUG = 'tx-defensive';

function getLearnMoreHref(slug: string) {
  if (isTexasEnabled && slug === TEXAS_SLUG) return '/texas';
  if (isAdeCard) return '/adult-drivers-ed/texas';
  return `/courses/${slug}`;
}

function getSignUpHref(course: Course) {
  // TX: "Sign up" goes straight to checkout, not the /texas marketing page
  if (isTexasEnabled && course.slug === TEXAS_SLUG) return isQa && course.qa_link ? course.qa_link : texasEnrollUrl;
  if (isAdeCard) return adeEnrollUrl;
  if (isQa && course.qa_link) return course.qa_link;
  if (course.provider_type === 'Partner' && course.affiliate_link) return course.affiliate_link;
  return portalUrl;
}

const isPartner = course.provider_type === 'Partner';
const signUpHref = getSignUpHref(course);
const learnMoreHref = getLearnMoreHref(course.slug);
---

<div class="bg-surface-muted rounded-[20px] p-6 flex flex-col justify-between h-full border border-border hover:shadow-md transition-shadow">
  <div>
    <h3 class="text-lg font-semibold text-text mb-3">{course.course_name}</h3>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 text-sm mb-3">
      {course.duration_hours && (
        <span class="rounded-md bg-white text-text border border-border px-2 py-1">{hours(course.duration_hours)}</span>
      )}
      {course.language && (
        <span class="rounded-md bg-white text-text border border-border px-2 py-1">
          {Array.isArray(course.language) ? course.language[0] : course.language}
        </span>
      )}
      {course.price_usd && (
        <span class="rounded-md bg-white text-text border border-border px-2 py-1">{usd(course.price_usd)}</span>
      )}
    </div>

    <p class="text-text-body leading-relaxed text-sm mb-3">
      {truncate(course.blurb || course.description, 140)}
    </p>

    {isPartner && (
      <span class="mt-3 inline-flex max-w-max items-center gap-1 rounded-full border border-info-border bg-info px-3 py-1 text-xs font-semibold text-primary leading-none">
        Offered through our partner{course.provider_name ? `, ${course.provider_name}` : ''}
      </span>
    )}
  </div>

  <!-- CTAs -->
  <div class="mt-5 flex flex-col gap-3 md:flex-row md:items-center">
    <a
      href={learnMoreHref}
      class="w-full text-center py-2.5 px-4 rounded-[12px] border border-border bg-white text-text text-sm font-semibold hover:bg-gray-50 transition-colors"
      style="font-family: 'DM Sans', sans-serif;"
    >
      Learn more
    </a>
    {isPartner ? (
      <a
        href={signUpHref}
        target="_blank"
        rel="noopener noreferrer"
        data-affiliate="true"
        class="w-full text-center py-2.5 px-4 rounded-[12px] bg-primary hover:bg-primary-hover text-white text-sm font-semibold transition-colors"
        style="font-family: 'DM Sans', sans-serif; box-shadow: 0 4px 6px -1px rgba(6,103,209,0.2);"
      >
        Sign up
      </a>
    ) : (
      <a
        href={signUpHref}
        class="w-full text-center py-2.5 px-4 rounded-[12px] bg-primary hover:bg-primary-hover text-white text-sm font-semibold transition-colors"
        style="font-family: 'DM Sans', sans-serif; box-shadow: 0 4px 6px -1px rgba(6,103,209,0.2);"
      >
        Sign up
      </a>
    )}
  </div>
</div>

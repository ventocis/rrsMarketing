---
/**
 * NextStepBlock — the compact "buy now, with one honest caveat" module for Texas content pages.
 *
 * Redesigned 2026-10-07 (Jackson): one sales bubble instead of two cards. The sale leads
 * ("Start the Texas course, $28 total, certificate the instant you finish"); a single small line
 * under it carries the caveat that protects the reader and us — the course only counts if the court
 * approved it first ("Court hasn't approved you yet? Ask first, here's how"). Pages whose reader is
 * already approved (lead="eligible") swap that line for a short reassurance. Pages where the course
 * cannot help still get the ineligible off-ramp line.
 *
 * The NextStepStrings interface is kept whole so translated pages (src/data/i18n/texas/*.json) keep
 * type-checking; the compact design uses approvedBtn (CTA), notYetTitle + step2Link (caveat),
 * approvedTitle + approvedText (reassurance on eligible pages) and the ineligible fields.
 * The reminderLabel/placeholder/send/sent/error strings are unused (the email form was removed on
 * 2026-09-24 because no Klaviyo flow sat behind it) and stay only for type compatibility.
 */
export interface NextStepStrings {
  heading: string; approvedTitle: string; approvedText: string; approvedBtn: string;
  notYetTitle: string; step1: string; step2: string; step2Link: string;
  reminderLabel: string; placeholder: string; send: string; sent: string; error: string;
  ineligibleNote: string; ineligibleLabel: string; ineligibleHref: string;
}
interface Props {
  /** Short page label; used for the block id and the data-page attribute. */
  page: string;
  /** 'eligible' = the reader already has court approval (reassure); 'precourt' = probably has not asked yet (caveat); 'ineligible' = same as precourt. */
  lead?: 'eligible' | 'precourt' | 'ineligible';
  /** Optional one-line note for readers whose ticket is likely not eligible. */
  ineligibleNote?: string;
  ineligibleHref?: string;
  ineligibleLabel?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  strings?: Partial<NextStepStrings>;
}

const {
  page,
  lead = 'precourt',
  ineligibleNote = 'Cited at 25+ mph over, in a work zone with workers present, or holding a CDL? Defensive driving dismissal is off the table, but you still have options.',
  ineligibleHref = '/texas/speeding-25-over',
  ineligibleLabel = 'See what to do instead',
  lang = 'en',
  dir = 'ltr',
  strings = {},
} = Astro.props;

const t: NextStepStrings = {
  heading: 'Your next step',
  approvedTitle: 'Court already approved you?',
  approvedText: 'The six-hour course is the only thing left. TDLR-approved (CP1234); the certificate downloads the moment you finish.',
  approvedBtn: 'Start the Texas course — $28 total, certificate the instant you finish',
  notYetTitle: "Court hasn't approved you yet? Ask first, before you take any course.",
  step1: "Don't pay the ticket online. Paying is a guilty plea and ends the dismissal option.",
  step2: 'Request the driving safety course from your court on or before the appearance date printed on the citation.',
  step2Link: "Here's how",
  reminderLabel: 'Email me the steps and a deadline reminder',
  placeholder: 'you@email.com',
  send: 'Send',
  sent: 'Sent. Check your inbox for the steps for your court.',
  error: 'Something went wrong. Please try again.',
  ineligibleNote,
  ineligibleLabel,
  ineligibleHref,
  ...strings,
};

const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const blockId = `rrs-next-${page.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const showIneligible = lead !== 'eligible' && Boolean(t.ineligibleNote);
---

<aside
  id={blockId}
  class="rrs-next-step my-10 rounded-2xl border border-primary-deep/30 bg-info p-5 sm:p-6 flex flex-col gap-3"
  data-page={page}
  data-lead={lead}
  dir={dir}
  lang={lang}
  aria-labelledby={`${blockId}-title`}
>
  <p id={`${blockId}-title`} class="sr-only">{t.heading}</p>

  <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
    <a
      href={enrollUrl}
      data-rrs-cta="next-step"
      class="inline-flex flex-1 min-h-[56px] items-center justify-center rounded-2xl bg-primary px-6 py-3 text-center text-base sm:text-lg font-semibold text-white no-underline hover:bg-primary-hover shadow-[0_10px_15px_-3px_rgba(17,23,34,0.10),0_4px_6px_-4px_rgba(17,23,34,0.05)]"
      style="font-family: 'DM Sans', sans-serif;"
    >{t.approvedBtn}</a>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 list-none p-0 m-0 text-xs sm:text-sm text-text-body sm:max-w-[16rem]" style="font-family: 'DM Sans', sans-serif;" aria-label="Included">
      <li class="inline-flex items-center gap-1.5"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-6.5" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>TDLR-approved · CP1234</li>
      <li class="inline-flex items-center gap-1.5"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-6.5" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Nothing added at checkout</li>
    </ul>
  </div>

  {lead === 'eligible' ? (
    <p class="m-0 text-sm text-text-body leading-6" style="font-family: 'DM Sans', sans-serif;">
      <strong class="text-text">{t.approvedTitle}</strong> {t.approvedText}
    </p>
  ) : (
    <p class="m-0 text-sm text-text-body leading-6" style="font-family: 'DM Sans', sans-serif;">
      <strong class="text-text">{t.notYetTitle}</strong> <a href="/texas/request-defensive-driving" class="text-primary-deep font-medium hover:underline">{t.step2Link}</a>. {t.step1}
    </p>
  )}

  {showIneligible && (
    <p class="m-0 text-xs text-text-body leading-5" style="font-family: 'DM Sans', sans-serif;">
      {t.ineligibleNote} <a href={t.ineligibleHref} class="text-primary-deep font-medium hover:underline">{t.ineligibleLabel}</a>
    </p>
  )}
</aside>

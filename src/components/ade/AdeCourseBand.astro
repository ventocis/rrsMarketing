---
/**
 * AdeCourseBand — the one course offer block for Texas adult driver education content pages.
 * Same shape as src/components/texas/CourseBand.astro (Jackson, 2026-10-07: one component, not hand-built
 * bands), with the ADE facts: the flat price from ade-texas.json, license C3705 (never CP1234, 16 TAC §84.503(j)(4)), the exam
 * sentence in its only approved wording, the instant certificate, and the full-refund-before-completion promise.
 *
 * Jackson, 2026-10-13: one fixed heading on every page, five bullets that read from their bold words alone,
 * one DPS-cost line under the button, no "not sure" link. Pages pass only `eyebrow` (and `id` when their
 * sticky CTA hides at a different anchor).
 */
import ade from '../../data/ade-texas.json';
import { adeEnrollUrl, ADE_LICENSE } from '../../lib/ade';
interface Props { id?: string; eyebrow?: string }
const { id = 'course', eyebrow = 'Required at 18 to 24' } = Astro.props;
const price = `$${ade.course.priceUsd}`;
const hours = Math.round(ade.course.courseMinutes / 60);
const checks: { strong: string; rest: string }[] = [
  { strong: 'The course Texas requires', rest: `${hours} hours, TDLR-approved, license ${ADE_LICENSE}` },
  { strong: 'Exam built in', rest: ade.exam.claimPhrasing },
  { strong: 'Instant certificate', rest: 'ready the moment you pass' },
  { strong: 'No hidden fees', rest: 'certificate, retakes and processing included' },
  { strong: 'Your pace', rest: `${ade.course.completionDays} days, any device, full refund any time before you finish` },
];
const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
---
<section id={id} class="max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-12 scroll-mt-28 text-text" style={sans}>
  {eyebrow && <p class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep m-0 mb-2">{eyebrow}</p>}
  <h2 class="text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3" style={inter}>Get the course done today. {price}, nothing added at checkout.</h2>
  <p class="text-base leading-7 m-0 mb-6 max-w-[780px] text-text-body">Most people finish before their DPS appointment comes up.</p>
  <div class="rounded-[20px] bg-primary-deep text-white p-7 lg:p-9 flex flex-wrap gap-8 items-center justify-between">
    <ul class="flex-[999_1_420px] min-w-0 flex flex-col gap-3 list-none p-0 m-0 text-[17px]">
      {checks.map((c) => (
        <li class="flex gap-2.5"><span class="text-info-border font-extrabold" aria-hidden="true">✓</span><span><strong class="text-white">{c.strong}</strong> <span class="text-info-border">{c.rest}</span></span></li>
      ))}
    </ul>
    <div class="flex-[1_1_240px] flex flex-col gap-3 justify-center">
      <a href={adeEnrollUrl} data-rrs-cta="ade-course-band" class="text-center no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-7 py-4 rounded-full whitespace-nowrap" style={inter}>Start the {price} course&nbsp;→</a>
      <p class="m-0 text-center text-sm text-info-border leading-5">DPS still charges its $33 license fee and requires the free ITAD video. <a href="/adult-drivers-ed/texas/cost" class="text-white font-semibold underline">See the whole bill</a></p>
    </div>
  </div>
</section>

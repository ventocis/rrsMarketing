---
/**
 * /adult-drivers-ed/texas/ade-1317-certificate — "ade-1317 certificate", "ade 1317 certificate expiration",
 * "ade 1317 or de 964", "ade-1317 form".
 *
 * Rebuilt 2026-10-13 on the hook → answer → loop → funnel recipe (~/Claude/SEO/ADE-PAGE-RECIPE.md). Facts used and
 * nothing more: the ADE-1317 does not expire (landing page); the ITAD certificate is the one valid 90 days
 * (itd.certValidDays); DPS lists "DE-964/DEE-964 or ADE-1317/ADEE-1317" for third-party skills testing at 18 to 24
 * (tpst.requires18to24); a provider has up to 15 working days to issue (course.certificateDays, 16 TAC §84.503(h)),
 * and ours is issued the moment you pass (Jackson, 2026-10-13); the under-25 exam waiver lapses at 2 years (WAIVER_LAPSE).
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import { course, law, itd, tpst, CLAIM, WAIVER_LAPSE } from '../../../data/ade-eligibility';

const base = '/adult-drivers-ed/texas';
const code = course.certificateCode; // ADE-1317
const tpstCert = tpst.requires18to24[0]; // 'A valid DE-964/DEE-964 or ADE-1317/ADEE-1317 showing a completed driver education course'

// The one-breath answer: lede and meta description.
const answer = `The ${code} is the Texas adult drivers ed certificate, required at ${law.requiredBand} for a first license. Ours is ready the moment you pass, and it does not expire.`;

const faqs = [
  { q: `What is an ${code} certificate?`, a: `The Texas adult driver education certificate of completion. A licensed provider issues it after you pass the six-hour course, and it is the document DPS wants from you if you are ${law.requiredBand} and applying for a first Texas driver license.` },
  { q: 'How long does it take to get the certificate?', a: `Ours is ready to download the moment you pass. Texas allows a provider up to ${course.certificateDays} working days after the completion date, so if you take the course somewhere else, ask before you book your DPS appointment.` },
  { q: `Does the ${code} expire?`, a: `No. It stays valid as proof that you took the course. If you are under 25, though, the knowledge-test waiver it carries lapses after 2 years. The certificate with a ${itd.certValidDays}-day clock is ITAD, the Impact Texas Adult Drivers certificate, and people confuse the two constantly.` },
  { q: 'What do I do with the certificate?', a: `Bring it to your DPS appointment with your other documents. It is the proof that you completed driver education, and it shows you passed the highway sign and traffic law portions of the DPS knowledge exam in the course. ${WAIVER_LAPSE}` },
  { q: 'What if I lose it?', a: 'Ask the provider that issued it for a replacement. Providers are required to keep student records, so a certificate can be reissued.' },
  { q: `Is ${code} the same as DE-964?`, a: `No. DE-964 is the minor driver education certificate, for the 32-hour teen course. ${code} is the adult six-hour equivalent. DPS accepts either for third-party skills testing at 18 to 24; they are still different documents.` },
];

const next = [
  { href: `${base}/final-exam`, title: 'The exam that produces it', blurb: `${course.finalExamQuestions} questions, ${course.finalExamPassPercent}% on each part, ${course.finalExamAttempts} attempts.` },
  { href: `${base}/texas-driver-license-documents`, title: 'What to bring to the appointment', blurb: 'The certificate goes in the folder with these.' },
  { href: `${base}/how-to-get-a-texas-license-as-an-adult`, title: 'The whole process, step by step', blurb: 'From the course to the card in your hand, in order.' },
  { href: `${base}/cost`, title: 'What the course costs', blurb: 'One price, with the exam and the certificate in it.' },
];
---
<AdeGuide
  title={`Does the Texas ADE-1317 Certificate Expire? (No)`}
  description={answer}
  url={`${base}/ade-1317-certificate`}
  eyebrow="The course"
  h1={`The ${code} certificate does not expire. The one with a ${itd.certValidDays}-day clock is ITAD.`}
  lede={`${answer} It gets mixed up with two other certificates, the ITAD one you also need for the driving test and the teen DE-964. Which is which, and when yours arrives, is below.`}
  faqs={faqs}
  dateModified="2026-10-29"
  updated="October 29, 2026"
  band={{ eyebrow: 'Ready the moment you pass' }}
  next={next}
  sources={[
    { label: '16 TAC §84.503(h), the 15-working-day issuance rule' },
    { label: 'Tex. Transp. Code §521.1601 and §521.167', href: 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm' },
    { label: 'Texas DPS, Third Party Skills Testing Program', href: 'https://www.dps.texas.gov/section/driver-license/third-party-skills-testing-program' },
  ]}
>
  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What is the {code} certificate, and do I need one?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      It is the certificate of completion for the Texas adult six-hour driver education course, and you
      need one if you are {law.requiredBand} and applying for a first Texas driver license. §521.1601 means
      DPS cannot issue that license without it. If you are 25 or older it is optional, and some people take
      the course anyway because it {CLAIM}.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Does the {code} certificate expire?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      No, the {code} does not expire. The certificate with a {itd.certValidDays}-day life is ITAD, the one
      DPS gives you after its one-hour video.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 pr-4 text-sm font-semibold text-text">Certificate</th>
            <th class="py-3 pr-4 text-sm font-semibold text-text">Comes from</th>
            <th class="py-3 text-sm font-semibold text-text">Clock</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border align-top">
            <td class="py-4 pr-4 text-[15px] text-text-body leading-6"><strong>{code}</strong><br />driver education completion</td>
            <td class="py-4 pr-4 text-[15px] text-text-body leading-6">Your course provider, after you pass</td>
            <td class="py-4 text-[15px] text-text-body leading-6">Does not expire</td>
          </tr>
          <tr class="border-b border-border align-top">
            <td class="py-4 pr-4 text-[15px] text-text-body leading-6"><strong>ITAD</strong><br />Impact Texas Adult Drivers</td>
            <td class="py-4 pr-4 text-[15px] text-text-body leading-6">DPS, free, after a one-hour video</td>
            <td class="py-4 text-[15px] font-semibold text-text leading-6">Valid {itd.certValidDays} days</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-[17px] text-text-body leading-[30px]">
      You need both to sit a driving skills test at 18 to 24, and only the ITAD certificate expires. The
      trap that follows from that is set out in{' '}
      <a class="underline hover:no-underline" href={`${base}/impact-texas-adult-drivers`}>the {itd.certValidDays}-day certificate trap</a>.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">{code} or DE-964: which one is yours?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      If you took the adult course, yours is the {code}. The DE-964 is the teen driver education
      certificate; the {code} is the adult one.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      DPS names both when it lists what you need for{' '}
      <a class="underline hover:no-underline" href={`${base}/third-party-skills-testing`}>third-party skills testing</a>{' '}
      at 18 to 24: &ldquo;{tpstCert}.&rdquo;
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">How long until I get my certificate?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Ours is ready to download the moment you pass. Texas allows a provider up to{' '}
      {course.certificateDays} working days after your completion date, and a provider that quotes the full{' '}
      {course.certificateDays} days is within the rules. If you take the course somewhere else, ask before you
      book a DPS appointment for the day after you finish.
    </p>
  </section>
</AdeGuide>

---
/**
 * /texas — the Texas course money page, rebuilt from Jackson's "Texas Hero Redesign" canvas (2026-10-07).
 * Section order, copy, CTAs and interactions follow the canvas; fonts and colors are our tokens.
 * Deviations from the canvas (each flagged in the PR):
 *  - Refund copy: full refund before completion or certificate, no forms, 3–5 business days (Jackson, 2026-10-07).
 *  - "Approved by every Texas court" reads "Accepted by every Texas court": TDLR approves, courts accept.
 *  - The video tile plays Jackson's pick, "Why YOU should take…" (vWLZ84aNCFU, 1:01). Its cover is a branded thumbnail
 *    is Jackson's "How to Dismiss Your Ticket" thumbnail (2026-10-07) with a centered play button, no label.
 *  - The audio card uses the canvas's navy (#0B2160), darker than our deep blue, to soften the contrast.
 *  - The audio card's button opens checkout with the audio add-on already in the cart (texasAudioCheckoutUrl).
 */
import TexasLayout from '../../layouts/TexasLayout.astro';
import reviews from '../../data/texas-reviews.json';
import { VIDEOS, isoDuration } from '../../data/videos';
import {
  TEXAS_COURSE, TEXAS_PRICE_LABEL, TEXAS_AUDIO_TOTAL_LABEL, texasAudioCheckoutUrl,
} from '../../data/texas-course';

const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';

const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const audioUrl = texasAudioCheckoutUrl(enrollUrl);
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || '/contact';
const trustpilotUrl = 'https://www.trustpilot.com/review/roadreadysafety.com';

const price = TEXAS_PRICE_LABEL; // "$28"
const [audioDollars, audioCents] = TEXAS_AUDIO_TOTAL_LABEL.split('.'); // "$37", "98"
const CP = TEXAS_COURSE.providerNumber;
const hours = TEXAS_COURSE.hours;

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";

const bullets = [
  { label: 'TDLR-Approved', text: 'Accepted by every Texas court for dismissal or insurance discounts.' },
  { label: 'Fastest Course', text: 'State-minimum time. Only what you need, nothing more.' },
  { label: 'Go at Your Own Pace', text: 'Pause anytime, pick up on any device.' },
  { label: 'No Final Exam', text: 'Quick quizzes as you go. Miss one, try again.' },
  { label: 'No Hidden Certificate Fee', text: 'Included with checkout. Instant download.' },
];

// Hero video: S-202 "Why This Course" sales film (Jackson, 2026-10-07). /texas is its canonical page, so the
// VideoObject schema is emitted here.
const video = VIDEOS['vWLZ84aNCFU'];
const videoSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.description,
  thumbnailUrl: [`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`, `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`],
  uploadDate: video.uploadDate,
  duration: isoDuration(video.seconds),
  embedUrl: `https://www.youtube.com/embed/${video.id}`,
  contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', logo: { '@type': 'ImageObject', url: 'https://roadreadysafety.com/assets/icons/texas/logo-shield-footer.svg' } },
});
const videoLength = `${Math.floor(video.seconds / 60)}:${String(video.seconds % 60).padStart(2, '0')}`;

interface Review { name: string; initials: string; date: string; rating: number; verified: boolean; quote: string; title?: string }
// Short reviews lead so nothing is cut off; MW's long review opens the "show more" set, shown in full (Jackson, 2026-10-07).
const LEAD = ['Ryan Johnson', 'Chelsie Gates', 'Bliss James', 'MW'];
const allReviews = [
  ...LEAD.map((n) => (reviews as Review[]).find((r) => r.name === n)).filter(Boolean) as Review[],
  ...(reviews as Review[]).filter((r) => !LEAD.includes(r.name)),
];
const REVIEWS_SHOWN = 3;

const courseChecks = [
  { strong: `Official ${hours}-hour course`, rest: ' to dismiss a ticket or get an insurance discount' },
  { rest: 'Accepted by every Texas court' },
  { rest: 'Free instant digital certificate' },
  { rest: 'Phone, tablet or computer: start, stop and resume anytime' },
  { rest: 'No final exam, unlimited quiz attempts' },
  { rest: 'Real customer support' },
];
const audioExtras = [
  { strong: 'Narrated audio', rest: ' for every lesson' },
  { strong: 'Autoplay', rest: ' keeps it going hands-free' },
  { rest: 'Pauses only when it’s time for a quiz' },
];
const fitBasic = ['Like reading at your own pace', 'Want the lowest price', 'Take it in short bursts on your phone or computer'];
const fitAudio = ['Learn better by listening', 'Want to stay hands-free while you do other things at home', 'Find long reading tiring'];

const expTabs = [
  {
    key: 'req', label: 'Texas Requirements',
    intro: 'Texas doesn’t just say “take a course.” To dismiss a ticket with defensive driving, most Texas courts require you to:',
    items: [
      ['Be Eligible', 'In general, you must not hold a commercial driver license, must not have been going 25 mph or more over the posted limit, and you usually can’t have taken a Texas defensive driving course for ticket dismissal in the last 12 months.'],
      ['Get Permission', `Before your deadline, your judge or court clerk must approve you to take a ${hours}-hour state-approved defensive driving course for ticket dismissal.`],
      ['Complete a Course', 'You must finish every lesson, pass the required quizzes, and certify that you—not someone else—completed the course.'],
      ['Get a Copy of Your Driving Record', 'Many Texas courts require a copy of your 3A driving record along with your course certificate.'],
      ['Turn Everything In', 'You’ll submit your Certificate of Course Completion to the court by the deadline they give you.'],
    ],
    note: 'Every court and precinct can have slightly different instructions, so always follow your local court’s rules first.',
  },
  {
    key: 'topics', label: 'Topics Covered',
    intro: `In ${hours} hours (the Texas state minimum, with two built-in breaks instead of extra fluff), we cover:`,
    items: [
      ['Texas traffic laws & ticket dismissal basics', 'Why the laws exist, how tickets work, and what courts actually care about.'],
      ['Real-world defensive driving', 'The 5 pillars of defensive driving, high-risk situations, crash dynamics, and how to avoid or reduce crash severity.'],
      ['Driver mindset & psychology', 'Attitude, road rage, distraction, multitasking myths, and how your emotions silently change the way you drive.'],
      ['Alcohol, drugs & DWI', 'How substances affect your brain and body, key Texas laws, and real-life consequences (and how to avoid them).'],
      ['Vulnerable road users & big vehicles', 'Pedestrians, cyclists, motorcyclists, school buses, emergency vehicles, large trucks, and work zones.'],
      ['Modern Texas road issues', 'Street racing awareness, human trafficking prevention, litter prevention, organ donation awareness, and traffic stop protocols.'],
      ['Special programs & recovery', 'Driving with disabilities indicators, oversize/overweight vehicle awareness, insurance, SR-22, and Texas support resources.'],
      ['Testing', 'And don’t stress about testing: instead of a giant scary exam, you’ll see short 3-question knowledge checks along the way. You always get unlimited retries, so the goal is learning—not tricking you.'],
    ],
    note: '',
  },
  {
    key: 'support', label: 'Support',
    intro: 'We’re here to help throughout your course. Our friendly support team is here to help with anything from questions about topics covered to technical issues like login or account access. You can browse our help articles and resources anytime, and if you still need assistance, email us and a real person will typically respond within one business day.',
    items: [],
    note: '',
    link: true,
  },
  {
    key: 'after', label: 'After the Course',
    intro: 'Once you finish and pass, you’ll get your Certificate of Completion right away.',
    items: [
      ['What else most courts require', 'Most Texas courts also require you to submit two additional items along with your certificate: your Texas Driver Record (DPS “Type 3A”), and a court affidavit (if your court requires one).'],
      ['Typical next steps', '1. Download your certificate. 2. Request your DPS Type 3A driver record. 3. Complete any required court affidavit. 4. Submit everything to the court by the deadline.'],
      ['Important', 'Every court is a little different. Always follow your court’s exact submission instructions and deadline. Your county page will tell you where to send it and what to include.'],
    ],
    note: '',
  },
];

const progressDone = ['Texas traffic laws', 'Real-world defensive driving', 'Driver mindset & psychology', 'Alcohol, drugs & DWI'];

const landingFaqs = [
  // The FAQPage schema below is built from this array, so schema and visible answers cannot drift.
  { q: 'Is this accepted by all Texas courts?', a: 'Yes! We are a TDLR-approved provider, and our certificates are accepted by every court in Texas for ticket dismissal.' },
  { q: 'Are there extra fees after completing the course?', a: `No hidden fees. ${price} all-in is all you pay — that covers the course, the certificate, and court reporting. Some courts may also require a copy of your driving record (DPS Type 3A), which has a separate fee paid directly to the DPS.` },
  { q: 'How long does the Texas defensive driving course take?', a: 'Six hours. Texas requires every approved driving safety course to run 6 hours, with at least 5 hours of instruction and the required breaks, so no approved course is shorter. You can finish in one sitting or spread it over several days; the course saves your place.' },
  { q: 'How do I get my certificate?', a: 'Download it the moment you finish. The certificate of completion appears in your account dashboard as soon as the course is done, with no extra fee and no waiting for mail. You then submit it to your court along with your Type 3A driving record. TDLR notes a new certificate can take up to 5 days to appear in its online validation tool, so do not wait until your deadline day.' },
  { q: 'Ticket dismissal or insurance discount: what is the difference?', a: 'Ticket dismissal is a court process and the course alone does not do it. You must ask the court for permission on or before the appearance date printed on your citation, pay the court fee, take the course, and return the certificate and your driving record within 90 days of the court granting the request (Tex. Code Crim. Proc. art. 45A.351). An insurance discount needs no court at all: finish the course and send the certificate to your insurer, which may lower your premium under its own filed rates. One completion can serve both purposes.' },
  { q: 'How long do I have to complete the course?', a: 'Texas gives you 90 days from the date the court grants the course — not from the day you enroll. Your court may set a shorter deadline, so follow the date on its approval letter.' },
  { q: 'Can I take the course on my phone?', a: 'Yes! The course is fully mobile-friendly. You can take it on any device — phone, tablet, or computer. Your progress automatically saves, so you can switch devices anytime.' },
  { q: 'Is there a final exam?', a: 'You get unlimited retakes on all unit quizzes. There is no final exam. The goal is learning, not tricking you. Take your time and review the material as needed.' },
  { q: 'Are refunds available?', a: 'Yes! If you’re not satisfied, you can request a full refund before you complete the course or receive your certificate.' },
];

const landingFaqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: landingFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const resources = [
  { href: '/texas/ticket-dismissal', tag: 'Process', title: 'Ticket Dismissal Guide', blurb: 'Every step to get a Texas ticket dismissed, start to finish.' },
  { href: '/texas/request-defensive-driving', tag: 'Step 1', title: 'How to Ask the Court for Defensive Driving', blurb: 'What to say, when to ask, and a letter template.' },
  { href: '/texas/type-3a-driving-record', tag: 'Paperwork', title: 'Type 3A Driving Record', blurb: 'Which record your court wants, how to order it, and if you need to print it.' },
  { href: '/texas/speeding-ticket', tag: 'Tickets', title: 'Texas Speeding Ticket Guide', blurb: 'Fines, options, and how to keep it off your record.' },
  { href: '/texas/insurance-discount', tag: 'Savings', title: 'Insurance Discount', blurb: 'How the course can lower your premium, no ticket needed.' },
  { href: '/texas/tdlr-approved', tag: 'Verify', title: 'What TDLR-Approved Means', blurb: 'How to check any course and certificate in a minute.' },
];

const check = (stroke: string) => `<svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M4 11.5 L9 16 L18 6" stroke="${stroke}" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const plus = `<svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M11 4 V18 M4 11 H18" stroke="#FFFFFF" stroke-width="3.2" stroke-linecap="round"/></svg>`;
const chev = (stroke: string, size = 18) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9 L12 15 L18 9" stroke="${stroke}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

{!isEnabled && (
  <meta http-equiv="refresh" content="0;url=/" />
)}

{isEnabled && (
<TexasLayout
  title={`Texas Defensive Driving Course Online: 6-Hour, ${TEXAS_PRICE_LABEL} Total, TDLR-Approved (${CP}) | Road Ready Safety`}
  description={`${hours}-hour Texas driving safety course, online, TDLR-approved (${CP}). ${TEXAS_PRICE_LABEL} total: course plus your certificate the moment you finish, nothing added at checkout. Accepted by every Texas court.`}
  keywords="texas defensive driving course, texas online defensive driving class, defensive driving course texas, online defensive driving texas, texas driving safety course, tdlr approved defensive driving"
  url="/texas"
  banner={`Limited Time: Code SAVE3 Drops Your Total to $${TEXAS_COURSE.legalMinimumPrice}. No Hidden Fees.`}
  courseSchema={true}
>
  <script type="application/ld+json" set:html={landingFaqSchema} />
  <script type="application/ld+json" set:html={videoSchema} />

  <div class="text-text bg-white" style={sans}>

    <!-- Hero -->
    <section class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-9 pb-14 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] items-center">
      <div class="min-w-0 flex flex-col gap-5">
        <p class="self-start inline-flex items-center gap-2.5 m-0 bg-white border border-[#B9D3F6] rounded-full py-1.5 pl-2 pr-4">
          <img src="/assets/images/badges/texas-approved-tdlr.png" width="32" height="32" alt="Texas approved: TDLR-approved defensive driving course" class="w-8 h-8 shrink-0" decoding="async" />
          <span class="font-bold text-base text-primary-deep" style={inter}>TDLR-Approved Provider {CP}</span>
        </p>
        <h1 class="m-0 font-extrabold text-[32px] lg:text-[44px] leading-[1.1] tracking-[-0.02em] text-text" style={inter}>Dismiss Your Ticket with a Texas Defensive Driving Course Online</h1>
        <ul class="list-none p-0 m-0 flex flex-col gap-3 max-w-[580px]">
          {bullets.map((b) => (
            <li class="flex gap-3.5 items-start">
              <span class="flex-none w-6 h-6 rounded-full bg-[#E3F6EC] flex items-center justify-center mt-px" set:html={check('#1E8E53')} />
              <span class="text-base leading-[1.45] text-text-body"><strong class="font-extrabold text-text" style={inter}>{b.label}:</strong>{' '}{b.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 w-full max-w-[480px] mx-auto lg:mx-0">
        <div class="rrs-hero-yt relative aspect-video rounded-2xl overflow-hidden bg-primary-navy shadow-[0_16px_40px_rgba(11,33,96,0.18)]" data-embed={`https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`} data-title={video.title}>
          <img src="/assets/images/texas/dismiss-ticket-video-v2-1280.webp" srcset="/assets/images/texas/dismiss-ticket-video-v2-640.webp 640w, /assets/images/texas/dismiss-ticket-video-v2-1280.webp 1280w" sizes="(min-width: 1024px) 480px, 100vw" alt="" width="1280" height="720" loading="eager" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
          <button type="button" class="rrs-hero-yt-play group absolute inset-0 w-full h-full bg-transparent border-0 cursor-pointer" aria-label={`Play video: ${video.title} (${videoLength})`}>
            <span class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white/95 flex items-center justify-center shadow-[0_12px_30px_rgba(0,0,0,0.35)] transition-transform group-hover:scale-105" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 30 30" fill="none"><path d="M10 6 L24 15 L10 24 Z" fill="#2454E6"/></svg>
            </span>
          </button>
        </div>
      </div>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2 pt-1">
        <a href={enrollUrl} data-rrs-cta="texas-hero" class="inline-block no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-[30px] py-[15px] rounded-full text-center max-w-full sm:whitespace-nowrap shadow-[0_8px_20px_rgba(36,84,230,0.28)]" style={inter}>Start My Course · {price}&nbsp;→</a>
      </div>
    </section>

    <!-- Reviews -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-14 pb-16 flex flex-col gap-7">
        <div class="flex flex-col gap-2.5 items-center text-center">
          <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Reviews</h2>
          <a href={trustpilotUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-sm text-text-muted no-underline border-b border-[#CBD3DF] pb-0.5 hover:text-text">Verified reviews on Trustpilot <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9 L9 3 M4.5 3 H9 V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="grid gap-5 grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]">
          {allReviews.map((r, i) => (
            <div data-more={i >= REVIEWS_SHOWN ? '' : undefined} hidden={i >= REVIEWS_SHOWN}>
              <div class="h-full bg-white border border-border rounded-[14px] p-5 flex flex-col gap-3">
                <div class="flex justify-between items-center gap-2.5">
                  <span class="text-accent text-[15px] tracking-[2px]" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                  <span class="text-xs text-text-muted">{r.date}</span>
                </div>
                {r.title && <strong class="text-[15px] text-text" style={inter}>{r.title}</strong>}
                <p class="m-0 text-[15px] leading-[1.5] text-text flex-1">“{r.quote}”</p>
                <div class="flex items-center gap-2.5 pt-2.5 border-t border-[#EEF2F7]">
                  <span class="w-[30px] h-[30px] rounded-full bg-[#DDEBFD] text-primary-deep font-bold text-xs flex items-center justify-center" aria-hidden="true">{r.initials}</span>
                  <span class="text-sm font-bold">{r.name}</span>
                  <span class="text-xs text-text-muted ml-auto">{r.verified ? 'Verified via Trustpilot' : 'via Trustpilot'}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        <button type="button" id="reviews-toggle" aria-expanded="false" class="self-center font-bold text-base min-h-12 px-6 py-2.5 rounded-full cursor-pointer bg-white text-text border-2 border-[#CBD3DF] hover:border-text-muted">Show more reviews</button>
      </div>
    </section>

    <!-- Choose your course -->
    <section id="choose" class="bg-white border-t border-border scroll-mt-28">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-9 items-center">
        <div class="flex flex-col gap-2 text-center max-w-[640px]">
          <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Choose Your Course</h2>
          <p class="m-0 text-base text-text-muted">Read it or listen to it. Same certificate.</p>
        </div>

        <div class="flex flex-wrap gap-6 justify-center items-stretch w-full">
          <div class="flex-[1_1_300px] max-w-[400px] min-w-0 rounded-[20px] px-6 py-7 flex flex-col gap-4 bg-white text-text border border-[#DCE4EF] shadow-[0_16px_40px_rgba(11,33,96,0.08)]">
            <div class="flex justify-between gap-4 items-start">
              <h3 class="m-0 font-extrabold text-[21px] leading-[1.2]" style={inter}>Texas Defensive Driving Course</h3>
              <span class="flex-none font-bold text-xs px-3 py-1.5 rounded-full bg-[#E5F0FE] text-primary">Great Value</span>
            </div>
            <p class="m-0 flex items-baseline gap-1"><span class="font-extrabold text-[44px] leading-none" style={inter}>{price}</span><span class="text-base text-text-body">.00</span></p>
            <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
              {courseChecks.map((c) => (
                <li class="flex gap-3.5 items-start">
                  <span class="flex-none w-6 h-6 rounded-full bg-[#DDEBFD] flex items-center justify-center" set:html={check('#2454E6')} />
                  <span class="text-[15px] leading-[1.45] pt-0.5">{c.strong && <strong>{c.strong}</strong>}{c.rest}</span>
                </li>
              ))}
            </ul>
            <a href={enrollUrl} data-rrs-cta="texas-choose-basic" class="mt-auto no-underline text-center font-extrabold text-[17px] px-4 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white" style={inter}>Enroll Now&nbsp;→</a>
          </div>

          <div class="flex-[1_1_300px] max-w-[400px] min-w-0 rounded-[20px] px-6 py-7 flex flex-col gap-4 bg-[#0B2160] text-white border border-[#0B2160] shadow-[0_24px_60px_rgba(11,33,96,0.28)]">
            <div class="flex justify-between gap-4 items-start">
              <h3 class="m-0 font-extrabold text-[21px] leading-[1.2]" style={inter}>Texas Defensive Driving Course + Audio</h3>
              <span class="flex-none font-bold text-xs px-3 py-1.5 rounded-full bg-white text-primary-deep">Hands-Free</span>
            </div>
            <p class="m-0 flex items-baseline gap-1"><span class="font-extrabold text-[44px] leading-none" style={inter}>{audioDollars}</span><span class="text-base text-[#D6E8FD]">.{audioCents}</span></p>
            <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
              {courseChecks.map((c) => (
                <li class="flex gap-3.5 items-start">
                  <span class="flex-none w-6 h-6 rounded-full bg-white/20 flex items-center justify-center" set:html={check('#FFFFFF')} />
                  <span class="text-[15px] leading-[1.45] pt-0.5 text-[#D6E8FD]">{c.strong && <strong class="text-white">{c.strong}</strong>}{c.rest}</span>
                </li>
              ))}
              {audioExtras.map((c) => (
                <li class="flex gap-3.5 items-start">
                  <span class="flex-none w-6 h-6 rounded-full bg-[#22A06B] flex items-center justify-center" set:html={plus} />
                  <span class="text-[15px] leading-[1.45] pt-0.5 text-white font-semibold">{c.strong && <strong>{c.strong}</strong>}{c.rest}</span>
                </li>
              ))}
            </ul>
            <a href={audioUrl} data-rrs-cta="texas-choose-audio" class="mt-auto no-underline text-center font-extrabold text-[17px] px-4 py-3.5 rounded-xl bg-white hover:bg-info text-primary-deep" style={inter}>Enroll with Audio&nbsp;→</a>
          </div>
        </div>

        <div class="flex flex-wrap gap-6 w-full justify-center">
          {[
            { head: 'Basic is for you if you…', items: fitBasic },
            { head: 'Audio is for you if you…', items: fitAudio },
          ].map((f) => (
            <div class="flex-[1_1_300px] max-w-[400px] min-w-0 flex flex-col gap-1.5 px-6 py-4 bg-surface-muted border border-border rounded-[14px]">
              <span class="font-extrabold text-[15px] text-text" style={inter}>{f.head}</span>
              {f.items.map((t) => <span class="flex gap-2 text-sm text-text-body"><span class="text-[#1E8E53] font-extrabold" aria-hidden="true">✓</span>{t}</span>)}
            </div>
          ))}
        </div>

        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-base text-text-body">
          <span class="inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="#2454E6" stroke-width="2"/><path d="M8 11 V8 a4 4 0 0 1 8 0 V11" stroke="#2454E6" stroke-width="2"/></svg>Secure checkout</span>
          <span class="inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z" stroke="#2454E6" stroke-width="2" stroke-linejoin="round"/><path d="M9 12 L11.2 14.2 L15.5 9.8" stroke="#2454E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>TDLR-approved provider</span>
          <span class="hidden sm:inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#2454E6" stroke-width="2"/><path d="M14.5 9 C14 8.2 13 7.8 12 7.8 C10.5 7.8 9.5 8.6 9.5 9.8 C9.5 12.4 14.5 11.2 14.5 14 C14.5 15.3 13.4 16.2 12 16.2 C10.8 16.2 9.8 15.7 9.3 14.8 M12 6.5 V7.8 M12 16.2 V17.5" stroke="#2454E6" stroke-width="1.8" stroke-linecap="round"/></svg>100% risk-free guarantee</span>
        </div>
      </div>
    </section>

    <!-- Risk-free -->
    <section class="bg-white">
      <div class="max-w-[880px] mx-auto px-4 sm:px-6 pt-8 pb-[88px]">
        <div class="bg-surface-muted border border-border rounded-3xl px-6 sm:px-10 py-12 flex flex-col items-center gap-4 text-center">
          <span class="w-16 h-16 rounded-full bg-white border border-[#DCE4EF] flex items-center justify-center"><svg width="32" height="32" viewBox="0 0 34 38" fill="none" aria-hidden="true"><path d="M17 2 L31 7 V18 C31 27 24 33 17 36 C10 33 3 27 3 18 V7 Z" stroke="#2454E6" stroke-width="3" stroke-linejoin="round"/><path d="M11 18.5 L15.5 23 L23.5 14" stroke="#2454E6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <h2 class="m-0 font-extrabold text-[28px] lg:text-[36px] leading-[1.15] text-text" style={inter}>Try It 100% Risk-Free</h2>
          <p class="m-0 text-lg text-text-body max-w-[560px]">We built Road Ready to be the easiest way to complete your Texas driving safety course. If you’re not satisfied, you can request a full refund before you complete the course or receive your certificate.</p>
          <div class="flex flex-wrap justify-center gap-2">
            {['Full refund if you request it before course completion or certificate issuance', 'No complicated forms or hoops', 'Refund processed within 3–5 business days'].map((t) => (
              <span class="inline-flex items-center gap-1.5 bg-white border border-[#DCE4EF] rounded-full px-3.5 py-[7px] text-sm font-bold text-text text-left"><Fragment set:html={check('#1E8E53')} />{t}</span>
            ))}
          </div>
          <a href={enrollUrl} data-rrs-cta="texas-risk-free" class="mt-1.5 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-6 sm:px-[30px] py-[15px] rounded-full max-w-full sm:whitespace-nowrap" style={inter}>Start Risk-Free Today&nbsp;→</a>
        </div>
      </div>
    </section>

    <!-- What to expect -->
    <section class="bg-white border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-20 pb-[88px] flex flex-col gap-3">
        <h2 class="m-0 text-center font-extrabold text-[32px] lg:text-[48px] leading-[1.1] text-text" style={inter}>What to Expect</h2>
        <p class="m-0 text-center text-lg text-text-body">Everything you need to know about the Texas defensive driving process.</p>
        <div class="w-full sm:w-auto self-center grid grid-cols-2 sm:flex sm:flex-wrap sm:justify-center gap-1 bg-info rounded-2xl sm:rounded-[28px] p-1.5 mt-5 mb-7" role="group" aria-label="What to expect topics" data-exp-tabs>
          {expTabs.map((t, i) => (
            <button type="button" data-pick={t.key} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['font-bold text-sm sm:text-base min-h-[44px] sm:min-h-[46px] px-3 sm:px-[22px] py-2 sm:py-2.5 border-0 rounded-xl sm:rounded-full cursor-pointer', i === 0 ? 'bg-primary text-white' : 'bg-transparent text-text']} style={inter}>{t.label}</button>
          ))}
        </div>
        <div class="flex flex-wrap gap-14 items-start">
          <div class="flex-[999_1_480px] min-w-0">
            {expTabs.map((t, ti) => (
              <div data-panel={t.key} hidden={ti !== 0}>
                <div class="flex flex-col">
                  <p class="m-0 mb-[18px] text-[17px] text-text-body">{t.intro}</p>
                  {t.items.map(([title, body], ii) => (
                    <details name={`exp-${t.key}`} class="group border-t border-border">
                      <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 py-5 cursor-pointer font-extrabold text-[19px] text-text" style={inter}>
                        {title}
                        <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#3B4250')} />
                      </summary>
                      <p class="m-0 mb-5 text-base text-text-body">{body}</p>
                    </details>
                  ))}
                  {t.note && <div class="border-t border-border pt-4 text-[15px] text-text-muted">{t.note}</div>}
                  {t.link && <a href={contactUrl} class="self-start mt-2 no-underline bg-primary hover:bg-primary-hover text-white font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap">Contact Support&nbsp;→</a>}
                </div>
              </div>
            ))}
          </div>
          <div class="hidden lg:block flex-[1_1_380px] min-w-0 bg-[#F4F6F9] rounded-[28px] px-6 sm:px-10 py-12" aria-hidden="true">
            <div class="bg-white rounded-[20px] p-[26px] flex flex-col gap-2.5 shadow-[0_10px_28px_rgba(11,33,96,0.06)]">
              <div class="flex justify-between text-[15px]"><strong class="text-text-body">Course progress</strong><strong class="text-text">4 of 7</strong></div>
              <div class="bg-[#EEF2F7] rounded-full h-2 mb-1.5"><div class="w-[57%] h-2 rounded-full bg-[#9DB4D6]"></div></div>
              {progressDone.map((m) => (
                <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full bg-[#9DB4D6] flex items-center justify-center"><svg width="12" height="12" viewBox="0 0 22 22" fill="none"><path d="M4 11.5 L9 16 L18 6" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{m}</div>
              ))}
              <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full border-2 border-[#9DB4D6]"></span>Vulnerable road users</div>
              <span class="mt-1.5 text-center bg-[#EEF2F7] text-text-body font-bold text-[15px] p-3 rounded-xl">Continue lesson 5</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About us -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px]">
        <div class="max-w-[860px] mx-auto bg-white border border-border rounded-[20px] px-6 sm:px-10 py-9 flex flex-col gap-3.5 shadow-[0_6px_18px_rgba(11,33,96,0.05)]">
          <span class="text-[13px] font-bold text-primary-deep uppercase tracking-[0.08em]">About us</span>
          <h2 class="m-0 font-extrabold text-[26px] leading-[1.2] text-text" style={inter}>Why we built Road Ready Safety</h2>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">Our goal is simple: fair, transparent, state-approved courses for Texans, plus plain-English guides so nobody is left confused, frustrated or upset about how ticket dismissal works.</p>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">A lot of drivers have had bad experiences with surprise fees, confusing options and no one to help. Our refund policy is compliant and clear, because we want to earn back the trust those experiences cost.</p>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">We hope you leave with a great course and a great experience, and that you trust us enough to tell your friends.</p>
          <span class="text-[15px] font-bold text-text">The Road Ready Safety team</span>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bg-white border-t border-border">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 pt-20 pb-24 flex flex-col gap-3">
        <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Frequently Asked Questions</h2>
        <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Everything you need to know about our Texas defensive driving course.</p>
        <div class="flex flex-col gap-2.5">
          {landingFaqs.map((f, i) => (
            <details name="texas-faq" open={i === 0} class="group bg-white border border-border rounded-[14px] open:border-[#B9D3F6] open:shadow-[0_8px_20px_rgba(11,33,96,0.06)]">
              <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 px-[22px] py-[18px] cursor-pointer">
                <h3 class="m-0 font-bold text-[17px] text-text" style={inter}>{f.q}</h3>
                <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#2454E6', 20)} />
              </summary>
              <p class="m-0 px-[22px] pb-5 text-base leading-[1.6] text-text-body">{f.a}</p>
            </details>
          ))}
        </div>
        <div class="mt-[18px] bg-info border border-[#B9E2FE] rounded-[18px] px-7 py-6 flex flex-wrap gap-3.5 items-center justify-between">
          <div class="flex flex-col"><strong class="text-[19px] text-text" style={inter}>Still have questions?</strong><span class="text-[15px] text-text-body">Our support team is here to help.</span></div>
          <a href={contactUrl} class="no-underline bg-white text-text border border-[#B9D3F6] font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap hover:border-primary">Contact Support&nbsp;→</a>
        </div>
      </div>
    </section>

    <!-- Helpful resources -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-3.5">
        <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Helpful Resources</h2>
        <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Free guides to help you through every step of the Texas process.</p>
        <div class="max-w-[760px] w-full mx-auto flex flex-col border-t border-border">
          {resources.map((r) => (
            <a href={r.href} class="group no-underline text-text flex items-start py-4 border-b border-border">
              <span class="flex flex-col gap-1 min-w-0">
                <span class="text-xs font-bold text-primary-deep uppercase tracking-[0.06em]">{r.tag}</span>
                <span class="font-extrabold text-lg text-text leading-[1.3] group-hover:text-primary" style={inter}>{r.title}</span>
                <span class="text-[15px] text-text-body">{r.blurb}</span>
                <span class="text-sm font-bold text-primary mt-0.5">Read guide&nbsp;→</span>
              </span>
            </a>
          ))}
        </div>
        <a href="/texas/eligibility-tracker" class="self-center text-center mt-4 font-bold text-base text-primary-deep underline">Not sure you qualify? Check your eligibility in 60 seconds&nbsp;→</a>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      // Hero video: load the YouTube player only on click.
      document.querySelectorAll('.rrs-hero-yt').forEach(function (box) {
        if (box.dataset.bound) return; box.dataset.bound = '1';
        var btn = box.querySelector('.rrs-hero-yt-play');
        btn.addEventListener('click', function () {
          var f = document.createElement('iframe');
          f.className = 'absolute inset-0 w-full h-full';
          f.src = box.getAttribute('data-embed');
          f.title = box.getAttribute('data-title') || 'Video';
          f.setAttribute('frameborder', '0');
          f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
          f.setAttribute('allowfullscreen', '');
          box.replaceChildren(f);
        });
      });
      // Reviews: show 3, toggle the rest.
      var rt = document.getElementById('reviews-toggle');
      if (rt && !rt.dataset.armed) {
        rt.dataset.armed = '1';
        rt.addEventListener('click', function () {
          var open = rt.getAttribute('aria-expanded') !== 'true';
          document.querySelectorAll('[data-more]').forEach(function (el) { el.hidden = !open; });
          rt.setAttribute('aria-expanded', open ? 'true' : 'false');
          rt.textContent = open ? 'Show fewer reviews' : 'Show more reviews';
        });
      }
      // What to expect: tab picker.
      var tabs = document.querySelector('[data-exp-tabs]');
      if (tabs && !tabs.dataset.armed) {
        tabs.dataset.armed = '1';
        tabs.addEventListener('click', function (e) {
          var b = e.target.closest('[data-pick]'); if (!b) return;
          var key = b.getAttribute('data-pick');
          tabs.querySelectorAll('[data-pick]').forEach(function (x) {
            var on = x === b;
            x.setAttribute('aria-pressed', on ? 'true' : 'false');
            x.classList.toggle('bg-primary', on); x.classList.toggle('text-white', on);
            x.classList.toggle('bg-transparent', !on); x.classList.toggle('text-text', !on);
          });
          document.querySelectorAll('[data-panel]').forEach(function (p) {
            var show = p.getAttribute('data-panel') === key;
            p.hidden = !show;
            if (show) p.querySelectorAll('details').forEach(function (d) { d.open = false; });
          });
        });
      }
    })();
  </script>
</TexasLayout>
)}

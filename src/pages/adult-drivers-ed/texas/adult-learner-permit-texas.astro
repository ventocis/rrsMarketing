/**
 * /adult-drivers-ed/texas/adult-learner-permit-texas — "is there an adult learner permit in Texas?"
 * Recipe pass 2026-10-13 (hook → answer → loop → funnel). Fact base verified the same day: Transp. Code §521.222(a)(1)
 * issues a learner license to a person "15 years of age or older but under 18 years of age"; DPS's learner license
 * page lists "15 and 17 years of age" and says nothing about adults. Neither source describes an adult learner license,
 * and this page says exactly that much and no more.
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import { law, CLAIM } from '../../../data/ade-eligibility';

const base = '/adult-drivers-ed/texas';
const answer = 'No. A Texas learner license is issued to people 15 or older but under 18 (Transportation Code §521.222). At 18 and over you apply for the driver license itself, with no permit stage and no six-month holding period.';

const faqs = [
  { q: 'Can an adult get a learner permit in Texas?', a: `${answer} An adult who needs practice before the driving test gets it through a driving school or supervised practice where circumstances allow, not through a learner license.` },
  { q: 'How do I practice driving legally before my test as an adult?', a: 'Through a driving school, which provides an instructor and a dual-control car, or supervised practice where your circumstances permit it. What you cannot do is drive unsupervised without a license to build up practice; that is the thing the learner license exists to authorize for teenagers.' },
  { q: 'Do I need to hold anything for six months like a teenager does?', a: 'No. The six-month holding period in Texas law attaches to a learner license, and learner licenses are a minor’s route. Adults are not serving a waiting period of that kind.' },
  { q: 'What about the "restricted driver license" DPS mentions for third-party testing?', a: 'DPS lists a valid restricted driver license among the requirements for third-party skills testing at 18 and over. If you hold no Texas credential at all, ask the school or DPS what applies to your situation before booking; this is the one corner of the adult path where the wording is unclear, and we are not going to invent an answer.' },
  { q: 'Do I still need the six-hour course?', a: `If you are ${law.requiredBand} and this is a first license, yes. Your practice arrangements do not change that, and the course's final exam ${CLAIM}.` },
];

const next = [
  { href: `${base}/never-had-a-license`, title: 'Never had a license, and you are an adult', blurb: 'There is no age limit on a first Texas license. What the process looks like from zero.' },
  { href: `${base}/texas-driving-test`, title: 'The driving test', blurb: 'What the examiner scores, and why the course does not replace it.' },
  { href: `${base}/third-party-skills-testing`, title: 'Taking the road test at a driving school', blurb: 'DPS-certified schools give the Class C test. What it costs and the one line to ask about first.' },
  { href: `${base}/how-to-get-a-texas-license-as-an-adult`, title: 'The whole process, step by step', blurb: 'From the course to the card in your hand, in order.' },
];

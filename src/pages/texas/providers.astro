---
import TexasLayout from '../../layouts/TexasLayout.astro';
import CourseBand from '../../components/texas/CourseBand.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import providerData from '../../data/tdlr-providers.json';
import { TEXAS_COURSE } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const { stats, topGroups, providers } = providerData as any;

// Rebuilt 2026-10-07 from Jackson's design canvas "Provider directory redesigned", with only verified content
// (his instruction: "if we can't verify, don't add that section"). Every number comes from
// src/data/tdlr-providers.json, regenerated from TDLR's own licensee file (vsDriverSafetyProvider.csv, downloaded
// from tdlr.texas.gov on September 2, 2026). Company groupings: licenses sharing a mailing address or a phone
// number in that file count as one company. Left out because they could not be verified: the competitor price
// cards (also against the no-competitor-prices rule), the "$25 course came to $50" card, and the tdlrapproved.com
// answer. The brand lookup keeps names and CP numbers only, checked against the same file.

const asOf = new Date(stats.asOf + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const byCp = new Map(providers.map((p: any) => [p.cp, p]));
const brands = [
  { brand: 'Road Ready Safety', cps: ['CP1234'], us: true },
  { brand: 'Safe2Drive', cps: ['CP577'] },
  { brand: 'DefensiveDriving.com', cps: ['CP284'] },
  { brand: 'Aceable', cps: ['CP262'] },
  { brand: 'I Drive Safely', cps: ['CP022', 'CP024'] },
  { brand: 'Improv Defensive Driving', cps: ['CP342'] },
  { brand: 'American Safety Council', cps: ['CP520'] },
  { brand: 'OnlineTXDefensiveDrivingCourse.com', cps: ['CP995'] },
].map((b) => ({ ...b, rows: b.cps.map((cp) => byCp.get(cp)).filter(Boolean) as any[] })).filter((b) => b.rows.length);

const faqs = [
  { q: 'How many TDLR-approved driving safety providers are there?', a: `${stats.total} licenses on file: ${stats.current} current and ${stats.expired} expired (TDLR licensee file, ${asOf}). Many belong to the same companies; matched by shared address or phone, they trace to about ${stats.companies}.` },
  { q: 'Why do some Texas defensive driving courses look the same?', a: 'One company can hold many TDLR licenses, each with its own name and website. If two courses look like duplicates, they often are.' },
  { q: 'What is a CP number?', a: 'The course provider number TDLR assigns each license. It’s on the provider’s site and your certificate, and it’s the fastest way to look a course up.' },
  { q: 'Does TDLR rank or recommend providers?', a: 'No. Every current license is equally approved. Compare the total price and how you get your certificate.' },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Every TDLR-approved defensive driving course in Texas, and why so many look the same',
  description: `All ${stats.total} TDLR driving safety provider licenses, searchable by name or CP number, and the ${stats.companies} companies behind them.`,
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  datePublished: '2026-06-11', dateModified: '2026-10-07',
  mainEntityOfPage: `${siteUrl}/texas/providers`,
});
const faqSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });

const nextSteps = [
  ['/texas/tdlr-approved', 'What “TDLR-approved” means', 'And what it doesn’t →'],
  ['/texas/cost', 'Compare total prices', 'Course + certificate + record →'],
  ['/texas/eligibility-tracker', 'Check if you qualify', 'Eligibility in 4 questions →'],
  ['/texas/request-defensive-driving', 'Ask the court first', 'With a letter template →'],
  ['/texas/best-defensive-driving-course', 'Comparing courses?', 'Check the final price →'],
];
const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5';
const pillOn = 'bg-primary text-white border-primary';
const pillOff = 'bg-white text-text border-[#CBD3DF] hover:border-primary-deep';
---

{isEnabled ? (
  <TexasLayout
    title={`All ${stats.total} TDLR-Approved Driving Safety Providers in Texas: CP# Directory`}
    description={`${stats.total} TDLR licenses, ${stats.current} current, but about ${stats.companies} companies behind them. Search any Texas defensive driving course by name or CP number.`}
    keywords="tdlr approved driving safety course providers, tdlr approved defensive driving course list, texas defensive driving providers, tdlr cp number lookup, is my defensive driving course approved texas"
    url="/texas/providers"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas defensive driving course</a><span class="mx-1.5">›</span><a href="/texas/tdlr-approved" class="text-text-body hover:underline">TDLR-approved courses</a><span class="mx-1.5">›</span><span>Provider directory</span></p>
        <div class="max-w-[860px] pt-8 pb-9">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>Every TDLR-approved defensive driving course in Texas, and why so many look the same</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">Texas has {stats.total} licensed driving safety providers on file: {stats.current} current, {stats.expired} expired. Search any course below by name or CP number before you pay.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">But {stats.total} licenses doesn't mean {stats.total} companies. One company holds {stats.biggestGroup} of them. Here's the inside story, and how to spot the real price before checkout.</p>
          <div class="flex flex-wrap gap-3 items-center">
            <a href="#directory" class="no-underline bg-primary hover:bg-primary-hover text-white font-bold text-[17px] px-6 py-3.5 rounded-full">Search the directory ↓</a>
            <a href="#groups" class="font-semibold text-primary hover:text-primary-deep">Why are there so many duplicates?</a>
          </div>
          <p class="text-[15px] text-text-muted m-0 mt-6">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber} · Built from TDLR licensing records ({asOf}), not marketing pages · Updated October 7, 2026</p>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 pb-12">
          {[[stats.current, 'Current licenses', 'text-primary-deep'], [stats.expired, 'Expired', 'text-amber-800'], [stats.companies, 'Actual companies behind them*', 'text-primary-deep'], [stats.biggestGroup, 'Licenses held by the biggest one*', 'text-primary-deep']].map(([n, l, c]) => (
            <div class="rounded-[14px] border border-border bg-white p-[18px]"><p class={`text-[34px] font-extrabold leading-none m-0 mb-1 ${c}`} style={inter}>{n}</p><p class="text-[15px] text-text-body m-0">{l}</p></div>
          ))}
        </div>
      </div>

      <!-- ===== Groups ===== -->
      <section id="groups" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`}>
          <p class="text-sm font-bold uppercase tracking-[0.06em] text-primary-deep m-0 mb-2">Inside baseball</p>
          <h2 class={h2c} style={inter}>Why do so many Texas courses look identical?</h2>
          <p class="text-base leading-7 m-0 mb-3 max-w-[780px]">Because they are. TDLR lists every license as its own entry, and nothing stops one company from holding dozens. More licenses means more spots on the list, so some operators register license after license under names built to catch your eye: "ONLY $25 - CLICK HERE NOW," "Fastest Course," "Dallas Defensive Driving," "Houston Defensive Driving."</p>
          <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Different name, often the same course behind it. Here are the biggest groups we found:</p>
          <div class="flex flex-col gap-3 max-w-[880px]">
            {topGroups.map((g: any) => (
              <div class="flex flex-col gap-1">
                <div class="flex justify-between gap-3 text-base flex-wrap"><span class="font-bold">“{g.name}” group ({g.cp} and others)</span><span class="text-text-body"><strong>{g.count}</strong> licenses</span></div>
                <div class="bg-[#EEF2F7] rounded-full h-3.5"><div class="h-3.5 rounded-full bg-primary" style={`width:${(g.count / stats.biggestGroup * 100).toFixed(1)}%`}></div></div>
              </div>
            ))}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 mt-6 max-w-[880px]">
            <div class="rounded-[14px] border border-info-border bg-info p-5 flex flex-col gap-1"><span class="font-bold">✓&nbsp; Is a duplicate still legit?</span><span class="text-base text-text-body">Yes, if its license reads CURRENT. A grouped license is still approved. It just isn't a different choice.</span></div>
            <div class="rounded-[14px] border border-info-border bg-info p-5 flex flex-col gap-1"><span class="font-bold">✓&nbsp; Even big brands do it</span><span class="text-base text-text-body">I Drive Safely holds two licenses under its own name, CP022 and CP024. Same company, two listings.</span></div>
          </div>
        </div>
      </section>

      <!-- ===== $25 ===== -->
      <section class={`${wrap} pt-16 pb-6`}>
        <h2 class={h2c} style={inter}>Is a $25 course really $25?</h2>
        <p class="text-base leading-7 m-0 mb-5 max-w-[780px]">Texas sets a minimum course price, so almost everyone advertises the same number. The difference shows up after you click buy:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
          {[['A paid certificate', 'Some charge to download or email the certificate you just earned.'], ['Mail-only delivery', 'Others mail it, then sell faster delivery when your court deadline is close.'], ['Marked-up driving records', 'The Type 3A record is $12 from DPS. Bundles can charge more for the same record.'], ['“Sale” off a higher list price', 'A struck-through list price makes a near-minimum course look like a deal.']].map(([t, b]) => <div class={card}><p class="font-bold m-0 mb-1">{t}</p><p class="text-base text-text-body m-0">{b}</p></div>)}
        </div>
        <p class="text-base leading-7 m-0 mt-5 max-w-[780px]">Every fee line is on the <a href="/texas/cost" class="text-primary hover:text-primary-deep font-medium">cost page</a>. First, find the license behind the brand you've heard of.</p>
      </section>

      <!-- ===== Brand lookup ===== -->
      <section id="brands" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>Most-searched providers, by CP number</h2>
        <p class="text-base leading-7 m-0 mb-5 max-w-[780px]">TDLR lists each license under its legal name, which often isn't the name on the website. Here's the license behind each brand people search for, from the same TDLR file.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          {brands.map((b) => (
            <div class={`rounded-2xl p-5 flex flex-col gap-1.5 ${b.us ? 'bg-info border-2 border-primary' : 'bg-white border border-border'}`}>
              <div class="flex justify-between gap-3 items-baseline flex-wrap"><span class="text-[21px] font-extrabold" style={inter}>{b.brand}</span><span class="text-sm font-bold text-primary-deep">{b.rows.map((r) => r.cp).join(' · ')}</span></div>
              <span class="text-[15px]">License: <strong class={b.rows.every((r) => r.status === 'CURRENT') ? 'text-primary-deep' : 'text-amber-800'}>{[...new Set(b.rows.map((r) => r.status))].join(' / ')}</strong></span>
              <span class="text-sm text-text-muted">Legal name on TDLR's list: {b.rows.map((r) => r.name).join('; ')}</span>
            </div>
          ))}
        </div>
      </section>

      <CourseBand />

      <!-- ===== How to check ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>How do you check that a course is approved?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Three checks, about two minutes. Do the first two before you pay.</p>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-3 list-none p-0 m-0">
          <li class={`${card} flex flex-col gap-1.5`}><span class="text-[28px] font-extrabold text-primary leading-none" style={inter}>1</span><span class="font-bold">Find the provider</span><span class="text-[15px] text-text-body">Search the brand or its CP number below. TDLR uses legal names, so use the <a href="#brands" class="text-primary hover:text-primary-deep font-medium">brand lookup</a> if a brand doesn't match.</span></li>
          <li class={`${card} flex flex-col gap-1.5`}><span class="text-[28px] font-extrabold text-primary leading-none" style={inter}>2</span><span class="font-bold">Check the status</span><span class="text-[15px] text-text-body">It should read CURRENT. An expired provider's certificate may not be accepted.</span></li>
          <li class={`${card} flex flex-col gap-1.5`}><span class="text-[28px] font-extrabold text-primary leading-none" style={inter}>3</span><span class="font-bold">Validate your certificate</span><span class="text-[15px] text-text-body">After the course, look up your number (CP###-########) at TDLR's DESSearch. It can take up to 5 days to show.</span></li>
        </ol>
      </section>

      <!-- ===== Directory ===== -->
      <section id="directory" class={`${wrap} pt-12 pb-6 scroll-mt-28`} data-dir>
        <h2 class={h2c} style={inter}>The complete TDLR provider list</h2>
        <p class="text-base leading-7 m-0 mb-5 max-w-[780px]">All {stats.total} licenses, by CP number. A "Group" tag means the license belongs to a company that holds others.</p>
        <div class="flex flex-wrap gap-2.5 items-end mb-3.5">
          <label for="provider-search" class="flex flex-col gap-1 flex-[1_1_320px] text-sm font-bold">Search by name or CP number
            <input id="provider-search" type="search" data-q placeholder="e.g. Aceable or CP262" autocomplete="off" class="text-[17px] font-normal min-h-[48px] px-4 rounded-xl border-2 border-[#CBD3DF] bg-white focus:border-primary-deep focus:outline-none" />
          </label>
          <div class="flex gap-2 flex-wrap">
            {[['all', 'All'], ['CURRENT', 'Current'], ['EXPIRED', 'Expired']].map(([k, l], i) => <button type="button" data-status={k} aria-pressed={i === 0 ? 'true' : 'false'} class={`font-bold text-[15px] min-h-[48px] px-4 rounded-full border-2 transition-colors ${i === 0 ? pillOn : pillOff}`}>{l}</button>)}
          </div>
        </div>
        <p class="text-sm text-text-muted m-0 mb-2" data-count>Showing all {stats.total}.</p>
        <div class="overflow-x-auto rounded-[14px] border border-border bg-white">
          <table class="w-full min-w-[680px] border-collapse text-[15px]" style="border-spacing:0;">
            <thead><tr class="bg-[#F6F6F9] text-left text-[13px] uppercase tracking-[0.05em] text-text-muted"><th class="px-4 py-2.5 font-bold w-[90px]">CP #</th><th class="px-4 py-2.5 font-bold">Provider (legal name)</th><th class="px-4 py-2.5 font-bold w-[110px]">License</th><th class="px-4 py-2.5 font-bold w-[110px]">Expires</th><th class="px-4 py-2.5 font-bold">Location</th></tr></thead>
            <tbody>
              {providers.map((p: any) => (
                <tr class={`border-t border-border ${p.cp === TEXAS_COURSE.providerNumber ? 'bg-info' : ''}`} data-row data-s={p.status} data-k={`${p.cp} ${p.name}`.toLowerCase()}>
                  <th scope="row" class="px-4 py-2.5 font-bold text-left">{p.cp}</th>
                  <td class="px-4 py-2.5">{p.name} {p.group > 1 && <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 whitespace-nowrap">Group of {p.group}</span>}</td>
                  <td class={`px-4 py-2.5 text-[13px] font-bold ${p.status === 'CURRENT' ? 'text-primary-deep' : 'text-amber-800'}`}>{p.status}</td>
                  <td class="px-4 py-2.5 whitespace-nowrap">{p.expires}</td>
                  <td class="px-4 py-2.5 text-text-body">{p.city}, {p.state}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-sm text-text-muted m-0 mt-2.5">Status as of TDLR's file dated {asOf}. Licenses renew every two years; confirm a provider's current status on TDLR's license search before you rely on it.</p>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[820px] mt-5">
          {faqs.map((f) => <div class="rounded-xl border border-border bg-white p-5"><h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3><p class="m-0 text-text-body leading-7">{f.a}</p></div>)}
        </div>
      </section>

      <!-- ===== Next step + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Your next step</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-7">
          {nextSteps.map(([href, t, s]) => <a href={href} class="no-underline text-text rounded-[14px] border border-border bg-white p-4 hover:border-primary-deep"><strong>{t}</strong><br /><span class="text-[15px] text-text-body">{s}</span></a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[820px] leading-6">*Company groupings from Road Ready Safety's analysis of TDLR's driving safety provider licensee file ({asOf}): {stats.method} Road Ready Safety is a TDLR-licensed provider ({TEXAS_COURSE.providerNumber}) and is listed here like every other provider. General information, not legal advice. Sources: TDLR driving safety provider licensee file (vsDriverSafetyProvider); TDLR DESSearch. Updated October 7, 2026.</p>
      </section>

      <StickyCta afterId="groups" hideAtId="course" />
    </article>

    <script is:inline>
      (function () {
        document.querySelectorAll('[data-dir]:not([data-armed])').forEach(function (root) {
          root.setAttribute('data-armed', '1');
          var q = root.querySelector('[data-q]'), count = root.querySelector('[data-count]'), rows = root.querySelectorAll('[data-row]'), btns = root.querySelectorAll('[data-status]'), status = 'all';
          var on = ['bg-primary', 'text-white', 'border-primary'], off = ['bg-white', 'text-text', 'border-[#CBD3DF]', 'hover:border-primary-deep'];
          function render() {
            var term = q.value.trim().toLowerCase(), n = 0;
            rows.forEach(function (r) { var ok = (status === 'all' || r.getAttribute('data-s') === status) && (!term || r.getAttribute('data-k').indexOf(term) !== -1); r.hidden = !ok; if (ok) n++; });
            count.textContent = n === rows.length ? 'Showing all ' + n + '.' : 'Showing ' + n + ' of ' + rows.length + '.';
          }
          q.addEventListener('input', render);
          btns.forEach(function (b) { b.addEventListener('click', function () { status = b.getAttribute('data-status'); btns.forEach(function (x) { var s = x === b; x.setAttribute('aria-pressed', s ? 'true' : 'false'); on.forEach(function (c) { x.classList.toggle(c, s); }); off.forEach(function (c) { x.classList.toggle(c, !s); }); }); render(); }); });
        });
      })();
    </script>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

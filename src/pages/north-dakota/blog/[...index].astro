---
/**
 * North Dakota guides index, grouped by topic (src/data/blog/nd-topics.ts). Overrides the shared
 * [state]/blog/index.astro for /north-dakota/blog only, with the same rest-param trick as the
 * course page: getStaticPaths returns nothing while North Dakota is disabled. Other states keep
 * the shared flat list.
 */
import CourseLayout from '../../../layouts/CourseLayout.astro';
import PageIntro from '../../../components/course/PageIntro.astro';
import FinalCta from '../../../components/course/FinalCta.astro';
import nd from '../../../data/courses/nd-ddc.json';
import { postsFor, type StatePost } from '../../../data/blog/index';
import { ndTopics, checkNdTopics } from '../../../data/blog/nd-topics';
import { isEnabled, enrollUrl as buildEnrollUrl } from '../../../lib/courseFlags';
import type { CourseData } from '../../../data/courses/types';

export function getStaticPaths() {
  return isEnabled(nd as CourseData) ? [{ params: { index: undefined } }] : [];
}

checkNdTopics();
const course = nd as CourseData;
const route = course.state.route;
const enrollUrl = buildEnrollUrl(course);
const bySlug = new Map(postsFor('ND').map((p) => [p.slug, p] as [string, StatePost]));
const groups = ndTopics.map((t) => ({ ...t, posts: t.slugs.map((s) => bySlug.get(s)!).filter(Boolean) }));
const outfit = "font-family:'Outfit',sans-serif;";
const crumbs = [
  { name: 'Home', url: '/' },
  { name: course.state.name, url: route },
  { name: 'Guides', url: `${route}/blog` },
];
---

<CourseLayout
  course={course}
  title={`${course.blog.title} | Road Ready`}
  description={course.blog.intro}
  url={`${route}/blog`}
  courseSchema={false}
  breadcrumbs={crumbs}
>
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-surface-muted">
    <div class="max-w-4xl mx-auto">
      <PageIntro chip="Guides" title={course.blog.title} subtitle={course.blog.intro} />

      <p class="text-base text-text-body leading-7 mb-10">
        Start with a hub if you just got a ticket: <a href={`${route}/speeding-ticket`} class="text-primary-deep font-semibold underline underline-offset-2">North Dakota speeding tickets</a>
        or <a href={`${route}/traffic-ticket`} class="text-primary-deep font-semibold underline underline-offset-2">paying, contesting or electing a course for any ticket</a>.
      </p>

      <div class="flex flex-col gap-12">
        {groups.map((g) => (
          <section aria-labelledby={`topic-${g.id}`}>
            <h2 id={`topic-${g.id}`} class="text-2xl font-bold text-text m-0 mb-4" style={outfit}>{g.label}</h2>
            <ul class="flex flex-col gap-3 list-none p-0 m-0">
              {g.posts.map((post) => (
                <li class="bg-white border border-border rounded-[20px] p-6">
                  <a href={`${route}/blog/${post.slug}`} class="text-lg font-bold text-text no-underline hover:text-primary" style={outfit}>{post.title}</a>
                  <p class="text-base text-text-body leading-7 m-0 mt-1">{post.description}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
  <FinalCta course={course} enrollUrl={enrollUrl} />
</CourseLayout>

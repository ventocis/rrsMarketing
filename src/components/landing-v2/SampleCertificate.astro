---
/**
 * Shows the thing the student gets. Our own artwork, clearly marked SAMPLE; it is not the
 * state's certificate form. Don't use it where the certificate is a state-controlled form
 * (Texas ADE-1317): a look-alike could read as the real thing.
 */
interface Props { courseName: string; hours: number; sampleNumber: string; class?: string }
const { courseName, hours, sampleNumber, class: cls = '' } = Astro.props;
---
<div class={`bg-white rounded-[20px] shadow-[0_24px_48px_-16px_rgba(2,25,84,0.35)] ring-1 ring-border p-5 w-[360px] max-w-full ${cls}`}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex flex-col gap-0.5">
      <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-primary-deep">Certificate of Completion</span>
      <span class="text-[15px] font-bold text-text leading-5" style="font-family:'Outfit',sans-serif;">{courseName}</span>
    </div>
    <img src="/assets/icons/texas/logo-shield.svg" alt="" class="w-10 h-10 flex-shrink-0" />
  </div>
  <dl class="grid grid-cols-2 gap-x-4 gap-y-2 mt-4 text-[11px]">
    <div><dt class="text-text-muted">Student</dt><dd class="font-semibold text-text m-0">JANE DRIVER</dd></div>
    <div><dt class="text-text-muted">Completed</dt><dd class="font-semibold text-text m-0 tabular-nums">09/23/2026</dd></div>
    <div><dt class="text-text-muted">Course length</dt><dd class="font-semibold text-text m-0">{hours} hours</dd></div>
    <div><dt class="text-text-muted">Certificate no.</dt><dd class="font-semibold text-text m-0 tabular-nums">{sampleNumber}</dd></div>
  </dl>
  <div class="mt-4 rounded-lg bg-primary text-white text-center text-[12px] font-bold tracking-[0.12em] py-2">SAMPLE · NOT A REAL CERTIFICATE</div>
</div>

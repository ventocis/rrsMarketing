---
import TexasLayout from '../../layouts/TexasLayout.astro';
import StickyCta from '../../components/texas/StickyCta.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || 'https://roadreadysafety.com/support';
const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const price = TEXAS_PRICE_LABEL;

// Rebuilt 2026-10-06 from Jackson's design canvas (Dallas Page Redesign2.html, artboard 02 "How to pick a
// course" + its search preview), implemented as the spec: his copy, section order, CTAs. Two flagged
// deviations: the refund checkmark matches our policy (full refund within the three-day cancellation
// window, /texas/refund), and the design has no video so the previous YouTube card is not carried over.

const faqs = [
  { q: 'What is the best defensive driving course in Texas?', a: 'There isn’t one best course. Every TDLR-approved course teaches the same six hours and issues the same certificate. Pick one that’s approved, shows its full price before you pay, and gives you the certificate the moment you finish.' },
  { q: 'What is the cheapest defensive driving course in Texas?', a: `By law, no approved course can cost less than ${floor} (Tex. Educ. Code §1001.352). The cheapest real option is one near that floor with the certificate included and nothing added at checkout.` },
  { q: 'Is there a faster course than six hours?', a: 'No. Six hours is the state rule and every approved online course enforces it with timers. A course promising two or three hours isn’t the Texas driving safety course. You can spread it over several evenings. <a href="/texas/what-the-course-looks-like" class="text-primary-deep font-medium hover:underline">Where the time goes</a>' },
  { q: 'Is Road Ready Safety a legitimate, court-accepted course?', a: `Yes. It’s TDLR-approved (provider ${TEXAS_COURSE.providerNumber}) and accepted by Texas courts statewide for an eligible ticket. You can confirm it on TDLR’s own license search.` },
];
const plain = (s: string) => s.replace(/<[^>]+>/g, '');

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Every Texas defensive driving course is the same. The price isn’t.',
  description: 'Every TDLR-approved course dismisses the same ticket. The difference is the checkout total. How a “$25” course becomes $45, and how to spot it.',
  datePublished: '2026-06-15',
  dateModified: '2026-10-06',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/best-defensive-driving-course`,
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: plain(f.a) } })),
});

const same = [
  { t: 'Same curriculum', b: 'Written by the state (16 TAC ch. 84)' },
  { t: 'Same 6 hours', b: 'At least 5 of instruction, enforced by timers' },
  { t: 'Same certificate', b: 'The court only sees this (Code Crim. Proc. ch. 45A)' },
];
const compare = [
  { t: '1. The final total', b: 'Look at the last checkout screen, not the ad. Certificate, “processing” and premium lines get added after the advertised price.' },
  { t: '2. When you get the certificate', b: 'Instant download, by mail next week, or instant for a fee? Your court has a deadline.' },
  { t: '3. Whether it saves your place', b: 'Six hours rarely happen in one sitting. Switching from phone to laptop shouldn’t cost you progress.' },
  { t: '4. Format and language', b: 'Text, video or audio, and whether there’s a Spanish version. Pick what you’ll actually sit through.' },
  { t: '5. Refunds and a human', b: 'Can you get your money back if you stop? Is there someone to call? Read it before you pay.' },
];

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const h2c = 'text-[28px] lg:text-[34px] font-extrabold tracking-[-0.02em] leading-[1.15] text-text m-0 mb-3';
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const card = 'rounded-[14px] border border-border bg-white p-5 lg:p-[22px]';
---

{isEnabled ? (
  <TexasLayout
    title="Best Texas Defensive Driving Course? Check the Final Price"
    description="Every TDLR-approved course dismisses the same ticket. The difference is the checkout total. Here's how a “$25” course becomes $45, and how to spot it."
    keywords="best defensive driving course texas, cheapest defensive driving course texas, texas defensive driving course comparison, tdlr approved defensive driving course, how to choose defensive driving course texas"
    url="/texas/best-defensive-driving-course"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-surface-muted pb-24 lg:pb-16 text-text" style={sans}>
      <!-- ===== Lead ===== -->
      <div class={wrap}>
        <p class="text-[15px] text-text-body pt-5 m-0"><a href="/texas" class="text-text-body hover:underline">Texas</a><span class="mx-1.5">›</span><span>How to pick a course</span></p>
        <div class="max-w-[780px] pt-8 pb-10">
          <h1 class="text-[36px] lg:text-[56px] font-extrabold tracking-[-0.02em] leading-[1.05] m-0 mb-5" style={inter}>Every Texas defensive driving course is the same. The price isn't.</h1>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-4">Any TDLR-approved course dismisses an eligible ticket. They all teach the same six hours and issue the same certificate. So the "best" course is the one that doesn't surprise you at the end.</p>
          <p class="text-lg lg:text-[21px] leading-8 m-0 mb-6">And the most common surprise is a <strong>{floor} course that ends up costing $40 to $50</strong>. Here's how that happens, and the one question that stops it.</p>
          <p class="text-[15px] text-text-muted m-0">By Road Ready Safety, TDLR provider {TEXAS_COURSE.providerNumber}. We sell one of these courses, so read this as a seller explaining the market. The checklist works on us too. · Updated October 6, 2026</p>
        </div>
      </div>

      <!-- ===== Why $25 becomes $40 ===== -->
      <section id="price" class="bg-white border-y border-border scroll-mt-28">
        <div class={`${wrap} py-12 lg:py-14`}>
          <h2 class={h2c} style={inter}>Why does a {floor} course end up costing $40 or more?</h2>
          <p class="text-base leading-7 m-0 mb-7 max-w-[780px]">Because the certificate is often only free by mail, in two to four weeks. You find that out after you finish. Your court has a deadline, so you pay another $15 to $25 to download it today.</p>
          <div class="flex flex-col gap-[22px] max-w-[820px]">
            <div class="flex flex-col gap-2">
              <div class="flex justify-between gap-3 text-[17px]"><span>What's advertised</span><strong>{floor}</strong></div>
              <div class="h-[22px] rounded-md bg-[#8B95A5] w-1/2"></div>
            </div>
            <div class="flex flex-col gap-2">
              <div class="flex justify-between gap-3 text-[17px]"><span>What many people pay once they need the certificate today</span><strong class="text-amber-800">$40–$50</strong></div>
              <div class="flex h-[22px] w-full"><div class="bg-[#8B95A5] w-1/2 rounded-l-md"></div><div class="bg-accent w-1/2 rounded-r-md"></div></div>
              <div class="text-[15px] text-amber-800 font-semibold">+ $15 to $25 certificate fee, charged after you finish</div>
            </div>
            <div class="flex flex-col gap-2">
              <div class="flex justify-between gap-3 text-[17px]"><span>Road Ready Safety, certificate included</span><strong class="text-primary">{price} total</strong></div>
              <div class="h-[22px] rounded-md bg-primary w-[56%]"></div>
            </div>
          </div>
          <div class="mt-8 rounded-[14px] bg-primary-deep text-white px-7 py-6 max-w-[820px] flex flex-col gap-1.5">
            <span class="text-sm font-bold uppercase tracking-[0.06em] text-info-border">Ask this before you enter a card</span>
            <p class="text-[22px] lg:text-[24px] font-bold leading-[1.3] m-0" style={inter}>"When I finish, is the certificate in my hands today at no extra cost?"</p>
          </div>
        </div>
      </section>

      <!-- ===== All the same ===== -->
      <section class={`${wrap} pt-16 pb-6`}>
        <h2 class={h2c} style={inter}>Are all Texas defensive driving courses the same?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">To the court, yes. The court doesn't grade the course. It checks for a completion certificate from a TDLR-licensed provider, then dismisses the charge. No course is "more accepted" or "faster to dismiss."</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          {same.map((s) => (
            <div class={card}>
              <p class="text-[26px] lg:text-[28px] font-extrabold text-primary leading-tight m-0 mb-1" style={inter}>{s.t}</p>
              <p class="text-base text-text-body leading-6 m-0">{s.b}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== What to compare ===== -->
      <section id="checks" class={`${wrap} pt-12 pb-6 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>What should you compare instead?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Five things, each checkable in a minute on the provider's own site.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {compare.map((c) => (
            <div class={`${card} flex flex-col gap-1.5`}>
              <span class="font-bold text-[19px]">{c.t}</span>
              <span class="text-base text-text-body leading-6">{c.b}</span>
            </div>
          ))}
          <div class="rounded-[14px] border border-info-border bg-info p-5 lg:p-[22px] flex flex-col gap-1.5">
            <span class="font-bold text-[19px]">Not on the list: brand or price tier</span>
            <span class="text-base text-text-body leading-6">Neither changes whether your ticket is dismissed. The court only sees the certificate.</span>
          </div>
        </div>
      </section>

      <!-- ===== TDLR check ===== -->
      <section class={`${wrap} pt-12 pb-6`}>
        <h2 class={h2c} style={inter}>How do you check a course is TDLR-approved?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">Find its provider number, then look it up on TDLR's own site. It takes 30 seconds.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 max-w-[820px]">
          <div class={card}>
            <p class="text-[28px] font-extrabold text-primary leading-none m-0 mb-2" style={inter}>1</p>
            <p class="font-bold m-0">Find the CP number on the course's site</p>
            <p class="text-base text-text-body leading-6 m-0">"CP" followed by digits. Ours is {TEXAS_COURSE.providerNumber}.</p>
          </div>
          <div class={card}>
            <p class="text-[28px] font-extrabold text-primary leading-none m-0 mb-2" style={inter}>2</p>
            <p class="font-bold m-0">Search it on TDLR's license lookup</p>
            <p class="text-base text-text-body leading-6 m-0">Not shown, or not found? Walk away. <a href="/texas/tdlr-approved" class="text-primary hover:text-primary-deep font-medium">Step-by-step search</a></p>
          </div>
        </div>
      </section>

      <!-- ===== Our checklist ===== -->
      <section id="course" class={`${wrap} pt-12 pb-12 scroll-mt-28`}>
        <h2 class={h2c} style={inter}>How does Road Ready Safety do on the same checklist?</h2>
        <p class="text-base leading-7 m-0 mb-6 max-w-[780px]">{price} is the whole price. Here's what that covers, and what we won't claim.</p>
        <div class="rounded-[20px] bg-primary-deep text-white p-7 lg:p-9 flex flex-wrap gap-8 items-center justify-between">
          <ul class="flex-[999_1_420px] min-w-0 flex flex-col gap-3 list-none p-0 m-0 text-[17px]">
            <li>✓&nbsp; <strong>Final total: {price}.</strong> No delivery, rush, processing or premium lines.</li>
            <li>✓&nbsp; <strong>Certificate:</strong> instant download when you finish, court and insurance copies included.</li>
            <li>✓&nbsp; <strong>Saves your place</strong> across phone, tablet and computer.</li>
            <li>✓&nbsp; <strong>Unlimited quiz retakes</strong>, no final exam.</li>
            <li>✓&nbsp; <strong>Full refund</strong> if you cancel within three days of enrolling.</li>
            <li>✓&nbsp; <strong>TDLR provider {TEXAS_COURSE.providerNumber}.</strong> <a href="/texas/spanish" class="text-info-border hover:underline">Prefer Spanish?</a></li>
            <li class="text-info text-base mt-1.5">What we don't claim: we can't make it shorter than six hours, and we can't promise what your court decides. Need a Type 3A record? It's $12 directly from Texas DPS, and we don't resell it.</li>
          </ul>
          <div class="flex-[1_1_240px] flex flex-col gap-3 justify-center">
            <a href={enrollUrl} class="text-center no-underline bg-white hover:bg-info text-primary-deep font-extrabold text-lg px-7 py-4 rounded-full" style={inter}>Start the {price} course →</a>
            <a href="/texas/request-defensive-driving" class="text-center no-underline text-info hover:text-white font-medium">Haven't asked your court yet? Do that first.</a>
          </div>
        </div>
      </section>

      <!-- ===== Quick answers ===== -->
      <section class={`${wrap} pt-2 pb-6`}>
        <h2 class={h2c} style={inter}>Quick answers</h2>
        <div class="flex flex-col gap-3 max-w-[780px] mt-5">
          {faqs.map((f) => (
            <div class="rounded-xl border border-border bg-white p-5">
              <h3 class="font-bold text-base m-0 mb-1" style={sans}>{f.q}</h3>
              <p class="m-0 text-text-body leading-7" set:html={f.a} />
            </div>
          ))}
        </div>
      </section>

      <!-- ===== Keep reading + legal ===== -->
      <section class={`${wrap} pt-6 pb-10`}>
        <p class="font-bold m-0 mb-2.5">Keep reading</p>
        <div class="flex flex-wrap gap-2.5 mb-7">
          {[
            ['/texas/cost', 'Every fee line, explained'],
            ['/texas/tdlr-approved', 'How to check TDLR approval'],
            ['/texas/request-defensive-driving', 'How to request the course from your court'],
            ['/texas/eligibility-tracker', 'Am I eligible?'],
            ['/texas/what-the-course-looks-like', 'See inside the course'],
            ['/texas/road-ready-safety-reviews', 'What our reviewers say'],
          ].map(([href, t]) => <a href={href} class="no-underline bg-white border border-border rounded-full px-4 py-2 text-base text-text hover:border-primary-deep">{t}</a>)}
        </div>
        <p class="text-[15px] text-text-muted m-0 max-w-[780px] leading-6">Seen a checkout that didn't match its advertised price? <a href={contactUrl} class="text-text-muted underline">Tell us</a>. It keeps our cost page honest. General information, not legal advice. Sources: 16 TAC ch. 84 (curriculum and length); Tex. Educ. Code §1001.352 as amended by HB 3012, eff. Sept. 1, 2025 (price floor); Tex. Code Crim. Proc. ch. 45A (dismissal). No provider other than Road Ready Safety is named or priced on this page. Road Ready Safety is a TDLR-licensed provider ({TEXAS_COURSE.providerNumber}). Last updated October 6, 2026.</p>
      </section>

      <StickyCta afterId="price" hideAtId="course" />
    </article>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

---
/**
 * SalesVideo — the 60-second "why this course" sales video, self-hosted.
 *
 * WHY SELF-HOSTED RATHER THAN YOUTUBE
 * This is a money-page asset. A YouTube embed puts YouTube's branding, a
 * "Watch on YouTube" affordance and end-screen suggestions on the one page
 * whose only job is enrollment. The site already serves static assets from
 * S3/CloudFront, so a plain <video> costs nothing extra to host.
 * (The course-tour video further down the page stays on YouTube on purpose —
 * it is a discovery asset and benefits from YouTube's reach.)
 *
 * WHY IT DOES NOT SLOW THE PAGE DOWN
 *  - preload="none" + a poster image: the page downloads ~55 KB (the poster),
 *    not the 14 MB video. Video bytes are spent only by people who press play.
 *  - The poster carries explicit width/height and the box is aspect-ratio
 *    locked, so the section reserves its space and contributes zero CLS.
 *  - No player library and no framework island — just the native element and
 *    ~40 lines of inline JS. Nothing is added to the critical path.
 *  - The MP4 is encoded faststart (moov atom first), so playback begins from a
 *    range request in well under a second rather than after a full download.
 *
 * CAPTIONS
 * The MP4 has captions burned into the picture, so this deliberately ships no
 * <track> element. Adding one renders a second set of subtitles on top of the
 * baked-in ones. If a caption-free cut is ever produced, add the track back.
 *
 * MEASUREMENT
 * Every meaningful moment is pushed to the GTM dataLayer (GTM-WR3LFPW5 →
 * GA4 G-F8S6Y64XWJ): video_start, video_progress at 25/50/75, video_complete.
 * A sessionStorage flag also rides along on the enrollment click as
 * `video_watched`, so watchers and non-watchers can be compared in GA4.
 * See docs/texas-sales-video.md for the decision rule and rollback triggers.
 */
interface Props {
  /** Checkout URL for the CTA under the player. */
  enrollUrl: string;
  /** Price shown on the CTA, e.g. "28". */
  price?: string;
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  ctaLabel?: string;
  /** Base path for the asset pair (.mp4 and -poster.jpg). */
  src?: string;
  /** Identifies the video in analytics. */
  videoId?: string;
  /** Length in seconds, for the schema and the badge. */
  seconds?: number;
}

const {
  enrollUrl,
  price = '28',
  // The eyebrow carries the one fact not stated anywhere else in this section:
  // how long the video is. Everything the old subheading said is either in the
  // video itself, the hero badges or the announcement bar, so it is gone.
  eyebrow = '60 seconds',
  heading = 'Why you should choose our course',
  subheading = '',
  ctaLabel = 'Dismiss My Ticket',
  src = '/assets/video/why-this-course',
  videoId = 'why-this-course',
  seconds = 61,
} = Astro.props;

const mp4 = `${src}.mp4`;
const poster = `${src}-poster.jpg`;
const mmss = `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---

<section id="why-this-course" class="bg-surface-dark py-16 lg:py-24 scroll-mt-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col gap-3 items-center text-center mb-8 lg:mb-10">
      <div class="flex items-center gap-2.5">
        <span class="h-[3px] w-7 rounded-full bg-primary"></span>
        <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-info-border">{eyebrow}</span>
        <span class="h-[3px] w-7 rounded-full bg-primary"></span>
      </div>
      <h2
        class="text-[30px] lg:text-[40px] font-bold text-white leading-[1.15] tracking-[-1px] max-w-2xl"
        style="font-family:'Outfit',sans-serif;"
      >
        {heading}
      </h2>
      {subheading && <p class="text-base lg:text-lg text-text-subtle leading-7 max-w-xl">{subheading}</p>}
    </div>

    <!-- Player. Aspect-ratio locked so the box never resizes as the poster or video loads. -->
    <div
      class="rrs-sv group relative w-full overflow-hidden rounded-[20px] border border-white/10 bg-black shadow-[0_32px_64px_-24px_rgba(0,0,0,0.7)]"
      style="aspect-ratio:16/9;"
      data-video-id={videoId}
      data-video-seconds={seconds}
    >
      <video
        class="rrs-sv-video absolute inset-0 h-full w-full"
        poster={poster}
        preload="none"
        playsinline
        controlslist="nodownload"
        width="1280"
        height="720"
        aria-label="Why this course — a 60 second overview"
      >
        <source src={mp4} type="video/mp4" />
        Your browser cannot play this video.
        <a href={mp4} class="underline">Download it instead</a>.
      </video>

      <!-- Overlay: only markup until someone presses play. -->
      <button
        type="button"
        class="rrs-sv-play absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center border-0 bg-gradient-to-t from-black/45 via-transparent to-black/10 p-0 transition-colors focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-[-4px] focus-visible:outline-info-border"
        aria-label="Play the 60 second overview"
      >
        <span
          class="flex h-[72px] w-[72px] items-center justify-center rounded-full bg-primary transition-transform duration-200 group-hover:scale-110 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          style="box-shadow:0 12px 32px rgba(36,84,230,.55), 0 0 0 16px rgba(4,9,24,.38)"
        >
          <svg width="30" height="30" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </span>
        <span
          class="absolute bottom-4 right-4 rounded-full bg-black/65 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm tabular-nums"
        >
          {mmss}
        </span>
      </button>
    </div>

    <!-- CTA. This band sits in what used to be a long CTA-free stretch of the page. -->
    <div class="mt-8 flex flex-col items-center gap-3">
      <a
        href={enrollUrl}
        data-rrs-enroll
        class="bg-primary hover:bg-primary-hover text-white h-[56px] px-10 rounded-[16px] text-[18px] font-semibold flex items-center justify-center no-underline transition-colors w-full sm:w-auto shadow-[0_12px_24px_-8px_rgba(36,84,230,0.6)]"
        style="font-family:'DM Sans',sans-serif;"
      >
        {ctaLabel} &mdash; ${price}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function init() {
      document.querySelectorAll('.rrs-sv').forEach(function (box) {
        if (box.dataset.bound) return;
        box.dataset.bound = '1';

        var video = box.querySelector('.rrs-sv-video');
        var overlay = box.querySelector('.rrs-sv-play');
        var id = box.getAttribute('data-video-id') || 'video';
        var declared = Number(box.getAttribute('data-video-seconds')) || 0;
        var marks = { 25: false, 50: false, 75: false };
        var started = false;

        // With preload="none" the real duration is unknown until metadata
        // arrives, which is after 'play' fires. Fall back to the declared
        // length so video_start never reports a duration of 0.
        function duration() {
          return video.duration && isFinite(video.duration) ? video.duration : declared;
        }

        function push(event, extra) {
          window.dataLayer = window.dataLayer || [];
          var payload = { event: event, video_id: id };
          for (var k in extra) payload[k] = extra[k];
          window.dataLayer.push(payload);
        }

        overlay.addEventListener('click', function () {
          // controls are added only now, so the poster stays clean until play
          video.setAttribute('controls', '');
          overlay.remove();
          var p = video.play();
          if (p && p.catch) p.catch(function () { video.setAttribute('controls', ''); });
        });

        video.addEventListener('play', function () {
          if (started) return;
          started = true;
          try { sessionStorage.setItem('rrs_video_watched', id); } catch (e) {}
          push('video_start', { video_duration: Math.round(duration()) });
        });

        video.addEventListener('timeupdate', function () {
          var d = duration();
          if (!d) return;
          var pct = (video.currentTime / d) * 100;
          [25, 50, 75].forEach(function (m) {
            if (!marks[m] && pct >= m) {
              marks[m] = true;
              try { sessionStorage.setItem('rrs_video_pct', String(m)); } catch (e) {}
              push('video_progress', { video_percent: m });
            }
          });
        });

        video.addEventListener('ended', function () {
          try { sessionStorage.setItem('rrs_video_pct', '100'); } catch (e) {}
          push('video_complete', { video_percent: 100 });
        });
      });

      // Tag every enrollment click with whether this session watched the video.
      // Delegated once on document so it survives full page loads and does not
      // depend on the ViewTransitions router (which does not ship in prod).
      if (!window.__rrsEnrollTagged) {
        window.__rrsEnrollTagged = true;
        document.addEventListener('click', function (e) {
          var link = e.target && e.target.closest && e.target.closest('a[href*="/public/checkout"]');
          if (!link) return;
          var watched = null, pct = null;
          try {
            watched = sessionStorage.getItem('rrs_video_watched');
            pct = sessionStorage.getItem('rrs_video_pct');
          } catch (err) {}
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'enroll_click',
            video_watched: watched ? 'yes' : 'no',
            video_percent_watched: pct ? Number(pct) : 0,
            cta_location: link.hasAttribute('data-rrs-enroll') ? 'sales_video' : 'other',
          });
        });
      }
    }

    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>

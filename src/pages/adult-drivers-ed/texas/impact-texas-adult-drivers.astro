---
/**
 * /adult-drivers-ed/texas/impact-texas-adult-drivers — ITAD, the free one-hour DPS video, and its 90-day certificate.
 *
 * Rebuilt 2026-10-13 on the hook → answer → loop → funnel recipe (ADE-PAGE-RECIPE.md): the H1 names the search and
 * the catch (free and an hour, but the certificate expires); the first paragraph answers it in one breath; each H2 is
 * the reader's next question; the page ends in the course band, because at 18 to 24 the course comes before ITAD.
 *
 * Facts: itd (DPS-ITD, 37 TAC §15.62) from src/data/ade-eligibility.ts; queue figures from src/lib/dps-stats.ts,
 * a dated snapshot of the DPS wait-time report. Nothing numeric is typed by hand.
 */
import AdeGuide from '../../../components/ade/AdeGuide.astro';
import { itd } from '../../../data/ade-eligibility';
import { dpsStats as W, pct } from '../../../lib/dps-stats';

const base = '/adult-drivers-ed/texas';
const longDate = new Date(`${W.capturedOn}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const hour = itd.adultLengthHours === 1 ? 'one-hour' : `${itd.adultLengthHours}-hour`;
const offices = (n: number) => `${n} ${n === 1 ? 'office' : 'offices'}`;

// The one-breath answer: lede and meta description use the same sentence.
const answer = `Impact Texas Adult Drivers (ITAD) is a free ${hour} Texas DPS video. You need its certificate to take the driving test, and it must be dated within ${itd.certValidDays} days of the test.`;

const faqs = [
  {
    q: 'What is Impact Texas Adult Drivers (ITAD)?',
    a: `ITAD is a free ${itd.adultLengthHours}-hour video from Texas DPS about distracted driving. DPS requires it for ${itd.adultAppliesTo}. You watch it online, print a certificate, and present that certificate before the driving skills test. Without it you cannot take the test.`,
  },
  {
    q: 'How long is the ITD certificate valid?',
    a: `${itd.certValidDays} days. DPS requires the certificate to be dated within ${itd.certValidDays} days of your driving skills test, so the clock starts when you finish the video, not when you book the appointment.`,
  },
  {
    q: 'How do I get my ITAD certificate?',
    a: 'Watch the free video online and print the certificate at the end. Bring the printed certificate to your driving skills test with your other documents.',
  },
  {
    q: 'Do I need ITAD if I am over 25?',
    a: 'Yes, if you are taking a driving skills test. DPS lists ITAD as required for drivers aged 18 through 24 who must complete an adult driver education course, and for drivers 25 years or older. The driver education course is not required at 25 and over, but the video still is.',
  },
  {
    q: 'Does the six-hour adult driver education course count instead of ITAD?',
    a: 'No. DPS says the ITD programs do not replace the distracted driving module in the six-hour adult driver education course. They are two separate requirements that cover overlapping ground, so if you need the course, you do both.',
  },
  {
    q: 'When should I watch the ITAD video?',
    a: `After you book your skills test and see the date you are given, close enough to that date that the certificate is still valid on the day. DPS says the ITD program must be completed ${itd.order}, and the certificate only lasts ${itd.certValidDays} days.`,
  },
  {
    q: 'Do I need ITAD for a third-party skills test?',
    a: 'Yes. DPS notes that third-party skills testing also requires ITD program completion based on your age.',
  },
];

const next = [
  { href: `${base}/dps-wait-times`, title: 'How far out your office books the road test', blurb: `Every DPS office ranked by the wait, so you can see whether your queue is near the ${itd.certValidDays}-day line.` },
  { href: `${base}/texas-driving-test`, title: 'What happens at the driving test', blurb: 'What to bring, how to book it, and what the course does and does not cover.' },
  { href: `${base}/how-to-get-a-texas-license-as-an-adult`, title: 'The whole process, in order', blurb: 'Where ITAD sits between the course and the card in your hand.' },
  { href: `${base}/do-i-need-adult-drivers-ed`, title: 'Do you need the six-hour course?', blurb: 'Required at 18 to 24 for a first license, optional at 25 and over. Check your case.' },
];
---

<AdeGuide
  title={`Impact Texas Adult Drivers (ITAD): Free ${itd.adultLengthHours}-Hour DPS Video, Certificate Valid ${itd.certValidDays} Days | Road Ready Safety`}
  description={answer}
  url={`${base}/impact-texas-adult-drivers`}
  eyebrow="DPS process"
  h1={`Impact Texas Adult Drivers takes an hour and costs nothing, but its certificate expires in ${itd.certValidDays} days`}
  lede={`${answer} ${W.driveTest.overItd > 0 ? 'At the slowest DPS office the road-test queue is longer than the certificate lasts' : 'A long road-test queue can outlast the certificate'}, so the order you do things in decides whether it is still valid on the day, and that order is below.`}
  faqs={faqs}
  dateModified="2026-10-13"
  updated="October 13, 2026"
  band={{ eyebrow: 'The course comes first, ITAD comes last' }}
  next={next}
  sources={[
    { label: 'Texas DPS, Impact Texas Drivers (ITD) Program (authority: 37 TAC §15.62)', href: 'https://www.dps.texas.gov/section/driver-license/impact-texas-drivers-itd-program' },
    { label: `Texas DPS, Driver License Appointment and Office Wait Times (figures read ${W.capturedOn})`, href: 'https://www.dps.texas.gov/apps/Viewer/Document/Vue/WAITTIMES' },
    { label: 'Texas DPS, Apply for a Texas Driver License', href: 'https://www.dps.texas.gov/section/driver-license/apply-texas-driver-license' },
  ]}
>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">What is Impact Texas Adult Drivers?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      It is a free {itd.adultLengthHours}-hour video about distracted driving, produced by Texas DPS, and you
      need its certificate to take the driving skills test. It is required for {itd.adultAppliesTo}. You watch
      it online, print the certificate, and bring it to your driving skills test. DPS says you cannot take the
      test without it.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Does ITAD replace the six-hour adult driver education course?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      No. If you are 18 through 24 and getting a first Texas license, you do both. DPS states that the ITD
      programs do not replace the distracted driving module in the six-hour course.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">
      Can your ITAD certificate expire before your driving test?
    </h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      {W.driveTest.overItd > 0
        ? `Yes, at the slowest office. On ${longDate}, ${offices(W.driveTest.overItd)} had a road-test queue longer than the ${itd.certValidDays} days an ITD certificate stays valid.`
        : `It can, if your appointment is more than ${itd.certValidDays} days after you watch the video.`}
      {' '}Two DPS rules sit next to each other and do not quite fit. The certificate must be dated within{' '}
      <strong>{itd.certValidDays} days</strong> of your driving skills test, and every driver license office is
      appointment only, with DPS publishing how far out those appointments run.
    </p>
    <p class="text-[17px] text-text-body leading-[30px]">
      We read that report on {W.capturedOn}. Across {W.driveTest.measured} offices reporting a
      non-commercial drive test:
    </p>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left">
        <thead>
          <tr class="border-b border-border">
            <th class="py-3 pr-4 text-sm font-semibold text-text">Driving skills test queue</th>
            <th class="py-3 text-sm font-semibold text-text">Offices</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border">
            <td class="py-3 pr-4 text-[15px] text-text-body leading-6">Median wait</td>
            <td class="py-3 text-[15px] font-semibold text-text leading-6">{W.driveTest.median} days</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 pr-4 text-[15px] text-text-body leading-6">More than two weeks out</td>
            <td class="py-3 text-[15px] font-semibold text-text leading-6">{W.driveTest.over14} of {W.driveTest.measured} ({pct(W.driveTest.over14, W.driveTest.measured)}%)</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 pr-4 text-[15px] text-text-body leading-6">More than a month out</td>
            <td class="py-3 text-[15px] font-semibold text-text leading-6">{W.driveTest.over30} of {W.driveTest.measured} ({pct(W.driveTest.over30, W.driveTest.measured)}%)</td>
          </tr>
          <tr class="border-b border-border">
            <td class="py-3 pr-4 text-[15px] text-text-body leading-6">Longest queue in the state</td>
            <td class="py-3 text-[15px] font-semibold text-text leading-6">{W.driveTest.max} days ({W.driveTest.maxOffice})</td>
          </tr>
        </tbody>
      </table>
    </div>
    {W.driveTest.overItd > 0 && (
      <p class="text-[17px] text-text-body leading-[30px]">
        At {W.driveTest.maxOffice} the wait for a driving skills test was {W.driveTest.max} days, longer than
        the{' '}{itd.certValidDays} days an ITD certificate stays valid. Someone who did everything in the
        obvious order, watching the video as soon as they finished their course, would arrive at that
        appointment with an expired certificate and be turned away.
      </p>
    )}
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">When should you watch the ITAD video?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      After you have a test date, inside the {itd.certValidDays} days before it. In order:
    </p>
    <ul class="flex flex-col gap-3 pl-5 m-0 list-disc marker:text-text-subtle">
      <li class="text-[17px] text-text-body leading-[30px]"><strong>1. Finish your driver education course</strong> if you need one. DPS requires ITD to come {itd.order}.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>2. Book the skills test and look at the date you were given.</strong> Appointments can be made up to {6} months in advance, so the date you get may be a long way off.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>3. Count back {itd.certValidDays} days from that date.</strong> Watch the {itd.adultLengthHours}-hour video inside that window, not before it.</li>
      <li class="text-[17px] text-text-body leading-[30px]"><strong>4. Print the certificate and keep it with your documents.</strong></li>
    </ul>
    <p class="text-[17px] text-text-body leading-[30px]">
      If your appointment moves later, check the date on the certificate before you go. Rewatching the video
      costs an hour, and losing an appointment can cost a month.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">Can you get the driving test sooner?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      Sometimes. DPS releases a limited number of same-day appointments on a first come, first served basis,
      and cancellations free up earlier slots that its published estimate does not count.{' '}
      <a class="underline hover:no-underline" href={`${base}/third-party-skills-testing`}>Third-party skills testing</a>{' '}
      is the other route, and it still requires ITD.
    </p>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-bold text-text leading-8" style="font-family:'Outfit',sans-serif;">How current are these numbers?</h2>
    <p class="text-[17px] text-text-body leading-[30px]">
      They are a snapshot taken on {W.capturedOn}, not a live reading. DPS refreshes the wait-time report daily
      from the previous business day. Check{' '}
      <a class="underline hover:no-underline" href="https://www.dps.texas.gov/apps/Viewer/Document/Vue/WAITTIMES" rel="nofollow noopener" target="_blank">the DPS report</a>{' '}
      for your own office before you plan around any of it. We are not DPS, and their page governs.
    </p>
  </section>

</AdeGuide>

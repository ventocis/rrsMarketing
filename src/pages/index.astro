---
/**
 * Homepage (Jackson, 2026-10-19): Texas first, in the landing-v2 look.
 *
 * Order: the Texas Defensive Driving hero in the style of the 2026-10-06 homepage and the /texas and ADE
 * landings (TDLR pill, headline, facts line, four reassurance chips, Start + How it works, Trustpilot score;
 * on desktop the Dallas bridge photo with the price tag, a review card and the sample certificate), with
 * "Not in Texas? Select your state" opening a dialog for everyone else; then "Which Texas course do you
 * need?", two cards side by side, the defensive driving course and adult driver education, so the ADE
 * course is a peer offer rather than a band; then the Trustpilot reviews and the rest of the canvas
 * sections (why choose us, how it works, peace of mind, about, FAQ, guides). The three-state card row and
 * the bottom finder are gone; North Dakota and Missouri live in the dialog.
 *
 * Rules kept: prices and hours come from texas-course.ts, ade-texas.json and the state course JSON; a state
 * appears in the dialog only when courseFlags says it is live; no competitor names or prices; no Review /
 * AggregateRating schema (reviews are for people); the ADE card carries the DE license C3705, never CP1234
 * (16 TAC §84.503(j)(4)); no sample certificate for ADE (the ADE-1317 is a TDLR-controlled form). Title and
 * meta unchanged. The hero quote is checked at build time against texas-reviews.json (featured-courses.ts).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rating from '../components/landing-v2/Rating.astro';
import RoadPhoto from '../components/landing-v2/RoadPhoto.astro';
import SampleCertificate from '../components/landing-v2/SampleCertificate.astro';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../data/texas-course';
import { FEATURED_COURSES } from '../data/featured-courses';
import texasReviews from '../data/texas-reviews.json';
import allCourses from '../data/courses.json';
import nd from '../data/courses/nd-ddc.json';
import ndIpr from '../data/courses/nd-ipr.json';
import mo from '../data/courses/mo-dip.json';
import type { CourseData } from '../data/courses/types';
import { isEnabled, enrollUrl as buildEnrollUrl } from '../lib/courseFlags';
import { stateNames } from '../utils/states';
import ade from '../data/ade-texas.json';
import { adeEnabled, adeEnrollUrl, ADE_LICENSE } from '../lib/ade';
import { COMPLETION_RATE_BANNER } from '../data/banners';

const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const texasEnrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';
const contactUrl = import.meta.env.VITE_CONTACT_US_URL || '/support';
const trustpilotUrl = 'https://www.trustpilot.com/review/roadreadysafety.com';
const price = TEXAS_PRICE_LABEL;

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";

const ICONS: Record<string, string> = {
  self: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7 V12 L15 14\"/></svg>",
  short: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 3 L5 14 H12 L11 21 L19 10 H12 Z\"/></svg>",
  device: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"7\" y=\"3\" width=\"10\" height=\"18\" rx=\"2\"/><path d=\"M11 18 H13\"/></svg>",
  refund: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z\"/><path d=\"M9 12 L11.2 14.2 L15.5 9.8\"/></svg>",
  state: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 4 L3 6 V20 L9 18 L15 20 L21 18 V4 L15 6 Z\"/><path d=\"M9 4 V18 M15 6 V20\"/></svg>",
  online: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M10 8 L15 11 L10 14 Z\"/><path d=\"M8 21 H16\"/></svg>",
  cert: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"3\" width=\"16\" height=\"13\" rx=\"2\"/><path d=\"M8 8 H16 M8 11 H13\"/><circle cx=\"16\" cy=\"18\" r=\"3\"/><path d=\"M14.5 20.5 L14 23 L16 22 L18 23 L17.5 20.5\"/></svg>",
  submit: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 3 L10 14\"/><path d=\"M21 3 L14 21 L10 14 L3 10 Z\"/></svg>",
  covered: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z\"/><path d=\"M9 12 L11.2 14.2 L15.5 9.8\"/></svg>",
  pay: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11 V8 a4 4 0 0 1 8 0 V11\"/></svg>",
  counts: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2454E6\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"9\" r=\"6\"/><path d=\"M8.5 14 L7 22 L12 19.5 L17 22 L15.5 14\"/></svg>",
  email: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7 L12 13 L21 7\"/></svg>",
  phone: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 4 H9 L11 9 L8.5 10.5 a11 11 0 0 0 5 5 L15 13 L20 15 V19 a2 2 0 0 1 -2 2 A16 16 0 0 1 3 6 a2 2 0 0 1 2 -2\"/></svg>",
  help: "<svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#03449E\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5 a2 2 0 0 1 2 -2 H20 V19 H6 a2 2 0 0 0 -2 2 Z\"/><path d=\"M4 19 V21\"/></svg>",
};

const ndCourse = nd as CourseData;
const ndInsurance = ndIpr as CourseData;
const moCourse = mo as CourseData;

// State cards: Texas always; the others only when courseFlags says the state is live.
const states = [
  {
    abbr: 'TX', name: 'Texas', url: '/texas', badge: '/assets/images/badges/texas-approved-tdlr.png', badgeAlt: 'Texas approved course seal',
    approval: `TDLR-approved · ${TEXAS_COURSE.providerNumber}`, course: 'Texas Defensive Driving Course',
    price, hours: TEXAS_COURSE.hours, enroll: texasEnrollUrl, live: true,
  },
  {
    abbr: 'ND', name: 'North Dakota', url: ndCourse.state.route, badge: '/assets/images/badges/north-dakota-approved.png', badgeAlt: 'North Dakota approved course seal',
    approval: 'NDDOT-approved for point reduction', course: ndCourse.course.name,
    price: `$${ndCourse.course.priceUsd}`, hours: ndCourse.course.hours, enroll: buildEnrollUrl(ndCourse), live: isEnabled(ndCourse),
  },
  // North Dakota's second course (Highway Patrol, insurance premium reduction) gets its own card so a buyer
  // with that intent is never sent to the point reduction checkout. Dark until nd-ipr.json carries its approval.
  {
    abbr: 'ND-IPR', name: 'North Dakota', url: ndInsurance.state.route, badge: '/assets/images/badges/north-dakota-approved.png', badgeAlt: 'North Dakota approved course seal',
    approval: 'NDHP-approved for insurance premium reduction', course: ndInsurance.course.name,
    price: `$${ndInsurance.course.priceUsd}`, hours: ndInsurance.course.hours, enroll: buildEnrollUrl(ndInsurance), live: isEnabled(ndInsurance),
  },
  {
    abbr: 'MO', name: 'Missouri', url: moCourse.state.route, badge: '/assets/images/badges/missouri-approved.png', badgeAlt: 'Missouri approved course seal',
    approval: `MSC-approved · ${moCourse.provider.approvalNumber}`, course: moCourse.course.name,
    price: `$${moCourse.course.priceUsd}`, hours: moCourse.course.hours, enroll: buildEnrollUrl(moCourse), live: isEnabled(moCourse),
  },
].filter((s) => s.live);

// Reviews: the canvas's six, short ones first (Jackson's /texas feedback), MW's long one opens "Show more".
type Review = { name: string; initials: string; date: string; rating: number; verified: boolean; quote: string };
const ORDER = ['Ryan Johnson', 'Chelsie Gates', 'Bliss James', 'MW', 'Jeffrey', 'Colleen Minor'];
const reviews = ORDER.map((n) => (texasReviews as Review[]).find((r) => r.name === n)).filter(Boolean) as Review[];
const REVIEWS_SHOWN = 3;

// Hero: the Texas course and its proof card. Refuse to build if the quoted excerpt is not the customer's words.
const featured = FEATURED_COURSES[0];
const featuredReview = (texasReviews as Review[]).find((r) => r.name === featured.proof.reviewerName);
if (!featuredReview || !featuredReview.quote.includes(featured.proof.reviewExcerpt)) {
  throw new Error(`featured-courses: "${featured.proof.reviewExcerpt}" is not a verbatim excerpt of ${featured.proof.reviewerName}'s review`);
}

const why = [
  { icon: 'self', title: 'Self-paced online course', body: 'Start, stop and pick up anytime. Your progress saves automatically, so you can finish in one sitting or over a few days.' },
  { icon: 'short', title: 'Shortest state-approved course', body: `Only the hours your state requires: ${TEXAS_COURSE.hours} in Texas, ${ndCourse.course.hours} in North Dakota, ${moCourse.course.hours} in Missouri. No filler.` },
  { icon: 'device', title: 'Works on phone, tablet or computer', body: 'Built mobile-first. Switch devices anytime and pick up right where you left off.' },
  { icon: 'refund', title: 'Refund-backed guarantee', body: 'Not happy before you finish? Request a refund. Terms vary by state and are listed on each course page.' },
];

const steps = [
  { icon: 'state', title: 'Choose your state', body: 'Pick where you’re licensed and why you need the course: a ticket, points or an insurance discount.' },
  { icon: 'online', title: 'Take it online', body: 'Short, clear modules you can start, stop and finish at your own pace.' },
  { icon: 'cert', title: 'Get your certificate', body: 'Your certificate is ready to download the moment you finish.' },
  { icon: 'submit', title: 'Submit if required', body: 'Some courts or insurers need a copy. Your course page shows exactly where it goes.' },
];

const covered = [
  { icon: 'covered', title: 'Changed your mind? You’re covered.', body: 'Ask for a refund before you finish. Terms vary by state and are spelled out on each course page.' },
  { icon: 'pay', title: 'Your payment stays safe', body: 'Checkout runs through Stripe with TLS/SSL encryption, so your card details go straight to them.' },
  { icon: 'counts', title: 'Your certificate counts', body: 'Every course is approved by its state, so the court, DMV or insurer that asked for it will accept it.' },
];

const support = [
  { icon: 'email', label: 'Email us anytime', value: 'info@roadreadysafety.com', note: '', href: 'mailto:info@roadreadysafety.com' },
  { icon: 'phone', label: 'Call us', value: '(888) 885-5707', note: 'Mon–Fri, 9 a.m.–5 p.m. ET', href: 'tel:+18888855707' },
  { icon: 'help', label: 'Help Center', value: 'Answers to common questions', note: 'Open 24/7', href: '/support' },
];

const faqs = [
  { q: 'Is this accepted in my state?', a: `Every Road Ready course is approved by its state: Texas (TDLR, ${TEXAS_COURSE.providerNumber}), North Dakota (NDDOT, point reduction${isEnabled(ndInsurance) ? '; NDHP, insurance premium reduction' : ''}) and Missouri (MSC, ${moCourse.provider.approvalNumber}). Each course page lists the approval and any special instructions.` },
  { q: 'How long is the course?', a: `It depends on your state: Texas is ${TEXAS_COURSE.hours} hours, North Dakota is ${ndCourse.course.hours} hours and Missouri is ${moCourse.course.hours} hours. Start and stop anytime; your progress saves.` },
  { q: 'How do I get my certificate?', a: 'Download it the moment you finish. Some courts and insurers need you to send them a copy; your course page explains exactly how.' },
  { q: 'Will this dismiss my ticket or remove points?', a: 'It depends on your state. In Texas, the course can dismiss an eligible ticket once your court approves it. In North Dakota, it can take 3 points off your record. In Missouri, a court-approved Driver Improvement Program keeps the points off. Your course page walks you through the steps.' },
  { q: 'Can I use my phone?', a: 'Absolutely. Every course works on phone, tablet or computer, and your progress saves so you can switch devices anytime.' },
  { q: 'What languages are available?', a: 'Language options vary by course and state. Check the course page for your state.' },
  { q: 'How do refunds work?', a: 'If you haven’t completed the course and need a refund, contact Support. Eligibility can vary by state requirements.' },
  { q: 'How do I contact support?', a: 'Email us anytime, or call Mon–Fri, 9 a.m.–5 p.m. ET. You can also browse the Help Center.' },
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const websiteSchema = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Road Ready Safety', url: siteUrl });

// "Select your state" dialog: our live courses grouped by state (North Dakota has two), then the
// partner-course states from courses.json.
const COURSE_TYPE_LABELS: Record<string, string> = {
  BDI: 'Basic Driver Improvement', BDIC: 'Basic Driver Improvement', ADI: 'Advanced Driver Improvement',
  IDI: 'Intermediate Driver Improvement', TLSAE: 'TLSAE (first-time driver course)', Exam: 'Permit Exam',
  'Adult Driver Ed': 'Adult Driver Education', IPIRP: 'Point and Insurance Reduction Program',
  'Pre-Licensing': 'Pre-Licensing', 'Driver Improvement': 'Driver Improvement', 'Driver Education': 'Driver Education',
};
type PickerCourse = { title: string; sub: string; cta: string; href: string; learn?: string; ctaId: string };
const picker: { key: string; name: string; courses: PickerCourse[] }[] = [];
for (const s of states) {
  let group = picker.find((p) => p.name === s.name);
  if (!group) {
    group = { key: s.name.toLowerCase().replace(/\s+/g, '-'), name: s.name, courses: [] };
    picker.push(group);
  }
  group.courses.push({
    title: s.course, sub: `${s.approval} · ${s.price} all-in · ${s.hours} hours online`,
    cta: 'Start now', href: s.enroll, learn: s.url, ctaId: `home-picker-${s.abbr.toLowerCase()}`,
  });
}
const partnerCodes = ['FL', 'IL', 'LA', 'MI', 'NY', 'TN', 'VA'].filter((c) => (allCourses as { state: string }[]).some((x) => x.state === c));
for (const c of partnerCodes) {
  const n = stateNames[c] || c;
  // Name the actual course types (QA finding: "approved options" for Illinois led to adult driver ed only).
  const types = [...new Set((allCourses as { state: string; course_type: string }[]).filter((x) => x.state === c).map((x) => COURSE_TYPE_LABELS[x.course_type] || x.course_type))];
  const list = types.length > 1 ? `${types.slice(0, -1).join(', ')} and ${types[types.length - 1]}` : types[0];
  picker.push({
    key: c.toLowerCase(), name: n,
    courses: [types.length === 1
      ? { title: `${n} ${types[0]}`, sub: `The approved ${types[0]} course for ${n}.`, cta: `See ${n} courses`, href: `/find/${c}/multi`, ctaId: `home-picker-${c.toLowerCase()}` }
      : { title: `${n} courses`, sub: `Approved courses: ${list}.`, cta: `See ${n} courses`, href: `/find/${c}/multi`, ctaId: `home-picker-${c.toLowerCase()}` }],
  });
}

const guides = [
  { href: '/texas/ways-to-dismiss-ticket', label: 'Every way to dismiss a traffic ticket in Texas' },
  { href: '/texas/how-much-is-a-speeding-ticket', label: 'How much a traffic ticket costs in Texas' },
  { href: '/texas/stop-sign-ticket', label: 'Running a stop sign in Texas: fines, points and options' },
  { href: '/texas/defensive-driving-certificate', label: 'Texas defensive driving certificate: how to get and submit it' },
  { href: '/texas/tdlr-approved', label: 'How to check if a course is TDLR-approved' },
  { href: '/texas/providers', label: 'Texas defensive driving course providers: the full TDLR list' },
];

// Hero chips: what the Texas course includes. Refund wording per /texas/refund (full refund before completion).
const heroChips = ['Certificate the moment you finish', 'Works on your phone', 'Nothing added at checkout', 'Full refund before you finish'];

// "Which Texas course do you need?": the defensive driving course and adult driver education side by side.
// ADE shows only once the DE license gate is on (src/lib/ade.ts) and carries C3705, never CP1234.
const adePrice = `$${ade.course.priceUsd}`;
const adeHours = Math.round(ade.course.courseMinutes / 60);
type TexasCard = {
  key: string; eyebrow: string; license: string; name: string; price: string; priceNote: string; lead: string;
  facts: { label: string; text: string }[]; enroll: string; ctaId: string; cta: string; href: string; featured: boolean; badgeAlt: string;
};
const texasCards: TexasCard[] = [
  {
    key: 'dsc', eyebrow: 'Got a ticket?', license: `TDLR-approved · ${TEXAS_COURSE.providerNumber}`, name: 'Texas Defensive Driving Course',
    price, priceNote: 'total, certificate included', lead: 'Dismiss an eligible ticket once your court approves the course, or earn an insurance discount with no ticket at all.',
    facts: [
      { label: `${TEXAS_COURSE.hours} hours, your pace`, text: 'Pause anytime, pick up on any device.' },
      { label: 'No final exam', text: 'Quick quizzes as you go. Miss one, try again.' },
      { label: 'Accepted statewide', text: 'Every Texas court and insurer takes the TDLR certificate.' },
      { label: 'Instant certificate', text: 'Download it the moment you finish. No fee.' },
    ],
    enroll: texasEnrollUrl, ctaId: 'home-start-tx-card', cta: `Start now · ${price}`, href: '/texas', featured: true, badgeAlt: 'Texas approved: TDLR-approved defensive driving course',
  },
  ...(adeEnabled ? [{
    key: 'ade', eyebrow: 'First license at 18 to 24?', license: `TDLR driver education provider · ${ADE_LICENSE}`, name: 'Texas Adult Driver Education Course',
    price: adePrice, priceNote: 'total, exam and certificate included', lead: 'The course Texas requires before a first license at 18 through 24. Finish online, then take your certificate to DPS.',
    facts: [
      { label: `${adeHours} hours online`, text: `${ade.course.completionDays} days to finish, at your own pace.` },
      { label: 'Exam built in', text: 'Finish the course and the knowledge exam is done.' },
      { label: 'No behind-the-wheel hours', text: 'Adults do not log practice hours or classroom time.' },
      { label: 'Instant certificate', text: 'Ready the moment you finish. Nothing added at checkout.' },
    ],
    enroll: adeEnrollUrl, ctaId: 'home-start-ade', cta: `Start the course · ${adePrice}`, href: '/adult-drivers-ed/texas', featured: false, badgeAlt: 'Texas approved: TDLR-approved adult driver education course',
  }] : []),
];

const eyebrow = 'text-sm font-bold uppercase tracking-[0.08em] text-primary-deep';
const h2 = 'm-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-[#0B2160]';
const iconBox = 'flex-none w-11 h-11 rounded-xl bg-white border border-[#DCE4EF] flex items-center justify-center [&>svg]:w-6 [&>svg]:h-6';
---

<Layout
  title={`Texas Defensive Driving Online, ${price} Total, TDLR-Approved | Road Ready Safety`}
  description={`TDLR-approved Texas defensive driving (${TEXAS_COURSE.providerNumber}), ${price} total with the certificate included, ${TEXAS_COURSE.hours} hours, no final exam. Plus North Dakota point reduction and the Missouri DIP.`}
  keywords="road ready safety, defensive driving course online, driving safety course, texas defensive driving, north dakota defensive driving, missouri driver improvement program"
  image="/assets/og-default.png"
  url="/"
>
  <script type="application/ld+json" slot="head" set:html={websiteSchema} />
  <script type="application/ld+json" slot="head" set:html={faqSchema} />

  <!-- Announcement banner, same bar as the course landing pages (Jackson, 2026-10-18). -->
  <div class="bg-announcement-tx text-white text-sm font-semibold text-center py-2.5 px-4 leading-5 tracking-[0.01em]" style={sans}>{COMPLETION_RATE_BANNER}</div>
  <Header />

  <main class="text-text" style={sans}>
    <!-- 1. Hero: the Texas course in the landing-v2 look (2026-10-06 homepage, /texas, ADE landing) -->
    <section class="bg-white border-b border-border overflow-hidden">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-9 pb-12 lg:pt-16 lg:pb-16 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] gap-x-14 gap-y-8 items-center">
        <div class="min-w-0 flex flex-col gap-5 items-start">
          <p class="inline-flex items-center gap-2 m-0 bg-white border border-[#B9D3F6] rounded-full py-1 pl-1 pr-3">
            <img src="/assets/images/badges/texas-approved-tdlr.png" width="24" height="24" alt="Texas approved: TDLR-approved defensive driving course" class="w-6 h-6 shrink-0" decoding="async" />
            <span class="font-bold text-[13px] text-primary-deep" style={inter}>TDLR-Approved Provider {TEXAS_COURSE.providerNumber}</span>
          </p>
          <h1 class="m-0 font-extrabold text-[34px] sm:text-[42px] lg:text-[46px] xl:text-[50px] leading-[1.08] tracking-[-0.02em] text-[#0B2160] max-w-[11ch] sm:max-w-none" style={inter}>Dismiss your Texas ticket online. Keep it off your record.</h1>
          <p class="m-0 text-[17px] lg:text-[19px] leading-[1.5] text-text-body max-w-[560px]">The {TEXAS_COURSE.hours}-hour defensive driving course Texas courts accept. <strong class="font-bold text-text">{price} total</strong> with the certificate included, no final exam, done on your phone.</p>
          <ul class="flex flex-wrap gap-2.5 list-none p-0 m-0" aria-label="What the course includes">
            {heroChips.map((t) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-border bg-white px-3.5 py-2 text-sm font-medium text-text">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="#16A34A" opacity="0.14"/><path d="M4.8 8.2l2.1 2.1 4.3-4.4" stroke="#16A34A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {t}
              </li>
            ))}
          </ul>
          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto mt-1">
            <a href={texasEnrollUrl} data-rrs-cta="home-start-tx" class="inline-flex items-center justify-center gap-2 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg h-[56px] px-8 rounded-full whitespace-nowrap shadow-[0_8px_20px_rgba(36,84,230,0.28)]" style={inter}>Start the Texas course · {price}&nbsp;→</a>
            <a href="/texas" class="inline-flex items-center justify-center no-underline bg-info hover:brightness-95 text-info-text font-bold text-base h-[56px] px-7 rounded-full whitespace-nowrap">How it works</a>
          </div>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-1">
            <Rating />
            <button type="button" data-open-states class="inline-flex items-center gap-1.5 bg-transparent border-0 p-0 cursor-pointer text-sm font-semibold text-primary-deep underline underline-offset-[3px] decoration-[#B9D3F6] hover:decoration-primary-deep">
              Not in Texas? Select your state
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>

        <!-- Desktop only: the Dallas bridge, the price tag, a verified review and the sample certificate. -->
        <div class="relative hidden lg:block min-w-0 pb-14">

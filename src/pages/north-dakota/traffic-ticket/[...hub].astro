---
/**
 * /north-dakota/traffic-ticket — hub for "north dakota traffic ticket": the three options under
 * NDCC 39-06.1-02, the deadlines, which court, and links to the pay, hearing, in-lieu and city
 * guides. Every fact here is already verified in the linked guide (NDCC 39-06.1 read 2026-10-05).
 * Rest-param route: emits nothing while North Dakota is disabled.
 */
import CourseLayout from '../../../layouts/CourseLayout.astro';
import nd from '../../../data/courses/nd-ddc.json';
import { postsFor } from '../../../data/blog/index';
import { ndTopics } from '../../../data/blog/nd-topics';
import { isEnabled, enrollUrl as buildEnrollUrl, siteUrl } from '../../../lib/courseFlags';
import type { CourseData } from '../../../data/courses/types';

export function getStaticPaths() {
  return isEnabled(nd as CourseData) ? [{ params: { hub: undefined } }] : [];
}

const course = nd as CourseData;
const route = course.state.route;
const url = `${route}/traffic-ticket`;
const enrollUrl = buildEnrollUrl(course);
const price = course.course.priceUsd;
const checked = '2026-10-05';
const g = (slug: string) => `${route}/blog/${slug}`;
const posts = new Map(postsFor('ND').map((p) => [p.slug, p]));
const cities = (ndTopics.find((t) => t.id === 'cities')?.slugs ?? []).map((s) => ({ slug: s, name: posts.get(s)!.title.split(' traffic ticket')[0] }));

const options = [
  { name: 'Pay the fee', result: 'Admits the violation. The court reports it to NDDOT within 10 days and the points post.', slug: 'how-to-pay-north-dakota-traffic-ticket-online', text: 'How to pay a North Dakota ticket online' },
  { name: 'Post bond and elect a course', result: 'For a ticket worth 5 points or fewer. The bond is still forfeited, but the points are never entered if NDDOT gets your certificate within 30 days.', slug: 'in-lieu-of-points-north-dakota-court-election', text: 'Electing a course in lieu of points' },
  { name: 'Ask for a hearing', result: 'Sign the request on the citation and post a bond equal to the fee. The prosecution has to prove the violation; if it does not appear, the charge is dismissed.', slug: 'north-dakota-traffic-ticket-hearing', text: 'Contesting a ticket at a hearing' },
];

const deadlines = [
  { what: 'Post bond by mail on a state-law ticket, or ask for a hearing', when: 'Within 14 days of the citation' },
  { what: 'Elect a course in lieu of points', when: 'When you post bond. Not after.' },
  { what: 'Get your course certificate to NDDOT after electing', when: 'Within 30 days of the election' },
  { what: 'Court reports a paid or forfeited ticket to NDDOT', when: 'Within 10 days' },
  { what: 'Appeal a municipal court finding to district court', when: 'Within 30 days' },
];

const answers = [
  { q: 'What happens if I ignore a North Dakota ticket?', a: 'You are deemed to have admitted the violation, and the points post. Failing to appear without paying the fee or posting bond is a class B misdemeanor, and NDDOT charges a $50 reinstatement fee if your license is suspended for it.' },
  { q: 'Which tickets can I keep the points off?', a: 'Moving violations worth 5 points or fewer that are not on the list of offenses in NDCC 39-06.1-05, such as reckless driving or driving under suspension, and only if you have not elected a course in the last 12 months.' },
  { q: 'Which court handles my ticket?', a: 'The one printed on the front of your citation. In Fargo, for example, a city ticket goes to the Fargo Municipal Court, while a ticket written elsewhere in Cass County goes to the Cass County Clerk of District Court.' },
  { q: 'Can I keep the points off after I have paid?', a: 'No. The election has to be made when you post bond. Once the points post, a defensive driving course can take 3 off your total, once every 12 months.' },
];

const crumbs = [
  { name: 'Home', url: '/' },
  { name: course.state.name, url: route },
  { name: 'Traffic tickets', url },
];
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'North Dakota traffic tickets',
  url: `${siteUrl}${url}`,
  dateModified: checked,
  inLanguage: 'en-US',
  publisher: { '@type': 'Organization', name: course.provider.dba, url: siteUrl },
  citation: [{ '@type': 'CreativeWork', name: 'NDCC chapter 39-06.1', url: 'https://ndlegis.gov/cencode/t39c06-1.pdf' }],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: answers.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })),
};
const outfit = "font-family:'Outfit',sans-serif;";
const link = 'text-primary-deep font-semibold underline underline-offset-2';
---

<CourseLayout
  course={course}
  title="North Dakota Traffic Ticket: Pay, Contest or Elect | Road Ready"
  description="Pay a North Dakota ticket and the points post. Contest it, or elect a course when you post bond to keep up to 5 points off. Deadlines and courts here."
  url={url}
  courseSchema={false}
  breadcrumbs={crumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <article class="bg-white">
    <div class="max-w-[768px] mx-auto px-4 sm:px-6 py-10 md:py-16">
      <nav class="mb-8 text-sm" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 list-none p-0 m-0 text-text-body">
          <li><a href="/" class="hover:text-primary no-underline">Home</a></li><li aria-hidden="true">›</li>
          <li><a href={route} class="hover:text-primary no-underline">{course.state.name}</a></li><li aria-hidden="true">›</li>
          <li aria-current="page" class="text-text-muted">Traffic tickets</li>
        </ol>
      </nav>

      <header class="mb-8 flex flex-col gap-4">
        <h1 class="text-3xl md:text-[40px] font-bold text-text leading-[1.15] tracking-[-0.02em] m-0" style={outfit}>North Dakota traffic tickets</h1>
        <p class="text-sm text-text-muted m-0">By Road Ready Safety &middot; Checked against North Dakota law on <time datetime={checked}>October 5, 2026</time></p>
      </header>

      <div class="rounded-[20px] bg-info border border-info-border p-6 md:p-7 mb-10">
        <p class="text-lg text-text leading-8 m-0">
          A North Dakota traffic ticket gives you three choices under <a href="https://ndlegis.gov/cencode/t39c06-1.pdf" class={link} target="_blank" rel="noopener noreferrer">NDCC 39-06.1-02</a>: pay the fee, post bond and forfeit it, or ask for a hearing.
          Paying admits the violation and the points post. If the ticket is worth 5 points or fewer, you can tell the court you elect a driver training course when you post bond, and the points stay off. Most deadlines are 14 days.
        </p>
      </div>

      <section>
        <h2 class="text-2xl font-bold text-text m-0 mb-4" style={outfit}>What are my options?</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-base text-left border-collapse">
            <thead><tr class="border-b border-border"><th scope="col" class="py-2.5 pr-4 font-semibold">Option</th><th scope="col" class="py-2.5 pr-4 font-semibold">What it does</th><th scope="col" class="py-2.5 font-semibold">Guide</th></tr></thead>
            <tbody>
              {options.map((o) => (
                <tr class="border-b border-border align-top">
                  <th scope="row" class="py-3 pr-4 font-semibold whitespace-nowrap">{o.name}</th>
                  <td class="py-3 pr-4 text-text-body leading-7">{o.result}</td>
                  <td class="py-3"><a href={g(o.slug)} class={link}>{o.text}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-base text-text-body leading-7 mt-4 mb-0">
          Not sure which to pick? <a href={g('should-i-pay-my-north-dakota-ticket')} class={link}>When it makes sense to just pay</a> walks through it by point value.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-bold text-text m-0 mb-4" style={outfit}>What are the deadlines?</h2>
        <table class="w-full text-base text-left border-collapse">
          <tbody>
            {deadlines.map((d) => (
              <tr class="border-b border-border align-top"><th scope="row" class="py-3 pr-4 font-normal text-text-body leading-7">{d.what}</th><td class="py-3 font-semibold text-text">{d.when}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="text-base text-text-body leading-7 mt-4 mb-0">
          The 30-day certificate rule trips people up most. <a href={g('north-dakota-in-lieu-of-points-30-day-deadline')} class={link}>The 30-day in-lieu deadline</a> has what counts as on time.
        </p>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl font-bold text-text m-0 mb-4" style={outfit}>Where do I pay a ticket from my city?</h2>
        <p class="text-base text-text-body leading-7 m-0 mb-4">Each municipal court has its own address, hours and payment options. We wrote these up for the seven largest:</p>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-2 list-none p-0 m-0">
          {cities.map((c) => <li><a href={g(c.slug)} class={link}>{c.name}</a></li>)}
        </ul>
      </section>

      <div class="flex flex-col gap-8 mt-10">
        {answers.map((x) => (
          <section>
            <h2 class="text-2xl font-bold text-text m-0 mb-2" style={outfit}>{x.q}</h2>
            <p class="text-base text-text-body leading-7 m-0">{x.a}</p>
          </section>
        ))}
      </div>
      <p class="text-base text-text-body leading-7 mt-4 mb-0">
        More on each: <a href={g('which-tickets-qualify-in-lieu-of-points-north-dakota')} class={link}>which tickets qualify for in lieu of points</a>,
        <a href={g('out-of-state-ticket-north-dakota-points')} class={link}>tickets from other states</a>,
        <a href={g('north-dakota-points-by-violation')} class={link}>fines and points for every violation</a>,
        and, for speeding, <a href={`${route}/speeding-ticket`} class={link}>the speeding ticket calculator</a>.
      </p>

      <aside class="mt-12 bg-primary-navy rounded-[24px] p-8 flex flex-col gap-4 text-white">
        <h2 class="text-2xl font-bold leading-tight m-0" style={outfit}>{course.course.name}</h2>
        <p class="text-white/85 leading-7 m-0">{course.course.hours} hours online, ${price} total. It works for the in-lieu election and for the 3-point reduction. It won't lower the fee on your ticket.</p>
        <a href={enrollUrl} class="bg-white text-primary-navy h-12 px-6 rounded-xl text-base font-semibold flex items-center justify-center no-underline hover:bg-info transition-colors w-full sm:w-fit">{course.hero.ctaLabel} &mdash; ${price}</a>
        <a href={route} class="text-white underline underline-offset-2 w-fit">About the North Dakota course</a>
      </aside>
    </div>
  </article>
</CourseLayout>

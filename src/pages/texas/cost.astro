---
import TexasLayout from '../../layouts/TexasLayout.astro';
import YouTubeCard from '../../components/YouTubeCard.astro';
import { courtStats as S } from '../../lib/court-stats';
import { TEXAS_COURSE, TEXAS_PRICE_LABEL } from '../../data/texas-course';
const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
const enrollUrl = import.meta.env.VITE_TEXAS_ENROLLMENT_URL || '/courses/tx-defensive';

const siteUrl = import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com';
const floor = `$${TEXAS_COURSE.legalMinimumPrice}`;
const price = TEXAS_PRICE_LABEL;

// Editorial rule for this page: no competitor names and no competitor prices. The page explains
// what a Texas driving safety course can legally cost, what the fee lines mean, and what we charge.
// Sources: Tex. Educ. Code §1001.352 (HB 3012, eff. Sept. 1, 2025) for the floor; court fees from
// src/lib/court-stats.ts (our verified court dataset); Type 3A fee per Texas DPS.

const feeLines = [
  { fee: 'Course fee', what: 'The course itself. By law at least ' + floor + '.', watch: 'An advertised number below ' + floor + ' is not the price you will pay.' },
  { fee: '"Processing" or "state" fee', what: 'A line some checkouts add to reach or exceed the ' + floor + ' minimum.', watch: 'Since September 1, 2025 there is no separate state fee; a "$3 state fee" line is a legacy of the old $25 + $3 rule.' },
  { fee: 'Certificate delivery', what: 'How you get the certificate of completion the court needs.', watch: 'The most common add-on. Some courses mail it free in a week or more and charge for an instant or emailed copy.' },
  { fee: 'Rush or "instant" certificate', what: 'Paying to get the certificate the same day.', watch: 'Only matters if the course does not already include instant download.' },
  { fee: 'Audio, video or "premium" version', what: 'A higher tier of the same approved course.', watch: 'Same certificate, same dismissal. Pay for it only if you want it.' },
  { fee: 'Driving record add-on', what: 'Ordering your Type 3A record through the course site.', watch: 'DPS sells it directly for $12 online. A markup on the same document is pure margin.' },
  { fee: 'Retake or extension fees', what: 'Charges to retry a quiz or reopen an expired course.', watch: 'Check the refund and retake policy before paying, not after failing a quiz.' },
];

const faqs = [
  {
    q: 'How much does a defensive driving course cost in Texas?',
    a: `At least ${floor}, by law. Texas Education Code §1001.352 sets a ${floor} minimum for every TDLR-approved driving safety course, so no approved course can cost less. What you actually pay is the course fee plus any certificate-delivery, processing or add-on charges a provider adds at checkout. Road Ready Safety is ${price} all-in with the instant certificate included.`,
  },
  {
    q: 'Is there a free defensive driving course in Texas?',
    a: `No. A free course cannot be TDLR-approved because the law requires a minimum price of ${floor}, and only an approved course produces the certificate a court or insurer accepts. "Free" in course advertising usually means free quiz retakes, free certificate delivery, or a free trial of the first module. Some employers and insurers reimburse the fee, which is the closest thing to free that exists.`,
  },
  {
    q: 'What is the cheapest defensive driving course in Texas?',
    a: `Any course at the ${floor} legal minimum with the certificate included and no add-on at checkout. Because every approved course teaches the same state curriculum and produces the same certificate, the only comparison that holds up is the all-in checkout total, not the advertised price. Ours is ${price}: ${floor} for the course plus $3, with the instant certificate, both copies, and no delivery fee.`,
  },
  {
    q: 'Why do some courses advertise $25 and charge more at checkout?',
    a: `Until September 1, 2025 Texas required a $25 course fee plus a separate $3 fee, so many checkouts still show $25 and add $3. HB 3012 folded that into a single ${floor} minimum. Beyond that, certificate delivery, "processing" and premium-version fees are added after the advertised price. Read the final order summary before you enter a card.`,
  },
  {
    q: 'How much does it cost to dismiss a ticket in Texas, all in?',
    a: `Roughly $150 to $210: the court's fee ($${S.fee.min} to $${S.fee.max} across the courts we have verified, most commonly $144), the course (at least ${floor}; ${price} with us), and the $12 Type 3A driving record from DPS if the court makes you order it yourself. Paying the ticket instead usually costs a similar amount in fines and puts a conviction on your record.`,
  },
  {
    q: 'Does Road Ready Safety charge anything after the course?',
    a: `No. ${price} covers the course, the instant certificate download with both the court copy and the insurance copy, and unlimited quiz retakes. The two costs we cannot include are the court's own fee and the DPS driving record, because the court and DPS collect those. If you cancel before completing the course you can get a full refund.`,
  },
];

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `How Much Does a Texas Defensive Driving Course Cost? The ${floor} Floor, Every Fee Line, ${price} All-In`,
  description: `What a Texas driving safety course can legally cost, what each checkout fee line means, what the whole dismissal costs beyond the course, and what Road Ready Safety charges and includes.`,
  dateModified: '2026-10-05',
  datePublished: '2026-03-03',
  author: { '@type': 'Organization', name: 'Road Ready Safety' },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}/texas/cost`,
});

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---

{isEnabled ? (
  <TexasLayout
    title={`Texas Defensive Driving Cost 2026: The ${floor} Legal Floor, Hidden Fees, ${price} All-In`}
    description={`A Texas defensive driving course costs at least ${floor} by law. What each checkout fee line means, why there is no free approved course, what the whole dismissal costs with court fees, and what ${price} all-in includes at Road Ready Safety.`}
    keywords="defensive driving texas cost, cheapest defensive driving course texas, free defensive driving course texas, texas defensive driving course price, how much is defensive driving in texas, texas driving safety course cost"
    url="/texas/cost"
  >
    <script type="application/ld+json" set:html={articleSchema} />
    <script type="application/ld+json" set:html={faqSchema} />

    <article class="bg-white pb-16 lg:pb-24">
      <div class="max-w-[880px] mx-auto px-4 sm:px-6 lg:px-8 pt-10 lg:pt-14">

        <p class="text-sm text-text-body mb-6" style="font-family: 'DM Sans', sans-serif;">
          <a href="/texas" class="text-primary-deep font-medium hover:underline">Texas defensive driving course</a>
          <span class="mx-2 text-text-subtle">›</span>
          <span class="text-text">Cost</span>
        </p>

        <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-primary-navy leading-tight tracking-[-0.02em] mb-6" style="font-family: 'Outfit', sans-serif;">
          How Much Does a Texas Defensive Driving Course Cost?
        </h1>

        <div class="space-y-4 text-text-body text-base leading-7 mb-8" style="font-family: 'DM Sans', sans-serif;">
          <p>A Texas defensive driving course costs <strong class="text-text">at least {floor}</strong>, because state law sets that as the minimum price for every TDLR-approved driving safety course (Tex. Educ. Code §1001.352). What you actually pay is that course fee plus whatever a provider adds at checkout: certificate delivery, a "processing" line, a premium version, a driving record. Those add-ons are where a {floor} course becomes a $40 or $50 one.</p>
          <p>This page is the price data, not a ranking. It covers what the law allows, what each fee line means, what the rest of the dismissal costs, and what we charge and include. Every approved course teaches the same state curriculum and produces the same certificate, so the only comparison that matters is the all-in total on the final checkout screen.</p>
        </div>

        <div class="bg-surface-muted border border-border rounded-xl p-5 mb-10">
          <p class="text-sm text-text-body" style="font-family: 'DM Sans', sans-serif;">We sell one of these courses (Road Ready Safety, {TEXAS_COURSE.providerNumber}, {price} all-in), so read this as a seller explaining the market, with every rule pointed at its source so you can check it.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What is the cheapest a Texas defensive driving course can legally be?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p><strong class="text-text">{floor}.</strong> Texas Education Code §1001.352, as amended by HB 3012 effective September 1, 2025, requires a driving safety course to cost at least {floor}. Before that date the rule was $25 plus a separate $3 fee, which is why many checkouts still show two lines that add to $28. There is no longer a separate state fee; there is one {floor} floor, and anything above it is the provider's margin or an add-on.</p>
          <p>The floor exists so that approval cannot be won on price alone, and it has a practical consequence for you: a course advertised below {floor} is either not TDLR-approved or not showing you the real price. Check the provider's CP number on <a href="/texas/tdlr-approved" class="text-primary-deep font-medium hover:underline">TDLR's license search</a> before you pay anything.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Is there a free defensive driving course in Texas?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p><strong class="text-text">No.</strong> A free course cannot be TDLR-approved, because approval requires charging the {floor} minimum, and only an approved course produces the certificate a court or insurer will accept. When you see "free" in this market it means free quiz retakes, free certificate delivery, or a free preview of the first module, not a free course. The closest real thing is reimbursement: some employers pay for the course, and an insurance discount can return the fee over a policy term. The <a href="/texas/insurance-discount" class="text-primary-deep font-medium hover:underline">insurance discount page</a> explains what insurers actually give.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What does an all-in price include, and which fees appear after the advertised price?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-4" style="font-family: 'DM Sans', sans-serif;">
          <p>An all-in price is the number on the final order summary: course, certificate in your hands, nothing else owed to the provider. These are the fee lines that turn an advertised price into a different one, and what to check for each.</p>
        </div>
        <div class="overflow-x-auto mb-4">
          <table class="w-full text-sm border-collapse" style="font-family: 'DM Sans', sans-serif;">
            <thead>
              <tr class="bg-surface-muted text-left">
                <th class="py-3 px-3 font-semibold text-text">Fee line</th>
                <th class="py-3 px-3 font-semibold text-text">What it is</th>
                <th class="py-3 px-3 font-semibold text-text">What to check</th>
              </tr>
            </thead>
            <tbody>
              {feeLines.map((f, i) => (
                <tr class={`border-b border-border align-top ${i % 2 === 0 ? '' : 'bg-surface-muted/40'}`}>
                  <td class="py-3 px-3 font-semibold text-text">{f.fee}</td>
                  <td class="py-3 px-3 text-text-body">{f.what}</td>
                  <td class="py-3 px-3 text-text-body">{f.watch}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>The certificate line is the one to read twice. The court needs the certificate, usually inside a deadline, so a course that mails it free in a week and charges for an instant copy is charging you for the deadline. Ask one question of any checkout: when I finish, do I have the certificate in my hands at no extra cost?</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What does the whole ticket dismissal cost beyond the course?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-10" style="font-family: 'DM Sans', sans-serif;">
          <p>The course is the smallest of three costs. <strong class="text-text">The court's fee</strong> is set locally when it grants the course: <a href="/texas/dsc-fees-by-court" class="text-primary-deep font-medium hover:underline">${S.fee.min} to ${S.fee.max}</a> across the courts we have verified, most commonly $144, with $169 common for school-zone tickets. <strong class="text-text">The Type 3A driving record</strong> is $12 online from Texas DPS if the court makes you order it (<a href="/texas/type-3a-driving-record" class="text-primary-deep font-medium hover:underline">how to order it</a>). <strong class="text-text">The course</strong> is at least {floor}. Add them up and dismissal runs about $150 to $210, against a fine that is often $150 to $300 plus three years of a conviction on your insurance. The full process is on the <a href="/texas/ticket-dismissal" class="text-primary-deep font-medium hover:underline">ticket dismissal guide</a>; the fine side is on the <a href="/texas/speeding-ticket" class="text-primary-deep font-medium hover:underline">speeding ticket page</a>.</p>
        </div>

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">What does Road Ready Safety charge, and what is included?</h2>
        <div class="space-y-4 text-text-body text-base leading-7 mb-6" style="font-family: 'DM Sans', sans-serif;">
          <p><strong class="text-text">{price}, all-in.</strong> That is the {floor} course fee plus $3, and it is the only number you see at checkout. It includes the {TEXAS_COURSE.hours}-hour TDLR-approved course, unlimited quiz retakes, and the certificate of completion as an instant download the moment you finish, with the court copy and the insurance copy both included. No delivery fee, no rush fee, no premium tier, no driving-record upsell. If you have not completed the course you can get a full refund.</p>
          <p>We publish the whole policy, including what we do not charge for and why, on the <a href="/texas/transparency" class="text-primary-deep font-medium hover:underline">transparency page</a>, and the plain price breakdown on the <a href="/texas/pricing" class="text-primary-deep font-medium hover:underline">pricing page</a>. Our provider number is {TEXAS_COURSE.providerNumber}; check it on TDLR's search before you pay us or anyone else.</p>
        </div>

        <YouTubeCard id="Y6sT-z7uFWQ" title="What Texas Defensive Driving Course Actually Costs All In" blurb="The real all-in price of a Texas defensive driving course." />

        <h2 class="text-2xl font-bold text-text mt-10 mb-4" style="font-family: 'Outfit', sans-serif;">Frequently asked questions</h2>
        <div class="space-y-8 mb-12">
          {faqs.map(item => (
            <div>
              <h3 class="text-lg font-semibold text-text mb-2" style="font-family: 'Outfit', sans-serif;">{item.q}</h3>
              <p class="text-text-body text-base leading-7" style="font-family: 'DM Sans', sans-serif;">{item.a}</p>
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <a
            href={enrollUrl}
            class="inline-flex bg-primary hover:bg-primary-hover text-white h-[56px] px-8 rounded-[16px] text-lg font-semibold items-center justify-center no-underline"
            style="font-family: 'DM Sans', sans-serif; box-shadow: 0px 10px 15px -3px rgba(17,23,34,0.08), 0px 4px 6px -4px rgba(17,23,34,0.05);"
          >
            Start the {price} Course →
          </a>
          <a
            href="/texas/faq"
            class="inline-flex h-[56px] px-8 border border-primary-deep text-primary-deep hover:bg-primary-deep hover:text-white rounded-[16px] text-lg font-semibold items-center justify-center no-underline transition-colors"
            style="font-family: 'DM Sans', sans-serif;"
          >
            Course questions answered
          </a>
        </div>

        <div class="pt-6 border-t border-border space-y-2" style="font-family: 'DM Sans', sans-serif;">
          <p class="text-sm text-text-subtle">Road Ready Safety is a TDLR-licensed Texas driving safety provider ({TEXAS_COURSE.providerNumber}). This page is informational and not legal advice; confirm requirements with the court on your citation.</p>
          <p class="text-xs text-text-subtle">Last updated October 5, 2026. Price floor per Tex. Educ. Code §1001.352 as amended by HB 3012 (eff. Sept. 1, 2025); court fee range from our verified court dataset; Type 3A fee per Texas DPS. Fee-line categories are drawn from checkout flows we reviewed in 2026; no provider is named and no provider's price is quoted on this page.</p>
        </div>

      </div>
    </article>
  </TexasLayout>
) : (
  <meta http-equiv="refresh" content="0; url=/" />
)}

---
// Responsive YouTube embed + VideoObject JSON-LD (for video rich results).
//
// Performance: this renders a "facade" (the video's own thumbnail plus a play
// button) instead of the YouTube player. The real iframe is injected only when
// the viewer clicks, with autoplay, so the page pays nothing for the player
// (about 1 MB of script) until someone actually wants to watch. Privacy-friendly
// (youtube-nocookie), 16:9, keyboard accessible.
//
// Title, description, duration and upload date come from src/data/videos.ts,
// which was verified against YouTube — pass only the `id` and they are correct.
// Schema is emitted only on the video's canonical page, so embedding the same
// video on several pages does not create competing VideoObjects.
import { VIDEOS, isoDuration, isCanonicalFor } from '../data/videos';

interface Props {
  id: string;            // YouTube video ID
  title?: string;        // override the catalogue title (rare)
  description?: string;  // override the catalogue description (rare)
  duration?: string;     // ISO 8601 override for videos not in the catalogue
  uploadDate?: string;   // ISO date override for videos not in the catalogue
  schema?: boolean;      // force schema on/off; defaults to "only on the canonical page"
}
const props = Astro.props as Props;
const meta = VIDEOS[props.id];

const title = props.title ?? meta?.title ?? 'Video';
const description = props.description ?? meta?.description ?? title;
const duration = meta ? isoDuration(meta.seconds) : props.duration;
const uploadDate = meta?.uploadDate ?? props.uploadDate ?? '2026-06-16';
const emitSchema = props.schema ?? (meta ? isCanonicalFor(props.id, Astro.url.pathname) : true);

const id = props.id;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const thumbHi = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const embed = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [thumb, thumbHi],
  uploadDate,
  ...(duration ? { duration } : {}),
  embedUrl: `https://www.youtube.com/embed/${id}`,
  contentUrl: `https://www.youtube.com/watch?v=${id}`,
  publisher: {
    '@type': 'Organization',
    name: 'Road Ready Safety',
    logo: { '@type': 'ImageObject', url: 'https://roadreadysafety.com/assets/icons/texas/logo-shield-footer.svg' },
  },
});
---
{emitSchema && <script type="application/ld+json" set:html={schema} />}
<figure class="my-8">
  <div
    class="rrs-yt relative w-full overflow-hidden rounded-xl border border-border bg-black"
    style="padding-bottom:56.25%;"
    data-embed={embed}
    data-title={title}
  >
    <img
      src={thumb}
      srcset={`${thumb} 480w, ${thumbHi} 1280w`}
      sizes="(min-width: 880px) 880px, 100vw"
      alt=""
      width="1280"
      height="720"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <button
      type="button"
      class="rrs-yt-play absolute inset-0 flex h-full w-full items-center justify-center bg-transparent focus-visible:outline focus-visible:outline-4 focus-visible:outline-white"
      aria-label={`Play video: ${title}`}
    >
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-black/65 transition-colors group-hover:bg-[#FF0000]" style="box-shadow:0 8px 24px rgba(0,0,0,.35)">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      </span>
    </button>
  </div>
  <figcaption class="mt-2 text-sm text-text-subtle" style="font-family: 'DM Sans', sans-serif;">▶ Watch: {title}</figcaption>
</figure>

<script is:inline>
  (function () {
    function activate(box) {
      if (box.dataset.loaded) return;
      box.dataset.loaded = '1';
      var iframe = document.createElement('iframe');
      iframe.className = 'absolute inset-0 h-full w-full';
      iframe.src = box.getAttribute('data-embed');
      iframe.title = box.getAttribute('data-title') || 'Video';
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      iframe.setAttribute('allowfullscreen', '');
      box.replaceChildren(iframe);
    }
    function warm() {
      // Preconnect once, on first hover/focus, so the click feels instant.
      if (document.getElementById('rrs-yt-preconnect')) return;
      ['https://www.youtube-nocookie.com', 'https://www.google.com', 'https://static.doubleclick.net'].forEach(function (href, i) {
        var l = document.createElement('link'); l.rel = 'preconnect'; l.href = href; if (i === 0) l.id = 'rrs-yt-preconnect';
        document.head.appendChild(l);
      });
    }
    function init() {
      document.querySelectorAll('.rrs-yt').forEach(function (box) {
        if (box.dataset.bound) return;
        box.dataset.bound = '1';
        var btn = box.querySelector('.rrs-yt-play');
        btn.addEventListener('click', function () { activate(box); });
        btn.addEventListener('pointerover', warm, { once: true });
        btn.addEventListener('focus', warm, { once: true });
      });
    }
    if (document.readyState !== 'loading') { init(); } else { document.addEventListener('DOMContentLoaded', init); }
  })();
</script>

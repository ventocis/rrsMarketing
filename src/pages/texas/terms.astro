---
/**
 * Texas terms page. Renders the site-wide Terms of Service and Student Policies
 * (src/content/policies/terms.md) inside the Texas layout. Texas-specific provisions
 * (TDLR complaint contact, three-day cancellation, §1001.402 refund terms, 90-day completion)
 * live in Part 3.1 of that document. The Texas refund policy keeps its own page at /texas/refund.
 */
import TexasLayout from '../../layouts/TexasLayout.astro';
import PolicyDoc from '../../components/course/PolicyDoc.astro';

const isEnabled = import.meta.env.VITE_TEXAS_ROUTES_ENABLED === 'true';
---

{!isEnabled && (
  <meta http-equiv="refresh" content="0;url=/" />
)}

{isEnabled && (
<TexasLayout
  title="Terms of Service - Road Ready Safety"
  description="Terms of service and student policies for Road Ready Safety's Texas defensive driving course: identity verification, refunds, grievances, records and TDLR complaint contact."
  url="/texas/terms"
>
  <section class="py-[112px] px-4 sm:px-6 lg:px-8 bg-surface-muted">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col gap-4 items-center mb-12">
        <div class="bg-info inline-flex items-center px-4 py-2 rounded-full">
          <span class="text-sm font-semibold text-info-text leading-5" style="font-family: 'DM Sans', sans-serif;">Legal</span>
        </div>
        <h1 class="text-[36px] font-bold text-text text-center leading-[40px] tracking-[-0.9px]" style="font-family: 'Outfit', sans-serif;">
          Terms of Service and Student Policies
        </h1>
        <p class="text-base text-text-body text-center leading-6 max-w-2xl" style="font-family: 'DM Sans', sans-serif;">
          Road Ready Driver Instruction LLC d/b/a Road Ready Safety
        </p>
      </div>

      <PolicyDoc file="terms.md" tokens={{ courseName: 'the Texas driving safety course', stateName: 'Texas', agency: 'the Texas Department of Licensing and Regulation' }} />
    </div>
  </section>
</TexasLayout>
)}

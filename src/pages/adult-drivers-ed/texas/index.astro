---
/**
 * /adult-drivers-ed/texas — the Texas Adult Driver Education (ADE-1317) money page, rebuilt on the /texas page
 * structure (Jackson, 2026-10-13: "look and feel more like the new /texas page"), the day TDLR issued Driver
 * Education Provider license C3705.
 *
 * Section order, matching /texas and the ND/MO StateLanding:
 *   hero (TDLR badge pill without a verify link, H1, five bullets, CTA, photo + progress card; the verify link is in the footer, Jackson 2026-10-13)
 *   reviews (three, then "Show more")  ·  your course (one card)  ·  risk-free
 *   what to expect (tabs + accordions, progress mockup on desktop)  ·  about us  ·  FAQ  ·  helpful resources
 *
 * Facts come from ade-texas.json and ade-eligibility.ts. Claims that are law:
 *  - Transp. Code §521.1601: no first license under 25 without driver education; §521.1601(b) exempts a valid
 *    license from another STATE (not country). DPS: the requirement is 18 through 24; waived for new residents
 *    surrendering a valid out-of-state license; 25+ "not required ... however it is highly recommended".
 *  - §521.167: completing the course satisfies the highway sign and traffic law portions of the DPS knowledge
 *    exam. That is the ONLY approved phrasing (never "skip the written test"; never promise a license).
 *  - 16 TAC §84.503: nine modules, 40-question final (20 signs + 20 laws, 70%), three attempts.
 *  - ITAD: DPS program, free, one hour, certificate valid 90 days, taken before the driving skills test.
 * Reviews are our verified Trustpilot reviews; any that mention a price or a ticket are filtered out because
 * none of that applies to this course. Certificate is instant (Jackson, 2026-10-13).
 * Refund promise: full refund before completion or certificate (Jackson, 2026-10-13), same as /texas.
 */
import AdeLayout from '../../../layouts/AdeLayout.astro';
import { COMPLETION_RATE_BANNER } from '../../../data/banners';
import RoadPhoto from '../../../components/landing-v2/RoadPhoto.astro';
import ade from '../../../data/ade-texas.json';
import reviews from '../../../data/texas-reviews.json';
import { law, itd } from '../../../data/ade-eligibility';
import { adeEnabled, adeEnrollUrl, adeContactUrl, ADE_LICENSE, ADE_VERIFY_URL } from '../../../lib/ade';

const isEnabled = adeEnabled;
const enrollUrl = adeEnrollUrl;
const contactUrl = adeContactUrl;
const trustpilotUrl = 'https://www.trustpilot.com/review/roadreadysafety.com';
const statuteHref = 'https://statutes.capitol.texas.gov/Docs/TN/htm/TN.521.htm';
const itadHref = 'https://impacttexasdrivers.dps.texas.gov/itad';

const price = `$${ade.course.priceUsd}`;
const [dollars, cents] = price.split('.');
const hours = Math.round(ade.course.courseMinutes / 60);
const code = ade.course.code;
const days = ade.course.completionDays;
const base = '/adult-drivers-ed/texas';

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";

const bullets = [
  { label: 'TDLR-Approved', text: `The official ${hours}-hour adult driver education course (${code}) Texas requires for a first license at 18 to 24.` },
  { label: 'Knowledge Exam Built In', text: `Finishing the course ${ade.exam.claimPhrasing}.` },
  { label: 'No Behind-the-Wheel Hours', text: 'Adults do not log practice hours. No classroom, no instructor visits.' },
  { label: 'Go at Your Own Pace', text: `Pause anytime, pick up on any device. ${days} days to finish.` },
  { label: `${price} Total`, text: 'Course, exam and certificate. Nothing added at checkout.' },
];
const heroNote = 'Required for a first Texas license at 18 through 24.';

// Reviews: our verified Trustpilot reviews. Drop any that mention a price, a ticket, a court or the absence of
// video — none of that is true of this course (two modules carry required videos). Instant certificate is true.
interface Review { name: string; initials: string; date: string; rating: number; verified: boolean; quote: string; title?: string }
const LEAD = ['Chelsie Gates', 'Colleen Minor', 'Vamsi Raju'];
const unfit = /\$\d|ticket|dismiss|court|video|audio/i;
const fits = (r: Review) => !unfit.test(`${r.title ?? ''} ${r.quote}`);
const allReviews = [
  ...LEAD.map((n) => (reviews as Review[]).find((r) => r.name === n)).filter(Boolean) as Review[],
  ...(reviews as Review[]).filter((r) => !LEAD.includes(r.name)),
].filter(fits);
const REVIEWS_SHOWN = 3;

const cardChecks = [
  { strong: `Official ${hours}-hour ${code} course`, rest: ' for a first Texas driver license at 18 to 24' },
  { strong: 'Highway sign and traffic law exam built in', rest: `: ${ade.exam.questions} questions, two extra attempts if you need them` },
  { strong: 'Instant certificate included', rest: ', ready the moment you pass' },
  { strong: 'Phone, tablet or computer', rest: ': start, stop and resume anytime' },
  { strong: `${days} days to finish`, rest: ', in as many sittings as you like' },
  { strong: 'Real customer support', rest: ' by email and phone' },
];

// DPS's own sentence on who needs the course (ade-eligibility.ts, DPS-APP), split so the waiver reads as a quote.
const dpsBand = law.dpsRequirementText.split('. ')[0];

const expTabs = [
  {
    key: 'req', label: 'Texas Requirements',
    intro: `Texas will not issue a first driver license to anyone under 25 who has not completed driver education (Transportation Code §521.1601). For adults, that means:`,
    items: [
      ['Be 18 or older', `DPS puts it this way: “${dpsBand}.” Under 18 takes the teen course with supervised driving. At 25 and over the course is optional; DPS says it is “highly recommended” for first-time applicants.`],
      ['Finish the six-hour course', `All nine modules the state sets (16 TAC §84.503), with the final exam at the end: ${ade.exam.signsQuestions} highway sign questions and ${ade.exam.lawsQuestions} traffic law questions, ${ade.exam.passPercent}% to pass, three attempts.`],
      ['Watch Impact Texas Adult Drivers (ITAD)', `A free ${itd.adultLengthHours}-hour video from DPS, taken on the DPS site. Its certificate is valid ${itd.certValidDays} days, so watch it close to your driving test, not the day you enroll.`],
      ['Bring your documents to DPS', `Proof of identity, Social Security number and Texas residency, plus your ${code} certificate and your ITAD certificate. Two printed residency documents, one showing 30 days in Texas.`],
      ['Pass the vision screening and the driving test', 'At your DPS appointment, or take the driving test with a DPS-certified third-party tester to skip the DPS road-test queue.'],
    ] as [string, string][],
    note: 'Moving to Texas with a valid, unexpired license from another state? The course requirement is waived when you surrender it. A license from another country usually is not, unless it is from a country with a DPS reciprocity agreement.',
  },
  {
    key: 'topics', label: 'Topics Covered',
    intro: `In ${hours} hours (the state-set length, with two built-in breaks), nine modules in plain English:`,
    items: ade.modules.map((m) => [m.title, m.blurb]) as [string, string][],
    note: '',
  },
  {
    key: 'support', label: 'Support',
    intro: 'We’re here to help throughout your course. Our friendly support team is here to help with anything from questions about topics covered to technical issues like login or account access. A licensed Texas instructor is on record for the course, and if you still need assistance, email us and a real person will typically respond within one business day.',
    items: [] as [string, string][],
    note: '',
    link: true,
  },
  {
    key: 'after', label: 'After the Course',
    intro: `Once you pass the final exam, your ${code} certificate is ready instantly in your account. It does not expire.`,
    items: [
      ['Watch ITAD', `Free, one hour, on the DPS site. Do it within ${itd.certValidDays} days of your driving test.`],
      ['Book your DPS appointment', 'Appointments are online. Road-test queues vary a lot by office, and nine offices offer no road test at all; our wait-time table ranks every office.'],
      ['Take the tests', 'Vision screening and the driving test at DPS, or the driving test with a third-party skills tester. The highway sign and traffic law parts of the knowledge test are already satisfied by the course.'],
      ['Important', 'Every remaining step is between you and DPS. The course does not entitle anyone to a license; it completes the driver education requirement.'],
    ] as [string, string][],
    note: '',
  },
];

const progressDone = ade.modules.slice(0, 4).map((m) => m.title);
const progressNext = ade.modules[4].title;

// The FAQPage schema below is built from this array, so schema and visible answers cannot drift.
const landingFaqs = [
  { q: 'Who has to take Texas adult drivers ed?', a: 'Anyone 18 to 24 getting a first Texas driver license has to complete a six-hour approved adult driver education course. Drivers 25 and over do not have to, though DPS recommends it. Drivers under 18 take a different, longer course that includes supervised driving hours.' },
  { q: 'Do I still take the written test at the DPS?', a: `Completing this course ${ade.exam.claimPhrasing}. You still take the vision screening and the driving test at the DPS.` },
  { q: 'How long is adult drivers ed in Texas?', a: `Six hours. Texas sets the length of every approved adult driver education course, so no approved course is shorter. You can finish in one sitting or spread it over several days; you have ${days} days and the course saves your place.` },
  { q: 'What is in the six hours?', a: 'Nine modules set by the state: getting your license, right-of-way, signs and signals, speed and lane use, alcohol and drugs, sharing the road, managing risk, and the final exam.' },
  { q: 'Do adults need behind-the-wheel hours in Texas?', a: 'No. Texas does not require adults to log practice hours. You still have to pass the driving test, so if you have never driven, get practice first through a driving school or supervised practice; Texas learner licenses go to applicants 15 to 17, not adults.' },
  { q: 'What if I fail the final exam?', a: 'You get two more attempts, with different questions each time. A third failure means starting over with a new enrollment; that limit is set by the state.' },
  { q: 'What is Impact Texas Adult Drivers (ITAD)?', a: `A free one-hour video program from the Texas Department of Public Safety about distracted driving. DPS requires it before your driving skills test. It is separate from our course: you take it on the DPS site and DPS issues that certificate. It is valid ${itd.certValidDays} days, so watch it close to your test date.` },
  { q: 'When do I get my certificate?', a: `The moment you pass. Your ${code} certificate is issued instantly and waits in your account; download it and bring it to your DPS appointment with your other documents.` },
  { q: `Is it really ${price}?`, a: 'Yes. The certificate is included. No processing fee, no delivery fee, no retake fee, and no upgraded version of the course.' },
  { q: 'I am 25 or older. Should I take this?', a: 'You do not have to. People over 25 take it because the sign and traffic law exam is part of the course, on their own schedule, and DPS says the course is highly recommended for first-time applicants.' },
  { q: 'Do I need a learner permit first?', a: 'No. You can take the course before you have any license or permit at all.' },
  { q: 'Can I take the course on my phone?', a: 'Yes. The course works on any device, and your progress saves as you go, so ten minutes on a break counts.' },
  { q: 'Can I get a refund?', a: 'Yes. If you’re not satisfied, you can request a full refund before you complete the course or receive your certificate.' },
];

const landingFaqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: landingFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const resources = [
  { href: `${base}/cost`, tag: 'Cost', title: 'How Much Adult Drivers Ed Costs', blurb: 'The whole bill to get licensed, and what other checkouts add after the ad.' },
  { href: `${base}/do-i-need-adult-drivers-ed`, tag: 'Start here', title: 'Do I Need Adult Drivers Ed in Texas?', blurb: 'Age, license history and where you are moving from, in one decision table.' },
  { href: `${base}/how-to-get-a-texas-license-as-an-adult`, tag: 'Process', title: 'How to Get a Texas License as an Adult', blurb: 'Every step from the course to the card in your hand.' },
  { href: `${base}/first-texas-license-18-to-24`, tag: 'Ages 18–24', title: 'Your First Texas License at 18 to 24', blurb: 'What the state requires at your age and in what order.' },
  { href: `${base}/drivers-ed-over-25`, tag: '25 and over', title: 'Drivers Ed Over 25: Optional, Still Useful', blurb: 'Why DPS recommends it and what you skip at the office.' },
  { href: `${base}/impact-texas-adult-drivers`, tag: 'ITAD', title: 'Impact Texas Adult Drivers', blurb: 'The free DPS video, its 90-day clock, and when to watch it.' },
  { href: `${base}/texas-written-knowledge-test`, tag: 'DPS test', title: 'The Texas Written Knowledge Test', blurb: 'What the course satisfies and what DPS still tests.' },
  { href: `${base}/texas-driving-test`, tag: 'Driving test', title: 'The Texas Driving Test', blurb: 'What examiners score and how to book it.' },
  { href: `${base}/ade-1317-certificate`, tag: 'Certificate', title: 'The ADE-1317 Certificate', blurb: 'Who issues it, when, and what to do with it.' },
  { href: `${base}/whats-in-the-course`, tag: 'Course', title: 'What Is in the Course', blurb: 'The nine modules, the videos and the final exam.' },
  { href: `${base}/how-long-does-the-course-take`, tag: 'Time', title: 'How Long the Course Takes', blurb: 'Six hours of instruction, your schedule.' },
  { href: `${base}/dps-wait-times`, tag: 'DPS', title: 'DPS Wait Times by Office', blurb: 'Every Texas office ranked by road-test queue.' },
  { href: `${base}/new-resident-out-of-state-license`, tag: 'Moving here', title: 'New Resident with an Out-of-State License', blurb: 'When the course is waived and what DPS wants instead.' },
];

// Jackson, 2026-10-13: show the first five guides, the rest behind a Show more button (same pattern as the reviews).
const GUIDES_SHOWN = 5;

const check = (stroke: string) => `<svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M4 11.5 L9 16 L18 6" stroke="${stroke}" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const chev = (stroke: string, size = 18) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9 L12 15 L18 9" stroke="${stroke}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

{!isEnabled && <meta http-equiv="refresh" content="0;url=/" />}

{isEnabled && (
<AdeLayout
  title={`Texas Adult Drivers Ed Online: 6-Hour TDLR-Approved Course, ${price} Flat | Road Ready Safety`}
  description={`The ${hours}-hour Texas adult driver education course (${code}) online, TDLR-approved (${ADE_LICENSE}), for first-time drivers 18 and over. ${price} flat: course, exam and certificate, nothing added at checkout. Required at 18 to 24.`}
  keywords="texas adult drivers ed, adult drivers ed texas, texas adult driver education course, 6 hour adult driver education texas, adult drivers ed online texas, ADE-1317, tdlr approved adult drivers ed"
  url={base}
  banner={COMPLETION_RATE_BANNER}
  headerStyle="minimal"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={landingFaqSchema} />
  </Fragment>

  <div class="text-text bg-white" style={sans}>

    <!-- Hero -->
    <section class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-9 pb-14 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] items-center">
      <div class="min-w-0 flex flex-col gap-5">
        <p class="self-start inline-flex items-center gap-2 m-0 bg-white border border-[#B9D3F6] rounded-full py-1 pl-1 pr-3">
          <img src="/assets/images/badges/texas-approved-tdlr.png" width="24" height="24" alt={`Texas approved: TDLR-approved adult driver education course (${code})`} class="w-6 h-6 shrink-0" decoding="async" />
          <span class="font-bold text-[13px] text-primary-deep" style={inter}>TDLR-Approved Driver Education Provider {ADE_LICENSE}</span>
        </p>
        <h1 class="m-0 font-extrabold text-[32px] lg:text-[44px] leading-[1.1] tracking-[-0.02em] text-text" style={inter}>Texas Adult Drivers Ed Online: The 6-Hour Course for Your First License</h1>
        <ul class="list-none p-0 m-0 flex flex-col gap-3 max-w-[580px]">
          {bullets.map((b) => (
            <li class="flex gap-3.5 items-start">
              <span class="flex-none w-6 h-6 rounded-full bg-[#E3F6EC] flex items-center justify-center mt-px" set:html={check('#1E8E53')} />
              <span class="text-base leading-[1.45] text-text-body"><strong class="font-extrabold text-text" style={inter}>{b.label}:</strong>{' '}{b.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Photo with the course-progress card. Not a certificate: the ADE-1317 is a TDLR-controlled form. -->
      <div class="hidden lg:block min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 relative pb-16" aria-hidden="true">
        <RoadPhoto class="w-full aspect-[4/3] rounded-[24px]" position="50% 50%" photo="texas-dallas" eager desktopOnly />
        <div class="absolute right-6 top-6 rounded-2xl bg-white shadow-[0_20px_25px_-5px_rgba(17,23,34,0.15)] px-4 py-3">
          <p class="text-[22px] font-extrabold text-primary-navy leading-6 m-0" style={inter}>{price}</p>
          <p class="text-xs text-text-body leading-4 m-0">all in</p>
        </div>
        <div class="absolute -left-8 bottom-0 w-[340px] rounded-[20px] bg-white ring-1 ring-border shadow-[0_24px_48px_-16px_rgba(2,25,84,0.35)] p-5 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-primary-deep">Course progress</span>
            <span class="text-xs font-semibold text-text tabular-nums">4 of {ade.modules.length} modules</span>
          </div>
          <div class="h-2 rounded-full bg-[#EEF2F7] overflow-hidden"><div class="h-full bg-[#9DB4D6] rounded-full" style={`width:${Math.round((4 / ade.modules.length) * 100)}%`}></div></div>
          <ul class="flex flex-col gap-1.5 list-none p-0 m-0">
            {progressDone.map((m) => (
              <li class="flex items-center gap-3 rounded-xl bg-surface-muted px-3 py-2">
                <span class="w-5 h-5 rounded-full bg-[#9DB4D6] flex items-center justify-center flex-shrink-0">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2l2.2 2.2 4.8-4.8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="text-[13px] text-text-body truncate">{m}</span>
              </li>
            ))}
          </ul>
          <div class="rounded-xl bg-[#EEF2F7] text-text-body text-sm font-bold text-center py-2.5">Continue module 5</div>
        </div>
      </div>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2 pt-1 flex flex-col gap-3 items-start">
        <a href={enrollUrl} data-rrs-cta="ade-hero" class="inline-block no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-[30px] py-[15px] rounded-full text-center max-w-full sm:whitespace-nowrap shadow-[0_8px_20px_rgba(36,84,230,0.28)]" style={inter}>Start My Course · {price}&nbsp;→</a>
        <p class="m-0 flex items-start gap-2 text-sm text-text-muted max-w-[520px]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none mt-0.5"><circle cx="12" cy="12" r="9" stroke="#64748B" stroke-width="2"/><path d="M12 11 V16 M12 8 V8.5" stroke="#64748B" stroke-width="2" stroke-linecap="round"/></svg>
          <span>{heroNote}</span>
        </p>
      </div>
    </section>

    <!-- Reviews -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-14 pb-16 flex flex-col gap-7">
        <div class="flex flex-col gap-2.5 items-center text-center">
          <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Reviews</h2>
          <a href={trustpilotUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-sm text-text-muted no-underline border-b border-[#CBD3DF] pb-0.5 hover:text-text">Verified reviews on Trustpilot <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 9 L9 3 M4.5 3 H9 V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="grid gap-5 grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]">
          {allReviews.map((r, i) => (
            <div data-more={i >= REVIEWS_SHOWN ? '' : undefined} hidden={i >= REVIEWS_SHOWN}>
              <div class="h-full bg-white border border-border rounded-[14px] p-5 flex flex-col gap-3">
                <div class="flex justify-between items-center gap-2.5">
                  <span class="text-accent text-[15px] tracking-[2px]" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                  <span class="text-xs text-text-muted">{r.date}</span>
                </div>
                {r.title && <strong class="text-[15px] text-text" style={inter}>{r.title}</strong>}
                <p class="m-0 text-[15px] leading-[1.5] text-text flex-1">“{r.quote}”</p>
                <div class="flex items-center gap-2.5 pt-2.5 border-t border-[#EEF2F7]">
                  <span class="w-[30px] h-[30px] rounded-full bg-[#DDEBFD] text-primary-deep font-bold text-xs flex items-center justify-center" aria-hidden="true">{r.initials}</span>
                  <span class="text-sm font-bold">{r.name}</span>
                  <span class="text-xs text-text-muted ml-auto">{r.verified ? 'Verified via Trustpilot' : 'via Trustpilot'}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
        {allReviews.length > REVIEWS_SHOWN && (
          <button type="button" id="reviews-toggle" aria-expanded="false" class="self-center font-bold text-base min-h-12 px-6 py-2.5 rounded-full cursor-pointer bg-white text-text border-2 border-[#CBD3DF] hover:border-text-muted">Show more reviews</button>
        )}
      </div>
    </section>

    <!-- Your course: one card on a contrast panel (#pricing and #curriculum are linked from every ADE page's header) -->
    <section id="pricing" class="bg-white border-t border-border scroll-mt-28">
      <span id="course" class="block" aria-hidden="true"></span>
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-9 items-center">
        <div class="flex flex-col gap-2 text-center max-w-[640px]">
          <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Your Course</h2>
          <p class="m-0 text-base text-text-muted">One price, everything included. Nothing is added at checkout.</p>
        </div>
        <div class="w-full max-w-[460px] rounded-[20px] px-5 py-6 sm:px-6 sm:py-7 flex flex-col gap-3.5 sm:gap-4 bg-[#0B2160] text-white border border-[#0B2160] shadow-[0_24px_60px_rgba(11,33,96,0.28)]">
          <div class="flex flex-col-reverse sm:flex-row sm:justify-between gap-2.5 sm:gap-4 items-start">
            <h3 class="m-0 font-extrabold text-[20px] sm:text-[21px] leading-[1.2]" style={inter}>{ade.course.name}</h3>
            <span class="flex-none font-bold text-xs px-3 py-1.5 rounded-full bg-white text-primary-deep">TDLR-Approved</span>
          </div>
          <p class="m-0 flex items-baseline gap-1"><span class="font-extrabold text-[38px] sm:text-[44px] leading-none" style={inter}>{dollars}</span><span class="text-base text-[#D6E8FD]">.{cents}</span></p>
          <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
            {cardChecks.map((c) => (
              <li class="flex gap-3.5 items-start">
                <span class="flex-none w-6 h-6 rounded-full bg-white/20 flex items-center justify-center" set:html={check('#FFFFFF')} />
                <span class="text-[14px] sm:text-[15px] leading-[1.45] pt-0.5 text-[#D6E8FD]">{c.strong && <strong class="text-white">{c.strong}</strong>}{c.rest}</span>
              </li>
            ))}
          </ul>
          <a href={enrollUrl} data-rrs-cta="ade-course-card" class="mt-2 no-underline text-center font-extrabold text-[17px] px-4 py-3.5 rounded-xl bg-white hover:bg-info text-primary-deep" style={inter}>Enroll Now&nbsp;→</a>
        </div>
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-base text-text-body">
          <span class="inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="#2454E6" stroke-width="2"/><path d="M8 11 V8 a4 4 0 0 1 8 0 V11" stroke="#2454E6" stroke-width="2"/></svg>Secure checkout</span>
          <a href={ADE_VERIFY_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-text-body no-underline hover:underline"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z" stroke="#2454E6" stroke-width="2" stroke-linejoin="round"/><path d="M9 12 L11.2 14.2 L15.5 9.8" stroke="#2454E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>TDLR-licensed provider {ADE_LICENSE}</a>
          <span class="hidden sm:inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#2454E6" stroke-width="2"/><path d="M14.5 9 C14 8.2 13 7.8 12 7.8 C10.5 7.8 9.5 8.6 9.5 9.8 C9.5 12.4 14.5 11.2 14.5 14 C14.5 15.3 13.4 16.2 12 16.2 C10.8 16.2 9.8 15.7 9.3 14.8 M12 6.5 V7.8 M12 16.2 V17.5" stroke="#2454E6" stroke-width="1.8" stroke-linecap="round"/></svg>100% risk-free guarantee</span>
        </div>
      </div>
    </section>

    <!-- Risk-free: full refund before completion or certificate (Jackson, 2026-10-13), same promise as /texas -->
    <section class="bg-white">
      <div class="max-w-[880px] mx-auto px-4 sm:px-6 pt-0 pb-[88px]">
        <div class="bg-surface-muted border border-border rounded-3xl px-6 sm:px-10 py-12 flex flex-col items-center gap-4 text-center">
          <span class="w-16 h-16 rounded-full bg-white border border-[#DCE4EF] flex items-center justify-center"><svg width="32" height="32" viewBox="0 0 34 38" fill="none" aria-hidden="true"><path d="M17 2 L31 7 V18 C31 27 24 33 17 36 C10 33 3 27 3 18 V7 Z" stroke="#2454E6" stroke-width="3" stroke-linejoin="round"/><path d="M11 18.5 L15.5 23 L23.5 14" stroke="#2454E6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <h2 class="m-0 font-extrabold text-[28px] lg:text-[36px] leading-[1.15] text-text" style={inter}>Try It 100% Risk-Free</h2>
          <p class="m-0 text-lg text-text-body max-w-[560px]">If you’re not satisfied, you can request a full refund before you complete the course or receive your certificate.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full max-w-[600px]">
            {['No complicated forms or hoops', 'Refund processed within 3–5 business days'].map((t) => (
              <span class="flex items-center justify-center gap-2 h-14 bg-white border border-[#DCE4EF] rounded-2xl px-4 text-sm leading-5 font-bold text-text text-center"><span class="flex-none w-5 h-5 rounded-full bg-[#E3F6EC] flex items-center justify-center [&>svg]:w-3 [&>svg]:h-3" set:html={check('#1E8E53')} />{t}</span>
            ))}
          </div>
          <a href={enrollUrl} data-rrs-cta="ade-risk-free" class="mt-1.5 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-6 sm:px-[30px] py-[15px] rounded-full max-w-full sm:whitespace-nowrap" style={inter}>Start Risk-Free Today&nbsp;→</a>
        </div>
      </div>
    </section>

    <!-- What to expect -->
    <section id="curriculum" class="bg-white border-t border-border scroll-mt-28">
      <span id="who-needs-it" class="block" aria-hidden="true"></span>
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-20 pb-[88px] flex flex-col gap-3">
        <h2 class="m-0 text-center font-extrabold text-[32px] lg:text-[48px] leading-[1.1] text-text" style={inter}>What to Expect</h2>
        <p class="m-0 text-center text-lg text-text-body">Everything you need to know about getting a Texas license as an adult.</p>
        <div class="w-full sm:w-auto self-center grid grid-cols-2 sm:flex sm:flex-wrap sm:justify-center gap-1 bg-info rounded-2xl sm:rounded-[28px] p-1.5 mt-5 mb-7" role="group" aria-label="What to expect topics" data-exp-tabs>
          {expTabs.map((t, i) => (
            <button type="button" data-pick={t.key} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['font-bold text-sm sm:text-base min-h-[44px] sm:min-h-[46px] px-3 sm:px-[22px] py-2 sm:py-2.5 border-0 rounded-xl sm:rounded-full cursor-pointer', i === 0 ? 'bg-primary text-white' : 'bg-transparent text-text']} style={inter}>{t.label}</button>
          ))}
        </div>
        <div class="flex flex-wrap gap-14 items-start">
          <div class="flex-[999_1_480px] min-w-0">
            {expTabs.map((t, ti) => (
              <div data-panel={t.key} hidden={ti !== 0}>
                <div class="flex flex-col">
                  <p class="m-0 mb-[18px] text-[17px] text-text-body">{t.intro}</p>
                  {t.items.map(([title, body]) => (
                    <details name={`exp-${t.key}`} class="group border-t border-border">
                      <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 py-5 cursor-pointer font-extrabold text-[19px] text-text" style={inter}>
                        {title}
                        <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#3B4250')} />
                      </summary>
                      <p class="m-0 mb-5 text-base text-text-body">{body}</p>
                    </details>
                  ))}
                  {t.note && <div class="border-t border-border pt-4 text-[15px] text-text-muted">{t.note}</div>}
                  {t.key === 'req' && <a href={statuteHref} target="_blank" rel="noopener noreferrer" class="self-start mt-3 text-sm font-semibold text-primary-deep underline">Read Transportation Code §521.1601 on the Texas statutes site&nbsp;↗</a>}
                  {t.key === 'after' && <a href={itadHref} target="_blank" rel="noopener" class="self-start mt-3 text-sm font-semibold text-primary-deep underline">Take ITAD on the DPS site&nbsp;↗</a>}
                  {t.link && <a href={contactUrl} class="self-start mt-2 no-underline bg-primary hover:bg-primary-hover text-white font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap">Contact Support&nbsp;→</a>}
                </div>
              </div>
            ))}
          </div>
          <div class="hidden lg:block flex-[1_1_380px] min-w-0 bg-[#F4F6F9] rounded-[28px] px-6 sm:px-10 py-12" aria-hidden="true">
            <div class="bg-white rounded-[20px] p-[26px] flex flex-col gap-2.5 shadow-[0_10px_28px_rgba(11,33,96,0.06)]">
              <div class="flex justify-between text-[15px]"><strong class="text-text-body">Course progress</strong><strong class="text-text">4 of {ade.modules.length}</strong></div>
              <div class="bg-[#EEF2F7] rounded-full h-2 mb-1.5"><div class="h-2 rounded-full bg-[#9DB4D6]" style={`width:${Math.round((4 / ade.modules.length) * 100)}%`}></div></div>
              {progressDone.map((m) => (
                <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full bg-[#9DB4D6] flex items-center justify-center"><svg width="12" height="12" viewBox="0 0 22 22" fill="none"><path d="M4 11.5 L9 16 L18 6" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{m}</div>
              ))}
              <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full border-2 border-[#9DB4D6]"></span>{progressNext}</div>
              <span class="mt-1.5 text-center bg-[#EEF2F7] text-text-body font-bold text-[15px] p-3 rounded-xl">Continue module 5</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- About us -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px]">
        <div class="max-w-[860px] mx-auto bg-white border border-border rounded-[20px] px-6 sm:px-10 py-9 flex flex-col gap-3.5 shadow-[0_6px_18px_rgba(11,33,96,0.05)]">
          <span class="text-[13px] font-bold text-primary-deep uppercase tracking-[0.08em]">About us</span>
          <h2 class="m-0 font-extrabold text-[26px] leading-[1.2] text-text" style={inter}>Why we built Road Ready Safety</h2>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">Our goal is simple: fair, transparent, state-approved courses for Texans getting their first license, plus plain-English guides so nobody is left confused, frustrated or upset about what DPS requires.</p>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">A lot of drivers have had bad experiences with surprise fees, confusing options and no one to help. Our refund policy is compliant and clear, because we want to earn back the trust those experiences cost.</p>
          <p class="m-0 text-[17px] leading-[1.65] text-text-body">We hope you leave with a great course and a great experience, and that you trust us enough to tell your friends.</p>
          <span class="text-[15px] font-bold text-text">The Road Ready Safety team</span>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white border-t border-border scroll-mt-28">
      <div class="max-w-[820px] mx-auto px-4 sm:px-6 pt-20 pb-24 flex flex-col gap-3">
        <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Frequently Asked Questions</h2>
        <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Everything you need to know about Texas adult drivers ed.</p>
        <div class="flex flex-col gap-2.5">
          {landingFaqs.map((f, i) => (
            <details name="ade-faq" open={i === 0} class="group bg-white border border-border rounded-[14px] open:border-[#B9D3F6] open:shadow-[0_8px_20px_rgba(11,33,96,0.06)]">
              <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 px-[22px] py-[18px] cursor-pointer">
                <h3 class="m-0 font-bold text-[17px] text-text" style={inter}>{f.q}</h3>
                <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#2454E6', 20)} />
              </summary>
              <p class="m-0 px-[22px] pb-5 text-base leading-[1.6] text-text-body">{f.a}</p>
            </details>
          ))}
        </div>
        <div class="mt-[18px] bg-info border border-[#B9E2FE] rounded-[18px] px-7 py-6 flex flex-wrap gap-3.5 items-center justify-between">
          <div class="flex flex-col"><strong class="text-[19px] text-text" style={inter}>Still have questions?</strong><span class="text-[15px] text-text-body">Our support team is here to help.</span></div>
          <a href={contactUrl} class="no-underline bg-white text-text border border-[#B9D3F6] font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap hover:border-primary">Contact Support&nbsp;→</a>
        </div>
      </div>
    </section>

    <!-- Helpful resources -->
    <section class="bg-surface-muted border-t border-border">
      <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-3.5">
        <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Helpful Resources</h2>
        <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Free guides to help you through every step of getting a Texas license as an adult.</p>
        <div class="max-w-[760px] w-full mx-auto flex flex-col border-t border-border">
          {resources.map((r, i) => (
            <div data-more-guide={i >= GUIDES_SHOWN ? '' : undefined} hidden={i >= GUIDES_SHOWN}>
              <a href={r.href} class="group no-underline text-text flex items-start py-4 border-b border-border">
                <span class="flex flex-col gap-1 min-w-0">
                  <span class="text-xs font-bold text-primary-deep uppercase tracking-[0.06em]">{r.tag}</span>
                  <span class="font-extrabold text-lg text-text leading-[1.3] group-hover:text-primary" style={inter}>{r.title}</span>
                  <span class="text-[15px] text-text-body">{r.blurb}</span>
                  <span class="text-sm font-bold text-primary mt-0.5">Read guide&nbsp;→</span>
                </span>
              </a>
            </div>
          ))}
        </div>
        {resources.length > GUIDES_SHOWN && (
          <button type="button" id="guides-toggle" aria-expanded="false" class="self-center mt-2 font-bold text-base min-h-12 px-6 py-2.5 rounded-full cursor-pointer bg-white text-text border-2 border-[#CBD3DF] hover:border-text-muted">Show more guides</button>
        )}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      // Reviews: show 3, toggle the rest.
      var rt = document.getElementById('reviews-toggle');
      if (rt && !rt.dataset.armed) {
        rt.dataset.armed = '1';
        rt.addEventListener('click', function () {
          var open = rt.getAttribute('aria-expanded') !== 'true';
          document.querySelectorAll('[data-more]').forEach(function (el) { el.hidden = !open; });
          rt.setAttribute('aria-expanded', open ? 'true' : 'false');
          rt.textContent = open ? 'Show fewer reviews' : 'Show more reviews';
        });
      }
      // Guides: show 5, toggle the rest.
      var gt = document.getElementById('guides-toggle');
      if (gt && !gt.dataset.armed) {
        gt.dataset.armed = '1';
        gt.addEventListener('click', function () {
          var open = gt.getAttribute('aria-expanded') !== 'true';
          document.querySelectorAll('[data-more-guide]').forEach(function (el) { el.hidden = !open; });
          gt.setAttribute('aria-expanded', open ? 'true' : 'false');
          gt.textContent = open ? 'Show fewer guides' : 'Show more guides';
        });
      }
      // What to expect: tab picker.
      var tabs = document.querySelector('[data-exp-tabs]');
      if (tabs && !tabs.dataset.armed) {
        tabs.dataset.armed = '1';
        tabs.addEventListener('click', function (e) {
          var b = e.target.closest('[data-pick]'); if (!b) return;
          var key = b.getAttribute('data-pick');
          tabs.querySelectorAll('[data-pick]').forEach(function (x) {
            var on = x === b;
            x.setAttribute('aria-pressed', on ? 'true' : 'false');
            x.classList.toggle('bg-primary', on); x.classList.toggle('text-white', on);
            x.classList.toggle('bg-transparent', !on); x.classList.toggle('text-text', !on);
          });
          document.querySelectorAll('[data-panel]').forEach(function (p) {
            var show = p.getAttribute('data-panel') === key;
            p.hidden = !show;
            if (show) p.querySelectorAll('details').forEach(function (d) { d.open = false; });
          });
        });
      }
    })();
  </script>
</AdeLayout>
)}

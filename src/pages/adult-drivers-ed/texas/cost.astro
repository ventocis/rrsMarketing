---
/**
 * /adult-drivers-ed/texas/cost — "The real price of Texas adult driver ed": the dated, named price table.
 *
 * Rebuilt 2026-10-29 per REPORT v3 §3–4 (~/Downloads/tx-adult-de) and SEO's TX-ADE-PRICE-AND-AI-CITATION spec.
 * Jackson decided on 2026-10-29 to name competitors here, dated, verified rows only (hold rows stay out until
 * rechecked). This page owns the price data; other pages show one summary sentence from the same module and link
 * to an anchor below, so keep the anchors stable.
 *
 * Every number comes from src/data/ade-prices.ts (rows: ade-prices.json; our price: ade-texas.json). Never type a
 * count, range, median or date here. Rules kept: no "cheapest"/"lowest" claim about us, no "best" labels or
 * badges, no "hidden fees" or quality judgments about named schools, no ownership claims, no Course/Offer/ItemList
 * schema (Course lives on the hub only).
 */
import AdeLayout from '../../../layouts/AdeLayout.astro';
import { fees, itd } from '../../../data/ade-eligibility';
import { adeEnabled, adeEnrollUrl, ADE_LICENSE } from '../../../lib/ade';
import {
  tableRows, inPerson, online, onlineOnly, classroom, cartGap, cartsCount, cartsWithTrial, requiredFees,
  preselectedUpgrades, advertisedBelowUs, advertisedSameAsUs, lowest, ourPrice, checkedOn, tdlrAdultProviders,
  providerPagesRead, bundles, schoolRoadTest, changelog, totalToLicense, usd, longDate, moneyText, competitors,
  STALE_WARN_DAYS,
} from '../../../data/ade-prices';

const siteUrl = (import.meta.env.VITE_SITE_URL || 'https://roadreadysafety.com').replace(/\/$/, '');
const base = '/adult-drivers-ed/texas';
const url = `${base}/cost`;
const csvPath = '/data/texas-adult-driver-ed-prices.csv';
const snapshotPath = `/data/texas-adult-driver-ed-prices-${checkedOn.slice(0, 7)}.csv`;

const N = competitors.length;
const date = longDate(checkedOn);
const price = usd(ourPrice);
const dps = fees.newLicense18to84;
const total = totalToLicense(dps);
const tdlrLookup = (lic: string) => `https://www.tdlr.texas.gov/driver/education/providers/search/?lic=${encodeURIComponent(lic)}`;
const shortDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const range = (s: { min: number; max: number }) => (s.min === s.max ? usd(s.min) : `${usd(s.min)} to ${usd(s.max)}`);

// Answer blocks: 40–60 words each, answer first, then the number with n, date and a caveat.
const answers = {
  howMuch: `Online Texas adult driver ed courses advertised prices from ${usd(online.min)} to ${usd(online.max)} when we checked ${N} TDLR-licensed providers on ${date}. The median advertised price was ${usd(online.median)}, and the median for online-only providers was ${usd(onlineOnly.median)}. In-person six-hour classes cost ${range(classroom)}. Prices change. Confirm at checkout.`,
  checkout: `Not always. In the ${cartsCount} checkouts we viewed on ${date}, the default total ran ${range(cartGap)} above the headline price. The extra came from required certificate fees (${range(requiredFees)}) and preselected instant-certificate upgrades (${range(preselectedUpgrades)}). ${cartsWithTrial} of the ${cartsCount} headline prices required starting a roadside-assistance trial that renews monthly.`,
  lowest: `The lowest advertised online price was ${usd(lowest.price)}, from ${lowest.count === 1 ? 'one provider' : `${lowest.count} providers`} on ${date}. We didn't view ${lowest.count === 1 ? 'that checkout' : 'those checkouts'}, so any added fees aren't verified. Every TDLR-approved adult course teaches the same six-hour state curriculum and issues the same ADE-1317 certificate.`,
  ours:
    `Road Ready Safety, which publishes this page, sells its TDLR-approved online course (${ADE_LICENSE}) for ${price} total. Our own checkout on ${longDate(tableRows.find((r) => r.publisher)!.checked)} showed the course and the instant certificate, and nothing else added. ` +
    (ourPrice < online.median
      ? `That's below the ${usd(online.median)} median of the ${N} providers we checked, but it isn't the lowest: ${advertisedBelowUs} advertised less.`
      : `Of the ${N} providers we checked, ${advertisedBelowUs} advertised less${advertisedSameAsUs ? ` and ${advertisedSameAsUs} advertised the same price` : ''}.`),
  inPerson: `Usually. In-person six-hour adult classes at TDLR-licensed local schools cost ${range(classroom)}, with a ${usd(classroom.median)} median across the ${classroom.n} schools we checked on ${date}. The online median advertised price was ${usd(online.median)}. Packages that add behind-the-wheel lessons and a school road test ran about ${usd(bundles.low)} to ${usd(bundles.high)}.`,
  total: `At 18 to 24, budget for the six-hour course, the free ${itd.adultName} video and the $${dps} DPS license fee. With the middle half of online course prices (${usd(Math.round(online.q1))} to ${usd(Math.round(online.q3))}), that comes to roughly ${usd(total.low)} to ${usd(total.high)}. A road test at a driving school, if you choose one, adds about ${usd(schoolRoadTest.low)} to ${usd(schoolRoadTest.high)}.`,
  same: `No. Every TDLR-approved adult driver education course teaches the same state-set six-hour curriculum and issues the ADE-1317 certificate, whatever it costs. The differences are price, how fast the certificate arrives, retake rules, audio, Spanish options and support. Check that a provider holds a TDLR license before you pay; every row below lists it.`,
};

const faqs = [
  { q: 'Do these prices include the certificate?', a: `Not always. The table's "What's added" column lists the certificate, handling or processing fees we saw or that the provider states. Where we only read the advertised price, the checkout total says "Not verified". Ours includes the instant certificate in ${price}.` },
  { q: 'What is an instant-certificate upgrade, and do I need it?', a: 'Some checkouts add a paid option to receive the certificate right away, and some tick it for you. Texas lets a provider take up to 15 working days to issue the ADE-1317, so the upgrade buys speed, not a different certificate. If you have a DPS appointment soon, ask how long the free option takes.' },
  { q: 'Why do some courses require a roadside-assistance trial?', a: `In ${cartsWithTrial} of the ${cartsCount} carts we viewed, the advertised price applied only with a roadside-assistance trial that starts free and then renews monthly. Without the trial, the same course cost more. If you accept a trial, note the date to cancel.` },
  { q: 'Are Spanish courses priced differently?', a: 'Sometimes. A few providers charge a different price for the Spanish version of the course; the Notes column shows it where we saw it. Prices in the table are for the English course.' },
  { q: `Is a ${usd(lowest.price)} course legitimate?`, a: 'Price doesn’t change the certificate. What matters is that the provider holds a current TDLR driver education license for adult courses. Every row in the table shows the license number we matched.' },
  { q: 'How often is this page updated?', a: `We recheck every row monthly and the carts we viewed twice a month. A row not rechecked in ${STALE_WARN_DAYS} days is marked "price may be outdated", and older rows come out of the table and the numbers.` },
  { q: 'Does Road Ready Safety earn money from this table?', a: `Only from our own course, which is one of the rows. No link in the table is an affiliate link, and the table is sorted by advertised price, not by preference.` },
  { q: 'Which price should I compare: advertised or checkout?', a: 'The checkout total, with nothing added that you didn’t choose. That is the number on your receipt. Where we couldn’t see it, compare the advertised price and check the final screen before you pay.' },
];

const methodItems = [
  `We pulled TDLR’s driver education provider data on ${date}: ${tdlrAdultProviders} licensed providers hold an adult approval.`,
  `We read prices on ${providerPagesRead} providers’ own course pages and published the ${N} competitors whose online price and TDLR license we could match. Rows with an approximate or unconfirmed price are left out until rechecked.`,
  `For ${cartsCount} providers and our own course, we viewed the checkout without creating an account or paying.`,
  'We show the price for the English six-hour course with default options. Promotional prices that apply automatically are included and noted.',
  'Each row links to the provider’s own page and to its TDLR license record.',
];

const tierLabel: Record<string, string> = { A: 'Checkout viewed', B: 'Provider states the total', C: 'Advertised price only' };
const outdated = 'Price may be outdated';

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Texas adult driver education course prices, ${new Date(`${checkedOn}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}`,
  description: `Advertised prices, and default checkout totals where viewed, for ${N} TDLR-licensed Texas adult driver education providers plus the publisher, and six-hour class prices at ${classroom.n} in-person schools. Checked ${checkedOn}.`,
  url: `${siteUrl}${url}`,
  temporalCoverage: checkedOn,
  dateModified: checkedOn,
  creator: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  spatialCoverage: { '@type': 'Place', name: 'Texas, US' },
  variableMeasured: ['Advertised price (USD)', 'Default checkout total (USD)', 'Verification tier', 'Date checked'],
  measurementTechnique: methodItems.join(' '),
  isBasedOn: 'https://www.tdlr.texas.gov/driver/education/providers/search/',
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${siteUrl}${csvPath}` }],
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `The real price of Texas adult driver ed: ${N} providers checked`,
  description: answers.howMuch,
  datePublished: '2026-10-13',
  dateModified: checkedOn,
  author: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'Road Ready Safety', url: siteUrl },
  mainEntityOfPage: `${siteUrl}${url}`,
  about: 'Texas adult driver education (ADE-1317) course prices',
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const next = [
  { href: base, title: 'Texas 6-hour adult drivers ed online', blurb: `Our course: TDLR ${ADE_LICENSE}, ${price} total, certificate the moment you pass.` },
  { href: `${base}/do-i-need-adult-drivers-ed`, title: 'Do you need the course at all?', blurb: 'Required at 18 to 24 for a first license; optional at 25 and over.' },
  { href: `${base}/texas-driver-license-fees`, title: 'What the license itself costs', blurb: `$${dps} at DPS, and what else you pay there.` },
  { href: `${base}/ade-1317-certificate`, title: 'The ADE-1317 certificate', blurb: 'What it is, when it arrives, and why it doesn’t expire.' },
];

const outfit = "font-family:'Outfit',sans-serif;";
const wrap = 'max-w-[1080px] mx-auto px-4 sm:px-6 lg:px-8';
const h2 = 'text-[24px] lg:text-[28px] font-bold text-text leading-tight m-0 mb-3 scroll-mt-24';
const p = 'text-[17px] text-text-body leading-[30px] m-0';
const th = 'text-left text-[11px] font-semibold uppercase tracking-wider text-text-muted px-2.5 py-3 border-b border-border whitespace-nowrap';
const td = 'px-2.5 py-2.5 border-b border-border align-top text-left text-[13px] leading-5 text-text-body';
---

{!adeEnabled && <meta http-equiv="refresh" content="0;url=/" />}

{adeEnabled && (
  <AdeLayout
    title="What Does Texas Adult Drivers Ed Really Cost? (2026)"
    description={answers.howMuch}
    keywords="how much is adult drivers ed in texas, texas adult drivers ed price comparison, 6 hour adult driving course texas cost, adult drivers ed texas cost"
    url={url}
    banner={`${price} total · Instant certificate included · Nothing added at checkout`}
    courseSchema={false}
  >
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </Fragment>

    <article class="bg-surface-muted pb-20 text-text">
      <!-- Lead: disclosure before the first number, then the dated line and the hook. -->
      <header class={`${wrap} pt-12 lg:pt-16 pb-8 flex flex-col gap-5`}>
        <span class="bg-info inline-flex w-fit items-center px-4 py-2 rounded-full text-sm font-semibold text-info-text">Price check</span>
        <h1 class="text-[32px] lg:text-[44px] font-bold leading-[1.1] tracking-[-1px] m-0 max-w-[860px]" style={outfit}>
          The real price of Texas adult driver ed: {N} providers checked
        </h1>
        <div class="rounded-2xl border border-border bg-white p-5 max-w-[860px]">
          <p class="text-[15px] text-text-body leading-6 m-0">
            <strong class="text-text">Disclosure.</strong> Road Ready Safety sells a Texas adult driver ed course (TDLR {ADE_LICENSE}, {price}). We&rsquo;re one of the rows below.
            The table is sorted by advertised price, not by preference. We don&rsquo;t rank providers or award &ldquo;best&rdquo; picks, and no link in the table earns us money.
          </p>
        </div>
        <p class="text-[15px] font-semibold text-text m-0">
          Prices checked <time datetime={checkedOn}>{date}</time>. Prices change. Confirm at checkout.
        </p>
        <p class={`${p} max-w-[860px]`}>
          The price on the ad isn&rsquo;t always the price at checkout. On {date} we put the same six-hour course in {cartsCount} providers&rsquo; carts,
          and the default totals ran {range(cartGap)} above the headline. Three line items move the total, and two of them are pre-checked in some carts.
          Here&rsquo;s what each provider advertises, what we saw at checkout, and what it all adds up to.
        </p>
      </header>

      <div class={`${wrap} flex flex-col gap-6`}>
        <section id="how-much" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
          <h2 class={h2} style={outfit}>How much does adult drivers ed cost in Texas?</h2>
          <p class={p}>{answers.howMuch}</p>
        </section>

        <section id="advertised-vs-checkout" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
          <h2 class={h2} style={outfit}>Is the advertised price what you pay?</h2>
          <p class={p}>{answers.checkout}</p>
          <p class={`${p} mt-4`}>
            Those are the three line items: a required certificate fee, a paid instant certificate, and a trial you&rsquo;d have to remember to cancel.
            A course that puts all three in one price makes comparing easy.
          </p>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <section id="lowest-price" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
            <h2 class={h2} style={outfit}>What&rsquo;s the lowest advertised price?</h2>
            <p class={p}>{answers.lowest}</p>
          </section>
          <section id="road-ready-price" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
            <h2 class={h2} style={outfit}>What does Road Ready Safety charge?</h2>
            <p class={p}>{answers.ours}</p>
          </section>
        </div>

        <!-- Online table -->
        <section id="online-prices" class="rounded-[20px] bg-white border border-border p-4 lg:p-6 scroll-mt-24">
          <h2 class={h2} style={outfit}>Online courses: advertised price vs checkout</h2>
          <p class={`${p} mb-4`}>Sorted by advertised price, lowest first. Scroll sideways on a phone.</p>
          <div class="overflow-x-auto -mx-4 lg:mx-0">
            <table class="w-full min-w-[860px] border-collapse">
              <caption class="sr-only">Texas adult driver education: online course prices, checked {date}</caption>
              <thead>
                <tr>
                  <th scope="col" class={th}>Provider and TDLR license</th>
                  <th scope="col" class={th}>Format</th>
                  <th scope="col" class={th}>Advertised</th>
                  <th scope="col" class={th}>Checkout total</th>
                  <th scope="col" class={th}>What&rsquo;s added</th>
                  <th scope="col" class={th}>How verified</th>
                  <th scope="col" class={th}>Notes</th>
                </tr>
              </thead>
              <tbody>
                {tableRows.map((r) => (
                  <tr class={r.publisher ? 'bg-info' : ''}>
                    <th scope="row" class={`${td} font-semibold text-text min-w-[170px]`}>
                      {r.publisher
                        ? <a href={r.source} class="underline hover:no-underline">{r.provider}</a>
                        : <a href={r.source} rel="nofollow noopener" target="_blank" class="underline hover:no-underline">{r.provider}</a>}
                      {r.publisher && <span class="font-normal text-text-muted"> (publisher)</span>}
                      <a href={tdlrLookup(r.license)} rel="nofollow noopener" target="_blank" class="block font-normal text-text-muted underline hover:no-underline">{r.license}</a>
                    </th>
                    <td class={td}>{r.format}</td>
                    <td class={`${td} whitespace-nowrap font-semibold text-text`}>{usd(r.advertised)}{r.advertisedNote && <span class="block font-normal text-text-muted text-[13px]">{r.advertisedNote}</span>}</td>
                    <td class={`${td} whitespace-nowrap`}>{r.checkout != null ? <>{usd(r.checkout)}<span class="block text-text-muted text-[13px]">{r.checkoutNote}</span></> : <span class="text-text-muted">Not verified</span>}</td>
                    <td class={`${td} min-w-[150px]`}>{r.added ? moneyText(r.added) : <span class="text-text-muted">Not checked</span>}</td>
                    <td class={`${td} min-w-[120px]`}>{tierLabel[r.tier]}<span class="block text-text-muted whitespace-nowrap"><time datetime={r.checked}>{shortDate(r.checked)}</time></span></td>
                    <td class={`${td} min-w-[150px]`}>{[r.stale ? outdated : '', moneyText(r.notes)].filter(Boolean).join('. ')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="online-vs-in-person-cost" class="rounded-[20px] bg-white border border-border p-4 lg:p-8 scroll-mt-24">
          <h2 class={h2} style={outfit}>Is in-person adult drivers ed more expensive?</h2>
          <p class={`${p} mb-5`}>{answers.inPerson}</p>
          <div class="overflow-x-auto -mx-4 lg:mx-0">
            <table class="w-full min-w-[600px] border-collapse">
              <caption class="sr-only">Texas adult driver education: in-person six-hour class prices, checked {date}</caption>
              <thead>
                <tr>
                  <th scope="col" class={th}>School and TDLR license</th>
                  <th scope="col" class={th}>6-hour class</th>
                  <th scope="col" class={th}>Checked</th>
                  <th scope="col" class={th}>Notes</th>
                </tr>
              </thead>
              <tbody>
                {inPerson.map((r) => (
                  <tr>
                    <th scope="row" class={`${td} font-semibold text-text`}><a href={r.source} rel="nofollow noopener" target="_blank" class="underline hover:no-underline">{r.provider}</a><a href={tdlrLookup(r.license)} rel="nofollow noopener" target="_blank" class="block font-normal text-text-muted underline hover:no-underline">{r.license}</a></th>
                    <td class={`${td} whitespace-nowrap font-semibold text-text`}>{usd(r.price)}</td>
                    <td class={`${td} whitespace-nowrap`}><time datetime={r.checked}>{shortDate(r.checked)}</time></td>
                    <td class={td}>{[r.stale ? outdated : '', moneyText(r.notes)].filter(Boolean).join('. ')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-[15px] text-text-muted leading-6 mt-4 mb-0">
            Class price only. Many of these schools also sell behind-the-wheel lessons and a road test as packages. Road Ready Safety sells online only;
            for a classroom near you, TDLR&rsquo;s provider search lists every licensed school.
          </p>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <section id="total-to-get-licensed" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
            <h2 class={h2} style={outfit}>What does it cost in total to get a Texas license at 18 to 24?</h2>
            <p class={p}>{answers.total}</p>
            <p class={`${p} mt-4`}><a class="underline hover:no-underline" href={`${base}/texas-driver-license-fees`}>What the license itself costs at DPS</a></p>
          </section>
          <section id="same-certificate" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
            <h2 class={h2} style={outfit}>Does a cheaper course give a lesser certificate?</h2>
            <p class={p}>{answers.same}</p>
          </section>
        </div>

        <section id="method" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
          <h2 class={h2} style={outfit}>How we checked</h2>
          <ul class="flex flex-col gap-2 pl-5 m-0 list-disc marker:text-text-subtle">
            {methodItems.map((m) => <li class="text-[16px] text-text-body leading-7">{m}</li>)}
          </ul>
        </section>

        <!-- CTA after the data, not before it. -->
        <aside class="bg-primary-navy rounded-[24px] p-8 flex flex-col lg:flex-row lg:items-center gap-5 text-white">
          <div class="flex-1 flex flex-col gap-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-white/70 m-0">If you want one price with the certificate included</p>
            <p class="text-2xl font-bold leading-tight m-0" style={outfit}>Road Ready Safety &middot; TDLR {ADE_LICENSE} &middot; {price} total</p>
            <p class="text-white/85 leading-7 m-0">If another course on this list fits you better, use it. Ours is six hours online, with the certificate ready the moment you pass.</p>
          </div>
          <a href={adeEnrollUrl} data-rrs-cta="ade-cost-table" class="bg-white text-primary-navy min-h-12 py-3 px-6 rounded-xl text-base font-semibold inline-flex items-center justify-center text-center no-underline hover:bg-info transition-colors">Start the 6-hour course &middot; {price}</a>
        </aside>

        <section id="faq" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 scroll-mt-24">
          <h2 class={h2} style={outfit}>Common questions</h2>
          <div class="flex flex-col gap-6">
            {faqs.map((f) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-[17px] font-semibold text-text leading-7 m-0">{f.q}</h3>
                <p class={p}>{f.a}</p>
              </div>
            ))}
          </div>
        </section>

        <section id="cite" class="rounded-[20px] bg-white border border-border p-6 lg:p-8 flex flex-col gap-4 scroll-mt-24">
          <h2 class="text-base font-semibold text-text m-0">Cite or download this data</h2>
          <p class="text-[15px] text-text-body leading-6 m-0">
            Road Ready Safety, <em>Texas adult driver education prices</em>, checked {checkedOn}, roadreadysafety.com{url}. Free to reuse with credit (CC BY 4.0).
          </p>
          <p class="text-[15px] text-text-body leading-6 m-0">
            <a class="underline hover:no-underline" href={csvPath} download>Download the table (CSV)</a>
            &middot; <a class="underline hover:no-underline" href={snapshotPath} download>This month&rsquo;s snapshot</a>
          </p>
          <div>
            <h3 class="text-sm font-semibold text-text m-0 mb-1">Changes</h3>
            <ul class="pl-5 m-0 list-disc text-[15px] text-text-body leading-6">
              {changelog.map((c) => <li><time datetime={c.date}>{longDate(c.date)}</time>: {c.text} {N} providers.</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-text m-0 mb-1">Sources</h3>
            <ul class="pl-5 m-0 list-disc text-[15px] text-text-muted leading-6">
              <li><a class="underline hover:no-underline" href="https://www.tdlr.texas.gov/driver/education/providers/search/" rel="nofollow noopener" target="_blank">TDLR driver education provider search</a></li>
              <li>Each provider&rsquo;s own course page, linked in the tables</li>
              <li><a class="underline hover:no-underline" href="https://www.dps.texas.gov/section/driver-license/driver-license-fees" rel="nofollow noopener" target="_blank">Texas DPS, driver license fees</a></li>
              <li><a class="underline hover:no-underline" href="https://www.dps.texas.gov/section/driver-license/impact-texas-drivers-itd-program" rel="nofollow noopener" target="_blank">Texas DPS, Impact Texas Drivers program</a></li>
            </ul>
          </div>
        </section>

        <section class="flex flex-col gap-3">
          <h2 class="text-base font-semibold text-text m-0">Keep reading</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {next.map((n) => (
              <a href={n.href} class="no-underline bg-white border border-border rounded-2xl p-5 flex flex-col gap-1 hover:border-primary-deep">
                <span class="font-bold text-text text-[17px] leading-6">{n.title}</span>
                <span class="text-[15px] text-text-body leading-6">{n.blurb}</span>
              </a>
            ))}
          </div>
        </section>
      </div>
    </article>
  </AdeLayout>
)}

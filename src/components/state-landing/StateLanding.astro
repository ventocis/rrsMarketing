---
/**
 * StateLanding — the North Dakota and Missouri course landing pages on the /texas page structure
 * (Jackson, 2026-10-08: "follow the /texas page structure more closely").
 *
 * Section order, matching /texas:
 *   hero (seal pill, H1, five bullets, CTA, outcome visual)
 *   reviews (three, then "Show more")
 *   your course (one card, contrast panel)
 *   risk-free
 *   what to expect (tabs + accordions, all collapsed; progress mockup on desktop only)
 *   about us · FAQ + still have questions · helpful resources
 *
 * Facts (price, hours, modules, exam, FAQs) come from the state's course JSON. State-specific copy
 * (bullets, tabs, resources) is passed in by the page, so this file holds layout only.
 * Reviews are our verified Trustpilot reviews from the Texas course, labeled as such (no state has its own yet).
 */
import RoadPhoto from '../landing-v2/RoadPhoto.astro';
import SampleCertificate from '../landing-v2/SampleCertificate.astro';
import texasReviews from '../../data/texas-reviews.json';
import type { CourseData } from '../../data/courses/types';
import { enrollUrl as buildEnrollUrl, contactUrl } from '../../lib/courseFlags';

type Check = { strong?: string; rest: string };
type Tab = { key: string; label: string; intro: string; items: [string, string][]; note?: string; link?: boolean };
type Resource = { href: string; tag: string; title: string; blurb: string };
interface Props {
  course: CourseData;
  seal: { src: string; alt: string; label: string };
  h1: string;
  bullets: { label: string; text: string }[];
  heroNote?: string;
  cardChecks: Check[];
  tabs: Tab[];
  resources: Resource[];
  aboutWho: string;
  sampleNumber: string;
  /** Override the FAQ list (Missouri drops its "$10 courses" answer on the landing page). Must match the page's FAQPage schema. */
  faqs?: { q: string; a: string }[];
}
const { course, seal, h1, bullets, heroNote, cardChecks, tabs, resources, aboutWho, sampleNumber, faqs = course.faqs } = Astro.props;

const enrollUrl = buildEnrollUrl(course);
const price = `$${course.course.priceUsd}`;
const [dollars, cents] = price.split('.');
const modules = course.course.modules.filter((m) => !/quiz|exam/i.test(m.title));
const progressDone = modules.slice(0, 4).map((m) => m.title);
const progressNext = modules[4]?.title ?? '';
const trustpilotUrl = 'https://www.trustpilot.com/review/roadreadysafety.com';
const key = course.course.key;

interface Review { name: string; initials: string; date: string; rating: number; verified: boolean; quote: string; title?: string }
const LEAD = ['Ryan Johnson', 'Chelsie Gates', 'Bliss James', 'MW'];
// Texas reviews can mention Texas-only things (a $28 price, "dismiss your ticket"). On another state's page,
// drop any review that names a price or uses one of that state's banned phrases (course.claims.banned).
const banned = ((course as any).claims?.banned ?? []).map((x: string) => x.toLowerCase());
const fits = (r: Review) => !/\$\d/.test(r.quote) && !banned.some((b: string) => `${r.title ?? ''} ${r.quote}`.toLowerCase().includes(b));
const reviews = [
  ...LEAD.map((n) => (texasReviews as Review[]).find((r) => r.name === n)).filter(Boolean) as Review[],
  ...(texasReviews as Review[]).filter((r) => !LEAD.includes(r.name)),
].filter(fits);
const SHOWN = 3;

const inter = "font-family:'Inter',sans-serif;";
const sans = "font-family:'DM Sans',sans-serif;";
const check = (stroke: string) => `<svg width="14" height="14" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M4 11.5 L9 16 L18 6" stroke="${stroke}" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const chev = (stroke: string, size = 18) => `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9 L12 15 L18 9" stroke="${stroke}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<div class="text-text bg-white" style={sans}>

  <!-- Hero -->
  <section class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-9 pb-14 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,480px)] items-center">
    <div class="min-w-0 flex flex-col gap-5">
      <p class="self-start inline-flex items-center gap-2 m-0 bg-white border border-[#B9D3F6] rounded-full py-1 pl-1 pr-3">
        <img src={seal.src} width="24" height="24" alt={seal.alt} class="w-6 h-6 shrink-0" decoding="async" />
        <span class="font-bold text-[13px] text-primary-deep" style={inter}>{seal.label}</span>
      </p>
      <h1 class="m-0 font-extrabold text-[32px] lg:text-[44px] leading-[1.1] tracking-[-0.02em] text-text" style={inter}>{h1}</h1>
      <ul class="list-none p-0 m-0 flex flex-col gap-3 max-w-[580px]">
        {bullets.map((b) => (
          <li class="flex gap-3.5 items-start">
            <span class="flex-none w-6 h-6 rounded-full bg-[#E3F6EC] flex items-center justify-center mt-px" set:html={check('#1E8E53')} />
            <span class="text-base leading-[1.45] text-text-body"><strong class="font-extrabold text-text" style={inter}>{b.label}:</strong>{' '}{b.text}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="hidden lg:block min-w-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 relative pb-14" aria-hidden="true">
      <RoadPhoto class="w-full aspect-[4/3] rounded-[24px]" position="50% 60%" eager desktopOnly />
      <SampleCertificate courseName={course.course.name} hours={course.course.hours} sampleNumber={sampleNumber} class="absolute -left-8 bottom-0" />
    </div>
    <div class="min-w-0 lg:col-start-1 lg:row-start-2 pt-1 flex flex-col gap-3 items-start">
      <a href={enrollUrl} data-rrs-cta={`${key}-hero`} class="inline-block no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-[30px] py-[15px] rounded-full text-center max-w-full sm:whitespace-nowrap shadow-[0_8px_20px_rgba(36,84,230,0.28)]" style={inter}>Start My Course · {price}&nbsp;→</a>
      {heroNote && (
        <p class="m-0 flex items-start gap-2 text-sm text-text-muted max-w-[520px]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="flex-none mt-0.5"><circle cx="12" cy="12" r="9" stroke="#64748B" stroke-width="2"/><path d="M12 11 V16 M12 8 V8.5" stroke="#64748B" stroke-width="2" stroke-linecap="round"/></svg>
          <span>{heroNote}</span>
        </p>
      )}
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-surface-muted border-t border-border">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-14 pb-16 flex flex-col gap-7">
      <div class="flex flex-col gap-2.5 items-center text-center">
        <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Reviews</h2>
        <a href={trustpilotUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-sm text-text-muted no-underline border-b border-[#CBD3DF] pb-0.5 hover:text-text">Verified reviews on Trustpilot ↗</a>
        <p class="m-0 text-sm text-text-muted max-w-[560px]">From students of our Texas course: the same team, platform and support behind this course.</p>
      </div>
      <div class="grid gap-5 grid-cols-[repeat(auto-fill,minmax(min(300px,100%),1fr))]">
        {reviews.map((r, i) => (
          <div data-more={i >= SHOWN ? '' : undefined} hidden={i >= SHOWN}>
            <div class="h-full bg-white border border-border rounded-[14px] p-5 flex flex-col gap-3">
              <div class="flex justify-between items-center gap-2.5">
                <span class="text-accent text-[15px] tracking-[2px]" aria-label={`${r.rating} out of 5 stars`}>{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</span>
                <span class="text-xs text-text-muted">{r.date}</span>
              </div>
              {r.title && <strong class="text-[15px] text-text" style={inter}>{r.title}</strong>}
              <p class="m-0 text-[15px] leading-[1.5] text-text flex-1">“{r.quote}”</p>
              <div class="flex items-center gap-2.5 pt-2.5 border-t border-[#EEF2F7]">
                <span class="w-[30px] h-[30px] rounded-full bg-[#DDEBFD] text-primary-deep font-bold text-xs flex items-center justify-center" aria-hidden="true">{r.initials}</span>
                <span class="text-sm font-bold">{r.name}</span>
                <span class="text-xs text-text-muted ml-auto">{r.verified ? 'Verified via Trustpilot' : 'via Trustpilot'}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <button type="button" data-state-reviews-toggle aria-expanded="false" class="self-center font-bold text-base min-h-12 px-6 py-2.5 rounded-full cursor-pointer bg-white text-text border-2 border-[#CBD3DF] hover:border-text-muted">Show more reviews</button>
    </div>
  </section>

  <!-- Your course: one card on a contrast panel -->
  <section id="course" class="bg-white border-t border-border scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-9 items-center">
      <div class="flex flex-col gap-2 text-center max-w-[640px]">
        <h2 class="m-0 font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Your Course</h2>
        <p class="m-0 text-base text-text-muted">One price, everything included. Nothing is added at checkout.</p>
      </div>
      <div class="w-full max-w-[460px] rounded-[20px] px-6 py-7 flex flex-col gap-4 bg-[#0B2160] text-white border border-[#0B2160] shadow-[0_24px_60px_rgba(11,33,96,0.28)]">
        <div class="flex justify-between gap-4 items-start">
          <h3 class="m-0 font-extrabold text-[21px] leading-[1.2]" style={inter}>{course.course.name}</h3>
          <span class="flex-none font-bold text-xs px-3 py-1.5 rounded-full bg-white text-primary-deep">{course.state.agencyShort}-Approved</span>
        </div>
        <p class="m-0 flex items-baseline gap-1"><span class="font-extrabold text-[44px] leading-none" style={inter}>{dollars}</span><span class="text-base text-[#D6E8FD]">{cents ? `.${cents}` : '.00'}</span></p>
        <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
          {cardChecks.map((c) => (
            <li class="flex gap-3.5 items-start">
              <span class="flex-none w-6 h-6 rounded-full bg-white/20 flex items-center justify-center" set:html={check('#FFFFFF')} />
              <span class="text-[15px] leading-[1.45] pt-0.5 text-[#D6E8FD]">{c.strong && <strong class="text-white">{c.strong}</strong>}{c.rest}</span>
            </li>
          ))}
        </ul>
        <a href={enrollUrl} data-rrs-cta={`${key}-course-card`} class="mt-2 no-underline text-center font-extrabold text-[17px] px-4 py-3.5 rounded-xl bg-white hover:bg-info text-primary-deep" style={inter}>Enroll Now&nbsp;→</a>
      </div>
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-base text-text-body">
        <span class="inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" stroke="#2454E6" stroke-width="2"/><path d="M8 11 V8 a4 4 0 0 1 8 0 V11" stroke="#2454E6" stroke-width="2"/></svg>Secure checkout</span>
        <span class="inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 L19 6 V11 C19 16 16 19 12 21 C8 19 5 16 5 11 V6 Z" stroke="#2454E6" stroke-width="2" stroke-linejoin="round"/><path d="M9 12 L11.2 14.2 L15.5 9.8" stroke="#2454E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{course.state.agencyShort}-approved provider</span>
        <span class="hidden sm:inline-flex items-center gap-2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="#2454E6" stroke-width="2"/><path d="M14.5 9 C14 8.2 13 7.8 12 7.8 C10.5 7.8 9.5 8.6 9.5 9.8 C9.5 12.4 14.5 11.2 14.5 14 C14.5 15.3 13.4 16.2 12 16.2 C10.8 16.2 9.8 15.7 9.3 14.8 M12 6.5 V7.8 M12 16.2 V17.5" stroke="#2454E6" stroke-width="1.8" stroke-linecap="round"/></svg>100% risk-free guarantee</span>
      </div>
    </div>
  </section>

  <!-- Risk-free -->
  <section class="bg-white">
    <div class="max-w-[880px] mx-auto px-4 sm:px-6 pt-0 pb-[88px]">
      <div class="bg-surface-muted border border-border rounded-3xl px-6 sm:px-10 py-12 flex flex-col items-center gap-4 text-center">
        <span class="w-16 h-16 rounded-full bg-white border border-[#DCE4EF] flex items-center justify-center"><svg width="32" height="32" viewBox="0 0 34 38" fill="none" aria-hidden="true"><path d="M17 2 L31 7 V18 C31 27 24 33 17 36 C10 33 3 27 3 18 V7 Z" stroke="#2454E6" stroke-width="3" stroke-linejoin="round"/><path d="M11 18.5 L15.5 23 L23.5 14" stroke="#2454E6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <h2 class="m-0 font-extrabold text-[28px] lg:text-[36px] leading-[1.15] text-text" style={inter}>Try It 100% Risk-Free</h2>
        <p class="m-0 text-lg text-text-body max-w-[560px]">If you’re not satisfied, you can request a full refund before you complete the course or receive your certificate.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full max-w-[600px]">
          {['No complicated forms or hoops', 'Refund processed within 3–5 business days'].map((t) => (
            <span class="flex items-center justify-center gap-2 h-14 bg-white border border-[#DCE4EF] rounded-2xl px-4 text-sm leading-5 font-bold text-text text-center"><span class="flex-none w-5 h-5 rounded-full bg-[#E3F6EC] flex items-center justify-center [&>svg]:w-3 [&>svg]:h-3" set:html={check('#1E8E53')} />{t}</span>
          ))}
        </div>
        <a href={enrollUrl} data-rrs-cta={`${key}-risk-free`} class="mt-1.5 no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-lg px-6 sm:px-[30px] py-[15px] rounded-full max-w-full sm:whitespace-nowrap" style={inter}>Start Risk-Free Today&nbsp;→</a>
      </div>
    </div>
  </section>

  <!-- What to expect -->
  <section id="how-it-works" class="bg-white border-t border-border scroll-mt-28">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-20 pb-[88px] flex flex-col gap-3">
      <h2 class="m-0 text-center font-extrabold text-[32px] lg:text-[48px] leading-[1.1] text-text" style={inter}>What to Expect</h2>
      <p class="m-0 text-center text-lg text-text-body">Everything you need to know about the {course.state.name} process.</p>
      <div class="w-full sm:w-auto self-center grid grid-cols-2 sm:flex sm:flex-wrap sm:justify-center gap-1 bg-info rounded-2xl sm:rounded-[28px] p-1.5 mt-5 mb-7" role="group" aria-label="What to expect topics" data-state-tabs>
        {tabs.map((t, i) => (
          <button type="button" data-pick={t.key} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['font-bold text-sm sm:text-base min-h-[44px] sm:min-h-[46px] px-3 sm:px-[22px] py-2 sm:py-2.5 border-0 rounded-xl sm:rounded-full cursor-pointer', i === 0 ? 'bg-primary text-white' : 'bg-transparent text-text']} style={inter}>{t.label}</button>
        ))}
      </div>
      <div class="flex flex-wrap gap-14 items-start">
        <div class="flex-[999_1_480px] min-w-0">
          {tabs.map((t, ti) => (
            <div data-panel={t.key} hidden={ti !== 0}>
              <div class="flex flex-col">
                <p class="m-0 mb-[18px] text-[17px] text-text-body">{t.intro}</p>
                {t.items.map(([title, body]) => (
                  <details name={`exp-${t.key}`} class="group border-t border-border">
                    <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 py-5 cursor-pointer font-extrabold text-[19px] text-text" style={inter}>
                      {title}
                      <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#3B4250')} />
                    </summary>
                    <p class="m-0 mb-5 text-base text-text-body">{body}</p>
                  </details>
                ))}
                {t.note && <div class="border-t border-border pt-4 text-[15px] text-text-muted">{t.note}</div>}
                {t.link && <a href={contactUrl} class="self-start mt-2 no-underline bg-primary hover:bg-primary-hover text-white font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap">Contact Support&nbsp;→</a>}
              </div>
            </div>
          ))}
        </div>
        <div class="hidden lg:block flex-[1_1_380px] min-w-0 bg-[#F4F6F9] rounded-[28px] px-10 py-12" aria-hidden="true">
          <div class="bg-white rounded-[20px] p-[26px] flex flex-col gap-2.5 shadow-[0_10px_28px_rgba(11,33,96,0.06)]">
            <div class="flex justify-between text-[15px]"><strong class="text-text-body">Course progress</strong><strong class="text-text">4 of {modules.length}</strong></div>
            <div class="bg-[#EEF2F7] rounded-full h-2 mb-1.5"><div class="h-2 rounded-full bg-[#9DB4D6]" style={`width:${Math.round((4 / modules.length) * 100)}%`}></div></div>
            {progressDone.map((m) => (
              <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full bg-[#9DB4D6] flex items-center justify-center"><svg width="12" height="12" viewBox="0 0 22 22" fill="none"><path d="M4 11.5 L9 16 L18 6" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{m}</div>
            ))}
            {progressNext && <div class="flex gap-3 items-center bg-surface-muted rounded-xl px-3.5 py-[11px] text-[15px] text-text"><span class="flex-none w-6 h-6 rounded-full border-2 border-[#9DB4D6]"></span>{progressNext}</div>}
            <span class="mt-1.5 text-center bg-[#EEF2F7] text-text-body font-bold text-[15px] p-3 rounded-xl">Continue module 5</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About us -->
  <section class="bg-surface-muted border-t border-border">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px]">
      <div class="max-w-[860px] mx-auto bg-white border border-border rounded-[20px] px-6 sm:px-10 py-9 flex flex-col gap-3.5 shadow-[0_6px_18px_rgba(11,33,96,0.05)]">
        <span class="text-[13px] font-bold text-primary-deep uppercase tracking-[0.08em]">About us</span>
        <h2 class="m-0 font-extrabold text-[26px] leading-[1.2] text-text" style={inter}>Why we built Road Ready Safety</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-text-body">Our goal is simple: fair, transparent, state-approved courses for {aboutWho}, plus plain-English guides so nobody is left confused, frustrated or upset about what their state requires.</p>
        <p class="m-0 text-[17px] leading-[1.65] text-text-body">A lot of drivers have had bad experiences with surprise fees, confusing options and no one to help. Our refund policy is compliant and clear, because we want to earn back the trust those experiences cost.</p>
        <p class="m-0 text-[17px] leading-[1.65] text-text-body">We hope you leave with a great course and a great experience, and that you trust us enough to tell your friends.</p>
        <span class="text-[15px] font-bold text-text">The Road Ready Safety team</span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-white border-t border-border scroll-mt-28">
    <div class="max-w-[820px] mx-auto px-4 sm:px-6 pt-20 pb-24 flex flex-col gap-3">
      <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Frequently Asked Questions</h2>
      <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Everything you need to know about the {course.course.shortName.toLowerCase().includes(course.state.name.toLowerCase()) ? course.course.shortName : `${course.state.name} course`}.</p>
      <div class="flex flex-col gap-2.5">
        {faqs.map((f, i) => (
          <details name={`${key}-faq`} open={i === 0} class="group bg-white border border-border rounded-[14px] open:border-[#B9D3F6] open:shadow-[0_8px_20px_rgba(11,33,96,0.06)]">
            <summary class="list-none [&::-webkit-details-marker]:hidden flex justify-between items-center gap-4 px-[22px] py-[18px] cursor-pointer">
              <h3 class="m-0 font-bold text-[17px] text-text" style={inter}>{f.q}</h3>
              <span class="flex-none transition-transform group-open:rotate-180" set:html={chev('#2454E6', 20)} />
            </summary>
            <p class="m-0 px-[22px] pb-5 text-base leading-[1.6] text-text-body">{f.a}</p>
          </details>
        ))}
      </div>
      <div class="mt-[18px] bg-info border border-[#B9E2FE] rounded-[18px] px-7 py-6 flex flex-wrap gap-3.5 items-center justify-between">
        <div class="flex flex-col"><strong class="text-[19px] text-text" style={inter}>Still have questions?</strong><span class="text-[15px] text-text-body">Our support team is here to help.</span></div>
        <a href={contactUrl} class="no-underline bg-white text-text border border-[#B9D3F6] font-bold text-base px-[22px] py-3 rounded-full whitespace-nowrap hover:border-primary">Contact Support&nbsp;→</a>
      </div>
    </div>
  </section>

  <!-- Helpful resources -->
  <section class="bg-surface-muted border-t border-border">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 pt-[72px] pb-[88px] flex flex-col gap-3.5">
      <h2 class="m-0 text-center font-extrabold text-[30px] lg:text-[40px] leading-[1.12] text-text" style={inter}>Helpful Resources</h2>
      <p class="m-0 mb-5 text-center text-[17px] text-text-muted">Free guides to help you through every step of the {course.state.name} process.</p>
      <div class="max-w-[760px] w-full mx-auto flex flex-col border-t border-border">
        {resources.map((r) => (
          <a href={r.href} class="group no-underline text-text flex items-start py-4 border-b border-border">
            <span class="flex flex-col gap-1 min-w-0">
              <span class="text-xs font-bold text-primary-deep uppercase tracking-[0.06em]">{r.tag}</span>
              <span class="font-extrabold text-lg text-text leading-[1.3] group-hover:text-primary" style={inter}>{r.title}</span>
              <span class="text-[15px] text-text-body">{r.blurb}</span>
              <span class="text-sm font-bold text-primary mt-0.5">Read guide&nbsp;→</span>
            </span>
          </a>
        ))}
      </div>
      <a href={`${course.state.route}/blog`} class="self-center text-center mt-4 font-bold text-base text-primary-deep underline">Every {course.state.name} guide&nbsp;→</a>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    if (window.__rrsStateLanding) return;
    window.__rrsStateLanding = true;
    // One delegated listener (survives ViewTransitions): reviews toggle + What to Expect tabs.
    document.addEventListener('click', function (e) {
      var rt = e.target.closest('[data-state-reviews-toggle]');
      if (rt) {
        var open = rt.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('[data-more]').forEach(function (el) { el.hidden = !open; });
        rt.setAttribute('aria-expanded', open ? 'true' : 'false');
        rt.textContent = open ? 'Show fewer reviews' : 'Show more reviews';
        return;
      }
      var b = e.target.closest('[data-state-tabs] [data-pick]');
      if (!b) return;
      var key = b.getAttribute('data-pick');
      document.querySelectorAll('[data-state-tabs] [data-pick]').forEach(function (x) {
        var on = x === b;
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
        x.classList.toggle('bg-primary', on); x.classList.toggle('text-white', on);
        x.classList.toggle('bg-transparent', !on); x.classList.toggle('text-text', !on);
      });
      document.querySelectorAll('#how-it-works [data-panel]').forEach(function (p) {
        var show = p.getAttribute('data-panel') === key;
        p.hidden = !show;
        if (show) p.querySelectorAll('details').forEach(function (d) { d.open = false; });
      });
    });
  })();
</script>

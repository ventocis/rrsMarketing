---
/**
 * North Dakota landing page on the /texas page structure (Jackson, 2026-10-08), via the shared
 * StateLanding layout. This is the point reduction course: the page says so in the hero and never
 * presents it as an insurance course (the insurance premium reduction course is a different course).
 *
 * Why a rest-param route: `north-dakota/[...override]` outranks the shared `[state]/index.astro`
 * for /north-dakota only, and getStaticPaths returns nothing when the state is disabled.
 * Facts come from nd-ddc.json (price, hours, modules, exam, FAQs) and the NDCC 39-06.1 facts verified
 * 2026-09-29 (memory: rrs-north-dakota-launch). Banned on ND pages: "insurance discount", NSC wording.
 */
import CourseLayout from '../../layouts/CourseLayout.astro';
import StateLanding from '../../components/state-landing/StateLanding.astro';
import nd from '../../data/courses/nd-ddc.json';
import ndIpr from '../../data/courses/nd-ipr.json';
import type { CourseData } from '../../data/courses/types';
import { isEnabled, siteUrl } from '../../lib/courseFlags';

export function getStaticPaths() {
  return isEnabled(nd as CourseData) ? [{ params: { override: undefined } }] : [];
}

const course = nd as CourseData;
const route = course.state.route;
const price = `$${course.course.priceUsd}`;
// The insurance premium reduction course (nd-ipr, a different course under the Highway Patrol) is linked
// from the hero and Helpful Resources only once it is enabled, so a reader with the other intent is sent to
// the right page. The FAQ answer in nd-ddc.json carries its own link to that course (NDHP approved it
// through 2028-10-31, so the two courses are live together); the FAQ and pricing pages render the same answer.
const insurance = ndIpr as CourseData;
const insuranceOn = isEnabled(insurance);
const faqs = course.faqs;
const exam = course.exam;
const modules = course.course.modules.filter((m) => !/quiz|exam/i.test(m.title));

const bullets = [
  { label: 'NDDOT-Approved', text: 'Approved by the North Dakota Department of Transportation for point reduction.' },
  { label: '3 Points Off', text: 'Once every 12 months, up to 9 points in 3 years.' },
  { label: 'Or Keep Points Off', text: 'Elect the course at court for a ticket worth 5 points or fewer.' },
  { label: `${course.course.hours} Hours, Your Pace`, text: 'Pause anytime, pick up on any device.' },
  { label: 'Certificate Included', text: `Download it the moment you pass. ${price} total.` },
];

const cardChecks = [
  { strong: `${course.course.hours}-hour course, NDDOT-approved for point reduction`, rest: ', to take 3 points off or keep a ticket’s points off' },
  { rest: `${modules.length} short modules in plain English` },
  { rest: `${exam.questions}-question final quiz, unlimited retakes` },
  { rest: 'Certificate ready to download the moment you pass' },
  { rest: 'Phone, tablet or computer: start, stop and resume anytime' },
  { rest: 'Real customer support' },
];

const tabs = [
  {
    key: 'rules', label: 'North Dakota Rules',
    intro: 'North Dakota’s defensive driving course works one of two ways, under NDCC 39-06.1:',
    items: [
      ['Take 3 points off your record', 'Finish the course and NDDOT takes 3 points off your record, once every 12 months and no more than 9 points in 3 years. It only removes points already on your record when you finish (NDCC 39-06.1-13).'],
      ['Or keep a ticket’s points off', 'For a violation worth 5 points or fewer, you can elect the course at court when you post bond, and those points are never entered on your record. The bond is still forfeited, and NDDOT needs your certificate within 30 days of the election (NDCC 39-06.1-10.1).'],
      ['Limits on the in-lieu option', 'You can use it once every 12 months, and criminal traffic offenses don’t qualify. Electing it also forfeits the point-reduction option; call NDDOT at 701-328-2604 to ask how they will apply that to your record.'],
      ['It can’t undo a suspension', 'At 12 or more points North Dakota suspends the license, 7 days for each point over 11. The reduction applies after the suspension is served. Under 18, the license is canceled at 6 points.'],
      ['Send your certificate to NDDOT', 'North Dakota has no provider reporting system, so this step is yours: email your certificate to drs@nd.gov or mail it to the Driver License Division.'],
    ] as [string, string][],
    note: 'NDDOT applies the reduction, not us. If you’re unsure how it affects your record, call NDDOT at 701-328-2604.',
  },
  {
    key: 'topics', label: 'Topics Covered',
    intro: course.curriculum.intro,
    items: [
      ...modules.map((m) => [m.title, m.blurb] as [string, string]),
      ['The final quiz', `${exam.questions} questions; ${exam.passCount} correct passes. ${exam.failNote}`],
    ] as [string, string][],
  },
  {
    key: 'support', label: 'Support',
    intro: 'We’re here to help throughout your course, from questions about the material to login or account access. Browse our help articles anytime, or contact us and a real person will help.',
    items: [] as [string, string][],
    link: true,
  },
  {
    key: 'after', label: 'After the Course',
    intro: 'Once you pass, your certificate of completion is ready to download right away.',
    items: [
      ['Send it to NDDOT', 'Email it to drs@nd.gov or mail it to the Driver License Division. If you elected the course at court, NDDOT needs it within 30 days of that election.'],
      ['Check your record', 'NDDOT applies the reduction to points already on your record. You can order a copy of your driving record from NDDOT to confirm it.'],
      ['Keep a copy', 'Keep the certificate PDF until you see the change on your record.'],
    ] as [string, string][],
  },
];

const resources = [
  { href: `${route}/blog/north-dakota-points-suspension-three-point-reduction`, tag: 'Points', title: 'North Dakota’s points system and the 3-point reduction', blurb: 'How points add up, when a suspension starts, and what the course takes off.' },
  { href: `${route}/blog/in-lieu-of-points-north-dakota-court-election`, tag: 'At court', title: 'In lieu of points: how to elect the course', blurb: 'What to tell the clerk when you post bond, and the 30-day deadline.' },
  { href: `${route}/blog/north-dakota-speeding-ticket`, tag: 'Tickets', title: 'North Dakota speeding ticket: fine and points', blurb: 'What a speeding ticket costs and how many points it carries.' },
  { href: `${route}/blog/north-dakota-traffic-ticket`, tag: 'Tickets', title: 'Got a North Dakota ticket? What to do next', blurb: 'Pay, keep the points off, or contest it.' },
  { href: `${route}/blog/send-defensive-driving-certificate-to-nddot`, tag: 'After the course', title: 'How to send your certificate to NDDOT', blurb: 'Where to email it, and what happens next.' },
  { href: `${route}/blog/how-long-is-north-dakota-defensive-driving-course`, tag: 'The course', title: 'How long the North Dakota course takes', blurb: 'Four hours, at your own pace.' },
  ...(insuranceOn ? [
    { href: '/north-dakota/which-course', tag: 'Which course?', title: 'Points off, or a lower premium? Pick the right North Dakota course', blurb: 'Two agencies approve two different courses. One question sorts it out.' },
    { href: insurance.state.route, tag: 'Insurance', title: 'The insurance premium reduction course', blurb: 'Lower your premium for two years, three at 55+. A separate course, also four hours.' },
  ] : []),
];

// One node typed both Course and Product (2026-10-05): Google retired Course rich results, and the
// price only counts in Product (merchant listing) markup, which needs an image and one Offer.
// The layout's own Course block is switched off on this page so there is one description, not two.
const courseProductSchema = {
  '@context': 'https://schema.org',
  '@type': ['Product', 'Course'],
  '@id': `${siteUrl}${route}#course`,
  name: course.course.name,
  description: course.seo.courseDescription,
  url: `${siteUrl}${route}`,
  image: `${siteUrl}/assets/images/badges/north-dakota-approved.png`,
  brand: { '@type': 'Brand', name: course.provider.dba },
  category: 'Online defensive driving course',
  provider: { '@type': 'Organization', name: course.provider.dba, legalName: course.provider.legalName, url: siteUrl },
  educationalCredentialAwarded: course.seo.credential,
  timeRequired: `PT${course.course.hours}H`,
  inLanguage: 'en-US',
  offers: {
    '@type': 'Offer',
    price: course.course.priceUsd,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: `${siteUrl}${route}`,
    seller: { '@type': 'Organization', name: course.provider.dba },
    areaServed: { '@type': 'State', name: course.state.name },
  },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: `PT${course.course.hours}H` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

---
<CourseLayout
  course={course}
  title={course.seo.title}
  description={course.seo.description}
  keywords={course.seo.keywords}
  url={route}
  courseSchema={false}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: course.course.name, url: route }]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(courseProductSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <StateLanding
    course={course}
    seal={{ src: '/assets/images/badges/north-dakota-approved.png', alt: 'North Dakota approved: defensive driving course, NDDOT-approved for point reduction', label: 'NDDOT-Approved Point Reduction Course' }}
    h1="Take 3 Points Off with a North Dakota Defensive Driving Course Online"
    bullets={bullets}
    heroNote="This is North Dakota’s point reduction course. The insurance premium reduction course is a different course."
    heroNoteLink={insuranceOn ? { href: insurance.state.route, label: 'See the insurance course →' } : undefined}
    faqs={faqs}
    cardChecks={cardChecks}
    tabs={tabs}
    resources={resources}
    aboutWho="North Dakotans"
    sampleNumber="ND-000123"
  />
</CourseLayout>

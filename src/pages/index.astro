      </div>
      <div class="px-5 sm:px-7 py-5 flex flex-col gap-5">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Pick your state" data-state-pills>
          {picker.map((p) => (
            <button type="button" data-pick={p.key} aria-pressed="false" class="font-bold text-[15px] min-h-11 px-4 py-2 rounded-full cursor-pointer border-2 bg-white text-[#0B2160] border-[#CBD3DF] hover:border-[#0B2160]">{p.name}</button>
          ))}
        </div>
        <p data-picker-hint class="m-0 text-[15px] text-text-body">Pick a state above to see its course.</p>
        {picker.map((p) => (
          <div data-panel={p.key} hidden>
            <div class="flex flex-col gap-3">
              {p.courses.map((c) => (
                <div class="bg-[#F4F8FD] border border-[#DCE4EF] rounded-[18px] p-5 flex flex-wrap gap-3.5 items-center justify-between">
                  <div class="flex flex-col gap-0.5 min-w-0 flex-[1_1_260px]"><strong class="text-[18px] leading-[1.3] text-[#0B2160]" style={inter}>{c.title}</strong><span class="text-[15px] text-text-body">{c.sub}</span></div>
                  <div class="flex gap-2.5 flex-wrap">
                    <a href={c.href} data-rrs-cta={c.ctaId} class="no-underline bg-primary hover:bg-primary-hover text-white font-extrabold text-base px-[22px] py-[13px] rounded-full whitespace-nowrap">{c.cta}&nbsp;→</a>
                    {c.learn && <a href={c.learn} class="no-underline text-[#0B2160] font-bold text-base px-5 py-3 rounded-full border border-[#CBD3DF] hover:border-[#0B2160] whitespace-nowrap bg-white">Learn more</a>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
        <p class="m-0 text-sm text-text-body border-t border-border pt-4">Don’t see your state? <a href="/courses" class="font-bold text-[#0B2160]">Browse every course</a>. We add states as they approve us.</p>
      </div>
    </dialog>
  </main>

  <Footer />

  <style>
    .rrs-state-dialog::backdrop { background: rgba(11, 33, 96, 0.55); }
    .rrs-state-dialog[open] { display: block; overflow: auto; }
  </style>

  <script is:inline>
    (function () {
      if (window.__rrsHomeV3) return;
      window.__rrsHomeV3 = true;
      // One delegated listener (no dependency on the ViewTransitions router): reviews toggle + state finder.
      document.addEventListener('click', function (e) {
        var rt = e.target.closest('#home-reviews-toggle');
        if (rt) {
          var open = rt.getAttribute('aria-expanded') !== 'true';
          document.querySelectorAll('[data-more]').forEach(function (el) { el.hidden = !open; });
          rt.setAttribute('aria-expanded', open ? 'true' : 'false');
          rt.textContent = open ? 'Show fewer reviews' : 'Show more reviews';
          return;
        }
        var dlg = document.getElementById('state-picker');
        if (!dlg) return;
        if (e.target.closest('[data-open-states]')) {
          if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.setAttribute('open', '');
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'finder_open', location: 'home_hero' });
          return;
        }
        if (e.target.closest('[data-close-states]') || e.target === dlg) { dlg.close ? dlg.close() : dlg.removeAttribute('open'); return; }
        var b = e.target.closest('[data-state-pills] [data-pick]');
        if (!b) return;
        var key = b.getAttribute('data-pick');
        dlg.querySelectorAll('[data-state-pills] [data-pick]').forEach(function (x) {
          var on = x === b;
          x.setAttribute('aria-pressed', on ? 'true' : 'false');
          ['bg-[#0B2160]', 'text-white', 'border-[#0B2160]'].forEach(function (c) { x.classList.toggle(c, on); });
          ['bg-white', 'text-[#0B2160]', 'border-[#CBD3DF]'].forEach(function (c) { x.classList.toggle(c, !on); });
        });
        var hint = dlg.querySelector('[data-picker-hint]');
        if (hint) hint.hidden = true;
        dlg.querySelectorAll('[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== key; });
      });
    })();
  </script>
</Layout>

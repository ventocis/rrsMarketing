---
import CourseLayout from '../../layouts/CourseLayout.astro';
import PageIntro from '../../components/course/PageIntro.astro';
import PolicyDoc from '../../components/course/PolicyDoc.astro';
import { enabledCourses, stateParam } from '../../data/courses/index';
import type { CourseData } from '../../data/courses/types';

export function getStaticPaths() {
  return enabledCourses.map((course) => ({ params: { state: stateParam(course) }, props: { course } }));
}

const { course } = Astro.props as { course: CourseData };
const route = course.state.route;
---

<CourseLayout
  course={course}
  title={`Refund and Withdrawal Policy — ${course.course.shortName} | Road Ready Safety`}
  description={`Refund policy for the ${course.course.name}: a full refund at any time before you complete the course, no cancellation window, no pro-rata deductions.`}
  url={`${route}/refund`}
>
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-surface-muted">
    <div class="max-w-4xl mx-auto">
      <PageIntro chip="Legal" title="Refund and Withdrawal Policy" subtitle={`${course.provider.legalName} d/b/a ${course.provider.dba}`} />
      <PolicyDoc file="refund-standard.md" tokens={{ courseName: `the ${course.course.name}`, stateName: course.state.name, agency: course.state.agency, supportEmail: course.provider.supportEmail, supportPhone: course.provider.supportPhone }} />
    </div>
  </section>
</CourseLayout>
